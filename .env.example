# Remote Turso Database (server-only; configure these in Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local review only. Never use demo mode to simulate persistence in production.
ASSESSMENT_DEMO_MODE=true

# Internal Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser key restricted to approved HTTP referrers and Maps JavaScript API / Places API (New).
PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (server-only). Use test locally and matching LIVE credentials in Vercel Production.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Production:
# STRIPE_MODE=live
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_... # signing secret from the LIVE webhook endpoint
