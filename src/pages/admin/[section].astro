---
import AdminShell from '../../layouts/AdminShell.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const section = Astro.params.section;
const sections = {
  informes: { title: 'Informes', eyebrow: 'ESPACIO / INFORMES', description: 'Decisiones apoyadas en datos reales y trazables.', heading: 'Una vista que contará lo que importa.', body: 'Los informes estarán disponibles cuando las fuentes operativas estén conectadas y verificadas. No mostramos métricas estimadas como resultados.', icon: 'reports' },
  configuracion: { title: 'Configuración', eyebrow: 'ESPACIO / CONFIGURACIÓN', description: 'Identidad, acceso y preferencias del espacio privado.', heading: 'Control para el equipo autorizado.', body: 'La gestión de usuarios, permisos y sesiones se activará después de verificar la autenticación de staging. Los cambios sensibles quedarán auditados.', icon: 'settings' },
} as const;
if (!section || !(section in sections)) return new Response('No se ha encontrado la sección.', { status: 404 });
const page = sections[section as keyof typeof sections];
---
<AdminShell title={page.title} eyebrow={page.eyebrow} description={page.description} active={`/admin/${section}`} principal={principal}>
  <section class="admin-placeholder" aria-labelledby="placeholder-title"><div class="admin-placeholder-copy"><span class="admin-placeholder-icon"><AdminIcon name={page.icon} /></span><p class="admin-eyebrow">PRÓXIMAMENTE EN ALTARIA OS</p><h2 id="placeholder-title">{page.heading}</h2><p>{page.body}</p></div><div class="admin-placeholder-visual" aria-hidden="true"><div class="admin-placeholder-sheet"><span></span><span></span><span></span><span></span><span></span></div></div></section>
</AdminShell>
