---
import AdminShell from '../../../layouts/AdminShell.astro';
import ContentNav from '../../../components/admin/ContentNav.astro';
import {createAdminCsrfToken} from '../../../lib/admin/access';
import {listBrands} from '../../../lib/admin/content/service';
import {listAssets} from '../../../lib/admin/content/storage';
import {grantFor} from '../../../lib/admin/content/model';
import {randomUUID} from 'node:crypto';
import '../../../styles/admin-content.css';
export const prerender=false;
const principal=Astro.locals.admin;
if(!principal)return new Response('Acceso denegado.',{status:403});
const rows=await listBrands(principal);
const brands=rows.filter((b,i,a)=>a.findIndex(x=>x.id===b.id)===i);
const brandId=Astro.url.searchParams.get('marca')??String(brands[0]?.id??'');
if(!brands.some(b=>b.id===brandId))return new Response('Marca no disponible.',{status:403});
const brand=brands.find(b=>b.id===brandId);
const assets=await listAssets(principal,brandId);
const canEdit=Boolean(brand?.status==='active'&&grantFor(principal,brandId)?.edit);
const csrf=createAdminCsrfToken(principal.sessionHash,process.env.WORKOS_COOKIE_PASSWORD||'','content');
---
<AdminShell title="Biblioteca" eyebrow="CONTENIDO / RECURSOS"
  description="Originales y exportaciones con procedencia, derechos e integridad comprobada."
  active="/admin/contenido" principal={principal}>
  <ContentNav active="library"/>
  <section class="content-hero"><div><p class="admin-eyebrow">ARCHIVO PRIVADO · TEST</p>
    <h2>Recursos con historia.</h2><p>Los archivos de esta fase permanecen en un adaptador local privado. No hay bucket cloud ni URL pública.</p></div></section>
  {Astro.url.searchParams.has('guardado')&&<p class="content-notice" role="status">Archivo TEST guardado y comprobado.</p>}
  <form class="content-toolbar" method="get"><label class="content-field">Marca<select name="marca">
    {brands.map(b=><option value={String(b.id)} selected={brandId===b.id}>{String(b.name)}</option>)}
    </select></label><button class="content-button" type="submit">Ver biblioteca</button></form>
  <div class="content-card-heading"><div><p class="content-kicker">{String(brand?.name??'Marca')}</p>
    <h2>{assets.length} recursos registrados</h2></div></div>
  {assets.length?<div class="content-assets">{assets.map(asset=><article class="content-card content-asset">
    <div class="content-asset-preview">
      {String(asset.mime_type).startsWith('image/')
        ?<img src={`/api/admin/content/assets/${asset.id}?preview=1`} alt={`Vista previa privada de ${asset.file_name}`} loading="lazy"/>
        :asset.mime_type==='video/mp4'?<video controls preload="metadata"
          aria-label={`Vista previa privada de ${String(asset.file_name)}`}
          src={`/api/admin/content/assets/${asset.id}?preview=1`}></video>
        :asset.mime_type==='application/pdf'?<a
          href={`/api/admin/content/assets/${asset.id}?preview=1`} target="_blank" rel="noopener noreferrer">
          Vista previa PDF privada ↗</a>:<span>Recurso privado</span>}
    </div>
    <strong>{String(asset.file_name)}</strong><small>{String(asset.asset_class)} · {(Number(asset.byte_size)/1024/1024).toFixed(2)} MiB</small>
    <small>SHA-256 {String(asset.sha256).slice(0,12)}… · {String(asset.status)}</small>
    <p>Procedencia: {String(asset.source_ref)}<br/>Derechos: {String(asset.rights_note)}</p>
    <a href={`/api/admin/content/assets/${asset.id}`}>Descarga privada ↗</a>
  </article>)}</div>:<div class="content-empty"><strong>Sin archivos en esta marca.</strong><p>La biblioteca empieza vacía. Solo importa material con procedencia y derechos revisados.</p></div>}
  {canEdit&&<section class="content-card" id="subir-recurso" style="margin-top:20px">
    <div class="content-card-heading"><div><p class="content-kicker">CARGA PRIVADA SIMULADA</p><h2>Registrar recurso TEST</h2></div></div>
    <form action="/api/admin/content/upload" method="post" enctype="multipart/form-data"
      class="content-form-grid" data-content-upload>
      <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="brandId" value={brandId}/>
      <input type="hidden" name="requestKey" value={randomUUID()}/>
      <label class="content-field">Clase<select name="assetClass"><option value="original">Original</option>
        <option value="work">Trabajo</option><option value="final">Exportación final</option>
        <option value="reference">Referencia</option></select></label>
      <label class="content-field">Archivo (máximo 20 MiB)<input type="file" name="file" required
        accept="image/png,image/jpeg,image/webp,video/mp4,application/pdf"/></label>
      <label class="content-field wide">Procedencia<input name="sourceRef" required minlength="3" maxlength="500"
        placeholder="Ej.: archivo sintético TEST creado para esta pieza"/></label>
      <label class="content-field wide">Derechos y uso<input name="rightsNote" required minlength="3" maxlength="500"
        placeholder="Indica quién autoriza su uso o marca TEST sintético"/></label>
      <button class="content-button" type="submit">Comprobar y guardar en TEST</button>
      <button class="content-button secondary" type="button" data-upload-cancel hidden>Cancelar carga</button>
      <progress class="content-upload-progress" max="100" value="0" hidden aria-label="Progreso de carga"></progress>
    </form><p>Para vídeos grandes se habilitará carga multipart directa solo después de autorizar un proveedor privado.</p>
  </section>}
</AdminShell>
