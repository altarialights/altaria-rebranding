---
import AdminShell from '../../../layouts/AdminShell.astro';
import ContentNav from '../../../components/admin/ContentNav.astro';
import {listBrands,listPieces} from '../../../lib/admin/content/service';
import {listMyWork} from '../../../lib/admin/automation/work';
import {stageLabels,publicationLabels,channelLabels,type ContentStage} from '../../../lib/admin/content/model';
import '../../../styles/admin-content.css';
export const prerender=false;
const principal=Astro.locals.admin;
if(!principal)return new Response('Acceso denegado.',{status:403});
const brands=await listBrands(principal);
const params=Astro.url.searchParams;
const selectedBrand=params.get('marca')??'',selectedChannel=params.get('canal')??'';
const assigned=params.get('responsable')??'',view=['mes','semana','lista'].includes(params.get('vista')??'')
  ?params.get('vista')!:'mes';
const entries=await listPieces(principal,{brandId:selectedBrand,channel:selectedChannel,
  assignedUserId:assigned});
const current=new Date();
const monthInput=params.get('mes');
const month=/^\d{4}-(0[1-9]|1[0-2])$/.test(monthInput??'')
  ?monthInput!:current.toLocaleDateString('sv-SE',{timeZone:'Europe/Madrid'}).slice(0,7);
const dateInput=params.get('dia');
const day=/^\d{4}-\d{2}-\d{2}$/.test(dateInput??'')?dateInput!
  :current.toLocaleDateString('sv-SE',{timeZone:'Europe/Madrid'});
const dateKey=(value:unknown)=>value
  ?new Date(String(value)).toLocaleDateString('sv-SE',{timeZone:'Europe/Madrid'}):'';
const entryDate=(entry:Record<string,unknown>)=>dateKey(entry.scheduled_at||entry.due_at);
const start=new Date(`${view==='semana'?day:month+'-01'}T12:00:00Z`);
if(view==='mes')start.setUTCDate(1-((start.getUTCDay()+6)%7));
else start.setUTCDate(start.getUTCDate()-((start.getUTCDay()+6)%7));
const count=view==='semana'?7:42;
const dates=Array.from({length:count},(_,i)=>{
  const date=new Date(start);date.setUTCDate(start.getUTCDate()+i);
  return {key:date.toISOString().slice(0,10),number:date.getUTCDate(),
    current:date.toISOString().slice(0,7)===month};
});
const offset=(n:number)=>{const date=new Date(`${month}-01T12:00:00Z`);
  date.setUTCMonth(date.getUTCMonth()+n);return date.toISOString().slice(0,7);};
const urlFor=(v:string,m=month,d=day)=>{
  const q=new URLSearchParams({vista:v,mes:m,dia:d});
  if(selectedBrand)q.set('marca',selectedBrand);
  if(selectedChannel)q.set('canal',selectedChannel);
  if(assigned)q.set('responsable',assigned);
  return `/admin/contenido?${q}`;
};
const monthLabel=new Intl.DateTimeFormat('es-ES',{month:'long',year:'numeric',timeZone:'UTC'})
  .format(new Date(`${month}-01T12:00:00Z`));
const people=[...new Map(entries.filter(e=>e.assigned_user_id).map(e=>[
  String(e.assigned_user_id),String(e.assignee_name||'Responsable')])).entries()];
const visiblePieces=new Set(entries.map(entry=>String(entry.id)));
const editorialWork=(await listMyWork(principal)).filter(work=>work.category==='content'
  &&visiblePieces.has(work.href.split('/').pop()??'')).slice(0,8);
---
<AdminShell title="Calendario editorial" eyebrow="CONTENIDO / PLANIFICACIÓN"
  description="Fechas y estados reales de cada marca. La programación no publica en redes."
  active="/admin/contenido" principal={principal}>
  <ContentNav active="calendar"/>
  <section class="content-hero"><div><p class="admin-eyebrow">ALTARIA CONTENT OS · TEST</p>
    <h2>Planifica con contexto.</h2><p>La agenda muestra piezas registradas, revisiones y fechas previstas. Los huecos permanecen vacíos hasta crear una idea.</p></div>
    <a href="/admin/contenido/produccion#crear-pieza">Crear una idea ↗</a></section>
  <form class="content-toolbar" method="get" aria-label="Filtrar calendario">
    <input type="hidden" name="vista" value={view}/><input type="hidden" name="mes" value={month}/>
    <label class="content-field">Marca<select name="marca"><option value="">Todas las autorizadas</option>
      {brands.filter((b,i,a)=>a.findIndex(x=>x.id===b.id)===i).map(b=><option value={String(b.id)}
        selected={selectedBrand===b.id}>{String(b.name)}</option>)}</select></label>
    <label class="content-field">Canal<select name="canal"><option value="">Todos</option>
      <option value="instagram" selected={selectedChannel==='instagram'}>Instagram</option>
      <option value="linkedin" selected={selectedChannel==='linkedin'}>LinkedIn</option></select></label>
    <label class="content-field">Responsable<select name="responsable"><option value="">Todos</option>
      {people.map(([id,name])=><option value={id} selected={assigned===id}>{name}</option>)}</select></label>
    <button class="content-button" type="submit">Filtrar</button>
  </form>
  <div class="content-calendar-head"><h2>{view==='semana'?'Semana de '+day:monthLabel}</h2>
    <div class="content-calendar-switch" aria-label="Vista del calendario">
      <a href={urlFor('mes')} aria-current={view==='mes'?'page':undefined}>Mes</a>
      <a href={urlFor('semana')} aria-current={view==='semana'?'page':undefined}>Semana</a>
      <a href={urlFor('lista')} aria-current={view==='lista'?'page':undefined}>Lista</a>
    </div>
    <div class="content-calendar-switch"><a href={urlFor(view,offset(-1))} aria-label="Mes anterior">←</a>
      <a href={urlFor(view,offset(1))} aria-label="Mes siguiente">→</a></div>
  </div>
  {view==='lista'?<div class="content-list">{entries.length?entries.map(entry=>
    <div class="content-list-row"><div><strong>{String(entry.title)}</strong><small>
      {String(entry.brand_name)} · {channelLabels[String(entry.channel) as keyof typeof channelLabels]}
      · {stageLabels[String(entry.stage) as ContentStage]} · {publicationLabels[String(entry.publication_state) as keyof typeof publicationLabels]}
      {entryDate(entry)?` · ${entryDate(entry)}`:''}</small></div>
      <a href={`/admin/contenido/piezas/${entry.id}`}>Abrir ficha ↗</a></div>)
    :<div class="content-empty"><strong>Sin piezas registradas.</strong><p>Abre Producción para crear la primera idea autorizada.</p></div>}</div>
    :<div class="content-calendar-wrap" tabindex="0" role="region" aria-label="Calendario desplazable"><div class="content-calendar" role="group" aria-label={view==='mes'?monthLabel:'Semana editorial'}>
      {['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(w=><div class="weekday">{w}</div>)}
      {dates.map(date=><div class:list={['content-day',{'is-outside':!date.current&&view==='mes'}]}
        role="group" aria-label={date.key}><strong>{date.number}</strong>
        {entries.filter(entry=>entryDate(entry)===date.key).map(entry=>
          <a class:list={[{scheduled:entry.publication_state==='scheduled',ready:entry.stage==='ready'}]}
            href={`/admin/contenido/piezas/${entry.id}`}>
            {String(entry.title)}<br/><small>{String(entry.brand_name)} · {stageLabels[String(entry.stage) as ContentStage]}</small>
          </a>)}</div>)}</div></div>}
  <section class="content-card" aria-labelledby="calendar-work-title">
    <div class="content-card-heading"><div><p class="content-kicker">MI TRABAJO</p>
      <h2 id="calendar-work-title">Tareas editoriales pendientes</h2></div></div>
    {editorialWork.length?<div class="content-list">{editorialWork.map(work=>
      <div class="content-list-row"><div><strong>{work.title}</strong>
        <small>{work.context}{work.dueAt?` · ${dateKey(work.dueAt)}`:''}</small></div>
        <a href={work.href}>Abrir pieza ↗</a></div>)}</div>
      :<div class="content-empty"><strong>Sin tareas editoriales pendientes.</strong>
        <p>Las sugerencias aparecerán al avanzar una pieza o acercarse su fecha prevista.</p></div>}
  </section>
  <p class="content-notice">PUBLICADA solo aparecerá tras evidencia registrada. En TEST cualquier confirmación es sintética y se identifica como simulación.</p>
</AdminShell>
