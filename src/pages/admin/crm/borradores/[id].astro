---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { getLocalDraft } from '../../../../lib/admin/gmail/service';
import { formatCrmDate } from '../../../../lib/admin/crm/presentation';
import '../../../../styles/admin-proposals.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
let draft;
try { draft = await getLocalDraft(principal, Astro.params.id || ''); }
catch { return new Response('Borrador no encontrado.', { status: 404 }); }
const canWrite = hasAdminPermission(principal, 'crm:write')
  && (principal.roles.includes('owner') || draft.responsible_user_id === principal.id)
  && draft.status !== 'archived';
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
---
<AdminShell title="Borrador comercial." eyebrow="CRM / COMUNICACIONES" description="Respuesta local preparada para revisión, sin envío automático." active="/admin/crm" principal={principal}>
  <CrmNav active="companies" />
  <div class="crm-toolbar"><a class="crm-button secondary" href={`/admin/crm/empresas/${String(draft.organization_id)}#communications`}>← {String(draft.organization_name)}</a><span class="crm-badge">TEST · No enviado</span></div>
  {Astro.url.searchParams.get('saved') && <p class="crm-notice" role="status">Borrador actualizado en TEST.</p>}
  <div class="proposal-layout"><section class="crm-card"><div class="crm-card-heading"><div><h2>Revisar respuesta</h2><p>Destinatario: {String(draft.recipient_email)} · Actualizado {formatCrmDate(draft.updated_at)}</p></div><span class="crm-badge">{String(draft.status)}</span></div>
    {canWrite ? <form action="/api/admin/gmail/draft-update" method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="draftId" value={String(draft.id)} /><div class="crm-form-grid"><label class="crm-field wide">Asunto<input name="subject" required minlength="2" maxlength="240" value={String(draft.subject)} /></label><label class="crm-field wide">Mensaje<textarea name="body" required minlength="5" maxlength="10000" style="min-height:260px">{String(draft.body)}</textarea></label><label class="crm-field">Estado de revisión<select name="status"><option value="review" selected={draft.status === 'review'}>Pendiente de revisión</option><option value="approved" selected={draft.status === 'approved'}>Aprobado internamente</option><option value="archived">Archivar borrador</option></select></label></div><p class="crm-help">Aprobar no envía correos ni crea borradores en Gmail.</p><div class="crm-form-actions"><button class="crm-button" type="submit">Guardar revisión</button></div></form>
      : <div><p class="proposal-message">{String(draft.body)}</p><p class="crm-help">Esta respuesta no se envió desde Altaria OS.</p></div>}
  </section><aside class="crm-card"><div class="crm-card-heading"><div><h2>Contexto comercial</h2><p>Este borrador pertenece a una empresa del CRM.</p></div></div><a class="crm-button secondary" href={`/admin/crm/empresas/${String(draft.organization_id)}#communications`}>Abrir ficha</a>{draft.proposal_id && <a class="crm-button subtle" style="margin-top:10px" href={`/admin/crm/propuestas/${String(draft.proposal_id)}`}>Ver propuesta</a>}</aside></div>
</AdminShell>
