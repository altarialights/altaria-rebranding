---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { listAssignableUsers } from '../../../../lib/admin/crm/queries';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal || !hasAdminPermission(principal, 'crm:write')) return new Response('Acceso denegado.', { status: 403 });
const users = principal.roles.includes('owner') ? await listAssignableUsers() : [];
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
---
<AdminShell title="Nueva empresa." eyebrow="CRM / NUEVA FICHA" description="Empieza por lo esencial. Podrás añadir contactos, oportunidades y actividad desde su ficha." active="/admin/crm" principal={principal}>
  <CrmNav active="companies" />
  <div class="crm-toolbar"><a class="crm-button secondary" href="/admin/crm/empresas">← Volver a empresas</a></div>
  <section class="crm-card" aria-labelledby="new-company-title">
    <div class="crm-card-heading"><div><h2 id="new-company-title">Información principal</h2><p>Los datos de origen se vinculan más tarde, tras verificar el registro histórico.</p></div><span class="crm-badge">ENTORNO TEST</span></div>
    <form action="/api/admin/crm/organizations" method="post" data-crm-form>
      <input type="hidden" name="csrf" value={csrf} />
      <div class="crm-form-grid">
        <label class="crm-field wide">Nombre de la empresa *<input name="name" maxlength="180" minlength="2" required autocomplete="organization" placeholder="Nombre comercial" /></label>
        <label class="crm-field">Sector<input name="sector" maxlength="100" placeholder="Ej. hostelería" /></label>
        <label class="crm-field">Sitio web<input type="url" name="websiteUrl" maxlength="500" placeholder="https://…" /></label>
        <label class="crm-field">Ciudad<input name="city" maxlength="100" autocomplete="address-level2" /></label>
        <label class="crm-field">Provincia o región<input name="region" maxlength="100" autocomplete="address-level1" /></label>
        <label class="crm-field">País<input name="countryCode" value="ES" minlength="2" maxlength="2" required autocomplete="country" /></label>
        <label class="crm-field">Origen declarado<select name="leadOrigin"><option value="manual">Alta manual</option><option value="digital_lead">Diagnóstico digital</option><option value="cards_inquiry">Consulta Cards</option><option value="cards_order">Pedido Cards</option><option value="other">Otro</option></select></label>
        {principal.roles.includes('owner') && <label class="crm-field wide">Responsable comercial<select name="responsibleUserId"><option value="">Yo</option>{users.map((user) => <option value={String(user.id)}>{String(user.display_name || user.email)}</option>)}</select></label>}
      </div>
      <div class="crm-card" style="margin-top:20px;background:#f8fbff"><div class="crm-card-heading"><div><h3>Identificador para detectar duplicados</h3><p>Opcional. Un valor introducido manualmente queda sin verificar hasta contrastarlo con una fuente fiable.</p></div></div>
        <div class="crm-form-grid"><label class="crm-field">Tipo<select name="identifierKind"><option value="">Sin identificador</option><option value="tax_id">Identificador fiscal</option><option value="domain">Dominio</option><option value="google_place_id">Google Place ID</option><option value="external_id">ID externo</option></select></label><label class="crm-field">Valor<input name="identifierValue" maxlength="255" placeholder="Valor exacto" /></label></div>
        <div class="crm-form-actions"><button type="button" class="crm-button secondary" data-crm-dedup-check>Comprobar coincidencias</button></div>
        <div class="crm-dedup" data-crm-dedup-result aria-live="polite">Comprueba coincidencias antes de crear la ficha.</div>
      </div>
      <div class="crm-form-actions">{principal.roles.includes('owner') ? <label class="crm-check"><input type="checkbox" name="confirmPossibleDuplicate" value="1" />He revisado las posibles coincidencias y confirmo que es una empresa distinta.</label> : <p class="crm-help">Si aparece una posible coincidencia, solicita revisión al propietario.</p>}</div>
      <p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p>
      <div class="crm-form-actions"><button class="crm-button" type="submit">Crear empresa</button><a class="crm-button secondary" href="/admin/crm/empresas">Cancelar</a></div>
    </form>
  </section>
</AdminShell>
