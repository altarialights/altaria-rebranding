---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { hasAdminPermission } from '../../../../lib/admin/access';
import { listOrganizations } from '../../../../lib/admin/crm/queries';
import { formatCrmDate, originLabels } from '../../../../lib/admin/crm/presentation';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100).trim();
const sector = (Astro.url.searchParams.get('sector') ?? '').slice(0, 100).trim();
const city = (Astro.url.searchParams.get('city') ?? '').slice(0, 100).trim();
const page = Math.min(Math.max(Number(Astro.url.searchParams.get('page') ?? '1') || 1, 1), 1000);
const organizations = await listOrganizations(principal, { q, sector, city, limit: 50, offset: (page - 1) * 50 });
const canWrite = hasAdminPermission(principal, 'crm:write');
const pageUrl = (next: number) => `/admin/crm/empresas?${new URLSearchParams({ q, sector, city, page: String(next) })}`;
---
<AdminShell title="Empresas." eyebrow="CRM / CARTERA" description="Encuentra cada relación y abre su ficha completa." active="/admin/crm" principal={principal}>
  <CrmNav active="companies" />
  <div class="crm-toolbar"><div><h2>Tu cartera</h2><p>Empresas activas en el entorno TEST.</p></div>{canWrite && <a class="crm-button" href="/admin/crm/empresas/nueva">+ Nueva empresa</a>}</div>
  <form class="crm-filters" method="get" action="/admin/crm/empresas" role="search" aria-label="Buscar y filtrar empresas">
    <label class="crm-field">Buscar empresa<input type="search" name="q" value={q} maxlength="100" placeholder="Nombre de empresa" /></label>
    <label class="crm-field">Sector<input type="search" name="sector" value={sector} maxlength="100" placeholder="Todos" /></label>
    <label class="crm-field">Ciudad<input type="search" name="city" value={city} maxlength="100" placeholder="Todas" /></label>
    <button class="crm-button secondary" type="submit">Aplicar filtros</button>
  </form>
  {organizations.length ? <section class="crm-card" aria-label="Resultados de empresas"><div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Empresa</th><th>Sector y ubicación</th><th>Origen</th><th>Responsable</th><th>Actualizada</th></tr></thead><tbody>
    {organizations.map((organization) => <tr><td><a href={`/admin/crm/empresas/${organization.id}`}>{organization.name}</a><small>{organization.website_url ?? 'Sin sitio web'}</small></td><td>{organization.sector ?? 'Sin sector'}<small>{[organization.city, organization.region].filter(Boolean).join(' · ') || 'Sin ubicación'}</small></td><td>{originLabels[organization.lead_origin] ?? organization.lead_origin}</td><td>{organization.responsible_name ?? 'Equipo Altaria'}</td><td>{formatCrmDate(organization.updated_at)}</td></tr>)}
  </tbody></table></div></section> : <div class="crm-empty"><strong>{q || sector || city ? 'No hay empresas con esos filtros.' : 'Aún no hay empresas.'}</strong><p>{q || sector || city ? 'Prueba otra búsqueda o limpia los filtros.' : 'La primera ficha reunirá contactos, oportunidades, actividades y próximas acciones.'}</p>{q || sector || city ? <a class="crm-button secondary" href="/admin/crm/empresas">Limpiar filtros</a> : canWrite && <a class="crm-button" href="/admin/crm/empresas/nueva">Crear empresa</a>}</div>}
  {(page > 1 || organizations.length === 50) && <nav class="crm-form-actions" aria-label="Páginas de empresas">{page > 1 && <a class="crm-button secondary" href={pageUrl(page - 1)}>Anterior</a>}{organizations.length === 50 && <a class="crm-button secondary" href={pageUrl(page + 1)}>Siguiente</a>}</nav>}
</AdminShell>
