---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { canAdvanceStage, crmStages, stageLabels, type CrmStage } from '../../../../lib/admin/crm/model';
import { getOrganizationDetail, listAssignableUsers } from '../../../../lib/admin/crm/queries';
import { activityLabels, formatCrmDate, formatCrmMoney, originLabels, timelineLabels } from '../../../../lib/admin/crm/presentation';
import { listProposals } from '../../../../lib/admin/proposals/service';
import { listCompanyCommunications } from '../../../../lib/admin/gmail/service';
import { formatCents } from '../../../../lib/admin/proposals/money';
import '../../../../styles/admin-proposals.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response('Ficha no encontrada.', { status: 404 });
const detail = await getOrganizationDetail(principal, id);
if (!detail) return new Response('Ficha no encontrada.', { status: 404 });
const { organization, contacts, opportunities, activities, tasks, timeline, sources, nextAction } = detail;
const [proposals, communications] = await Promise.all([
  listProposals(principal, id), listCompanyCommunications(principal, id),
]);
const canWrite = hasAdminPermission(principal, 'crm:write')
  && (principal.roles.includes('owner') || organization.responsible_user_id === principal.id);
const users = canWrite && principal.roles.includes('owner') ? await listAssignableUsers() : [];
const assignableUsers = users.filter((user) => String(user.id) === organization.responsible_user_id || Number(user.is_owner) === 1);
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
const savedLabels: Record<string, string> = { organization: 'Ficha guardada.', contact: 'Contacto añadido.',
  opportunity: 'Oportunidad creada.', stage: 'Etapa actualizada.', activity: 'Actividad registrada.',
  task: 'Tarea guardada.', source: 'Fuente vinculada.', draft: 'Borrador local preparado; no se envió correo.',
  thread: 'Conversación asociada.' };
const saved = savedLabels[Astro.url.searchParams.get('saved') ?? ''];
---
<AdminShell title="Ficha de empresa." eyebrow="CRM / FICHA DE EMPRESA" description="Un lugar para cuidar la relación comercial y mantener el siguiente paso claro." active="/admin/crm" principal={principal}>
  <CrmNav active="companies" />
  <div class="crm-toolbar"><a class="crm-button secondary" href="/admin/crm/empresas">← Todas las empresas</a><span class="crm-badge">TEST · FICHA COMERCIAL</span></div>
  {saved && <p class="crm-notice" role="status">{saved}</p>}
  <div class="crm-detail-head"><div><h2>{organization.name}</h2><p>{[organization.sector, organization.city, organization.region].filter(Boolean).join(' · ') || 'Sector y ubicación por completar'}</p></div>{canWrite && <a class="crm-button secondary" href="#quick-actions">Añadir actividad <span aria-hidden="true">↓</span></a>}</div>
  <section class="crm-card" aria-label="Guía comercial contextual" style="margin-bottom:16px"><div class="crm-card-heading"><div><h2>Preparar la conversación</h2><p>Guiones, objeciones y siguientes pasos con los datos verificados de esta empresa.</p></div><a class="crm-button secondary" href={`/admin/crm/guia-comercial?empresa=${id}`}>Abrir guía comercial</a></div>
    {opportunities.length>0&&<div style="display:flex;flex-wrap:wrap;gap:8px">{opportunities.slice(0,4).map(opp=><a class="crm-button subtle" href={`/admin/crm/guia-comercial?empresa=${id}&oportunidad=${String(opp.id)}`}>Guía · {String(opp.title)}</a>)}</div>}
  </section>
  <div class="crm-detail-layout">
    <div class="crm-stack">
      <section class="crm-card" aria-labelledby="org-info-title"><div class="crm-card-heading"><div><h2 id="org-info-title">Información general</h2><p>Contexto esencial y responsable de la relación.</p></div><span class="crm-badge">{originLabels[organization.lead_origin] ?? organization.lead_origin}</span></div>
        <dl class="crm-facts"><div><dt>Sector</dt><dd>{organization.sector ?? 'Sin definir'}</dd></div><div><dt>Ubicación</dt><dd>{[organization.city, organization.region, organization.country_code].filter(Boolean).join(', ')}</dd></div><div><dt>Responsable</dt><dd>{organization.responsible_name ?? 'Equipo Altaria'}</dd></div><div><dt>Sitio web</dt><dd>{organization.website_url ? <a href={organization.website_url} target="_blank" rel="noopener noreferrer">Abrir sitio ↗</a> : 'Sin añadir'}</dd></div></dl>
        {canWrite && <details style="margin-top:20px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">Editar datos de empresa</summary><form action="/api/admin/crm/organization-update" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field wide">Nombre *<input name="name" value={organization.name} maxlength="180" required /></label><label class="crm-field">Sector<input name="sector" value={organization.sector ?? ''} maxlength="100" /></label><label class="crm-field">Sitio web<input type="url" name="websiteUrl" value={organization.website_url ?? ''} maxlength="500" /></label><label class="crm-field">Ciudad<input name="city" value={organization.city ?? ''} maxlength="100" /></label><label class="crm-field">Provincia o región<input name="region" value={organization.region ?? ''} maxlength="100" /></label><label class="crm-field">País<input name="countryCode" value={organization.country_code} minlength="2" maxlength="2" required /></label><label class="crm-field">Origen declarado<select name="leadOrigin">{Object.entries(originLabels).map(([key, label]) => <option value={key} selected={organization.lead_origin === key}>{label}</option>)}</select></label>{principal.roles.includes('owner') && <label class="crm-field wide">Responsable<select name="responsibleUserId">{users.map((user) => <option value={String(user.id)} selected={organization.responsible_user_id === String(user.id)}>{String(user.display_name || user.email)}</option>)}</select></label>}</div><label class="crm-check" style="margin-top:14px"><input type="checkbox" name="confirmPossibleDuplicate" value="1" />He revisado las coincidencias si cambié el nombre o la ciudad.</label><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Guardar cambios</button></div></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="contacts" aria-labelledby="contacts-title"><div class="crm-card-heading"><div><h2 id="contacts-title">Personas de contacto</h2><p>Personas vinculadas a esta empresa.</p></div><span class="crm-badge">{contacts.length}</span></div>
        {contacts.length ? <ul class="crm-inline-list">{contacts.map((contact) => <li><div><strong>{String(contact.full_name)} {contact.is_primary === 1 && <span class="crm-badge">Principal</span>}</strong><small>{[contact.job_title, contact.email, contact.phone].filter(Boolean).join(' · ') || 'Sin datos adicionales'}</small></div></li>)}</ul> : <div class="crm-empty"><strong>Aún no hay contactos.</strong><p>Añade a la persona que lleva la conversación.</p></div>}
        {canWrite && <details style="margin-top:17px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">+ Añadir contacto</summary><form action="/api/admin/crm/contacts" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field">Nombre *<input name="fullName" minlength="2" maxlength="160" required autocomplete="name" /></label><label class="crm-field">Cargo<input name="jobTitle" maxlength="120" /></label><label class="crm-field">Email<input type="email" name="email" maxlength="254" autocomplete="email" /></label><label class="crm-field">Teléfono<input type="tel" name="phone" maxlength="30" autocomplete="tel" /></label></div><div class="crm-form-actions"><label class="crm-check"><input type="checkbox" name="isPrimary" value="1" />Contacto principal</label></div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Guardar contacto</button></div></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="opportunities" aria-labelledby="opportunities-title"><div class="crm-card-heading"><div><h2 id="opportunities-title">Oportunidades</h2><p>Varias conversaciones pueden avanzar en paralelo.</p></div><a class="crm-button secondary" href="/admin/crm/oportunidades">Ver pipeline</a></div>
        {opportunities.length ? <ul class="crm-inline-list">{opportunities.map((opportunity) => { const from = String(opportunity.stage) as CrmStage; const next = crmStages.filter((stage) => canAdvanceStage(from, stage)); return <li><div><strong>{String(opportunity.title)}</strong><small>{formatCrmMoney(opportunity.amount_cents)} · Actualizada {formatCrmDate(opportunity.updated_at)}</small></div><div><span class:list={['crm-badge', from]}>{stageLabels[from] ?? from}</span>{canWrite && next.length > 0 && <details style="margin-top:8px"><summary class="crm-button subtle" style="cursor:pointer">Cambiar etapa</summary><form action="/api/admin/crm/stage" method="post" data-crm-form style="margin-top:8px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="opportunityId" value={String(opportunity.id)} /><label class="crm-field">Siguiente etapa<select name="toStage">{next.map((stage) => <option value={stage}>{stageLabels[stage]}</option>)}</select></label><label class="crm-field" style="margin-top:8px">Motivo si se pierde<input name="lostReason" maxlength="500" placeholder="Sólo si eliges Perdido" /></label><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><button class="crm-button" type="submit" style="margin-top:8px">Guardar etapa</button></form></details>}</div></li>; })}</ul> : <div class="crm-empty"><strong>Sin oportunidades todavía.</strong><p>Registra la primera conversación cuando exista una posibilidad comercial concreta.</p></div>}
        {canWrite && <details style="margin-top:17px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">+ Crear oportunidad</summary><form action="/api/admin/crm/opportunities" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field wide">Título *<input name="title" maxlength="180" required placeholder="Qué podemos resolver" /></label><label class="crm-field">Importe estimado (€)<input type="number" name="amountEuros" min="0" max="99999999.99" step="0.01" placeholder="Opcional" /></label>{principal.roles.includes('owner') && <label class="crm-field">Responsable<select name="responsibleUserId"><option value="">Yo</option>{assignableUsers.map((user) => <option value={String(user.id)}>{String(user.display_name || user.email)}</option>)}</select></label>}</div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Crear oportunidad</button></div></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="proposals" aria-labelledby="company-proposals-title">
        <div class="crm-card-heading"><div><h2 id="company-proposals-title">Propuestas</h2><p>Documentos comerciales y decisiones vinculados a esta empresa.</p></div><a class="crm-button secondary" href="/admin/crm/propuestas">Ver todas</a></div>
        {proposals.length ? <ul class="crm-inline-list">{proposals.map((proposal) => <li><div><strong>{String(proposal.title)}</strong><small>{String(proposal.opportunity_title)} · {String(proposal.status)} · {proposal.total_cents == null ? 'Sin importe' : formatCents(Number(proposal.total_cents))}</small></div><a href={`/admin/crm/propuestas/${String(proposal.id)}`}>Abrir</a></li>)}</ul> : <div class="crm-empty"><strong>Aún no hay propuestas.</strong><p>Crea una desde una oportunidad activa de esta empresa.</p></div>}
        {canWrite && opportunities.some((opp) => !['won', 'lost'].includes(String(opp.stage))) && <details class="proposal-resource-form"><summary class="crm-button subtle">+ Crear propuesta</summary><form action="/api/admin/proposals/create" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><div class="crm-form-grid"><label class="crm-field">Oportunidad<select name="opportunityId">{opportunities.filter((opp) => !['won', 'lost'].includes(String(opp.stage))).map((opp) => <option value={String(opp.id)}>{String(opp.title)}</option>)}</select></label><label class="crm-field">Título de propuesta<input name="title" required minlength="2" maxlength="180" placeholder="Solución para esta oportunidad" /></label></div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><button class="crm-button" type="submit">Abrir editor</button></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="communications" aria-labelledby="company-communications-title">
        <div class="crm-card-heading"><div><h2 id="company-communications-title">Conversaciones y respuestas</h2><p>Sólo hilos etiquetados ALTARIA/CRM y borradores locales pendientes de revisión.</p></div><span class="crm-badge">{communications.threads.length} hilos</span></div>
        {communications.threads.length ? <ul class="crm-inline-list">{communications.threads.map((thread) => <li><div><strong><a href={`/admin/crm/conversaciones/${String(thread.id)}`}>{String(thread.subject || 'Sin asunto')}</a></strong><small>{String(thread.association_status)} · {String(thread.message_count)} mensajes · {formatCrmDate(thread.last_message_at)}</small></div>{principal.roles.includes('owner') && <details><summary class="crm-button subtle">Asociar</summary><form action="/api/admin/gmail/link-thread" method="post" style="display:grid;gap:8px;margin-top:9px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><input type="hidden" name="threadId" value={String(thread.id)} /><label class="crm-field">Contacto<select name="contactId"><option value="">Sin contacto</option>{contacts.map((contact) => <option value={String(contact.id)} selected={thread.contact_id === contact.id}>{String(contact.full_name)}</option>)}</select></label><label class="crm-field">Propuesta<select name="proposalId"><option value="">Sin propuesta</option>{proposals.map((proposal) => <option value={String(proposal.id)} selected={thread.proposal_id === proposal.id}>{String(proposal.title)}</option>)}</select></label><button class="crm-button secondary" type="submit">Guardar vínculo</button></form></details>}</li>)}</ul> : <div class="crm-empty"><strong>Sin conversaciones sincronizadas.</strong><p>Gmail permanece pendiente de configuración externa. Los borradores se pueden preparar aquí sin enviar.</p></div>}
        {communications.drafts.length > 0 && <div style="margin-top:20px"><h3>Borradores para revisar</h3><ul class="crm-inline-list">{communications.drafts.map((draft) => <li><div><strong><a href={`/admin/crm/borradores/${String(draft.id)}`}>{String(draft.subject)}</a></strong><small>{String(draft.recipient_email)} · {formatCrmDate(draft.updated_at)} · No enviado</small></div></li>)}</ul></div>}
        {canWrite && contacts.some((contact) => contact.email) && <details class="proposal-resource-form"><summary class="crm-button subtle">+ Preparar respuesta</summary><form action="/api/admin/gmail/draft" method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field">Contacto destinatario<select name="contactId">{contacts.filter((contact) => contact.email).map((contact) => <option value={String(contact.id)}>{String(contact.full_name)} · {String(contact.email)}</option>)}</select></label><label class="crm-field">Propuesta relacionada<select name="proposalId"><option value="">General</option>{proposals.map((proposal) => <option value={String(proposal.id)}>{String(proposal.title)}</option>)}</select></label><label class="crm-field wide">Asunto<input name="subject" required minlength="2" maxlength="240" /></label><label class="crm-field wide">Respuesta<textarea name="body" required minlength="5" maxlength="10000"></textarea></label></div><p class="crm-help">Queda en Altaria OS para revisión. No crea un borrador en Gmail ni envía el mensaje.</p><button class="crm-button" type="submit">Guardar borrador local</button></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="activity" aria-labelledby="activity-title"><div class="crm-card-heading"><div><h2 id="activity-title">Actividad</h2><p>Llamadas, visitas, reuniones y notas en contexto.</p></div><span class="crm-badge">{activities.length}</span></div>
        {activities.length ? <ul class="crm-inline-list">{activities.map((activity) => <li><div><strong>{activityLabels[String(activity.kind)] ?? String(activity.kind)} · {String(activity.summary)}</strong><small>{formatCrmDate(activity.happened_at)} · {String(activity.actor_name || 'Equipo Altaria')}</small>{activity.detail && <p class="crm-help">{String(activity.detail)}</p>}</div></li>)}</ul> : <div class="crm-empty"><strong>Aún no hay actividades.</strong><p>Una nota breve basta para que el equipo conozca el último contacto.</p></div>}
        {canWrite && <details id="quick-actions" style="margin-top:17px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">+ Registrar actividad</summary><form action="/api/admin/crm/activities" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field">Tipo<select name="kind"><option value="call">Llamada</option><option value="visit">Visita</option><option value="meeting">Reunión</option><option value="note">Nota</option></select></label><label class="crm-field">Cuándo ocurrió<input type="datetime-local" name="happenedAt" /><small class="crm-help">Vacío: ahora</small></label><label class="crm-field wide">Resumen *<input name="summary" maxlength="240" required placeholder="Qué se habló o decidió" /></label><label class="crm-field wide">Detalle<textarea name="detail" maxlength="4000" placeholder="Sólo el contexto útil"></textarea></label><label class="crm-field">Oportunidad<select name="opportunityId"><option value="">General de la empresa</option>{opportunities.map((opp) => <option value={String(opp.id)}>{String(opp.title)}</option>)}</select></label><label class="crm-field">Contacto<select name="contactId"><option value="">Sin contacto concreto</option>{contacts.map((contact) => <option value={String(contact.id)}>{String(contact.full_name)}</option>)}</select></label><label class="crm-field">Crear seguimiento<input name="followupTitle" maxlength="240" placeholder="Título de la tarea opcional" /></label><label class="crm-field">Fecha de seguimiento<input type="datetime-local" name="followupDueAt" /></label></div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Guardar actividad</button></div></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="tasks" aria-labelledby="tasks-title"><div class="crm-card-heading"><div><h2 id="tasks-title">Tareas y seguimientos</h2><p>La próxima acción queda siempre visible.</p></div><a class="crm-button secondary" href="/admin/crm/tareas">Ver tareas</a></div>
        {tasks.length ? <ul class="crm-inline-list">{tasks.map((task) => <li><div><strong>{String(task.title)}</strong><small>{task.cancelled_at ? 'Cancelada' : task.status === 'done' ? 'Completada' : task.due_at ? formatCrmDate(task.due_at) : 'Pendiente sin fecha'} · {String(task.responsible_name || 'Equipo Altaria')}</small></div>{canWrite && task.status === 'open' && !task.cancelled_at && <div><form action="/api/admin/crm/task-complete" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="taskId" value={String(task.id)} /><button class="crm-button subtle" type="submit">Completar</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>{principal.roles.includes('owner') && assignableUsers.length > 1 && <form action="/api/admin/crm/task-reassign" method="post" data-crm-form style="margin-top:6px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="taskId" value={String(task.id)} /><label class="crm-field">Reasignar<select name="responsibleUserId">{assignableUsers.map((user) => <option value={String(user.id)} selected={task.responsible_user_id === user.id}>{String(user.display_name || user.email)}</option>)}</select></label><button class="crm-button secondary" type="submit">Guardar</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>}</div>}</li>)}</ul> : <div class="crm-empty"><strong>Sin tareas para esta empresa.</strong><p>Crea una tarea o genera un seguimiento desde una actividad.</p></div>}
        {canWrite && <details style="margin-top:17px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">+ Crear tarea</summary><form action="/api/admin/crm/tasks" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field wide">Qué hay que hacer *<input name="title" maxlength="240" required /></label><label class="crm-field">Vencimiento<input type="datetime-local" name="dueAt" /></label><label class="crm-field">Oportunidad<select name="opportunityId"><option value="">General</option>{opportunities.map((opp) => <option value={String(opp.id)}>{String(opp.title)}</option>)}</select></label><label class="crm-field">Contacto<select name="contactId"><option value="">Sin contacto</option>{contacts.map((contact) => <option value={String(contact.id)}>{String(contact.full_name)}</option>)}</select></label>{principal.roles.includes('owner') && <label class="crm-field">Responsable<select name="responsibleUserId"><option value="">Yo</option>{assignableUsers.map((user) => <option value={String(user.id)}>{String(user.display_name || user.email)}</option>)}</select></label>}</div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Crear tarea</button></div></form></details>}
      </section>
      <section class="crm-card crm-section-anchor" id="sources" aria-labelledby="sources-title"><div class="crm-card-heading"><div><h2 id="sources-title">Pedidos y fuentes</h2><p>Vínculos verificados con registros históricos de TEST, sin alterar su contenido.</p></div></div>
        {sources.length ? <ul class="crm-inline-list">{sources.map((source) => <li><div><strong>{source.digital_lead_id ? 'Diagnóstico digital' : source.card_inquiry_id ? 'Consulta Cards' : 'Pedido Cards'}</strong><small>{source.order_number ? `${String(source.order_number)} · ` : ''}{formatCrmDate(source.linked_at)}{source.order_status ? ` · ${String(source.order_status)}` : ''}</small></div></li>)}</ul> : <div class="crm-empty"><strong>Sin fuentes vinculadas.</strong><p>Los registros existentes se asociarán tras revisar su identidad y procedencia.</p></div>}
        {canWrite && <details style="margin-top:17px"><summary class="crm-button subtle" style="display:inline-flex;cursor:pointer">Vincular registro TEST</summary><form action="/api/admin/crm/source-links" method="post" data-crm-form style="margin-top:17px"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="organizationId" value={id} /><div class="crm-form-grid"><label class="crm-field">Fuente<select name="sourceKind"><option value="digital_lead">Diagnóstico digital</option><option value="cards_inquiry">Consulta Cards</option><option value="cards_order">Pedido Cards</option></select></label><label class="crm-field">ID verificado del registro<input name="sourceId" required placeholder="UUID del origen TEST" /></label></div><p class="crm-help">La operación comprueba que el registro existe en TEST y que no está vinculado a otra empresa. No importa sus datos.</p><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Vincular fuente</button></div></form></details>}
      </section>
    </div>
    <aside class="crm-stack" aria-label="Seguimiento de empresa"><section class="crm-card"><div class="crm-card-heading"><div><h2>Próxima acción</h2><p>El siguiente paso del equipo.</p></div></div>{nextAction ? <div><strong>{String(nextAction.title)}</strong><p class="crm-help">{nextAction.due_at ? formatCrmDate(nextAction.due_at) : 'Sin fecha prevista'}</p><a class="crm-button subtle" href="#tasks">Ver tarea</a></div> : <div class="crm-empty"><strong>Sin próxima acción.</strong><p>Añade una tarea para dar continuidad a la relación.</p></div>}</section>
      <section class="crm-card"><div class="crm-card-heading"><div><h2>Historia de la relación</h2><p>Cambios y decisiones con autor y fecha.</p></div></div>{timeline.length ? <ol class="crm-timeline">{timeline.map((event) => <li><strong>{timelineLabels[String(event.event_type)] ?? String(event.event_type)}</strong><time datetime={String(event.occurred_at)}>{formatCrmDate(event.occurred_at)}</time><div>{String(event.actor_name || 'Equipo Altaria')}</div></li>)}</ol> : <div class="crm-empty"><strong>La historia empieza aquí.</strong><p>Cada operación nueva aparecerá en orden cronológico.</p></div>}</section>
    </aside>
  </div>
</AdminShell>
