---
import AdminShell from '../../../layouts/AdminShell.astro';
import CrmNav from '../../../components/admin/CrmNav.astro';
import { listCrmTasks } from '../../../lib/admin/crm/queries';
import { formatCrmDate } from '../../../lib/admin/crm/presentation';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const status = Astro.url.searchParams.get('estado') === 'completadas' ? 'done' : 'open';
const tasks = await listCrmTasks(principal, status);
---
<AdminShell title="Tareas." eyebrow="CRM / SEGUIMIENTO" description="El siguiente paso de cada relación comercial, en un solo lugar." active="/admin/crm" principal={principal}>
  <CrmNav active="tasks" />
  <div class="crm-toolbar"><div><h2>{status === 'open' ? 'Próximas acciones' : 'Tareas completadas'}</h2><p>Ordenadas por vencimiento. Abre la empresa para gestionar cada tarea.</p></div><a class="crm-button secondary" href="/admin/crm/empresas">Ver empresas</a></div>
  <nav class="crm-task-filter" aria-label="Estado de tareas"><a href="/admin/crm/tareas" aria-current={status === 'open' ? 'page' : undefined} class:list={[{ 'is-active': status === 'open' }]}>Pendientes</a><a href="/admin/crm/tareas?estado=completadas" aria-current={status === 'done' ? 'page' : undefined} class:list={[{ 'is-active': status === 'done' }]}>Completadas</a></nav>
  {tasks.length ? <section class="crm-card" aria-label="Lista de tareas"><ul class="crm-inline-list">{tasks.map((task) => <li><div><strong>{String(task.title)}</strong><small>{String(task.organization_name)} · {task.due_at ? formatCrmDate(task.due_at) : 'Sin fecha'} · {String(task.responsible_name)}</small></div><a href={`/admin/crm/empresas/${String(task.organization_id)}#tasks`}>Abrir ficha</a></li>)}</ul></section>
    : <div class="crm-empty"><strong>{status === 'open' ? 'Todo al día.' : 'Aún no hay tareas completadas.'}</strong><p>{status === 'open' ? 'Las acciones pendientes aparecerán aquí cuando se creen desde una empresa o actividad.' : 'Las tareas terminadas aparecerán aquí con su fecha y responsable.'}</p><a class="crm-button secondary" href="/admin/crm/empresas">Ir a empresas</a></div>}
</AdminShell>
