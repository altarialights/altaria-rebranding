---
import AdminShell from '../../../layouts/AdminShell.astro';
import CrmNav from '../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../lib/admin/access';
import { categoryLabels, getSalesContext, getSalesEntry, listSalesEntries,
  salesCategories, type SalesCategory } from '../../../lib/admin/sales/library';
import { stageLabels, type CrmStage } from '../../../lib/admin/crm/model';
import { formatCrmDate } from '../../../lib/admin/crm/presentation';
import '../../../styles/admin-sales.css';
export const prerender=false;
const principal=Astro.locals.admin;
if(!principal)return new Response('Acceso denegado.',{status:403});
const params=Astro.url.searchParams;
const filters={q:params.get('q')??'',category:params.get('categoria')??'',
  product:params.get('producto')??'',sector:params.get('sector')??'',
  channel:params.get('canal')??'',stage:params.get('etapa')??''};
const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const organizationId=params.get('empresa')??'';
const opportunityId=params.get('oportunidad')??'';
let company=null;
if(organizationId){
  if(!uuid.test(organizationId))return new Response('Empresa no encontrada.',{status:404});
  try{company=await getSalesContext(principal,organizationId,opportunityId||null);}
  catch{return new Response('Empresa no disponible.',{status:404});}
}
const entries=await listSalesEntries(principal,filters);
const suggested=company?.opportunity?(await listSalesEntries(principal,{}))
  .filter(item=>item.stage===company.opportunity?.stage||item.stage==='general')
  .filter(item=>item.sector==='general'||String(item.sector).toLowerCase()===String(company.org.sector??'').toLowerCase())
  .sort((a,b)=>Number(b.stage===company.opportunity?.stage)-Number(a.stage===company.opportunity?.stage)
    ||Number(b.sector!=='general')-Number(a.sector!=='general')).slice(0,4):[];
const selectedId=params.get('ficha')??'';
const selectedVersion=params.get('version');
let selected=null;
if(selectedId){
  if(!uuid.test(selectedId))return new Response('Contenido no encontrado.',{status:404});
  const version=selectedVersion===null?undefined:Number(selectedVersion);
  try{selected=await getSalesEntry(principal,selectedId,undefined,version);}catch{return new Response('Contenido no disponible.',{status:404});}
}
const csrf=createAdminCsrfToken(principal.sessionHash,process.env.WORKOS_COOKIE_PASSWORD||'','crm');
const canWrite=hasAdminPermission(principal,'crm:write');
const canWriteCompany=canWrite&&company&&(principal.roles.includes('owner')||company.org.responsible_user_id===principal.id);
const isOwner=principal.roles.includes('owner');
const category=(value:unknown)=>categoryLabels[String(value) as SalesCategory]??String(value);
const status=(value:unknown)=>({draft:'Borrador',review:'Pendiente de revisión',approved:'Aprobado',retired:'Retirado'}[String(value)]??String(value));
const link=(id:string)=>{
  const query=new URLSearchParams();
  for(const [key,value] of Object.entries({q:filters.q,categoria:filters.category,producto:filters.product,
    sector:filters.sector,canal:filters.channel,etapa:filters.stage}))if(value)query.set(key,value);
  if(organizationId)query.set('empresa',organizationId);
  if(opportunityId)query.set('oportunidad',opportunityId);
  query.set('ficha',id);
  return `/admin/crm/guia-comercial?${query}`;
};
const contextLink=(category:string)=>{
  const query=new URLSearchParams({empresa:organizationId});
  if(opportunityId)query.set('oportunidad',opportunityId);
  query.set('categoria',category);
  return `/admin/crm/guia-comercial?${query}`;
};
const recommendedLink=(id:string)=>{
  const query=new URLSearchParams({empresa:organizationId,oportunidad:opportunityId,ficha:id});
  return `/admin/crm/guia-comercial?${query}`;
};
const historyLink=(version:number)=>{
  const query=new URLSearchParams(link(selectedId).split('?')[1]);
  query.set('version',String(version));
  return `/admin/crm/guia-comercial?${query}`;
};
const productOptions=[...new Set(entries.map(e=>String(e.product)))].sort();
const sectorOptions=[...new Set(entries.map(e=>String(e.sector)))].sort();
const latest=selected?.current;
const entry=selected?.entry;
const isHistorical=Boolean(entry&&latest&&Number(latest.version)!==Number(entry.latest_version));
const sourceLabel=(value:unknown)=>value==='new_proposal'?'Propuesta nueva':value==='supplied_original'?'Original aportado':'Referencia web';
const sourceRefLabel=(value:unknown)=>String(value).startsWith('phase6.5b:initial:')
  ?'Colección inicial de Sales OS':String(value);
const saved=({borrador:'Borrador guardado.',propuesto:'Contenido enviado a revisión.',version:'Nueva versión pendiente de revisión.',
  approve:'Versión aprobada.',retire:'Contenido retirado.',canal:'Revisión del canal registrada.'} as Record<string,string>)[params.get('guardado')??''];
---
<AdminShell title="Guía comercial." eyebrow="CRM / SALES OS" description="Guiones y decisiones con contexto, versión y revisión humana." active="/admin/crm" principal={principal}>
  <CrmNav active="sales" />
  <section class="sales-hero" aria-labelledby="sales-title">
    <div><p class="admin-eyebrow">ALTARIA OS · TEST</p><h2 id="sales-title">Una conversación mejor preparada.</h2>
      <p>Consulta el guion, escucha lo que falta y registra el siguiente paso en el CRM. Ningún contenido se envía automáticamente.</p></div>
    {canWrite&&<a class="crm-button" href="#nuevo-contenido">Crear contenido <span aria-hidden="true">↗</span></a>}
  </section>
  {saved&&<p class="crm-notice" role="status">{saved}</p>}
  {company&&<section class="sales-context" aria-labelledby="sales-company-title">
    <div><p class="admin-eyebrow">CONTEXTO VERIFICADO EN CRM</p><h2 id="sales-company-title">{String(company.org.name)}</h2>
      <p>{[company.org.sector,company.org.city].filter(Boolean).join(' · ')||'Sector y ciudad no indicados'}
      {company.opportunity&&<> · Oportunidad: <strong>{String(company.opportunity.title)}</strong> ({stageLabels[String(company.opportunity.stage) as CrmStage]??String(company.opportunity.stage)})</>}</p></div>
    <a class="crm-button secondary" href={`/admin/crm/empresas/${organizationId}`}>Abrir ficha de empresa</a>
  </section>}
  {company?.opportunity&&<section class="sales-suggestions" aria-labelledby="sales-suggestions-title"><div><p class="admin-eyebrow">PARA ESTA OPORTUNIDAD</p><h2 id="sales-suggestions-title">Guiones sugeridos</h2><p>Coinciden con la etapa y el sector registrados. La selección final es humana.</p></div>
    {suggested.length?<div class="sales-suggestion-list">{suggested.map(item=><a href={recommendedLink(String(item.id))}><strong>{String(item.title)}</strong><small>{Number(item.version)===Number(item.approved_version)?'Aprobado':'Pendiente de revisión'}</small></a>)}</div>:<p class="crm-help">Aún no hay guiones accesibles para esta etapa.</p>}
  </section>}
  <form class="sales-filters" method="get" action="/admin/crm/guia-comercial" role="search" aria-label="Buscar en la guía comercial">
    {organizationId&&<input type="hidden" name="empresa" value={organizationId} />}
    {opportunityId&&<input type="hidden" name="oportunidad" value={opportunityId} />}
    <label class="crm-field sales-search">Buscar<input type="search" name="q" value={filters.q} maxlength="100" placeholder="Producto, guion u objeción" /></label>
    <label class="crm-field">Categoría<select name="categoria"><option value="">Todas</option>{salesCategories.map(c=><option value={c} selected={filters.category===c}>{categoryLabels[c]}</option>)}</select></label>
    <label class="crm-field">Producto<select name="producto"><option value="">Todos</option>{productOptions.map(p=><option value={p} selected={filters.product===p}>{p}</option>)}</select></label>
    <label class="crm-field">Sector<select name="sector"><option value="">Todos</option>{sectorOptions.map(s=><option value={s} selected={filters.sector===s}>{s}</option>)}</select></label>
    <label class="crm-field">Canal<select name="canal"><option value="">Todos</option><option value="phone" selected={filters.channel==='phone'}>Teléfono</option><option value="email" selected={filters.channel==='email'}>Email</option><option value="in_person" selected={filters.channel==='in_person'}>Presencial</option><option value="general" selected={filters.channel==='general'}>General</option></select></label>
    <label class="crm-field">Etapa<select name="etapa"><option value="">Todas</option>{Object.entries(stageLabels).map(([key,label])=><option value={key} selected={filters.stage===key}>{label}</option>)}<option value="general" selected={filters.stage==='general'}>General</option></select></label>
    <button class="crm-button" type="submit">Filtrar</button>
  </form>
  <div class="sales-layout">
    <section class="sales-list crm-card" aria-labelledby="sales-list-title"><div class="crm-card-heading"><div><h2 id="sales-list-title">Biblioteca</h2><p>{entries.length} contenidos disponibles para tu perfil</p></div></div>
      {entries.length?<div class="sales-results">{entries.map(item=><a class:list={['sales-result',{active:selectedId===item.id}]} href={link(String(item.id))} aria-current={selectedId===item.id?'true':undefined}>
        <span class="sales-result-top"><span>{category(item.category)} · {String(item.product)}</span><small>{item.approved_version&&Number(item.version)===Number(item.approved_version)?'Aprobado':'Revisión'}</small></span>
        <strong>{String(item.title)}</strong><span class="sales-excerpt">{String(item.body).slice(0,135)}{String(item.body).length>135?'…':''}</span>
      </a>)}</div>:<div class="crm-empty"><strong>Sin coincidencias.</strong><p>Prueba otra búsqueda o limpia los filtros. El contenido pendiente solo lo ven su autor y el propietario.</p></div>}
    </section>
    <div class="sales-detail">
      {selected&&latest&&entry?<article class="crm-card" aria-labelledby="sales-entry-title">
        <div class="sales-detail-head"><div><p class="admin-eyebrow">{category(latest.category)} · {String(latest.product)}</p><h2 id="sales-entry-title">{String(latest.title)}</h2>
          <p>{String(latest.sector)} · {String(latest.channel)} · v{String(latest.version)}</p></div>
          <span class:list={['sales-status',{pending:Number(entry.approved_version)!==Number(latest.version)}]}>{Number(entry.approved_version)===Number(latest.version)?'Aprobado':status(entry.status)}</span></div>
        <div class="sales-copy"><h3>Guion / contenido</h3><p>{String(latest.body)}</p></div>
        <div class="sales-next"><span>Próximo paso propuesto</span><p>{String(latest.next_step)}</p></div>
        <div class="sales-meta"><span title={String(latest.source_ref)}>{sourceLabel(latest.provenance)} · {sourceRefLabel(latest.source_ref)}</span><span>v{String(latest.version)} · {formatCrmDate(latest.created_at)}</span></div>
        {isHistorical&&selected.canEdit&&<a class="crm-button subtle" href={link(selectedId)}>Volver a la versión actual</a>}
        <div class="sales-actions"><button class="crm-button secondary" type="button" data-copy-sales data-copy-text={String(latest.body)}>Copiar fragmento</button><span class="sales-copy-feedback" role="status" aria-live="polite"></span></div>
        {Number(entry.approved_version)!==Number(latest.version)&&<p class="sales-warning">{entry.status==='draft'?'Borrador sin revisión. Envíalo a revisión antes de considerarlo aprobado.':'Contenido propuesto: pendiente de revisión del propietario. Revísalo antes de usarlo en una comunicación.'}</p>}
        {selected.canEdit&&!isHistorical&&entry.status==='draft'&&<form action="/api/admin/crm/sales/submit" method="post" class="sales-inline-form"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="entryId" value={selectedId}/><input type="hidden" name="expectedVersion" value={String(entry.latest_version)}/><button class="crm-button" type="submit">Enviar a revisión</button></form>}
        {isOwner&&!isHistorical&&entry.status==='review'&&Number(entry.approved_version)!==Number(entry.latest_version)&&<form action={`/api/admin/crm/sales/approve`} method="post" class="sales-inline-form"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="entryId" value={selectedId}/><input type="hidden" name="expectedVersion" value={String(entry.latest_version)}/><button class="crm-button" type="submit">Aprobar esta versión</button></form>}
        {isOwner&&!isHistorical&&entry.status!=='retired'&&<form action="/api/admin/crm/sales/retire" method="post" class="sales-inline-form"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="entryId" value={selectedId}/><input type="hidden" name="expectedVersion" value={String(entry.latest_version)}/><button class="crm-button subtle" type="submit">Retirar contenido</button></form>}
      </article>:<section class="crm-card sales-welcome" aria-labelledby="sales-welcome-title"><p class="admin-eyebrow">GUÍA COMERCIAL</p><h2 id="sales-welcome-title">Elige una ficha.</h2><p>Busca por producto, etapa o categoría. Cada texto incluye procedencia, versión y estado de revisión.</p></section>}
      {selected?.canEdit&&!isHistorical&&latest&&entry&&entry.status!=='retired'&&<details class="crm-card sales-edit"><summary>Editar y crear nueva versión</summary><form action="/api/admin/crm/sales/revise" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="entryId" value={selectedId}/><input type="hidden" name="expectedVersion" value={String(entry.latest_version)}/>
        <div class="sales-form-grid"><label class="crm-field">Título<input name="title" value={String(latest.title)} required minlength="3" maxlength="180"/></label><label class="crm-field">Categoría<select name="category">{salesCategories.map(c=><option value={c} selected={latest.category===c}>{categoryLabels[c]}</option>)}</select></label><label class="crm-field">Producto<input name="product" value={String(latest.product)} required maxlength="100"/></label><label class="crm-field">Sector<input name="sector" value={String(latest.sector)} required maxlength="100"/></label><label class="crm-field">Canal<select name="channel"><option value="general" selected={latest.channel==='general'}>General</option><option value="email" selected={latest.channel==='email'}>Email</option><option value="phone" selected={latest.channel==='phone'}>Teléfono</option><option value="in_person" selected={latest.channel==='in_person'}>Presencial</option></select></label><label class="crm-field">Etapa<select name="stage">{Object.entries(stageLabels).map(([key,label])=><option value={key} selected={latest.stage===key}>{label}</option>)}<option value="general" selected={latest.stage==='general'}>General</option></select></label><label class="crm-field wide">Guion<textarea name="body" required minlength="10" maxlength="10000">{String(latest.body)}</textarea></label><label class="crm-field wide">Siguiente paso<textarea name="nextStep" required minlength="5" maxlength="1000">{String(latest.next_step)}</textarea></label></div><p class="crm-help">El guardado conserva la versión actual y devuelve el contenido a revisión.</p><button class="crm-button" type="submit">Guardar nueva versión</button></form></details>}
      {selected&&selected.history.length>0&&<section class="crm-card" aria-labelledby="sales-history-title"><div class="crm-card-heading"><h2 id="sales-history-title">Historial de versiones</h2></div><ol class="sales-history">{selected.history.map(item=><li><a href={historyLink(Number(item.version))} aria-current={Number(item.version)===Number(latest?.version)?'true':undefined}><strong>v{String(item.version)} · {sourceLabel(item.provenance)}</strong></a><span>{formatCrmDate(item.created_at)} · {String(item.display_name||'Equipo Altaria')}</span></li>)}</ol><h3 class="sales-history-heading">Decisiones</h3><ul class="sales-history">{selected.events.map(item=><li><strong>{String(item.kind)} · v{String(item.version)}</strong><span>{formatCrmDate(item.occurred_at)} · {String(item.display_name||'Equipo Altaria')}</span></li>)}</ul></section>}
      {company&&<section class="crm-card" aria-labelledby="sales-actions-title"><div class="crm-card-heading"><div><h2 id="sales-actions-title">Acciones en esta empresa</h2><p>Solo datos presentes en el CRM; tú decides cada paso.</p></div></div>
        <div class="sales-context-links"><a href={contextLink('call')}>Preparar llamada</a><a href={contextLink('objection')}>Buscar objeciones</a><a href={contextLink('email')}>Plantillas email</a><a href={`/admin/crm/empresas/${organizationId}#activity`}>Registrar interacción</a><a href={`/admin/crm/empresas/${organizationId}#tasks`}>Seguimientos</a><a href={`/admin/crm/empresas/${organizationId}#opportunities`}>Preparar propuesta</a></div>
        {canWriteCompany&&<><details class="sales-action-form"><summary>Registrar llamada realizada</summary><form action="/api/admin/crm/sales/activity" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="organizationId" value={organizationId}/><input type="hidden" name="opportunityId" value={opportunityId}/><label class="crm-field">Resumen de lo ocurrido<input name="summary" required minlength="2" maxlength="240"/></label><label class="crm-field">Detalle confirmado<textarea name="detail" maxlength="4000"></textarea></label><label class="crm-field">Seguimiento acordado, opcional<input name="followupTitle" maxlength="240"/></label><label class="crm-field">Fecha, opcional<input name="followupDueAt" type="datetime-local"/></label><button class="crm-button" type="submit">Registrar en CRM</button></form></details>
        <details class="sales-action-form"><summary>Crear seguimiento</summary><form action="/api/admin/crm/sales/followup" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="organizationId" value={organizationId}/><input type="hidden" name="opportunityId" value={opportunityId}/><label class="crm-field">Tarea<input name="title" required minlength="2" maxlength="240"/></label><label class="crm-field">Fecha, opcional<input name="dueAt" type="datetime-local"/></label><button class="crm-button" type="submit">Crear tarea</button></form></details>
        <details class="sales-action-form"><summary>Registrar revisión del canal u oposición</summary><form action="/api/admin/crm/sales/channel-review" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="organizationId" value={organizationId}/><input type="hidden" name="opportunityId" value={opportunityId}/><label class="crm-field">Alcance<select name="contactId"><option value="">Toda la empresa</option>{company.contacts.map(c=><option value={String(c.id)}>{String(c.full_name)}</option>)}</select></label><label class="crm-field">Canal<select name="channel"><option value="email">Email</option><option value="phone">Teléfono</option><option value="in_person">Presencial</option></select></label><label class="crm-field">Decisión<select name="decision"><option value="unknown">Pendiente de comprobar</option><option value="eligible">Revisado manualmente</option><option value="blocked">Bloqueado</option><option value="opposed">Oposición registrada</option></select></label><label class="crm-field">Motivo / evidencia mínima<textarea name="reason" required minlength="3" maxlength="500"></textarea></label><button class="crm-button secondary" type="submit">Guardar revisión</button></form></details>
        {selected&&!isHistorical&&latest&&latest.channel==='email'&&company.contacts.some(c=>c.email)&&<details class="sales-action-form"><summary>Preparar borrador local</summary><form action="/api/admin/crm/sales/draft" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="entryId" value={selectedId}/><input type="hidden" name="organizationId" value={organizationId}/><input type="hidden" name="opportunityId" value={opportunityId}/><label class="crm-field">Contacto con email registrado<select name="contactId" required>{company.contacts.filter(c=>c.email).map(c=><option value={String(c.id)}>{String(c.full_name)}</option>)}</select></label><label class="crm-field">Asunto<input name="subject" required minlength="2" maxlength="240"/></label><label class="crm-field">Texto revisable<textarea name="body" required minlength="5" maxlength="10000">{String(latest.body)}</textarea></label><p class="sales-warning">Borrador local, sin envío. Revisa permiso de contacto, personalización y oposiciones.</p><button class="crm-button" type="submit">Guardar borrador</button></form></details>}
        </>}
        {company.opposition.length>0&&<div class="sales-opposition"><strong>Estado registrado de canales</strong><ul>{company.opposition.map(r=><li>{String(r.channel)} · {String(r.contact_id??'Empresa')} · {String(r.decision)}</li>)}</ul></div>}
      </section>}
    </div>
  </div>
  {canWrite&&<details class="crm-card sales-new" id="nuevo-contenido"><summary>Nueva propuesta de contenido</summary><p>Puedes guardarla como borrador o enviarla a revisión; no se marcará como material histórico.</p><form action="/api/admin/crm/sales/create" method="post"><input type="hidden" name="csrf" value={csrf}/><div class="sales-form-grid"><label class="crm-field">Título<input name="title" required minlength="3" maxlength="180"/></label><label class="crm-field">Categoría<select name="category">{salesCategories.map(c=><option value={c}>{categoryLabels[c]}</option>)}</select></label><label class="crm-field">Producto / servicio<input name="product" required maxlength="100"/></label><label class="crm-field">Sector<input name="sector" value="general" required maxlength="100"/></label><label class="crm-field">Canal<select name="channel"><option value="general">General</option><option value="email">Email</option><option value="phone">Teléfono</option><option value="in_person">Presencial</option></select></label><label class="crm-field">Etapa<select name="stage"><option value="general">General</option>{Object.entries(stageLabels).map(([key,label])=><option value={key}>{label}</option>)}</select></label><label class="crm-field wide">Guion / texto<textarea name="body" required minlength="10" maxlength="10000"></textarea></label><label class="crm-field wide">Siguiente paso<textarea name="nextStep" required minlength="5" maxlength="1000"></textarea></label></div><div class="sales-actions"><button class="crm-button secondary" type="submit" name="intent" value="draft">Guardar borrador</button><button class="crm-button" type="submit" name="intent" value="review">Enviar a revisión</button></div></form></details>}
</AdminShell>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-sales]').forEach(button=>button.addEventListener('click',async()=>{
    const feedback=button.parentElement?.querySelector<HTMLElement>('.sales-copy-feedback');
    try{await navigator.clipboard.writeText(button.dataset.copyText??'');if(feedback)feedback.textContent='Fragmento copiado.';}
    catch{if(feedback)feedback.textContent='No se pudo copiar; selecciona el texto manualmente.';}
  }));
</script>
