---
import AdminShell from '../../../layouts/AdminShell.astro';
import CrmNav from '../../../components/admin/CrmNav.astro';
import { hasAdminPermission } from '../../../lib/admin/access';
import { getCrmSummary, listOrganizations, listCrmTasks } from '../../../lib/admin/crm/queries';
import { formatCrmDate } from '../../../lib/admin/crm/presentation';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const [summary, recent, tasks] = await Promise.all([
  getCrmSummary(principal), listOrganizations(principal, { limit: 4 }), listCrmTasks(principal),
]);
const canWrite = hasAdminPermission(principal, 'crm:write');
---
<AdminShell title="CRM central." eyebrow="ALTARIA OS / RELACIONES" description="Empresas, personas y oportunidades con todo su contexto en un mismo lugar." active="/admin/crm" principal={principal}>
  <CrmNav active="overview" />
  <div class="crm-kpi-grid" aria-label="Estado real del CRM">
    <div class="crm-kpi"><p>Empresas</p><strong>{summary.organizations}</strong><span>Fichas activas</span></div>
    <div class="crm-kpi"><p>Oportunidades</p><strong>{summary.openOpportunities}</strong><span>En curso</span></div>
    <div class="crm-kpi"><p>Tareas</p><strong>{summary.openTasks}</strong><span>Pendientes</span></div>
  </div>
  <div class="crm-highlight">
    <section class="crm-feature" aria-labelledby="crm-start-title">
      <p class="admin-eyebrow">TU ESPACIO COMERCIAL · TEST</p>
      <h2 id="crm-start-title">Cada conversación merece continuidad.</h2>
      <p>Abre una empresa para ver contactos, oportunidades, próximas acciones y su historial sin perder el hilo.</p>
      <a class="crm-button" href={canWrite ? '/admin/crm/empresas/nueva' : '/admin/crm/empresas'}>{canWrite ? 'Añadir empresa' : 'Ver empresas'} <span aria-hidden="true">↗</span></a>
    </section>
    <section class="crm-note" aria-labelledby="crm-note-title"><h2 id="crm-note-title">Un CRM con contexto</h2><ul><li>La ficha de empresa conecta actividades y tareas.</li><li>El pipeline conserva cada cambio de etapa y su autor.</li><li>Los pedidos y diagnósticos se vinculan tras validación manual.</li></ul></section>
  </div>
  <div class="crm-toolbar"><div><h2>Empresas recientes</h2><p>Ordenadas por su última actualización.</p></div><a class="crm-button secondary" href="/admin/crm/empresas">Ver todas</a></div>
  {recent.length ? <section class="crm-card"><div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>Empresa</th><th>Sector</th><th>Ciudad</th><th>Actualizada</th></tr></thead><tbody>
    {recent.map((organization) => <tr><td><a href={`/admin/crm/empresas/${organization.id}`}>{organization.name}</a></td><td>{organization.sector ?? 'Sin definir'}</td><td>{organization.city ?? 'Sin definir'}</td><td>{formatCrmDate(organization.updated_at)}</td></tr>)}
  </tbody></table></div></section> : <div class="crm-empty"><strong>Tu CRM está listo para su primera empresa.</strong><p>No hay registros comerciales en esta base TEST. Añade una empresa cuando quieras empezar.</p>{canWrite && <a class="crm-button" href="/admin/crm/empresas/nueva">Crear empresa</a>}</div>}
  <div class="crm-toolbar"><div><h2>Próximas acciones</h2><p>Tareas abiertas con fecha de seguimiento.</p></div><a class="crm-button secondary" href="/admin/crm/tareas">Ver tareas</a></div>
  {tasks.length ? <section class="crm-card"><ul class="crm-inline-list">{tasks.slice(0, 4).map((task) => <li><div><strong>{String(task.title)}</strong><small>{String(task.organization_name)} · {task.due_at ? formatCrmDate(task.due_at) : 'Sin fecha'}</small></div><a href={`/admin/crm/empresas/${String(task.organization_id)}#tasks`}>Abrir ficha</a></li>)}</ul></section>
    : <div class="crm-empty"><strong>Sin tareas pendientes.</strong><p>Las próximas acciones aparecerán aquí cuando se creen desde una empresa o una actividad.</p></div>}
</AdminShell>
