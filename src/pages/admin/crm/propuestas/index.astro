---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken } from '../../../../lib/admin/access';
import { getDatabase } from '../../../../lib/db/client';
import { listProposalResources, listProposals } from '../../../../lib/admin/proposals/service';
import { formatCents } from '../../../../lib/admin/proposals/money';
import { formatCrmDate } from '../../../../lib/admin/crm/presentation';
import { listOrganizations } from '../../../../lib/admin/crm/queries';
import '../../../../styles/admin-proposals.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const [proposals, resources] = await Promise.all([listProposals(principal), listProposalResources()]);
const db = getDatabase();
const connection = principal.roles.includes('owner')
  ? await db.get('SELECT id, status, last_sync_at FROM crm_gmail_connections WHERE owner_user_id = ?', [principal.id]) : null;
const incidents = connection ? await db.all(`SELECT code, occurred_at FROM crm_gmail_sync_incidents
  WHERE connection_id = ? AND status = 'open' ORDER BY occurred_at DESC LIMIT 5`, [connection.id]) : [];
const unmatched = connection ? await db.all(`SELECT id, subject, association_status, last_message_at
  FROM crm_gmail_threads WHERE connection_id = ? AND organization_id IS NULL
  ORDER BY last_message_at DESC LIMIT 30`, [connection.id]) : [];
const candidates = unmatched.length ? await listOrganizations(principal, { limit: 100 }) : [];
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
const gmailReady = process.env.ALTARIA_TEST_ISOLATED === '1'
  && process.env.ALTARIA_GMAIL_CONNECT_ENABLED === '1';
const statusLabels: Record<string, string> = { draft: 'Borrador', sent: 'Enviada · registro manual',
  accepted: 'Aceptada', rejected: 'Rechazada', expired: 'Caducada' };
---
<AdminShell title="Propuestas." eyebrow="CRM / PROPUESTAS" description="De la oportunidad a un documento claro, con versiones y seguimiento." active="/admin/crm" principal={principal}>
  <CrmNav active="proposals" />
  <div class="proposal-hero"><div><p class="admin-eyebrow">ALTARIA LIGHTS · TEST</p><h2>Propuestas que avanzan con cada conversación.</h2><p>Prepara alcance, inversión y condiciones. Cada guardado conserva una versión independiente.</p></div><a class="crm-button" href="/admin/crm/empresas">Elegir oportunidad <span aria-hidden="true">↗</span></a></div>
  {Astro.url.searchParams.get('registrado') && <p class="crm-notice" role="status">Recurso guardado en TEST.</p>}
  {Astro.url.searchParams.get('gmail') === 'connected' && <p class="crm-notice" role="status">Gmail staging conectado. La sincronización es manual.</p>}
  {Astro.url.searchParams.get('gmail') === 'error' && <p class="proposal-warning" role="alert">No se completó la conexión Gmail. Revisa identidad, etiqueta y permisos.</p>}
  <section class="crm-card" aria-labelledby="proposal-list-title"><div class="crm-card-heading"><div><h2 id="proposal-list-title">Propuestas comerciales</h2><p>Estados reales de esta base TEST; ninguna propuesta equivale a una factura.</p></div><span class="crm-badge">{proposals.length}</span></div>
    {proposals.length ? <div class="proposal-list">{proposals.map((proposal) => <a class="proposal-list-item" href={`/admin/crm/propuestas/${String(proposal.id)}`}><div><span class="proposal-kicker">{String(proposal.organization_name)} · v{String(proposal.current_version)}</span><strong>{String(proposal.title)}</strong><small>{String(proposal.opportunity_title)} · {formatCrmDate(proposal.updated_at)}</small></div><div class="proposal-list-side"><span class="crm-badge">{statusLabels[String(proposal.status)] ?? String(proposal.status)}</span><b>{proposal.total_cents == null ? 'Sin importe' : formatCents(Number(proposal.total_cents))}</b></div></a>)}</div>
      : <div class="crm-empty"><strong>Aún no hay propuestas.</strong><p>Abre una empresa y crea una propuesta desde una oportunidad activa. El catálogo empieza vacío hasta que registres tus servicios reales.</p><a class="crm-button secondary" href="/admin/crm/empresas">Ver empresas</a></div>}
  </section>
  <div class="proposal-two-col">
    <section class="crm-card"><div class="crm-card-heading"><div><h2>Biblioteca comercial</h2><p>Plantillas y partidas reutilizables, sin precios inventados.</p></div></div>
      <div class="proposal-resource-count"><span><b>{resources.templates.length}</b> plantillas</span><span><b>{resources.catalog.length}</b> productos y servicios</span></div>
      {resources.templates.length ? <ul class="crm-inline-list">{resources.templates.map((item) => <li><div><strong>{String(item.name)}</strong><small>Plantilla reutilizable</small></div></li>)}</ul> : <p class="crm-help">Crea una plantilla con alcance y condiciones habituales.</p>}
      {principal.roles.includes('owner') && <details class="proposal-resource-form"><summary class="crm-button subtle">+ Nueva plantilla</summary><form action="/api/admin/proposals/template" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><div class="crm-form-grid"><label class="crm-field wide">Nombre<input name="name" required minlength="2" maxlength="120" /></label><label class="crm-field wide">Descripción<textarea name="description" maxlength="3000"></textarea></label><label class="crm-field wide">Alcance<textarea name="scope" maxlength="5000"></textarea></label><label class="crm-field">Plazos<textarea name="schedule" maxlength="2000"></textarea></label><label class="crm-field">Condiciones<textarea name="terms" maxlength="5000"></textarea></label></div><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><button class="crm-button" type="submit">Guardar plantilla</button></form></details>}
      {principal.roles.includes('owner') && <details class="proposal-resource-form"><summary class="crm-button subtle">+ Producto o servicio</summary><form action="/api/admin/proposals/catalog" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><div class="crm-form-grid"><label class="crm-field">Tipo<select name="kind"><option value="service">Servicio</option><option value="product">Producto</option></select></label><label class="crm-field">Nombre<input name="name" required minlength="2" maxlength="120" /></label><label class="crm-field wide">Descripción<textarea name="description" maxlength="1000"></textarea></label><label class="crm-field">Precio unitario, céntimos<input type="number" name="unitPrice" min="0" step="1" placeholder="Opcional" /></label><label class="crm-field">Impuesto, puntos básicos<input type="number" name="taxBps" min="0" max="10000" step="1" value="2100" /></label></div><p class="crm-help">2.100 puntos básicos = 21 %. Precio opcional para presupuestar cada caso.</p><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><button class="crm-button" type="submit">Guardar artículo</button></form></details>}
    </section>
    <section class="crm-card"><div class="crm-card-heading"><div><h2>Gmail CRM</h2><p>La conexión permanece separada del acceso Google al administrador.</p></div><span class="crm-badge">{connection ? String(connection.status) : 'Pendiente'}</span></div>
      <p class="crm-help">Sólo se procesarán mensajes con la etiqueta <strong>ALTARIA/CRM</strong>. Google concede lectura de metadatos de todo el buzón mediante <code>gmail.metadata</code>; la etiqueta no reduce el permiso OAuth.</p>
      {!gmailReady && <p class="proposal-warning">Conexión real pendiente de Google Cloud, consentimiento y aprobación de permisos restringidos. Los borradores locales no se envían.</p>}
      {incidents.length > 0 && <div class="proposal-warning" role="status"><strong>Sincronización con incidencia</strong><ul>{incidents.map((incident) => <li>{String(incident.code)} · {formatCrmDate(incident.occurred_at)}</li>)}</ul></div>}
      {unmatched.length > 0 && <div class="proposal-unmatched"><h3>Hilos pendientes de asociación</h3><p class="crm-help">Revisa cada coincidencia antes de vincularla. Nunca se asocia por un email ambiguo.</p>{unmatched.map((thread) => <form action="/api/admin/gmail/link-thread" method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="threadId" value={String(thread.id)} /><strong>{String(thread.subject || 'Sin asunto')}</strong><small>{String(thread.association_status)} · {formatCrmDate(thread.last_message_at)}</small><label class="crm-field">Empresa verificada<select name="organizationId" required><option value="">Selecciona empresa</option>{candidates.map((org) => <option value={org.id}>{org.name}</option>)}</select></label><button class="crm-button secondary" type="submit">Vincular hilo</button></form>)}</div>}
      {principal.roles.includes('owner') && gmailReady && <div class="proposal-resource-actions">{!connection || connection.status !== 'connected' ? <form action="/api/admin/gmail/connect" method="post"><input type="hidden" name="csrf" value={csrf} /><button class="crm-button" type="submit">Conectar Gmail staging</button></form> : <><form action="/api/admin/gmail/sync" method="post"><input type="hidden" name="csrf" value={csrf} /><button class="crm-button" type="submit">Sincronizar etiqueta</button></form><form action="/api/admin/gmail/disconnect" method="post"><input type="hidden" name="csrf" value={csrf} /><button class="crm-button secondary" type="submit">Desconectar</button></form></>}</div>}
      {connection?.last_sync_at && <p class="crm-help">Última sincronización: {formatCrmDate(connection.last_sync_at)}</p>}
    </section>
  </div>
</AdminShell>
