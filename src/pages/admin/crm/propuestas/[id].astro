---
import AdminShell from '../../../../layouts/AdminShell.astro';
import CrmNav from '../../../../components/admin/CrmNav.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { getProposal, listProposalResources } from '../../../../lib/admin/proposals/service';
import { formatCents } from '../../../../lib/admin/proposals/money';
import { formatCrmDate } from '../../../../lib/admin/crm/presentation';
import '../../../../styles/admin-proposals.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const id = Astro.params.id || '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response('Propuesta no encontrada.', { status: 404 });
let detail;
try { detail = await getProposal(principal, id); }
catch { return new Response('Propuesta no encontrada.', { status: 404 }); }
const { proposal, versions, events } = detail;
const latest = versions[0];
const snapshot = latest ? JSON.parse(String(latest.snapshot_json)) : null;
const { templates, catalog } = await listProposalResources();
const canWrite = hasAdminPermission(principal, 'crm:write')
  && (principal.roles.includes('owner') || proposal.responsible_user_id === principal.id);
const editable = canWrite && ['draft', 'sent'].includes(String(proposal.status));
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
const labels: Record<string, string> = { draft: 'Borrador', sent: 'Enviada · registro manual',
  accepted: 'Aceptada', rejected: 'Rechazada', expired: 'Caducada' };
const eventLabels: Record<string, string> = { created: 'Propuesta creada', versioned: 'Nueva versión guardada',
  duplicated: 'Propuesta duplicada', marked_sent: 'Marcada como enviada', accepted: 'Aceptación registrada',
  rejected: 'Rechazo registrado', expired: 'Caducidad registrada', changes_requested: 'Cambios solicitados' };
const saved = Astro.url.searchParams.get('saved');
---
<AdminShell title="Editor de propuesta." eyebrow="CRM / PROPUESTA" description="Documento comercial versionado, calculado y protegido en el servidor." active="/admin/crm" principal={principal}>
  <CrmNav active="proposals" />
  <div class="crm-toolbar"><a class="crm-button secondary" href={`/admin/crm/empresas/${String(proposal.organization_id)}#proposals`}>← {String(proposal.organization_name)}</a><span class="crm-badge">TEST · {labels[String(proposal.status)]}</span></div>
  {saved && <p class="crm-notice" role="status">Cambio registrado en TEST.</p>}
  <header class="proposal-detail-hero"><div><p class="admin-eyebrow">{String(proposal.organization_name)} / {String(proposal.opportunity_title)}</p><h2>{String(proposal.title)}</h2><p>Versión actual {String(proposal.current_version)} · {formatCrmDate(proposal.updated_at)}</p></div><div><strong>{latest ? formatCents(Number(latest.total_cents)) : 'Sin calcular'}</strong><span>Importe comercial orientativo</span></div></header>
  <div class="proposal-layout"><div class="crm-stack">
    {editable && <section class="crm-card" aria-labelledby="editor-title"><div class="crm-card-heading"><div><h2 id="editor-title">{latest ? 'Crear nueva versión' : 'Preparar primera versión'}</h2><p>El contenido anterior queda inmutable. Los cálculos definitivos se validan en el servidor.</p></div><span class="crm-badge">v{Number(proposal.current_version) + 1}</span></div>
      <form action="/api/admin/proposals/version" method="post" data-crm-form data-proposal-editor data-lines={JSON.stringify(snapshot?.lines || [])} data-catalog={JSON.stringify(catalog)} data-templates={JSON.stringify(templates)}>
        <input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="expectedVersion" value={String(proposal.current_version)} /><input type="hidden" name="linesJson" value="[]" />
        <div class="crm-form-grid"><label class="crm-field wide">Usar plantilla<select data-template><option value="">Sin plantilla · empezar desde esta versión</option>{templates.map((template) => <option value={String(template.id)}>{String(template.name)}</option>)}</select></label><label class="crm-field wide">Descripción<textarea name="description" maxlength="3000" placeholder="La oportunidad y el enfoque propuesto">{snapshot?.description || ''}</textarea></label><label class="crm-field wide">Alcance<textarea name="scope" maxlength="5000" placeholder="Qué incluye el trabajo">{snapshot?.scope || ''}</textarea></label><label class="crm-field">Plazos<textarea name="schedule" maxlength="2000" placeholder="Fases y fechas estimadas">{snapshot?.schedule || ''}</textarea></label><label class="crm-field">Condiciones<textarea name="terms" maxlength="5000" placeholder="Validez, entregables y acuerdos">{snapshot?.terms || ''}</textarea></label><label class="crm-field">Válida hasta<input type="date" name="expiresAt" value={snapshot?.expiresAt ? String(snapshot.expiresAt).slice(0, 10) : ''} /></label></div>
        <div class="proposal-editor-heading"><div><h3>Partidas</h3><p>Productos, servicios o conceptos personalizados. Puedes ajustar el precio de cada propuesta.</p></div><button class="crm-button secondary" type="button" data-add-line>+ Añadir partida</button></div>
        <div class="proposal-lines" data-line-list></div>
        <div class="proposal-preview" aria-live="polite"><span>Total provisional</span><strong data-preview-total>0,00 €</strong><small>El servidor recalcula y valida al guardar.</small></div>
        <p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p><div class="crm-form-actions"><button class="crm-button" type="submit">Guardar nueva versión</button></div>
      </form>
    </section>}
    {!editable && <section class="crm-card"><div class="crm-card-heading"><div><h2>Documento cerrado</h2><p>La decisión comercial queda en el historial. Duplica para preparar otra propuesta.</p></div></div></section>}
    <section class="crm-card" aria-labelledby="history-title"><div class="crm-card-heading"><div><h2 id="history-title">Versiones e historial</h2><p>Cada versión conserva su contenido y un PDF independiente.</p></div></div>
      {versions.length ? <div class="proposal-version-list">{versions.map((version) => <div><div><strong>Versión {String(version.version_number)}</strong><small>{formatCrmDate(version.created_at)} · {formatCents(Number(version.total_cents))}</small></div><a class="crm-button secondary" href={`/api/admin/proposals/${id}/pdf?version=${String(version.version_number)}`}>Descargar PDF</a></div>)}</div> : <div class="crm-empty"><strong>Aún no hay versiones.</strong><p>Completa la primera versión para generar el PDF.</p></div>}
      {events.length > 0 && <ol class="crm-timeline proposal-timeline">{events.map((event) => <li><strong>{eventLabels[String(event.kind)] ?? String(event.kind)}</strong><time datetime={String(event.occurred_at)}>{formatCrmDate(event.occurred_at)}</time>{event.note && <p>{String(event.note)}</p>}</li>)}</ol>}
    </section>
  </div><aside class="crm-stack" aria-label="Acciones de propuesta">
    <section class="crm-card"><div class="crm-card-heading"><div><h2>Siguiente paso</h2><p>Estado comercial con registro de quién lo decidió.</p></div></div>
      {canWrite && <div class="proposal-actions">
        {proposal.status === 'draft' && Number(proposal.current_version) > 0 && <form action="/api/admin/proposals/transition" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="transition" value="marked_sent" /><button class="crm-button" type="submit">Marcar como enviada</button><p class="crm-help">Registro manual: no se envía correo. Programa una tarea de seguimiento.</p><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>}
        {proposal.status === 'sent' && <><form action="/api/admin/proposals/transition" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="transition" value="accepted" /><label class="crm-field">Nota de aceptación<input name="note" minlength="5" maxlength="1000" required placeholder="Cómo se confirmó" /></label><button class="crm-button" type="submit">Registrar aceptación</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form><form action="/api/admin/proposals/transition" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="transition" value="changes_requested" /><label class="crm-field">Cambios solicitados<input name="note" maxlength="1000" placeholder="Resumen del ajuste" /></label><button class="crm-button secondary" type="submit">Preparar nueva versión</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form><form action="/api/admin/proposals/transition" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="transition" value="rejected" /><label class="crm-field">Motivo del rechazo<input name="note" required minlength="5" maxlength="1000" /></label><button class="crm-button secondary" type="submit">Registrar rechazo</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>{proposal.expires_at && new Date(String(proposal.expires_at)).getTime() <= Date.now() && <form action="/api/admin/proposals/transition" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><input type="hidden" name="transition" value="expired" /><button class="crm-button secondary" type="submit">Registrar caducidad</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>}</>}
        <form action="/api/admin/proposals/duplicate" method="post" data-crm-form><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="proposalId" value={id} /><button class="crm-button subtle" type="submit">Duplicar propuesta</button><p class="crm-form-error" data-crm-error role="alert" tabindex="-1" hidden></p></form>
      </div>}
      {!canWrite && <p class="crm-help">Consulta disponible. Sólo el responsable comercial puede editar.</p>}
      <p class="proposal-warning">Aceptar esta propuesta no emite una factura ni registra un pago. La oportunidad sólo se cierra automáticamente si ya está en Negociación.</p>
    </section>
  </aside></div>
</AdminShell>
<script>import '../../../../scripts/admin-proposal-editor';</script>
