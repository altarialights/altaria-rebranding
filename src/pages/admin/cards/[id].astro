---
import { randomUUID } from 'node:crypto';
import AdminShell from '../../../layouts/AdminShell.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../lib/admin/access';
import { getCardOrder } from '../../../lib/admin/cards/service';
import { batchModes, checkKeys, checkLabels, modeLabels, nextStage, stageLabels,
  type CheckKey, type ProductionStage } from '../../../lib/admin/cards/workflow';
import { listOrganizations } from '../../../lib/admin/crm/queries';
import '../../../styles/admin-cards.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const orderId = Astro.params.id ?? '';
const detail = await getCardOrder(principal, orderId);
if (!detail) return new Response('Pedido TEST no encontrado.', { status: 404 });
const { order, artwork, batches, units, checks, incidents, events, orderEvents, allocated, stage, blockers } = detail;
const canWrite = hasAdminPermission(principal, 'cards:write');
const canArtwork = hasAdminPermission(principal, 'cards:artwork');
const canLink = principal.roles.includes('owner') && hasAdminPermission(principal, 'crm:write');
const organizations = canLink && !order.organization_id ? await listOrganizations(principal, { limit: 100 }) : [];
const csrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'cards');
const crmCsrf = createAdminCsrfToken(principal.sessionHash, process.env.WORKOS_COOKIE_PASSWORD || '', 'crm');
const money = (value: unknown) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(Number(value || 0) / 100);
const date = (value: unknown) => value ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(String(value))) : '—';
const next = stage ? nextStage(stage) : null;
const config = (() => { try { const raw = JSON.parse(String(order.personalizacion_json || '{}')); return raw.configuracion ?? raw; } catch { return {}; } })();
const detailFields = Object.entries(config.details ?? {}).filter(([key, value]) => value && !['email','phone'].includes(key)).slice(0, 12);
const saved: Record<string,string> = { start: 'Preparación iniciada.', check: 'Comprobación registrada.', batch: 'Lote creado.', advance: 'Etapa actualizada.', priority: 'Prioridad actualizada.', incident: 'Incidencia registrada.', resolve: 'Incidencia resuelta.' };
const notice = saved[Astro.url.searchParams.get('saved') ?? ''];
const isPaid = Boolean(order.pagado_en) && Number(order.payment_confirmed) === 1 && ['pagado','preparando','enviado','entregado'].includes(String(order.estado));
const paymentLabel = order.estado === 'pendiente_pago' ? 'Pendiente de pago' :
  order.pagado_en && !isPaid ? 'Pago por verificar' : String(order.estado);
const stageCheckKeys = stage === 'preparation' ? checkKeys.slice(0,2) : stage === 'production' ? checkKeys.slice(2,4) : stage === 'verification' ? checkKeys.slice(4) : [];
---
<AdminShell title={`Pedido ${String(order.numero_pedido)}`} eyebrow="CARDS / FICHA OPERATIVA" description="Diseño, lotes, verificaciones e historial en una sola ficha." active="/admin/cards" principal={principal}>
  <div class="cards-back"><a href="/admin/cards">← Volver a pedidos</a><span>TEST · {String(order.numero_pedido)}</span></div>
  {notice && <p class="cards-notice" role="status">{notice}</p>}
  <div class="cards-detail-heading"><div><p class="admin-eyebrow">{String(order.producto_nombre)} · {Number(order.cantidad)} unidades</p><h2>{String(order.negocio_nombre)}</h2><p>{String(order.cliente_nombre)} · {String(order.cliente_email)}</p></div><div class="cards-detail-tags"><span class:list={['cards-status', isPaid ? 'is-paid' : 'is-pending']}>{isPaid ? 'Pago test confirmado' : paymentLabel}</span><span class="cards-stage">{stage ? stageLabels[stage] : 'Producción sin iniciar'}</span></div></div>
  <nav class="cards-local-nav" aria-label="Secciones del pedido"><a href="#resumen">Resumen</a><a href="#produccion">Producción</a><a href="#lotes">Lotes</a><a href={`/admin/cards/${orderId}/enlaces`}>QR y NFC</a><a href="#incidencias">Incidencias</a><a href="#historial">Historial</a></nav>
  <div class="cards-detail-grid">
    <div class="cards-main-column">
      <section class="cards-panel" id="resumen" aria-labelledby="cards-summary-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">CONTEXTO</p><h2 id="cards-summary-title">Pedido y cliente</h2></div><strong>{money(order.total_centimos)}</strong></div>
        <dl class="cards-facts"><div><dt>Pedido</dt><dd>{String(order.numero_pedido)}</dd></div><div><dt>Creado</dt><dd>{date(order.creado_en)}</dd></div><div><dt>Pago confirmado</dt><dd>{date(order.pagado_en)}</dd></div><div><dt>Producto</dt><dd>{String(order.producto_nombre)}</dd></div><div><dt>Cantidad</dt><dd>{Number(order.cantidad)} unidades</dd></div><div><dt>Entrega</dt><dd>{String(order.envio_ciudad)}, {String(order.envio_provincia)}</dd></div><div><dt>Empresa CRM</dt><dd>{order.organization_id ? <a href={`/admin/crm/empresas/${String(order.organization_id)}`}>{String(order.organization_name)}</a> : 'Sin vincular'}</dd></div><div><dt>Referencia envío</dt><dd>{String(order.referencia_envio ?? '—')}</dd></div></dl>
        {canLink && !order.organization_id && <div class="cards-inline-form"><h3>Vincular con una empresa</h3><p>Revisa la identidad de la empresa antes de vincular. El enlace es único y queda auditado.</p>{organizations.length ? <form action="/api/admin/crm/source-links" method="post"><input type="hidden" name="csrf" value={crmCsrf} /><input type="hidden" name="sourceKind" value="cards_order" /><input type="hidden" name="sourceId" value={orderId} /><label>Empresa CRM<select name="organizationId" required><option value="">Seleccionar empresa</option>{organizations.map((org) => <option value={org.id}>{org.name}</option>)}</select></label><button class="cards-button secondary" type="submit">Vincular pedido</button></form> : <p>No hay empresas CRM para vincular.</p>}</div>}
      </section>
      <section class="cards-panel" aria-labelledby="cards-design-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">DISEÑO Y PERSONALIZACIÓN</p><h2 id="cards-design-title">Material de trabajo</h2></div></div>
        <div class="cards-design-card"><div><strong>{artwork.length ? String(artwork[0].filename) : 'Sin diseño original adjunto'}</strong><p>{artwork.length ? `${String(artwork[0].validation_status)} · ${Number(artwork[0].size_bytes)} bytes` : 'Revisa las instrucciones de personalización antes de registrar la comprobación.'}</p></div>{artwork.length > 0 && canArtwork && <a class="cards-button secondary" href={`/api/admin/cards/${orderId}/artwork`}>Descargar original</a>}</div>
        <dl class="cards-facts"><div><dt>Tipo de diseño</dt><dd>{String(config.design ?? 'Sin especificar')}</dd></div><div><dt>Destino solicitado</dt><dd>{String(config.destination ?? 'Sin especificar')}</dd></div>{detailFields.map(([key,value]) => <div><dt>{key}</dt><dd>{String(value)}</dd></div>)}</dl>
      </section>
      <section class="cards-panel" id="produccion" aria-labelledby="cards-production-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">FLUJO DE TALLER</p><h2 id="cards-production-title">Producción</h2><p>Las comprobaciones físicas solo se registran mediante una acción humana.</p></div></div>
        {!stage ? <div class="cards-empty compact"><h3>{isPaid ? 'Listo para preparar.' : 'Pendiente de pago test.'}</h3><p>{isPaid ? 'Inicia la ficha de producción cuando el pedido entre en taller.' : 'No se puede iniciar producción hasta que Stripe test confirme el pago.'}</p>{isPaid && canWrite && <form action="/api/admin/cards/start" method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><button class="cards-button" type="submit">Iniciar preparación</button></form>}</div> : <>
          <ol class="cards-stepper" aria-label="Etapas de producción">{(['preparation','production','verification','ready_to_ship','shipped','delivered'] as ProductionStage[]).map((item, index) => <li class:list={[{ 'is-current': item === stage, 'is-done': index < (['preparation','production','verification','ready_to_ship','shipped','delivered'] as string[]).indexOf(stage) }]}><span>{String(index+1).padStart(2,'0')}</span><strong>{stageLabels[item]}</strong></li>)}</ol>
          {stageCheckKeys.length > 0 && <div class="cards-check-list"><h3>Comprobaciones de esta etapa</h3>{stageCheckKeys.map((key) => { const entry = checks.find((item) => item.check_key === key); return <div class="cards-check-row"><span class:list={['cards-check-dot', { 'is-done': Boolean(entry) }]} aria-hidden="true">{entry ? '✓' : '○'}</span><div><strong>{checkLabels[key as CheckKey]}</strong><small>{entry ? `${String(entry.actor_name)} · ${date(entry.checked_at)} · ${String(entry.note)}` : 'Pendiente de confirmación humana'}</small></div>{!entry && canWrite && <details><summary class="cards-button secondary">Registrar</summary><form action="/api/admin/cards/check" method="post" class="cards-pop-form"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><input type="hidden" name="checkKey" value={key} /><label>Detalle de la comprobación<textarea name="note" minlength="3" maxlength="500" required placeholder="Qué se ha revisado o realizado"></textarea></label><button class="cards-button" type="submit">Confirmar personalmente</button></form></details>}</div>; })}</div>}
          {next && <div class="cards-next"><div><strong>Siguiente paso: {stageLabels[next]}</strong>{blockers.length ? <ul>{blockers.map((item) => <li>{item}</li>)}</ul> : <p>Los requisitos de esta etapa están completos.</p>}</div>{canWrite && blockers.length === 0 && <form action="/api/admin/cards/advance" method="post"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><input type="hidden" name="version" value={String(order.version)} />{next === 'shipped' && <div class="cards-ship-fields"><label>Transportista<input name="carrier" minlength="2" maxlength="100" required /></label><label>Seguimiento<input name="tracking" minlength="3" maxlength="120" required /></label></div>}<button class="cards-button" type="submit">Avanzar a {stageLabels[next]}</button></form>}</div>}
          {stage === 'shipped' || stage === 'delivered' ? <div class="cards-shipping"><strong>Seguimiento de envío</strong><p>{String(order.carrier ?? '—')} · {String(order.tracking ?? '—')}</p><small>Salida: {date(order.shipped_at)} · Entrega: {date(order.delivered_at)}</small></div> : null}
        </>}
      </section>
      <section class="cards-panel" id="lotes" aria-labelledby="cards-batches-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">TRAZABILIDAD</p><h2 id="cards-batches-title">Lotes y unidades</h2><p>{allocated} de {Number(order.cantidad)} unidades asignadas.</p></div></div>
        {batches.length ? <div class="cards-batches">{batches.map((batch) => <details class="cards-batch"><summary><strong>{modeLabels[String(batch.mode) as keyof typeof modeLabels]}</strong><span>{Number(batch.quantity)} uds. · {date(batch.created_at)}</span></summary><p>Código de lote: {batch.internal_batch_code ? String(batch.internal_batch_code) : 'Códigos individuales'}. Los destinos y códigos QR/NFC se gestionan en <a href={`/admin/cards/${orderId}/enlaces`}>Enlaces del pedido</a>.</p><ol>{units.filter((unit) => unit.batch_id === batch.id).map((unit) => <li><span>Unidad {Number(unit.sequence)}</span><code>{String(unit.internal_unit_code ?? batch.internal_batch_code)}</code></li>)}</ol></details>)}</div> : <p class="cards-muted">Aún no se ha creado ningún lote.</p>}
        {stage === 'preparation' && canWrite && allocated < Number(order.cantidad) && <form action="/api/admin/cards/batch" method="post" class="cards-batch-form"><h3>Crear lote</h3><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><input type="hidden" name="idempotencyKey" value={randomUUID()} /><label>Modo<select name="mode" required>{batchModes.map((mode) => <option value={mode}>{modeLabels[mode]}</option>)}</select></label><label>Unidades<input type="number" name="quantity" min="1" max={Math.min(500, Number(order.cantidad) - allocated)} value={String(Number(order.cantidad) - allocated)} required /></label><button class="cards-button" type="submit">Crear lote y unidades</button></form>}
      </section>
    </div>
    <aside class="cards-side-column" aria-label="Control del pedido">
      <section class="cards-panel" aria-labelledby="cards-control-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">CONTROL</p><h2 id="cards-control-title">Prioridad</h2></div></div><p class="cards-muted">Organiza el taller sin cambiar el pago ni la etapa.</p>{stage && canWrite ? <form action="/api/admin/cards/priority" method="post" class="cards-priority-form"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><label>Prioridad<select name="priority"><option value="normal" selected={order.priority === 'normal'}>Normal</option><option value="high" selected={order.priority === 'high'}>Alta</option><option value="urgent" selected={order.priority === 'urgent'}>Urgente</option></select></label><button class="cards-button secondary" type="submit">Guardar</button></form> : <strong>{String(order.priority ?? 'Normal')}</strong>}</section>
      <section class="cards-panel" id="incidencias" aria-labelledby="cards-incidents-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">CALIDAD</p><h2 id="cards-incidents-title">Incidencias</h2></div><span class="cards-count">{incidents.filter((item) => item.status === 'open').length}</span></div>
        {incidents.length ? <ul class="cards-incident-list">{incidents.map((item) => <li><strong>{String(item.summary)}</strong><small>{item.severity === 'blocking' ? 'Bloqueante' : 'Menor'} · {item.status === 'open' ? 'Abierta' : 'Resuelta'} · {date(item.created_at)}</small>{item.status === 'resolved' && <p>{String(item.resolution)}</p>}{item.status === 'open' && canWrite && <details><summary class="cards-button secondary">Resolver</summary><form action="/api/admin/cards/resolve" method="post" class="cards-pop-form"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><input type="hidden" name="incidentId" value={String(item.id)} /><label>Resolución<textarea name="resolution" minlength="5" maxlength="500" required></textarea></label><button class="cards-button" type="submit">Registrar resolución</button></form></details>}</li>)}</ul> : <p class="cards-muted">Sin incidencias registradas.</p>}
        {stage && canWrite && <form action="/api/admin/cards/incident" method="post" class="cards-incident-form"><h3>Registrar incidencia</h3><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="orderId" value={orderId} /><label>Descripción<textarea name="summary" minlength="5" maxlength="500" required></textarea></label><label>Impacto<select name="severity"><option value="minor">Menor</option><option value="blocking">Bloqueante</option></select></label><button class="cards-button secondary" type="submit">Añadir incidencia</button></form>}
      </section>
    </aside>
  </div>
  <section class="cards-panel cards-history" id="historial" aria-labelledby="cards-history-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">TRAZABILIDAD</p><h2 id="cards-history-title">Historial del pedido</h2></div></div><div class="cards-history-grid"><div><h3>Producción</h3>{events.length ? <ol>{events.map((item) => <li><span>{date(item.occurred_at)}</span><strong>{String(item.kind).replaceAll('_',' ')}</strong><small>{String(item.actor_name)}</small></li>)}</ol> : <p class="cards-muted">Sin acciones de producción.</p>}</div><div><h3>Pedido y pago</h3>{orderEvents.length ? <ol>{orderEvents.map((item) => <li><span>{date(item.creado_en)}</span><strong>{String(item.tipo_evento).replaceAll('_',' ')}</strong><small>{String(item.estado_nuevo ?? '')}</small></li>)}</ol> : <p class="cards-muted">Sin eventos de pedido.</p>}</div></div></section>
</AdminShell>
