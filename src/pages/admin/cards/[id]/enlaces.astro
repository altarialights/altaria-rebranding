---
import { randomUUID } from 'node:crypto';
import AdminShell from '../../../../layouts/AdminShell.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { getCardOrder } from '../../../../lib/admin/cards/service';
import { listOrderLinks } from '../../../../lib/admin/cards/links';
import { modeLabels, type BatchMode } from '../../../../lib/admin/cards/workflow';
import '../../../../styles/admin-cards.css';
import '../../../../styles/admin-cards-links.css';
export const prerender=false;
const principal=Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.',{status:403});
const orderId=Astro.params.id??'';
const detail=await getCardOrder(principal,orderId);
if (!detail) return new Response('Pedido TEST no encontrado.',{status:404});
const data=await listOrderLinks(principal,orderId);
const canWrite=hasAdminPermission(principal,'cards:write');
const isOwner=canWrite&&principal.roles.includes('owner');
const csrf=createAdminCsrfToken(principal.sessionHash,process.env.WORKOS_COOKIE_PASSWORD||'','cards');
const refs=[...new Map(data.links.map(link=>[String(link.destination_ref_id),link])).values()];
const linkCount=(batchId:string)=>data.links.filter(link=>link.batch_id===batchId).length;
const summary={active:data.links.filter(link=>link.status==='active').length,
  paused:data.links.filter(link=>link.status==='paused').length,
  opens:data.totalOpenings};
const short=(value:unknown)=>String(value).slice(0,8);
---
<AdminShell title="Enlaces Cards" eyebrow="CARDS / REDIRECCIONES TEST" description="Destinos editables, códigos permanentes y trazabilidad de cada cambio." active="/admin/cards" principal={principal}>
  <nav class="cards-local-nav" aria-label="Navegación Cards"><a href="/admin/cards">Pedidos</a><a href={`/admin/cards/${orderId}`}>Ficha del pedido</a><a aria-current="page" href={`/admin/cards/${orderId}/enlaces`}>Enlaces</a><a href="/admin/cards/analitica">Analítica</a></nav>
  {Astro.url.searchParams.has('saved') && <p class="cards-notice" role="status">Cambio guardado y auditado en TEST.</p>}
  <div class="cards-detail-heading"><div><p class="admin-eyebrow">PEDIDO TEST · {String(detail.order.numero_pedido)}</p><h2>QR y NFC dinámicos</h2><p>{String(detail.order.negocio_nombre)} · {Number(detail.order.cantidad)} tarjetas</p></div><div class="cards-detail-tags"><span class="cards-status is-paid">{summary.active} activos</span><span class="cards-stage">{summary.opens} aperturas</span></div></div>
  <div class="cards-links-grid">
    <section class="cards-panel" aria-labelledby="domain-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">01 / SEGURIDAD</p><h2 id="domain-title">Dominios autorizados</h2><p>Solo el propietario aprueba dominios HTTPS públicos. La aprobación se limita a este pedido.</p></div></div>
      {data.domains.length ? <ul class="cards-link-list">{data.domains.map(domain=><li><strong>{String(domain.hostname)}</strong><span>{Number(domain.active)===1?'Aprobado':'Inactivo'}</span></li>)}</ul> : <p class="cards-muted">Sin dominios aprobados. Aprueba uno antes de generar códigos.</p>}
      {isOwner && <form class="cards-link-form" action="/api/admin/cards/links" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={orderId}/><input type="hidden" name="action" value="domain"/><label>Dominio exacto<input name="hostname" type="text" placeholder="ejemplo.com" required maxlength="253"/></label><button class="cards-button secondary" type="submit">Aprobar dominio</button></form>}
    </section>
    <section class="cards-panel" aria-labelledby="batch-links-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">02 / PRODUCCIÓN</p><h2 id="batch-links-title">Lotes y códigos</h2><p>QR y NFC tienen códigos distintos. Los códigos ya generados no cambian al editar el destino.</p></div></div>
      {detail.batches.length ? <div class="cards-link-batches">{detail.batches.map(batch=><div class="cards-link-batch"><div><strong>{modeLabels[String(batch.mode) as BatchMode]}</strong><small>{Number(batch.quantity)} unidades · {linkCount(String(batch.id))} enlaces</small></div>{linkCount(String(batch.id))===0&&canWrite?<details><summary class="cards-button secondary">Preparar enlaces</summary><form class="cards-link-form" action="/api/admin/cards/links" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={orderId}/><input type="hidden" name="action" value="generate"/><input type="hidden" name="batchId" value={String(batch.id)}/><input type="hidden" name="idempotencyKey" value={randomUUID()}/><label>Destino HTTPS aprobado<input name="destination" type="url" placeholder="https://ejemplo.com/tarjeta" maxlength="2048" required/></label><label>Campaña opcional<input name="campaign" maxlength="80" placeholder="Campaña de prueba"/></label><p>Se crearán códigos QR y NFC para {batch.mode==='shared_batch'?'el lote':`${Number(batch.quantity)} unidades`}. Revisa el destino antes de confirmar.</p><button class="cards-button" type="submit">Generar códigos permanentes</button></form></details>:<span class="cards-stage">{linkCount(String(batch.id))?'Preparado':'Pendiente'}</span>}</div>)}</div>:<p class="cards-muted">Crea primero un lote en la ficha operativa.</p>}
    </section>
  </div>
  <section class="cards-panel" aria-labelledby="targets-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">03 / DESTINOS</p><h2 id="targets-title">Destinos activos</h2><p>Los cambios requieren motivo y quedan versionados. El destino se comparte según el modo del lote.</p></div></div>
    {refs.length?<div class="cards-targets" tabindex="0" role="region" aria-label="Destinos desplazables">{refs.map(ref=><details class="cards-target"><summary><span><strong>{String(ref.url)}</strong><small>Referencia {short(ref.destination_ref_id)} · versión {Number(ref.target_revision)} · {String(ref.mode)==='identified_shared'?'destino compartido entre unidades':String(ref.mode)==='shared_batch'?'destino del lote':'destino individual'}</small></span><span class="cards-stage">Editar</span></summary>{canWrite&&<form class="cards-link-form" action="/api/admin/cards/links" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={orderId}/><input type="hidden" name="action" value="destination"/><input type="hidden" name="refId" value={String(ref.destination_ref_id)}/><input type="hidden" name="revision" value={String(ref.target_revision)}/><label>Nuevo destino HTTPS<input name="destination" type="url" value={String(ref.url)} required maxlength="2048"/></label><label>Motivo del cambio<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><button class="cards-button" type="submit">Confirmar nueva versión</button></form>}</details>)}</div>:<p class="cards-muted">Los destinos aparecerán al generar enlaces.</p>}
  </section>
  <section class="cards-panel" aria-labelledby="link-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">04 / CÓDIGOS</p><h2 id="link-title">Códigos de prueba</h2><p>URL canónica pendiente. Las direcciones locales no se exportan para impresión comercial; la verificación física se registra por separado.</p></div></div>
    {data.links.length?<div class="cards-link-table-wrap" tabindex="0" role="region" aria-label="Tabla desplazable de resultados"><table class="cards-link-table cards-code-table"><thead><tr><th>Unidad / lote</th><th>Canal</th><th>Estado</th><th>Material</th><th>Detalle</th></tr></thead><tbody>{data.links.map(link=><tr><td><strong>{link.unit_id?`Unidad ${Number(link.sequence)}`:'Lote compartido'}</strong><small>{short(link.batch_id)} · {String(link.campaign??'Sin campaña')}</small></td><td><span class="cards-channel">{String(link.channel).toUpperCase()}</span></td><td><span class:list={['cards-link-state',{paused:link.status!=='active'}]}>{String(link.status)==='active'?'Activo':link.status==='paused'?'Pausado':'Retirado'}</span></td><td><span class="cards-muted">Solo vista previa TEST</span></td><td><a href={`/admin/cards/enlaces/${String(link.id)}`}>Abrir ficha ↗</a></td></tr>)}</tbody></table></div>:<p class="cards-muted">Todavía no hay enlaces en este pedido.</p>}
  </section>
  <section class="cards-panel" aria-labelledby="history-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">05 / AUDITORÍA</p><h2 id="history-title">Historial de destinos</h2></div></div>{data.history.length?<ol class="cards-link-history">{data.history.map(item=><li><strong>Versión {Number(item.revision)} · {String(item.action)}</strong><span>{String(item.next_url)}</span><small>{String(item.reason)} · {new Date(String(item.occurred_at)).toLocaleString('es-ES')}</small>{canWrite&&Number(item.revision)!==Number(refs.find(ref=>ref.destination_ref_id===item.destination_ref_id)?.target_revision??0)&&<form action="/api/admin/cards/links" method="post" class="cards-revert-form"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={orderId}/><input type="hidden" name="action" value="revert"/><input type="hidden" name="refId" value={String(item.destination_ref_id)}/><input type="hidden" name="historicalRevision" value={String(item.revision)}/><input type="hidden" name="revision" value={String(refs.find(ref=>ref.destination_ref_id===item.destination_ref_id)?.target_revision??0)}/><label>Motivo de reversión<input name="reason" minlength="5" maxlength="500" required/></label><button class="cards-button secondary" type="submit">Recuperar esta versión</button></form>}</li>)}</ol>:<p class="cards-muted">Sin cambios de destino todavía.</p>}
  </section>
</AdminShell>
