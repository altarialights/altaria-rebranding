---
import { randomUUID } from 'node:crypto';
import AdminShell from '../../../../layouts/AdminShell.astro';
import { createAdminCsrfToken, hasAdminPermission } from '../../../../lib/admin/access';
import { getLinkDetail } from '../../../../lib/admin/cards/links';
import { modeLabels, type BatchMode } from '../../../../lib/admin/cards/workflow';
import '../../../../styles/admin-cards.css';
import '../../../../styles/admin-cards-links.css';
export const prerender=false;
const principal=Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.',{status:403});
const detail=await getLinkDetail(principal,Astro.params.id??'');
if (!detail) return new Response('Enlace TEST no encontrado.',{status:404});
const {link,history,statusHistory,metrics,incidents}=detail;
const canWrite=hasAdminPermission(principal,'cards:write');
const csrf=createAdminCsrfToken(principal.sessionHash,process.env.WORKOS_COOKIE_PASSWORD||'','cards');
const localUrl=`http://127.0.0.1:4321/c/${String(link.public_code)}`;
const canonicalUrl: string | null = null;
const total=metrics.reduce((sum,row)=>sum+Number(row.openings),0);
const suspected=metrics.filter(row=>row.traffic_class==='suspected_bot').reduce((sum,row)=>sum+Number(row.openings),0);
const byDay=[...new Map(metrics.map(row=>[String(row.day_utc),0]))].sort((a,b)=>a[0].localeCompare(b[0]));
for(const row of metrics){const point=byDay.find(item=>item[0]===String(row.day_utc));if(point)point[1]+=Number(row.openings);}
const peak=Math.max(1,...byDay.map(point=>point[1]));
const health=link.status!=='active'?'Pausado o retirado':Number(link.domain_active)!==1?'Dominio inactivo':'Destino aprobado';
---
<AdminShell title={`Enlace ${String(link.channel).toUpperCase()}`} eyebrow="CARDS / FICHA DE ENLACE TEST" description="Código permanente, destino editable y métricas de aperturas." active="/admin/cards" principal={principal}>
  <nav class="cards-local-nav" aria-label="Navegación Cards"><a href="/admin/cards">Pedidos</a><a href={`/admin/cards/${String(link.order_id)}`}>Ficha del pedido</a><a href={`/admin/cards/${String(link.order_id)}/enlaces`}>Enlaces del pedido</a><a href="/admin/cards/analitica">Analítica</a></nav>
  {Astro.url.searchParams.has('saved')&&<p class="cards-notice" role="status">Cambio guardado y auditado en TEST.</p>}
  <div class="cards-detail-heading"><div><p class="admin-eyebrow">{String(link.numero_pedido)} · {modeLabels[String(link.mode) as BatchMode]}</p><h2>{String(link.channel).toUpperCase()} · {link.unit_id?`Unidad ${Number(link.sequence)}`:'Lote compartido'}</h2><p>{String(link.negocio_nombre)} · {String(link.organization_name??'Sin empresa CRM vinculada')}</p></div><div class="cards-detail-tags"><span class:list={['cards-link-state',{paused:link.status!=='active'}]}>{String(link.status)}</span><span class="cards-stage">{health}</span></div></div>
  <div class="cards-links-grid"><section class="cards-panel" aria-labelledby="identity-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">IDENTIDAD</p><h2 id="identity-title">Código permanente</h2><p>Este código no cambia al actualizar el destino.</p></div></div><code class="cards-identity-code">{String(link.public_code)}</code><div class="cards-copy-row"><code id="cards-local-url">{localUrl}</code><button type="button" class="cards-button secondary" data-copy-target="cards-local-url">Copiar URL TEST</button></div><dl class="cards-facts"><div><dt>Lote</dt><dd>{String(link.batch_id).slice(0,8)}</dd></div><div><dt>Campaña</dt><dd>{String(link.campaign??'Sin campaña')}</dd></div><div><dt>Estado</dt><dd>{String(link.status)}</dd></div></dl></section>
    <section class="cards-panel" aria-labelledby="production-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">MATERIAL</p><h2 id="production-title">Vista previa local</h2><p>El QR de TEST lleva una marca visible. La descarga imprimible está bloqueada mientras no exista una URL canónica pública aprobada.</p></div></div>{link.channel==='qr'&&canWrite?<img class="cards-qr-preview" src={`/api/admin/cards/links/${String(link.id)}/qr?format=svg&inline=1`} width="200" height="200" alt="QR SOLO TEST, NO IMPRIMIR"/>:<p class="cards-muted">{link.channel==='nfc'?'La URL TEST solo sirve para programación y pruebas locales.':'La vista previa requiere permiso de producción.'}</p>}<p class="cards-muted">URL canónica: {canonicalUrl??'pendiente de aprobación y despliegue'}. No grabar ni imprimir el enlace local.</p><p><a href={`/admin/cards/${String(link.order_id)}#produccion`}>Abrir verificaciones humanas ↗</a></p></section></div>
  <section class="cards-panel" aria-labelledby="destination-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">DESTINO ACTUAL</p><h2 id="destination-title">Redirección</h2><p>HTTPS y dominio aprobado para este pedido. No se realiza ninguna solicitud al destino desde el editor.</p></div></div><p class="cards-destination-url">{String(link.url)}</p>{canWrite&&<details class="cards-editor"><summary class="cards-button secondary">Preparar cambio de destino</summary><form class="cards-link-form" action="/api/admin/cards/links" method="post" data-preview-form><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={String(link.order_id)}/><input type="hidden" name="action" value="destination"/><input type="hidden" name="refId" value={String(link.destination_ref_id)}/><input type="hidden" name="revision" value={String(link.target_revision)}/><label>Nuevo destino HTTPS<input name="destination" type="url" value={String(link.url)} maxlength="2048" required data-preview-input/></label><p>Vista previa textual: <output data-preview-output>{String(link.url)}</output></p><label>Motivo<textarea name="reason" minlength="5" maxlength="500" required></textarea></label><label class="cards-confirm"><input type="checkbox" required/>Confirmo el destino y su dominio aprobado.</label><button class="cards-button" type="submit">Guardar nueva versión</button></form></details>}</section>
  <div class="cards-links-grid"><section class="cards-panel" aria-labelledby="metrics-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">APERTURAS</p><h2 id="metrics-title">Analítica individual</h2><p>Solicitudes del enlace; no personas únicas.</p></div></div><div class="cards-analytics-stats"><div><span>Total</span><strong>{total}</strong></div><div><span>Bot sospechoso</span><strong>{suspected}</strong></div></div>{byDay.length?<div class="cards-trend" role="img" tabindex="0" aria-label={`${total} aperturas registradas por día`}>{byDay.map(([day,count])=><div class="cards-trend-bar" title={`${day}: ${count} aperturas`}><span style={`height:${Math.max(3,Math.round(count/peak*100))}%`}></span><small>{day.slice(5)}</small></div>)}</div>:<p class="cards-muted">Sin aperturas registradas todavía.</p>}</section>
    <section class="cards-panel" aria-labelledby="status-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">CONTROL</p><h2 id="status-title">Estado e incidencias</h2></div></div>{canWrite&&link.status!=='retired'&&<form class="cards-link-form" action="/api/admin/cards/links" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={String(link.order_id)}/><input type="hidden" name="action" value="status"/><input type="hidden" name="linkId" value={String(link.id)}/><input type="hidden" name="revision" value={String(link.revision)}/><label>Acción<select name="status"><option value={link.status==='active'?'paused':'active'}>{link.status==='active'?'Pausar':'Reactivar'}</option><option value="retired">Retirar permanentemente</option></select></label><label>Motivo<textarea name="reason" minlength="5" maxlength="500" required></textarea></label><button class="cards-button secondary" type="submit">Confirmar estado</button></form>}{canWrite&&link.status==='retired'&&<form class="cards-link-form" action="/api/admin/cards/links" method="post"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={String(link.order_id)}/><input type="hidden" name="action" value="replace"/><input type="hidden" name="linkId" value={String(link.id)}/><input type="hidden" name="idempotencyKey" value={randomUUID()}/><p>El código retirado permanece inactivo. Su sustitución genera un código nuevo y exige reimpresión o nueva programación.</p><label>Motivo de sustitución<textarea name="reason" minlength="5" maxlength="500" required></textarea></label><button class="cards-button" type="submit">Crear código sustituto</button></form>}{incidents.length?<ul class="cards-link-list">{incidents.map(item=><li><strong>{String(item.summary)}</strong><small>{String(item.severity)}</small></li>)}</ul>:<p class="cards-muted">Sin incidencias abiertas en el pedido.</p>}<p><a href={`/admin/cards/${String(link.order_id)}#incidencias`}>Registrar o resolver incidencia ↗</a></p></section></div>
  <div class="cards-links-grid"><section class="cards-panel" aria-labelledby="history-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">TRAZABILIDAD</p><h2 id="history-title">Versiones de destino</h2></div></div><ol class="cards-link-history">{history.map(item=><li><strong>Versión {Number(item.revision)} · {String(item.action)}</strong><span>{String(item.next_url)}</span><small>{String(item.reason)} · {String(item.occurred_at)}</small>{canWrite&&Number(item.revision)!==Number(link.target_revision)&&<form action="/api/admin/cards/links" method="post" class="cards-revert-form"><input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="orderId" value={String(link.order_id)}/><input type="hidden" name="action" value="revert"/><input type="hidden" name="refId" value={String(link.destination_ref_id)}/><input type="hidden" name="historicalRevision" value={String(item.revision)}/><input type="hidden" name="revision" value={String(link.target_revision)}/><label>Motivo<input name="reason" minlength="5" maxlength="500" required/></label><button class="cards-button secondary" type="submit">Revertir a esta versión</button></form>}</li>)}</ol></section><section class="cards-panel" aria-labelledby="status-history-title"><div class="cards-section-heading"><div><p class="admin-eyebrow">TRAZABILIDAD</p><h2 id="status-history-title">Cambios de estado</h2></div></div>{statusHistory.length?<ol class="cards-link-history">{statusHistory.map(item=><li><strong>{String(item.previous_status)} → {String(item.next_status)}</strong><small>{String(item.reason)} · {String(item.occurred_at)}</small></li>)}</ol>:<p class="cards-muted">El enlace permanece en su estado inicial.</p>}</section></div>
</AdminShell>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach(button=>button.addEventListener('click',async()=>{
    const text=document.getElementById(button.dataset.copyTarget||'')?.textContent||'';
    if (!text) return;
    try { await navigator.clipboard.writeText(text); button.textContent='Copiado'; }
    catch { button.textContent='Copia manualmente la URL'; }
  }));
  document.querySelectorAll<HTMLFormElement>('[data-preview-form]').forEach(form=>{
    const input=form.querySelector<HTMLInputElement>('[data-preview-input]');
    const output=form.querySelector<HTMLOutputElement>('[data-preview-output]');
    input?.addEventListener('input',()=>{if(output)output.textContent=input.value;});
  });
</script>
