---
import AdminShell from '../../../layouts/AdminShell.astro';
import { listCardOrders } from '../../../lib/admin/cards/service';
import { stageLabels, productionStages, type ProductionStage } from '../../../lib/admin/cards/workflow';
import '../../../styles/admin-cards.css';
export const prerender = false;
const principal = Astro.locals.admin;
if (!principal) return new Response('Acceso denegado.', { status: 403 });
const filters = {
  q: Astro.url.searchParams.get('q') ?? '', status: Astro.url.searchParams.get('status') ?? '',
  from: Astro.url.searchParams.get('from') ?? '', to: Astro.url.searchParams.get('to') ?? '',
  priority: Astro.url.searchParams.get('priority') ?? '',
};
const orders = await listCardOrders(principal, filters);
const money = (value: unknown) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(Number(value || 0) / 100);
const date = (value: unknown) => value ? new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(String(value))) : '—';
const paid = orders.filter((row) => row.pagado_en && Number(row.payment_confirmed) === 1 && ['pagado','preparando','enviado','entregado'].includes(String(row.estado)));
const active = orders.filter((row) => row.stage && row.stage !== 'delivered');
const openIncidents = orders.reduce((sum, row) => sum + Number(row.open_incidents || 0), 0);
---
<AdminShell title="Cards y producción." eyebrow="ALTARIA OS / CARDS" description="Del pago confirmado a la entrega, con cada comprobación en su sitio." active="/admin/cards" principal={principal}>
  <nav class="cards-local-nav" aria-label="Navegación Cards"><a aria-current="page" href="/admin/cards">Pedidos</a><a href="/admin/cards/analitica">Analítica de enlaces</a></nav>
  <div class="cards-hero"><div><p class="admin-eyebrow">OPERACIONES · SOLO TEST</p><h2>Una vista clara para cada pedido.</h2><p>El estado de pago se conserva tal como llega de Stripe. La producción avanza por separado y deja constancia de cada acción humana.</p></div><div class="cards-hero-mark" aria-hidden="true"><span>A</span><small>CARDS</small></div></div>
  <div class="cards-stats" aria-label="Resumen de pedidos visibles"><div><span>Pedidos visibles</span><strong>{orders.length}</strong><small>Según los filtros aplicados</small></div><div><span>Pago confirmado</span><strong>{paid.length}</strong><small>Stripe test</small></div><div><span>En producción</span><strong>{active.length}</strong><small>Trabajo abierto</small></div><div><span>Incidencias abiertas</span><strong>{openIncidents}</strong><small>En estos pedidos</small></div></div>
  <section class="cards-panel" aria-labelledby="cards-orders-title">
    <div class="cards-section-heading"><div><p class="admin-eyebrow">PEDIDOS TEST</p><h2 id="cards-orders-title">Bandeja de producción</h2><p>Busca y filtra sin mezclar pedidos live.</p></div></div>
    <form class="cards-filters" method="get" action="/admin/cards" role="search">
      <label>Pedido o cliente<input type="search" name="q" value={filters.q} placeholder="Número, negocio o cliente" maxlength="100" /></label>
      <label>Producción<select name="status"><option value="">Todas las etapas</option><option value="pending" selected={filters.status === 'pending'}>Sin iniciar</option>{productionStages.map((stage) => <option value={stage} selected={filters.status === stage}>{stageLabels[stage]}</option>)}</select></label>
      <label>Prioridad<select name="priority"><option value="">Todas</option><option value="normal" selected={filters.priority === 'normal'}>Normal</option><option value="high" selected={filters.priority === 'high'}>Alta</option><option value="urgent" selected={filters.priority === 'urgent'}>Urgente</option></select></label>
      <label>Desde<input type="date" name="from" value={filters.from} /></label>
      <label>Hasta<input type="date" name="to" value={filters.to} /></label>
      <button class="cards-button" type="submit">Aplicar filtros</button>
    </form>
    {orders.length ? <div class="cards-table-wrap"><table class="cards-table"><thead><tr><th>Pedido</th><th>Cliente / empresa</th><th>Pago</th><th>Producción</th><th>Prioridad</th><th>Fecha</th><th><span class="sr-only">Abrir</span></th></tr></thead><tbody>{orders.map((order) => <tr><td><a class="cards-order-number" href={`/admin/cards/${String(order.id)}`}>{String(order.numero_pedido)}</a><span class="cards-muted">{String(order.producto_nombre)} · {Number(order.cantidad)} uds.</span></td><td><strong>{String(order.negocio_nombre)}</strong><span class="cards-muted">{order.organization_name ? String(order.organization_name) : String(order.cliente_nombre)}</span></td><td><span class:list={['cards-status', Number(order.payment_confirmed) === 1 && order.pagado_en ? 'is-paid' : 'is-pending']}>{Number(order.payment_confirmed) === 1 && order.pagado_en ? 'Confirmado' : String(order.estado).replace('_',' ')}</span><span class="cards-muted">{money(order.total_centimos)}</span></td><td><span class="cards-stage">{order.stage ? stageLabels[String(order.stage) as ProductionStage] : 'Sin iniciar'}</span>{Number(order.open_incidents) > 0 && <span class="cards-alert">{Number(order.open_incidents)} incidencia(s)</span>}</td><td><span class:list={['cards-priority', `is-${String(order.priority ?? 'normal')}`]}>{order.priority === 'urgent' ? 'Urgente' : order.priority === 'high' ? 'Alta' : 'Normal'}</span></td><td>{date(order.creado_en)}</td><td><a class="cards-row-link" href={`/admin/cards/${String(order.id)}`}>Abrir <span aria-hidden="true">↗</span></a></td></tr>)}</tbody></table></div> : <div class="cards-empty"><div class="cards-empty-icon" aria-hidden="true">A</div><h3>{Object.values(filters).some(Boolean) ? 'No hay pedidos con estos filtros.' : 'Aún no hay pedidos en TEST.'}</h3><p>{Object.values(filters).some(Boolean) ? 'Prueba con otra fecha, estado, cliente o prioridad.' : 'Los pedidos creados mediante checkout test aparecerán aquí. No se han importado pedidos reales.'}</p>{Object.values(filters).some(Boolean) && <a class="cards-button secondary" href="/admin/cards">Quitar filtros</a>}</div>}
  </section>
</AdminShell>
