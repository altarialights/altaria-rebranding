---
import FloatingHeader from '../components/hero/FloatingHeader.astro';
import ProductIcon from '../components/tarjetas/ProductIcon.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { cardsProductConfig } from '../data/cards-product';
import Base from '../layouts/Base.astro';
import '../styles/tarjetas.css';

const seoDescription = 'Tarjetas NFC y QR para facilitar reseñas de Google, reforzar la confianza y hacer más visible tu negocio.';
const contactHref = '/contacto?interes=marketing';
const googleMapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY?.trim() ?? '';
const currency = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
const initialSubtotal = cardsProductConfig.unitPrice;
const initialTotal = initialSubtotal + cardsProductConfig.shipping + cardsProductConfig.taxes;

const headerNav = [
  { label: 'Servicios', href: '/servicios' },
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Casos', href: '#negocios' },
] as const;

const businesses = [
  {
    name: 'Maña Peluqueros',
    type: 'Peluquería',
    image: 'mana',
    alt: 'Interior luminoso de Maña Peluqueros',
    rating: '4,9',
    reviews: 71,
    copy: 'La tarjeta les permite pedir una reseña justo después de cada servicio, cuando la experiencia todavía está reciente.',
  },
  {
    name: 'Como Tú',
    type: 'Peluquería y barbería',
    image: 'como-tu',
    alt: 'Interior de la peluquería y barbería Como Tú',
    rating: '4,8',
    reviews: 302,
    copy: 'Un toque o un escaneo convierte el momento de despedida en una oportunidad sencilla de pedir una reseña.',
  },
  {
    name: 'De Zamorano',
    type: 'Restaurante',
    image: 'de-zamorano',
    alt: 'Interior del restaurante De Zamorano',
    rating: '4,8',
    reviews: 352,
    copy: 'Después de una buena experiencia, sus clientes pueden llegar a la reseña de Google en segundos, sin tener que buscar el negocio.',
  },
] as const;

const process = [
  { icon: 'search', title: 'Elige tu negocio', copy: 'Localiza tu ficha de Google y confirma la información.' },
  { icon: 'edit', title: 'Completa el pedido', copy: 'Selecciona cantidad, mensaje y datos de envío.' },
  { icon: 'package', title: 'Recibe tus tarjetas', copy: 'Las preparamos y enviamos listas para colocar.' },
  { icon: 'star', title: 'Consigue reseñas', copy: 'Tus clientes acercan el móvil o escanean el QR.' },
] as const;
---

<Base
  title="Tarjetas NFC y QR para reseñas de Google | Altaria Lights"
  description={seoDescription}
  canonical="/tarjetas-reseñas-google"
>
  <FloatingHeader alwaysVisible brandHref="/" nav={headerNav} cta={{ label: 'Hablemos', href: contactHref }} />

  <main class="cards-page" id="top">
    <section class="cards-hero" aria-labelledby="cards-hero-title">
      <div class="cards-sky" aria-hidden="true">
        <span class="cards-sky__sun"></span>
        <span class="cards-sky__cloud cards-sky__cloud--one"></span>
        <span class="cards-sky__cloud cards-sky__cloud--two"></span>
      </div>

      <div class="cards-shell cards-hero__inner">
        <div class="cards-hero__copy">
          <p class="cards-eyebrow"><span><ProductIcon icon="sparkle" size={15} /></span> Producto Altaria</p>
          <h1 id="cards-hero-title">Convierte cada visita en una reseña.</h1>
          <p class="cards-hero__lead">Tarjetas NFC + QR para que valorar tu negocio sea tan fácil como acercar el móvil.</p>
          <div class="cards-hero__actions">
            <a class="cards-button" href="#configurador"><span>Configura tu pedido</span><ProductIcon icon="arrow" size={19} /></a>
            <a class="cards-button cards-button--ghost" href="#como-funciona">Ver cómo funciona</a>
          </div>
          <ul class="cards-hero__checks" aria-label="Ventajas del producto">
            <li><ProductIcon icon="check" size={16} /> Sin apps</li>
            <li><ProductIcon icon="check" size={16} /> Listas para usar</li>
            <li><ProductIcon icon="check" size={16} /> NFC + QR</li>
          </ul>
        </div>

        <div class="cards-hero__visual">
          <span class="cards-hero__orbit" aria-hidden="true"></span>
          <picture>
            <source srcset="/media/tarjetas/optimized/hero-560.webp 560w, /media/tarjetas/optimized/hero-900.webp 900w" sizes="(max-width: 699px) 94vw, (max-width: 1019px) 70vw, 46vw" type="image/webp" />
            <img src="/media/tarjetas/optimized/hero-900.webp" width="900" height="1125" alt="Dos tarjetas NFC y QR de Altaria Lights para solicitar reseñas de Google" fetchpriority="high" decoding="async" />
          </picture>
          <div class="cards-hero__note cards-hero__note--tap"><span><ProductIcon icon="tap" size={20} /></span><strong>Un toque</strong><small>para abrir Google</small></div>
          <div class="cards-hero__note cards-hero__note--ready"><span><ProductIcon icon="star" size={18} /></span><strong>Siempre listas</strong><small>en el punto de venta</small></div>
        </div>
      </div>
    </section>

    <section class="cards-trust" aria-label="Confianza en el producto">
      <div class="cards-shell cards-trust__grid">
        <div><strong>NFC + QR</strong><span>Dos formas de conectar</span></div>
        <div><strong>Diseño Altaria</strong><span>Una presencia clara y cuidada</span></div>
        <div><strong>Listas para usar</strong><span>Sin apps ni configuraciones</span></div>
        <div><strong>Soporte Altaria</strong><span>Te acompañamos en el proceso</span></div>
      </div>
    </section>

    <section class="cards-section cards-builder" id="configurador" aria-labelledby="builder-title">
      <div class="cards-shell">
        <header class="cards-heading cards-heading--center">
          <p class="cards-eyebrow">Tu pedido, paso a paso</p>
          <h2 id="builder-title">Prepara tus tarjetas</h2>
          <p>Completa el pedido y revisa cada detalle antes de abrir el pago seguro de Stripe.</p>
        </header>

        <form class="cards-builder__grid ph-no-capture" data-card-builder data-google-maps-api-key={googleMapsApiKey} data-ph-no-replay data-ph-sensitive novalidate>
          <section class="builder-panel builder-business" aria-labelledby="business-title">
            <div class="builder-panel__heading"><span>01</span><div><h3 id="business-title">Encuentra tu negocio</h3><p>Usaremos los datos públicos de tu ficha.</p></div></div>
            <div class="builder-autocomplete" data-place-autocomplete>
              <label class="builder-search" for="business-search">
                <span class="u-visually-hidden">Buscar negocio en Google Maps</span>
                <ProductIcon icon="search" size={18} />
                <input
                  id="business-search"
                  type="search"
                  placeholder="Nombre de tu negocio"
                  autocomplete="off"
                  role="combobox"
                  aria-autocomplete="list"
                  aria-expanded="false"
                  aria-controls="business-suggestions"
                  aria-activedescendant=""
                  data-business-search
                />
                <span class="builder-search__loader" aria-hidden="true" data-search-loader></span>
              </label>
              <div class="builder-suggestions" data-suggestions-popover hidden>
                <ul id="business-suggestions" role="listbox" aria-label="Negocios encontrados" data-business-suggestions></ul>
                <div class="builder-suggestions__attribution" data-google-attribution hidden></div>
              </div>
              <p class="builder-search__status" role="status" aria-live="polite" data-search-status></p>
            </div>
            <div class="builder-map" aria-label="Referencia visual de ubicación" data-place-map>
              <span class="builder-map__road builder-map__road--one"></span>
              <span class="builder-map__road builder-map__road--two"></span>
              <span class="builder-map__road builder-map__road--three"></span>
              <span class="builder-map__park"></span>
              <span class="builder-map__pin"><ProductIcon icon="pin" size={25} /></span>
            </div>
            <article class="builder-place" data-selected-place aria-live="polite">
              <span class="builder-place__logo"><img src="/brand/optimized/altaria-v2-normal-azul-128.webp" width="128" height="128" alt="" /></span>
              <div><strong data-place-name>Tu negocio</strong><small data-place-address>Selecciona tu ficha de Google</small><span data-place-state>Pendiente de seleccionar</span></div>
              <span class="builder-place__check"><ProductIcon icon="check" size={16} /></span>
            </article>
            <input type="hidden" name="placeId" data-place-field="placeId" />
            <input type="hidden" name="placeDisplayName" data-place-field="displayName" />
            <input type="hidden" name="placeFormattedAddress" data-place-field="formattedAddress" />
            <input type="hidden" name="placeGoogleMapsURI" data-place-field="googleMapsURI" />
            <p class="builder-helper"><ProductIcon icon="shield" size={18} /> No publicaremos ni modificaremos nada en tu ficha de Google.</p>
          </section>

          <section class="builder-panel builder-options" aria-labelledby="options-title">
            <div class="builder-panel__heading"><span>02</span><div><h3 id="options-title">Configura tu pedido</h3><p>Elige cantidad y completa el envío.</p></div></div>
            <fieldset class="builder-quantity">
              <legend>Cantidad</legend>
              <div>
                <button class="is-active" type="button" data-quantity="1" aria-pressed="true"><strong>1</strong><small>unidad</small></button>
                <button type="button" data-quantity="5" aria-pressed="false"><strong>5</strong><small>unidades</small></button>
                <button type="button" data-quantity="10" aria-pressed="false"><strong>10</strong><small>unidades</small></button>
                <button type="button" data-quantity-custom aria-pressed="false"><strong>Personalizada</strong><small>elige la cantidad</small></button>
              </div>
              <div class="builder-custom-quantity" data-custom-quantity-panel hidden>
                <label for="custom-quantity">¿Cuántas necesitas?</label>
                <input id="custom-quantity" type="number" min="1" step="1" inputmode="numeric" placeholder="Ej. 20" aria-describedby="custom-quantity-error" data-custom-quantity />
                <p id="custom-quantity-error" data-custom-quantity-error></p>
              </div>
              <p>Mismo precio por unidad para todas las cantidades.</p>
            </fieldset>
            <div class="builder-fields">
              <label class="builder-field builder-field--wide"><span>Nombre completo</span><input name="customerName" type="text" autocomplete="name" minlength="2" maxlength="120" placeholder="Nombre y apellidos" required data-required-field /></label>
              <label class="builder-field builder-field--wide"><span>Email</span><input name="customerEmail" type="email" autocomplete="email" maxlength="254" placeholder="nombre@empresa.com" required data-required-field /></label>
              <label class="builder-field"><span>Teléfono</span><input name="customerPhone" type="tel" autocomplete="tel" minlength="7" maxlength="32" placeholder="+34 600 000 000" required data-required-field /></label>
              <label class="builder-field"><span>Código postal</span><input name="shippingPostalCode" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" placeholder="28001" required data-required-field /></label>
              <label class="builder-field builder-field--wide"><span>Dirección de envío</span><input name="shippingAddress" type="text" autocomplete="address-line1" maxlength="220" placeholder="Calle y número" required data-required-field /></label>
              <label class="builder-field builder-field--wide"><span>Piso, puerta o local <em>opcional</em></span><input name="shippingAddressExtra" type="text" autocomplete="address-line2" maxlength="120" placeholder="Piso, puerta, bloque…" /></label>
              <label class="builder-field"><span>Ciudad</span><input name="shippingCity" type="text" autocomplete="address-level2" maxlength="120" placeholder="Madrid" required data-required-field /></label>
              <label class="builder-field"><span>Provincia</span><input name="shippingProvince" type="text" autocomplete="address-level1" maxlength="120" placeholder="Madrid" required data-required-field /></label>
              <label class="builder-field builder-field--wide"><span>Referencia de entrega <em>opcional</em></span><input name="shippingReference" type="text" maxlength="220" placeholder="Horario o indicaciones para la entrega" /></label>
              <input name="shippingCountry" type="hidden" value="ES" />
            </div>
          </section>

          <section class="builder-panel builder-summary" aria-labelledby="summary-title">
            <div class="builder-panel__heading"><span>03</span><div><h3 id="summary-title">Resumen</h3><p>Pago seguro en modo prueba.</p></div></div>
            <div class="builder-summary__product">
              <img src="/media/tarjetas/optimized/tarjeta-320.webp" width="320" height="427" alt="Tarjeta NFC y QR" loading="lazy" decoding="async" />
              <div><strong>Tarjeta NFC + QR</strong><span>Diseño Altaria</span><small>Lista para usar</small></div>
            </div>
            <dl class="builder-summary__prices">
              <div><dt>Negocio</dt><dd data-summary-business>Pendiente</dd></div>
              <div><dt>Cantidad</dt><dd><span data-summary-quantity>1</span> <span data-summary-unit>unidad</span></dd></div>
              <div><dt>Precio unitario</dt><dd data-unit-price>{currency.format(cardsProductConfig.unitPrice)}</dd></div>
              <div><dt>Subtotal</dt><dd data-summary-subtotal>{currency.format(initialSubtotal)}</dd></div>
              <div><dt>Envío estimado</dt><dd>{currency.format(cardsProductConfig.shipping)}</dd></div>
              <div><dt>Impuestos</dt><dd data-tax>{currency.format(cardsProductConfig.taxes)}</dd></div>
              <div class="builder-summary__total"><dt>Total</dt><dd data-total>{currency.format(initialTotal)}</dd></div>
            </dl>
            <p class="builder-summary__notice">El servidor recalcula todos los importes antes de abrir Stripe. No se aplica fiscalidad automática en esta fase de pruebas.</p>
            <button class="cards-button builder-summary__cta" type="submit" data-builder-submit><span data-builder-submit-label>Pagar con Stripe (prueba)</span><ProductIcon icon="arrow" size={19} /></button>
            <span class="builder-summary__secure"><ProductIcon icon="shield" size={17} /> Checkout alojado y seguro de Stripe · test mode</span>
            <p class="builder-form-status" role="status" aria-live="polite" data-builder-status></p>
          </section>

          <aside class="builder-panel builder-preview" aria-labelledby="preview-title">
            <div class="builder-panel__heading"><span>04</span><div><h3 id="preview-title">Vista previa</h3><p>Así la verán tus clientes.</p></div></div>
            <div class="builder-preview__stage">
              <img src="/media/tarjetas/optimized/tarjeta-520.webp" width="520" height="693" alt="Vista previa de una tarjeta NFC y QR para reseñas de Google" loading="lazy" decoding="async" />
            </div>
            <div class="builder-preview__closing">
              <p>Lista para que cada buena experiencia se convierta en el reconocimiento que tu negocio merece.</p>
              <small>Tus clientes solo tienen que acercar el móvil o escanear el QR.</small>
            </div>
          </aside>
        </form>
      </div>
    </section>

    <section class="cards-section cards-businesses" id="negocios" aria-labelledby="businesses-title">
      <div class="cards-shell">
        <header class="cards-heading cards-heading--split">
          <div><p class="cards-eyebrow">En el mundo real</p><h2 id="businesses-title">Negocios que ya destacan</h2></div>
          <p>Una solución pensada para espacios donde cada buena experiencia puede convertirse en confianza visible.</p>
        </header>
        <div class="cards-businesses__grid">
          {businesses.map((business) => (
            <article class="cards-business-card">
              <picture>
                <source srcset={`/media/tarjetas/optimized/${business.image}-480.webp 480w, /media/tarjetas/optimized/${business.image}-760.webp 760w`} sizes="(max-width: 699px) 92vw, (max-width: 1019px) 45vw, 30vw" type="image/webp" />
                <img src={`/media/tarjetas/optimized/${business.image}-760.webp`} width="760" height="570" alt={business.alt} loading="lazy" decoding="async" />
              </picture>
              <div>
                <span>{business.type}</span>
                <h3>{business.name}</h3>
                <div class="cards-business-card__rating" aria-label={`${business.rating} sobre 5 · ${business.reviews} reseñas en Google`}>
                  <strong>{business.rating}</strong><b aria-hidden="true">★★★★★</b><small>{business.reviews} reseñas en Google</small>
                </div>
                <p>{business.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

   <section class="cards-section cards-process" id="como-funciona" aria-labelledby="process-title">
      <div class="cards-shell">
        <header class="cards-heading cards-heading--center">
          <p class="cards-eyebrow">Claro y sin complicaciones</p>
          <h2 id="process-title">De tu ficha a nuevas reseñas</h2>
          <p>Nos encargamos de dejarlo todo preparado para que tú solo tengas que colocar las tarjetas.</p>
        </header>
        <ol class="cards-process__grid">
          {process.map((step, index) => (
            <li>
              <span class="cards-process__number">{index + 1}</span>
              <span class="cards-process__icon"><ProductIcon icon={step.icon} size={30} /></span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </li>
          ))}
        </ol>
        <p class="cards-process__foot"><ProductIcon icon="tap" size={22} /><strong>Sin apps. Sin instrucciones largas.</strong> Acercar el móvil o escanear: eso es todo.</p>
      </div>
    </section>

    <section class="cards-section cards-faq" aria-labelledby="faq-title">
      <div class="cards-shell cards-faq__layout">
        <header class="cards-heading">
          <p class="cards-eyebrow">Resolvemos tus dudas</p>
          <h2 id="faq-title">Preguntas frecuentes</h2>
          <p>Si tu caso necesita algo distinto, cuéntanoslo y buscaremos la mejor forma de resolverlo.</p>
          <a class="cards-text-link" href={contactHref}>Hablar con Altaria <ProductIcon icon="arrow" size={18} /></a>
        </header>
        <div class="cards-faq__list" data-cards-faq>
          <article class="cards-faq__item is-open">
            <button type="button" id="faq-button-1" aria-expanded="true" aria-controls="faq-panel-1">¿Cuánto tarda el envío?<span aria-hidden="true">+</span></button>
            <div id="faq-panel-1" role="region" aria-labelledby="faq-button-1" data-faq-panel><div><p>El plazo final dependerá de la cantidad. Lo confirmaremos contigo antes de preparar el pedido.</p></div></div>
          </article>
          <article class="cards-faq__item">
            <button type="button" id="faq-button-2" aria-expanded="false" aria-controls="faq-panel-2">¿Qué incluye el pedido?<span aria-hidden="true">+</span></button>
            <div id="faq-panel-2" role="region" aria-labelledby="faq-button-2" data-faq-panel hidden><div><p>Las tarjetas NFC + QR, la configuración del acceso a tu ficha y una comprobación técnica antes de preparar el pedido.</p></div></div>
          </article>
          <article class="cards-faq__item">
            <button type="button" id="faq-button-3" aria-expanded="false" aria-controls="faq-panel-3">¿Sirve para cualquier negocio?<span aria-hidden="true">+</span></button>
            <div id="faq-panel-3" role="region" aria-labelledby="faq-button-3" data-faq-panel hidden><div><p>Sí, siempre que el negocio tenga una ficha pública de Google donde sus clientes puedan dejar una reseña.</p></div></div>
          </article>
          <article class="cards-faq__item">
            <button type="button" id="faq-button-4" aria-expanded="false" aria-controls="faq-panel-4">¿Se puede actualizar más adelante?<span aria-hidden="true">+</span></button>
            <div id="faq-panel-4" role="region" aria-labelledby="faq-button-4" data-faq-panel hidden><div><p>La configuración queda preparada para gestionar cambios futuros. Te indicaremos qué ajustes admite cada pedido.</p></div></div>
          </article>
          <article class="cards-faq__item">
            <button type="button" id="faq-button-5" aria-expanded="false" aria-controls="faq-panel-5">¿Necesita una app?<span aria-hidden="true">+</span></button>
            <div id="faq-panel-5" role="region" aria-labelledby="faq-button-5" data-faq-panel hidden><div><p>No. Un móvil compatible puede acercarse a la tarjeta y cualquier cámara puede escanear el código QR.</p></div></div>
          </article>
        </div>
      </div>
    </section>

    

    
  </main>

  <SiteFooter />
</Base>

<script>
  import { initCardsProductPage } from '../scripts/cards-product-page';
  initCardsProductPage();
</script>
