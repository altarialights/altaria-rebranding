---
import '../../../styles/fonts.css';
import '../../../styles/contact-card-navaluenga.css';
import Icon from '../../../components/contact/ContactCardIcon.astro';
import profile from '../../../data/contact-cards/navaluenga.json';

const canonical = new URL(profile.path, Astro.site);
const description = `${profile.name}. ${profile.title} y ${profile.secondaryTitle}. Teléfono, correo y tarjeta de contacto.`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#073d83" />
    <title>{profile.name} · {profile.organization}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={profile.logo} />
    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={`${profile.name} · ${profile.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(profile.contactPhoto, Astro.site)} />
    <meta property="og:image:alt" content={`Retrato de ${profile.name}`} />
  </head>
  <body>
    <a class="skip-link" href="#contacto">Ir al contacto</a>
    <div class="page-shell">
      <header class="page-header">
        <a class="municipality" href={profile.website} target="_blank" rel="noopener noreferrer">
          <span class="municipality-icon"><Icon name="building" /></span>
          <span><span class="eyebrow">Ayuntamiento de</span><strong>Navaluenga</strong></span>
        </a>
        <span class="header-location"><Icon name="pin" /> Ávila, España</span>
      </header>

      <main id="contacto">
        <article class="contact-card" aria-labelledby="contact-name">
          <div class="portrait-panel">
            <img class="portrait" src={profile.photo} alt={`Retrato de ${profile.name}`} width="467" height="700" fetchpriority="high" />
            <div class="portrait-shade"></div>
            <div class="portrait-caption">
              <span class="portrait-line"></span>
              <span>Navaluenga<span class="portrait-caption-sub">Ayuntamiento · Ávila</span></span>
            </div>
            <span class="portrait-label">TARJETA DE CONTACTO</span>
          </div>

          <div class="contact-content">
            <div class="profile-topline">
              <span class="eyebrow">Representación institucional</span>
              <img class="party-logo" src={profile.logo} width="64" height="45" alt={profile.party} />
            </div>
            <h1 id="contact-name">{profile.givenName}{' '}<span>{profile.familyName}<span class="name-dot" aria-hidden="true">.</span></span></h1>
            <p class="position">{profile.title}</p>
            <p class="secondary-position">{profile.secondaryTitle}</p>
            <div class="department"><span></span><p>Asuntos Europeos,<br />Energía y Turismo</p></div>

            <div class="contact-links" aria-label="Datos de contacto">
              <a class="contact-row" href={`tel:${profile.phone}`}>
                <span class="contact-icon"><Icon name="phone" /></span>
                <span class="contact-detail"><span class="contact-label">Teléfono</span><strong>{profile.phoneDisplay}</strong></span>
                <span class="row-arrow"><Icon name="arrow" /></span>
              </a>
              <a class="contact-row" href={`mailto:${profile.email}`}>
                <span class="contact-icon"><Icon name="mail" /></span>
                <span class="contact-detail"><span class="contact-label">Correo electrónico</span><strong class="email">{profile.email}</strong></span>
                <span class="row-arrow"><Icon name="arrow" /></span>
              </a>
            </div>

            <div class="primary-actions">
              <a class="save-contact" href={`${profile.path}.vcf`} download="armando-garcia-cuenca.vcf"><Icon name="download" /> Guardar contacto <Icon name="arrow" /></a>
              <button class="share-contact" type="button" aria-label="Compartir tarjeta de contacto" data-share hidden><Icon name="share" /></button>
            </div>
            <p class="save-hint">Sus datos, siempre a mano en tu agenda.</p>
            <a class="website-link" href={profile.website} target="_blank" rel="noopener noreferrer"><Icon name="globe" /> Web del Ayuntamiento <Icon name="arrow" /></a>
          </div>
        </article>
      </main>
      <footer class="page-footer">
        <span>{profile.organization}</span>
        <a href="/" aria-label="Altaria Lights, creador de esta tarjeta">Una conexión de <strong>ALTARIA</strong><span aria-hidden="true"> ↗</span></a>
      </footer>
    </div>

    <dialog class="share-dialog" aria-labelledby="share-title">
      <button class="close-dialog" type="button" aria-label="Cerrar"><Icon name="close" /></button>
      <span class="eyebrow">Siempre conectados</span>
      <h2 id="share-title">Comparte el contacto.</h2>
      <p>Escanea el QR o envía el enlace de esta tarjeta.</p>
      <img class="share-qr" width="240" height="240" alt="Código QR para abrir la tarjeta de Armando García Cuenca" hidden />
      <button class="copy-link" type="button"><Icon name="copy" /> Copiar enlace</button>
      <button class="native-share" type="button" hidden><Icon name="share" /> Compartir con…</button>
      <p class="share-status" role="status" aria-live="polite"></p>
      <input class="share-url" type="text" readonly aria-label="Enlace de la tarjeta para copiar manualmente" hidden />
    </dialog>
    <script>
      const trigger = document.querySelector<HTMLButtonElement>('[data-share]');
      const dialog = document.querySelector<HTMLDialogElement>('.share-dialog');
      const close = document.querySelector<HTMLButtonElement>('.close-dialog');
      const copy = document.querySelector<HTMLButtonElement>('.copy-link');
      const native = document.querySelector<HTMLButtonElement>('.native-share');
      const status = document.querySelector<HTMLElement>('.share-status');
      const qr = document.querySelector<HTMLImageElement>('.share-qr');
      const urlInput = document.querySelector<HTMLInputElement>('.share-url');
      const url = new URL(window.location.pathname, window.location.origin).href;
      if (trigger && dialog && close && copy && native && status && qr && urlInput) {
        trigger.hidden = false;
        trigger.addEventListener('click', async () => {
          status.textContent = '';
          dialog.showModal();
          try {
            const { default: QRCode } = await import('qrcode');
            qr.src = await QRCode.toDataURL(url, { width: 480, margin: 2, color: { dark: '#062c60', light: '#ffffff' } });
            qr.hidden = false;
          } catch {
            status.textContent = 'Puedes compartir la tarjeta copiando el enlace.';
          }
        });
        close.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            status.textContent = 'Enlace copiado. Ya puedes compartirlo.';
          } catch {
            urlInput.value = url;
            urlInput.hidden = false;
            urlInput.focus();
            urlInput.select();
            status.textContent = 'Selecciona y copia este enlace.';
          }
        });
        if (navigator.share) {
          native.hidden = false;
          native.addEventListener('click', async () => {
            try {
              await navigator.share({ title: 'Armando García Cuenca · Ayuntamiento de Navaluenga', url });
            } catch (error) {
              if (!(error instanceof DOMException && error.name === 'AbortError')) status.textContent = 'Puedes compartir la tarjeta copiando el enlace.';
            }
          });
        }
      }
    </script>
  </body>
</html>
