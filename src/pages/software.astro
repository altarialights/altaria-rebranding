---
import FloatingHeader from '../components/hero/FloatingHeader.astro';
import ServiceInterestTracker from '../components/contact/ServiceInterestTracker.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import SoftwareIcon from '../components/software/SoftwareIcon.astro';
import Base from '../layouts/Base.astro';
import { createServiceSchema } from '../lib/seo';

const contactHref = '/contacto?interes=software';
const seoDescription = 'Creamos software a medida y automatizaciones para ahorrar tiempo, reducir errores, centralizar información y mejorar los procesos de tu empresa.';
const serviceSchema = createServiceSchema(
  Astro.site ?? new URL(Astro.url.origin),
  '/software',
  'Software a medida para empresas',
  seoDescription,
  'Software a medida, automatización y digitalización de procesos',
);

const headerNav = [
  { label: 'Servicios', href: '/servicios' },
  { label: 'Caso real', href: '/proyectos/de-zamorano' },
  { label: 'Proceso', href: '/#como-funciona' },
] as const;

const processSteps = [
  { number: '01', asset: '/media/marketing/optimized/step-1', fallback: '/media/marketing/optimized/step-1-420.webp', title: 'Hablamos contigo', description: 'Conocemos tu negocio, tus procesos, problemas y objetivos.' },
  { number: '02', asset: '/media/marketing/optimized/step-2', fallback: '/media/marketing/optimized/step-2-420.webp', title: 'Entendemos tus objetivos', description: 'Analizamos cómo trabajas y dónde existen oportunidades reales de mejora.' },
  { number: '03', asset: '/media/marketing/optimized/step-3', fallback: '/media/marketing/optimized/step-3-420.webp', title: 'Te asesoramos', description: 'Proponemos la solución, la tecnología y las automatizaciones adecuadas.' },
  { number: '04', asset: '/media/marketing/optimized/step-4', fallback: '/media/marketing/optimized/step-4-420.webp', title: 'Diseñamos la solución', description: 'Definimos funcionalidades, flujos, arquitectura, experiencia y plan de desarrollo.' },
  { number: '05', asset: '/media/web/optimized/step-5', fallback: '/media/web/optimized/step-5-420.webp', title: 'Primera mitad', description: 'Con el alcance aprobado, se abona el 50% inicial y comenzamos.' },
  { number: '06', asset: '/media/web/optimized/step-6', fallback: '/media/web/optimized/step-6-420.webp', title: 'Desarrollamos', description: 'Construimos un software sólido, seguro y ajustado a tus necesidades.' },
  { number: '07', asset: '/media/web/optimized/step-7', fallback: '/media/web/optimized/step-7-420.webp', title: 'Revisamos y modificamos', description: 'Probamos el sistema contigo, recogemos feedback y realizamos los ajustes.' },
  { number: '08', asset: '/media/marketing/optimized/step-5', fallback: '/media/marketing/optimized/step-5-420.webp', title: 'Segunda mitad y despliegue', description: 'Se abona el 50% restante y desplegamos, configuramos y entregamos tu software.' },
] as const;

const comparison = {
  without: [
    'Procesos manuales y repetitivos',
    'Errores frecuentes',
    'Información dispersa',
    'Datos desactualizados',
    'Dificultad para saber qué ocurre realmente',
    'Decisiones a ciegas',
    'Pérdida de tiempo y recursos',
    'Administración innecesaria',
    'Equipo frustrado y desmotivado',
    'Crecimiento limitado y desordenado',
  ],
  with: [
    'Procesos automatizados',
    'Menos errores y más precisión',
    'Toda la información centralizada',
    'Datos actualizados y accesibles',
    'Mayor control sobre el negocio',
    'Decisiones basadas en datos',
    'Ahorro de tiempo y recursos',
    'Equipos más productivos',
    'Menos tareas repetitivas',
    'Procesos claros y preparados para crecer',
  ],
} as const;

const solutions = [
  { icon: 'web', title: 'Aplicaciones web', description: 'Plataformas personalizadas, accesibles desde cualquier dispositivo y navegador.' },
  { icon: 'management', title: 'Sistemas de gestión', description: 'ERP, CRM y herramientas para organizar clientes, productos, facturación y operaciones.' },
  { icon: 'automation', title: 'Automatizaciones', description: 'Conectamos procesos y eliminamos tareas repetitivas para ahorrar tiempo.' },
  { icon: 'dashboard', title: 'Dashboards e informes', description: 'Datos claros y actualizados para tomar mejores decisiones en menos tiempo.' },
  { icon: 'mobile', title: 'Aplicaciones móviles', description: 'Apps para iOS y Android adaptadas a tu negocio y a tus clientes.' },
  { icon: 'integration', title: 'Integraciones', description: 'Conectamos tu software con pasarelas de pago, envíos, contabilidad y más.' },
  { icon: 'portal', title: 'Portales para clientes', description: 'Espacios privados para consultar, solicitar y gestionar información de forma autónoma.' },
  { icon: 'support', title: 'Soporte y evolución', description: 'Mantenimiento, soporte técnico y nuevas funcionalidades para seguir creciendo.' },
] as const;

const benefits = [
  { asset: 1, title: 'Más control', description: 'Tu negocio, sus procesos y su información en un mismo lugar.' },
  { asset: 2, title: 'Mejores decisiones', description: 'Información clara y actualizada para elegir el siguiente paso.' },
  { asset: 3, title: 'Más eficiencia', description: 'Automatizas procesos y eliminas tareas innecesarias.' },
  { asset: 4, title: 'Más rentabilidad', description: 'Reduces errores, costes y tiempo dedicado a gestionar.' },
  { asset: 5, title: 'Equipo más contento', description: 'Menos frustración y mejores herramientas para trabajar.' },
  { asset: 6, title: 'Escalable', description: 'El software evoluciona contigo sin limitar tus próximos pasos.' },
] as const;
---

<Base
  title="Software a Medida para Empresas | Altaria Lights"
  description={seoDescription}
  canonical="/software"
  schema={serviceSchema}
>
  <ServiceInterestTracker interest="software" />
  <FloatingHeader alwaysVisible brandHref="/" nav={headerNav} cta={{ label: 'Hablemos', href: contactHref }} />

  <main class="software-page" id="top">
    <section class="software-hero" aria-labelledby="software-hero-title">
      <div class="software-sky" aria-hidden="true">
        <span class="software-sky__sun"></span>
        <span class="software-sky__haze"></span>
        <span class="software-sky__clouds software-sky__clouds--far"></span>
        <span class="software-sky__clouds software-sky__clouds--near"></span>
      </div>

      <div class="software-hero__inner">
        <div class="software-hero__cloud">
          <svg viewBox="0 0 900 650" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="software-cloud-fill" gradientUnits="userSpaceOnUse" x1="0" y1="70" x2="0" y2="620">
                <stop offset="0" stop-color="#fff" />
                <stop offset=".55" stop-color="#fafdff" />
                <stop offset="1" stop-color="#e6f1fa" />
              </linearGradient>
              <radialGradient id="software-cloud-sheen" gradientUnits="userSpaceOnUse" cx="315" cy="168" r="315">
                <stop offset="0" stop-color="#fff" stop-opacity=".88" />
                <stop offset="1" stop-color="#fff" stop-opacity="0" />
              </radialGradient>
            </defs>
            <g fill="url(#software-cloud-fill)">
              <ellipse cx="450" cy="385" rx="330" ry="200" />
              <ellipse cx="205" cy="390" rx="180" ry="150" />
              <ellipse cx="315" cy="255" rx="184" ry="175" />
              <ellipse cx="485" cy="210" rx="210" ry="190" />
              <ellipse cx="680" cy="320" rx="205" ry="180" />
              <ellipse cx="300" cy="500" rx="190" ry="120" />
              <ellipse cx="495" cy="520" rx="230" ry="122" />
              <ellipse cx="680" cy="490" rx="178" ry="116" />
            </g>
            <g fill="url(#software-cloud-sheen)" opacity=".72">
              <ellipse cx="305" cy="220" rx="118" ry="92" />
              <ellipse cx="460" cy="170" rx="145" ry="100" />
            </g>
          </svg>

          <div class="software-hero__copy">
            <p class="software-eyebrow">Software a medida</p>
            <h1 id="software-hero-title"><span>Software que optimiza</span><span>tu negocio y lo lleva</span><span>al siguiente nivel.</span></h1>
            <p>Desarrollamos soluciones a medida que automatizan, organizan y hacen crecer tu empresa.</p>
            <a class="software-button" href={contactHref} data-software-cta="hero">
              <span>Hablemos de tu proyecto</span><span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <picture class="software-hero__visual">
          <source srcset="/media/software/optimized/hero-720.webp 720w, /media/software/optimized/hero-1200.webp 1200w" sizes="(max-width: 699px) 102vw, (max-width: 1019px) 88vw, 50vw" type="image/webp" />
          <img src="/media/software/optimized/hero-1200.webp" width="1448" height="1086" alt="Composición tridimensional de software a medida con paneles de datos, automatización y un cohete" decoding="async" fetchpriority="high" />
        </picture>
      </div>
    </section>

    <div class="software-hero-transition" aria-hidden="true">
      <svg viewBox="0 0 1900 160" preserveAspectRatio="none"><path d="M0 0H1900V72C1795 72 1740 105 1640 96C1540 86 1490 62 1385 78C1270 96 1190 113 1070 91C960 70 870 66 760 87C650 108 560 102 455 82C345 62 250 72 160 96C92 114 42 108 0 94V0Z" /></svg>
    </div>

    <div class="software-content">
      <section class="software-panel software-process" aria-labelledby="software-process-title">
        <header class="software-heading">
          <p class="software-eyebrow">Un recorrido compartido</p>
          <h2 id="software-process-title">Cómo trabajamos contigo</h2>
          <p>Un proceso claro y colaborativo para crear un software que funcione de verdad.</p>
        </header>
        <ol class="software-process__grid">
          {processSteps.map((step) => (
            <li class="software-process__card">
              <picture class="software-process__asset">
                <source srcset={`${step.asset}-240.webp 240w, ${step.asset}-420.webp 420w`} sizes="(max-width: 699px) 105px, (max-width: 1019px) 130px, 135px" type="image/webp" />
                <img src={step.fallback} width="1254" height="1254" alt="" loading="lazy" decoding="async" />
              </picture>
              <span class="software-process__number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))}
        </ol>
        <p class="software-process__note"><span aria-hidden="true">★</span> Después, si lo necesitas, seguimos contigo mediante mantenimiento, soporte, actualizaciones y nuevas mejoras.</p>
      </section>

      <section class="software-panel software-comparison" aria-labelledby="software-comparison-title">
        <header class="software-heading">
          <p class="software-eyebrow">Más claridad, menos fricción</p>
          <h2 id="software-comparison-title">¿Por qué un buen software marca la diferencia?</h2>
          <p>La diferencia entre trabajar a ciegas o tener el control de tu negocio.</p>
        </header>

        <div class="software-comparison__grid">
          <article class="software-comparison__side software-comparison__side--without">
            <h3>Sin un buen software <span aria-hidden="true">×</span></h3>
            <div class="software-comparison__body">
              <figure>
                <img src="/media/software/optimized/triste-640.webp" srcset="/media/software/optimized/triste-360.webp 360w, /media/software/optimized/triste-640.webp 640w" sizes="(max-width: 699px) 72vw, (max-width: 1019px) 38vw, 330px" width="640" height="640" alt="Representación conceptual de una persona saturada por procesos manuales" loading="lazy" decoding="async" />
              </figure>
              <ul>{comparison.without.map((item) => <li>{item}</li>)}</ul>
            </div>
          </article>

          <span class="software-comparison__vs" aria-hidden="true">VS</span>

          <article class="software-comparison__side software-comparison__side--with">
            <h3>Con un software a medida <span aria-hidden="true">✓</span></h3>
            <div class="software-comparison__body software-comparison__body--reverse">
              <ul>{comparison.with.map((item) => <li>{item}</li>)}</ul>
              <figure>
                <img src="/media/software/optimized/contento-640.webp" srcset="/media/software/optimized/contento-360.webp 360w, /media/software/optimized/contento-640.webp 640w" sizes="(max-width: 699px) 72vw, (max-width: 1019px) 38vw, 330px" width="640" height="640" alt="Representación conceptual de una persona trabajando con información organizada" loading="lazy" decoding="async" />
              </figure>
            </div>
          </article>
        </div>
        <p class="software-comparison__note">Representaciones conceptuales para explicar una mejora operativa; no corresponden a clientes ni resultados concretos.</p>
        <p class="software-comparison__conclusion"><span aria-hidden="true">★</span> Automatizar y centralizar tu negocio no es un gasto: es una inversión para reducir fricción, ganar control y preparar tu crecimiento.</p>
      </section>

      <section class="software-solutions" aria-labelledby="software-solutions-title">
        <header class="software-heading">
          <p class="software-eyebrow">Tecnología que se adapta</p>
          <h2 id="software-solutions-title">¿Qué podemos desarrollar para ti?</h2>
          <p>Soluciones a medida para hacer tu negocio más eficiente, rentable y preparado para crecer. Si aún no sabes dónde está la principal fricción, puedes <a href="/medir-nivel-digital">medir el nivel digital de tu empresa</a> antes de priorizar una solución.</p>
        </header>
        <div class="software-solutions__grid">
          {solutions.map((solution) => (
            <article class="software-solutions__card">
              <span><SoftwareIcon icon={solution.icon} /></span>
              <div><h3>{solution.title}</h3><p>{solution.description}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="software-panel software-budget" aria-labelledby="software-budget-title">
        <picture class="software-budget__asset">
          <source srcset="/media/software/optimized/beneficio-3-180.webp 180w, /media/software/optimized/beneficio-3-320.webp 320w" sizes="(max-width: 699px) 72vw, (max-width: 1019px) 38vw, 390px" type="image/webp" />
          <img src="/media/software/optimized/beneficio-3-320.webp" width="1254" height="1254" alt="Ilustración de crecimiento, datos y automatización" loading="lazy" decoding="async" />
        </picture>
        <div class="software-budget__copy">
          <p class="software-eyebrow">Una propuesta para ti</p>
          <h2 id="software-budget-title">Presupuesto a medida</h2>
          <strong>No hay un precio mínimo fijo.</strong>
          <p>Cada negocio es único. Adaptamos la propuesta a tus objetivos, necesidades y presupuesto.</p>
          <p>El importe depende de la complejidad, funcionalidades, integraciones, nivel de personalización y acompañamiento que necesites.</p>
          <aside><span aria-hidden="true">i</span><p>Al aprobar el alcance, se abona el 50% para comenzar y el 50% restante antes del despliegue. El mantenimiento posterior es opcional y se adapta a cada proyecto.</p></aside>
          <a class="software-button" href={contactHref} data-software-cta="budget"><span>Hablemos de tu proyecto</span><span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="software-benefits" aria-labelledby="software-benefits-title">
        <header class="software-heading">
          <p class="software-eyebrow">Creamos para avanzar</p>
          <h2 id="software-benefits-title">Beneficios de trabajar con nosotros</h2>
          <p>Más que programar, nos implicamos en hacer crecer tu negocio.</p>
        </header>
        <div class="software-benefits__grid">
          {benefits.map((benefit) => (
            <article>
              <picture>
                <source srcset={`/media/software/optimized/beneficio-${benefit.asset}-180.webp 180w, /media/software/optimized/beneficio-${benefit.asset}-320.webp 320w`} sizes="(max-width: 699px) 100px, (max-width: 1019px) 130px, 145px" type="image/webp" />
                <img src={`/media/software/optimized/beneficio-${benefit.asset}-320.webp`} width="1254" height="1254" alt="" loading="lazy" decoding="async" />
              </picture>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="software-final-cta" aria-labelledby="software-final-title">
        <img src="/media/servicios/optimized/marketing-320.webp" width="320" height="320" alt="" loading="lazy" decoding="async" />
        <div><h2 id="software-final-title">¿Listo para llevar tu negocio al siguiente nivel?</h2><p>Creamos el software que necesitas para optimizar, automatizar y hacer crecer tu empresa.</p></div>
        <a class="software-button" href={contactHref} data-software-cta="final"><span>Hablemos de tu proyecto</span><span aria-hidden="true">→</span></a>
        <img src="/media/servicios/optimized/marketing-320.webp" width="320" height="320" alt="" loading="lazy" decoding="async" />
      </section>
    </div>
  </main>

  <SiteFooter anchorPrefix="/" />
</Base>

<script>
  import { captureEvent } from '../lib/analytics/posthog';

  document.querySelectorAll<HTMLElement>('[data-software-cta]').forEach((cta) => {
    cta.addEventListener('click', () => {
      void captureEvent('software_service_cta_clicked', {
        placement: cta.dataset.softwareCta ?? 'unknown',
        destination: cta.getAttribute('href'),
      });
    });
  });
</script>

<style>
  .software-page { color: #123b69; background: #edf7fd; }
  .software-eyebrow { font-size: 11px; font-weight: 780; letter-spacing: .11em; color: #1371c9; text-transform: uppercase; }
  .software-button { display: inline-flex; min-height: 52px; padding: 0 24px; align-items: center; justify-content: center; gap: 24px; border-radius: 999px; font-size: 13px; font-weight: 750; color: #fff; background: linear-gradient(135deg, #1762ad, #07396f); box-shadow: 0 14px 28px -16px rgba(7,55,108,.8); text-decoration: none; transition: transform 180ms ease, filter 180ms ease; }
  .software-button:hover { filter: brightness(1.08); transform: translateY(-2px); }

  .software-hero { position: relative; min-height: max(780px, 100vh); padding: 132px max(34px, 5vw) 120px; overflow: hidden; isolation: isolate; background: linear-gradient(180deg, #62afe0 0%, #8bc7eb 52%, #d8eef9 100%); }
  .software-sky, .software-sky__clouds { position: absolute; inset: 0; pointer-events: none; }
  .software-sky__sun { position: absolute; top: 10%; right: 7%; width: clamp(38px, 4.5vw, 78px); aspect-ratio: 1; border-radius: 50%; background: #fffdf6; box-shadow: 0 0 0 18px rgba(255,253,246,.1), 0 0 50px 22px rgba(255,253,246,.42); }
  .software-sky__haze { position: absolute; right: -10%; bottom: 0; left: -10%; height: 31%; background: linear-gradient(180deg, transparent, rgba(244,251,255,.76) 72%, #fff 100%); }
  .software-sky__clouds { top: auto; height: 22%; background: radial-gradient(ellipse 24% 74% at 2% 106%, #fff 0 97%, transparent 100%), radial-gradient(ellipse 28% 68% at 26% 112%, #fff 0 97%, transparent 100%), radial-gradient(ellipse 30% 72% at 56% 111%, #fff 0 97%, transparent 100%), radial-gradient(ellipse 28% 70% at 83% 110%, #fff 0 97%, transparent 100%), radial-gradient(ellipse 22% 68% at 103% 105%, #fff 0 97%, transparent 100%); }
  .software-sky__clouds--far { bottom: 7%; opacity: .34; filter: blur(12px); transform: scale(.88); }
  .software-sky__clouds--near { bottom: -2%; }
  .software-hero__inner { position: relative; z-index: 2; display: grid; width: min(1660px, 100%); min-height: 640px; margin-inline: auto; grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr); align-items: center; gap: clamp(18px, 2vw, 42px); }
  .software-hero__cloud { position: relative; z-index: 2; width: min(880px, 100%); aspect-ratio: 900 / 650; }
  .software-hero__cloud > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 20px 17px rgba(54,124,174,.22)); }
  .software-hero__copy { position: absolute; z-index: 1; top: 50%; left: 50%; width: 67%; transform: translate(-47%, -41%); }
  .software-hero__copy h1, .software-heading h2, .software-budget h2, .software-final-cta h2 { font-family: var(--font-display); font-weight: 900; color: #0b3268; text-transform: uppercase; }
  .software-hero__copy h1 { margin-top: 12px; font-size: clamp(36px, 2.75vw, 53px); line-height: .97; }
  .software-hero__copy h1 span { display: block; }
  .software-hero__copy > p:last-of-type { max-width: 47ch; margin-top: 22px; font-size: clamp(15px, 1.05vw, 18px); line-height: 1.5; color: #43698f; }
  .software-hero__copy .software-button { margin-top: 25px; }
  .software-hero__visual { position: relative; z-index: 1; width: min(820px, 100%); filter: drop-shadow(0 28px 28px rgba(25,86,137,.16)); }
  .software-hero__visual img { width: 100%; height: auto; }

  @media (min-width: 1200px) {
    .software-hero__cloud { --cloud-left-extension: clamp(54px, 4.2vw, 82px); }
    .software-hero__cloud > svg { inset: 0 auto 0 calc(var(--cloud-left-extension) * -1); width: calc(100% + var(--cloud-left-extension)); }
  }

  .software-hero-transition { display: none; }
  .software-content { position: relative; z-index: 3; display: grid; width: min(1780px, calc(100% - 40px)); margin: -42px auto 0; padding-bottom: 72px; gap: 28px; }
  .software-panel, .software-final-cta { border: 1px solid rgba(255,255,255,.9); border-radius: 34px; background: linear-gradient(145deg, rgba(255,255,255,.94), rgba(239,248,254,.9)); box-shadow: 0 24px 55px -40px rgba(15,72,120,.48); }
  .software-panel { padding: clamp(30px, 3vw, 54px); }
  .software-heading { max-width: 980px; margin: 0 auto clamp(26px, 3vw, 44px); text-align: center; }
  .software-heading h2, .software-budget h2, .software-final-cta h2 { margin-top: 8px; font-size: clamp(28px, 2.35vw, 44px); line-height: 1; }
  .software-heading > p:last-child, .software-budget__copy > p, .software-final-cta p { margin-top: 12px; line-height: 1.55; color: #527597; }

  @media (min-width: 1020px) {
    .software-hero-transition { position: relative; z-index: 2; display: block; width: 100vw; height: 160px; margin-top: -100px; margin-bottom: -60px; pointer-events: none; }
    .software-hero-transition svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 14px 15px rgba(92,156,198,.08)); }
    .software-hero-transition path { fill: #fff; }
  }

  .software-process__grid { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 11px; list-style: none; }
  .software-process__card { position: relative; min-width: 0; min-height: 340px; padding: 12px 12px 20px; border: 1px solid rgba(23,104,176,.1); border-radius: 20px; background: rgba(255,255,255,.84); box-shadow: 0 18px 30px -28px rgba(18,70,116,.65); }
  .software-process__card:not(:last-child)::after { content: '→'; position: absolute; top: 34%; right: -14px; z-index: 2; color: #69aee7; font-weight: 800; }
  .software-process__asset { display: block; width: min(135px, 86%); aspect-ratio: 1; margin: 0 auto 6px; }
  .software-process__asset img { width: 100%; height: 100%; object-fit: contain; }
  .software-process__number { display: grid; width: 27px; height: 27px; margin-bottom: 10px; place-items: center; border-radius: 50%; color: #fff; background: #1471ce; font-size: 10px; font-weight: 800; }
  .software-process__card h3, .software-solutions__card h3, .software-benefits h3 { font-size: 12px; line-height: 1.2; color: #0b3268; text-transform: uppercase; }
  .software-process__card > p, .software-solutions__card p, .software-benefits article p { margin-top: 11px; font-size: 11px; line-height: 1.5; color: #527597; }
