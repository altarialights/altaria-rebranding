---
interface Props {
  name: 'time' | 'growth' | 'star' | 'users' | 'design' | 'speed' | 'responsive' | 'seo' | 'security' | 'support' | 'info';
}

const { name } = Astro.props;
---

<svg class="web-icon" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'time' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3.2 2" /></>}
  {name === 'growth' && <><path d="M4 18.5h16M6.5 16v-3.5M11 16V9.5M15.5 16v-6M20 16V5.5" /><path d="m14.8 6.8 2.5-2.5 2.7 2.3" /></>}
  {name === 'star' && <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" />}
  {name === 'users' && <><circle cx="9" cy="9" r="3" /><circle cx="16.5" cy="10" r="2.3" /><path d="M3.5 19c.5-3.2 2.5-5 5.5-5s5 1.8 5.5 5M14 15c2.9-.5 5.3.9 6 3.7" /></>}
  {name === 'design' && <><path d="M5 18.5 15.8 7.7l2.5 2.5L7.5 21H5v-2.5Z" /><path d="m14.2 9.3 2.5 2.5M4 5h6M4 9h4" /></>}
  {name === 'speed' && <><circle cx="12" cy="12" r="8.5" /><path d="M7.5 15.5a5.5 5.5 0 0 1 8.8-6.4M12 12l4-3" /></>}
  {name === 'responsive' && <><rect x="4" y="4" width="12" height="9" rx="1.5" /><rect x="14" y="10" width="6" height="10" rx="1.3" /><path d="M8 17h4M9.5 13v4M16.5 17.5h1" /></>}
  {name === 'seo' && <><circle cx="10.5" cy="10.5" r="5.5" /><path d="m14.7 14.7 5 5M8 10.5h5M10.5 8v5" /></>}
  {name === 'security' && <><path d="M12 3.5 19 6v5.3c0 4.3-2.6 7.4-7 9.2-4.4-1.8-7-4.9-7-9.2V6l7-2.5Z" /><path d="m8.7 12 2.1 2.1 4.5-4.5" /></>}
  {name === 'support' && <><path d="M4.5 13v-2a7.5 7.5 0 0 1 15 0v2" /><path d="M4.5 12H7v5H5.8a1.3 1.3 0 0 1-1.3-1.3V12ZM19.5 12H17v5h1.2a1.3 1.3 0 0 0 1.3-1.3V12ZM17 17c0 2-1.5 3-4.5 3" /></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 10.5V17M12 7h.01" /></>}
</svg>

<style>
  .web-icon {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
