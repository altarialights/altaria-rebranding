---
import { howItWorks, flow } from '../../data/hero';

/**
 * "Cómo funciona" — the destination for the hero's flow nodes.
 *
 * Built now, minimally, so the nodes are genuinely functional rather than
 * decorative: each one is a real anchor to a real article. The rest of
 * the home is still out of scope.
 *
 * Deliberately not a SaaS card grid: a single travelling line, small step
 * numerals, two columns of air, and the same visual language as the
 * nodes. No metrics, invented or otherwise.
 */
---

<section class="how" id="como-funciona" aria-labelledby="how-title">
  <div class="how__head">
    <h2 class="how__title" id="how-title">
      {howItWorks.title.map((line) => <span>{line}</span>)}
    </h2>
    <p class="how__sub">{howItWorks.sub}</p>
  </div>

  <ol class="how__list">
    {
      flow.map((step, i) => (
        <li>
          <article class="step" id={`paso-${step.id}`} tabindex="-1">
            <span class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="step__body">
              <p class="step__eyebrow">{step.label}</p>
              <h3 class="step__title">{step.stepTitle}</h3>
              <p class="step__text">{step.stepBody}</p>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how {
    position: relative;
    padding: clamp(6rem, 4rem + 6vw, 11rem) var(--gutter) clamp(7rem, 5rem + 6vw, 12rem);
    /* Continues the sky rather than cutting to a flat white panel. */
    background: linear-gradient(to bottom, #ffffff 0%, #f7fbfe 42%, var(--sky-haze) 100%);
  }

  /* Full already spends its final viewport travelling through the white
     exit bank. Repeating the section's former 6–11rem top padding after
     that transition read as an empty strip between the clouds and the
     first real heading. Keep a short breathing space instead. */
  :global(html[data-performance-tier='full']) .how {
    padding-top: clamp(1.25rem, 0.8rem + 0.5vw, 1.75rem);
  }

  .how__head {
    max-width: 900px;
    margin: 0 auto clamp(3.5rem, 2rem + 4vw, 6rem);
    text-align: center;
  }

  .how__title {
    display: grid;
    gap: 0.06em;
    font-size: clamp(34px, 3.2vw, 62px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.042em;
    color: var(--ink);
  }

  .how__sub {
    margin-top: 1.1rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .how__list {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 2.4vw, 4.5rem);
  }

  /* The travelling line that ties the four steps together. */
  .how__list::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      rgba(29, 111, 192, 0.5),
      rgba(29, 111, 192, 0.18) 70%,
      rgba(201, 163, 90, 0.55)
    );
  }

  .step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: clamp(1.2rem, 0.6rem + 1.4vw, 2.4rem);
    align-items: start;
    scroll-margin-top: calc(var(--header-top) + var(--header-h) + 32px);
    border-radius: 18px;
    padding: 1rem;
    margin: -1rem;
    transition: background-color 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }

  .step:focus {
    outline: none;
  }

  /* Highlight applied for ~1.5 s when arrived at from a hero node. */
  .step.is-targeted {
    background: rgba(255, 255, 255, 0.86);
    box-shadow:
      0 0 0 1px rgba(29, 111, 192, 0.24),
      0 22px 48px -26px rgba(20, 60, 100, 0.5);
  }

  .step__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: 6px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 2px rgba(29, 111, 192, 0.45);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-deep);
  }

  .how__list li:last-child .step__num {
    box-shadow: 0 0 0 2px rgba(201, 163, 90, 0.6);
    color: var(--gold-deep);
  }

  .step__eyebrow {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .step__title {
    margin-top: 0.4rem;
    max-width: 20ch;
    font-size: clamp(22px, 1.8vw, 34px);
    font-weight: 750;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .step__text {
    margin-top: 0.7rem;
    max-width: 62ch;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* Two columns of air from 1100px up: title left, text right. */
  @media (min-width: 1100px) {
    .step__body {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 1rem + 2.4vw, 4rem);
      align-items: start;
    }
    .step__eyebrow {
      grid-column: 1;
    }
    .step__title {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0.4rem;
    }
    .step__text {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0.2rem;
    }
  }
</style>
