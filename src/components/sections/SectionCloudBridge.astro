---
interface Props {
  variant: 'case-how' | 'how-mirador';
}

const { variant } = Astro.props;
---

<div class:list={['section-cloud-bridge', `section-cloud-bridge--${variant}`]} aria-hidden="true"></div>

<style>
  /* One physical cloud bank centred on the boundary between two sections.
     It is intentionally painted once: no mirrored halves and no seam. */
  .section-cloud-bridge { display: none; }

  @media (min-width: 1020px) {
    :global(html[data-performance-tier='full']) .section-cloud-bridge {
      position: absolute;
      z-index: -1;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      width: 100%;
      height: clamp(190px, 15vw, 280px);
      pointer-events: none;
      filter: blur(3px);
      transform: translateY(50%);
      background:
        radial-gradient(ellipse 15% 48% at 9% 40%, #fffefb 0%, rgba(255,254,251,.97) 52%, rgba(255,254,251,0) 78%),
        radial-gradient(ellipse 12% 38% at 19% 54%, #fffdf8 0%, rgba(255,253,248,.95) 52%, rgba(255,253,248,0) 79%),
        radial-gradient(ellipse 10% 30% at 29% 68%, #fffdf8 0%, rgba(255,253,248,.92) 54%, rgba(255,253,248,0) 81%),
        radial-gradient(ellipse 11% 32% at 74% 66%, #fffdf8 0%, rgba(255,253,248,.93) 54%, rgba(255,253,248,0) 80%),
        radial-gradient(ellipse 14% 44% at 84% 48%, #fffefb 0%, rgba(255,254,251,.96) 50%, rgba(255,254,251,0) 77%),
        radial-gradient(ellipse 16% 50% at 92% 38%, #fffefb 0%, rgba(255,254,251,.97) 50%, rgba(255,254,251,0) 77%),
        radial-gradient(ellipse 16% 40% at 9% 62%, #c3d5e4 0%, rgba(195,213,228,.62) 56%, rgba(195,213,228,0) 82%),
        radial-gradient(ellipse 13% 32% at 20% 76%, #c3d5e4 0%, rgba(195,213,228,.55) 58%, rgba(195,213,228,0) 84%),
        radial-gradient(ellipse 15% 38% at 86% 70%, #c3d5e4 0%, rgba(195,213,228,.58) 56%, rgba(195,213,228,0) 82%),
        radial-gradient(ellipse 17% 42% at 92% 58%, #c3d5e4 0%, rgba(195,213,228,.6) 56%, rgba(195,213,228,0) 82%);
    }

    :global(html[data-performance-tier='full']) .section-cloud-bridge--how-mirador {
      transform: translateY(50%) scaleX(-1);
    }
  }
</style>
