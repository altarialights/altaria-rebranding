---
import SectionCloudBridge from './SectionCloudBridge.astro';

const metrics = [
  { value: '+132%', label: 'Más reservas directas', icon: 'calendar' },
  { value: '+58%', label: 'Mejor imagen de marca', icon: 'star' },
  { value: '+41%', label: 'Más confianza del usuario', icon: 'shield' },
  { value: '+62%', label: 'Reservas online en 3 meses', icon: 'chart' },
] as const;

const metricIcon = (icon: string) => {
  if (icon === 'calendar') return 'M4 7.5h16v12H4zM7 3.5v7M17 3.5v7M4 11h16';
  if (icon === 'star') return 'm12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z';
  if (icon === 'shield') return 'M12 3.5 19 6v5.2c0 4.4-2.8 7.6-7 9.3-4.2-1.7-7-4.9-7-9.3V6zM9 12l2 2 4-5';
  return 'M5 20V12M10 20V8M15 20V4M20 20V10M3 20h19';
};
---

<section class="case" id="caso-real" aria-labelledby="case-title" data-case-study>
  <div class="case__atmosphere" aria-hidden="true">
    <span class="case__cloud case__cloud--one"></span>
    <span class="case__cloud case__cloud--two"></span>
    <span class="case__cloud case__cloud--three"></span>
  </div>

  <div class="case__inner">
    <header class="case__copy" data-case-reveal>
      <div class="case__copy-cloud" aria-hidden="true">
        <svg class="case__cloud-shape case__cloud-shape--wide" viewBox="0 0 1200 620" preserveAspectRatio="none">
          <defs>
            <linearGradient id="case-cloud-fill" x1="230" y1="52" x2="720" y2="590" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="1" stop-color="#edf8ff" />
            </linearGradient>
            <linearGradient id="case-cloud-full-fill" gradientUnits="userSpaceOnUse" x1="0" y1="54" x2="0" y2="620">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.52" stop-color="#fbfdff" />
              <stop offset="1" stop-color="#e6f0fb" />
            </linearGradient>
            <radialGradient id="case-cloud-full-sheen" gradientUnits="userSpaceOnUse" cx="396" cy="164" r="396">
              <stop offset="0" stop-color="#fffaf0" stop-opacity="0.85" />
              <stop offset="1" stop-color="#fffaf0" stop-opacity="0" />
            </radialGradient>
            <filter id="case-cloud-full-soft" x="-20%" y="-28%" width="140%" height="156%">
              <feGaussianBlur stdDeviation="5" />
            </filter>
            <filter id="case-cloud-full-cast" x="-45%" y="-70%" width="190%" height="240%">
              <feGaussianBlur stdDeviation="26" />
            </filter>
            <linearGradient id="case-cloud-tablet-fill" gradientUnits="userSpaceOnUse" x1="0" y1="54" x2="0" y2="620">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.55" stop-color="#fafdff" />
              <stop offset="1" stop-color="#e6f1fa" />
            </linearGradient>
            <radialGradient id="case-cloud-tablet-sheen" gradientUnits="userSpaceOnUse" cx="396" cy="164" r="396">
              <stop offset="0" stop-color="#fffdf5" stop-opacity="0.78" />
              <stop offset="1" stop-color="#fffdf5" stop-opacity="0" />
            </radialGradient>
            <filter id="case-cloud-tablet-soft" x="-14%" y="-18%" width="128%" height="136%">
              <feGaussianBlur stdDeviation="3" />
            </filter>
            <filter id="case-cloud-tablet-shadow" x="-22%" y="-36%" width="144%" height="172%">
              <feGaussianBlur stdDeviation="18" />
            </filter>
          </defs>
          <g class="case__cloud-body-default" fill="url(#case-cloud-fill)">
            <ellipse cx="600" cy="410" rx="548" ry="192" />
            <ellipse cx="178" cy="338" rx="164" ry="188" />
            <ellipse cx="420" cy="242" rx="252" ry="222" />
            <ellipse cx="735" cy="226" rx="274" ry="226" />
            <ellipse cx="1015" cy="345" rx="170" ry="178" />
          </g>
          <g class="case__cloud-full case__cloud-full--cast" fill="rgba(41, 92, 152, 0.17)" filter="url(#case-cloud-full-cast)" transform="translate(0 31)">
            <ellipse cx="600" cy="410" rx="548" ry="192" />
            <ellipse cx="178" cy="338" rx="164" ry="188" />
            <ellipse cx="420" cy="242" rx="252" ry="222" />
            <ellipse cx="735" cy="226" rx="274" ry="226" />
            <ellipse cx="1015" cy="345" rx="170" ry="178" />
          </g>
          <g class="case__cloud-full case__cloud-full--body" fill="url(#case-cloud-full-fill)" filter="url(#case-cloud-full-soft)">
            <ellipse cx="600" cy="410" rx="548" ry="192" />
            <ellipse cx="178" cy="338" rx="164" ry="188" />
            <ellipse cx="420" cy="242" rx="252" ry="222" />
            <ellipse cx="735" cy="226" rx="274" ry="226" />
            <ellipse cx="1015" cy="345" rx="170" ry="178" />
          </g>
          <g class="case__cloud-full case__cloud-full--sheen" fill="url(#case-cloud-full-sheen)" filter="url(#case-cloud-full-soft)">
            <ellipse cx="178" cy="304" rx="128" ry="117" />
            <ellipse cx="420" cy="202" rx="197" ry="138" />
          </g>
          <g class="case__cloud-tablet" fill="#386e9a" fill-opacity="0.16" filter="url(#case-cloud-tablet-shadow)" transform="translate(0 28)">
            <ellipse cx="600" cy="410" rx="548" ry="192" />
            <ellipse cx="178" cy="338" rx="164" ry="188" />
            <ellipse cx="420" cy="242" rx="252" ry="222" />
            <ellipse cx="735" cy="226" rx="274" ry="226" />
            <ellipse cx="1015" cy="345" rx="170" ry="178" />
          </g>
          <g class="case__cloud-tablet" fill="url(#case-cloud-tablet-fill)" filter="url(#case-cloud-tablet-soft)">
            <ellipse cx="600" cy="410" rx="548" ry="192" />
            <ellipse cx="178" cy="338" rx="164" ry="188" />
            <ellipse cx="420" cy="242" rx="252" ry="222" />
            <ellipse cx="735" cy="226" rx="274" ry="226" />
            <ellipse cx="1015" cy="345" rx="170" ry="178" />
          </g>
          <g class="case__cloud-tablet" fill="url(#case-cloud-tablet-sheen)" filter="url(#case-cloud-tablet-soft)">
            <ellipse cx="178" cy="304" rx="128" ry="117" />
            <ellipse cx="420" cy="202" rx="197" ry="138" />
          </g>
        </svg>
        <svg class="case__cloud-shape case__cloud-shape--mobile" viewBox="0 0 600 650" preserveAspectRatio="none">
          <defs>
            <linearGradient id="case-cloud-fill-mobile" gradientUnits="userSpaceOnUse" x1="0" y1="45" x2="0" y2="610">
              <stop offset="0" stop-color="#ffffff" />
              <stop offset="0.55" stop-color="#fafdff" />
              <stop offset="1" stop-color="#e6f1fa" />
            </linearGradient>
            <radialGradient id="case-cloud-sheen-mobile" gradientUnits="userSpaceOnUse" cx="218" cy="146" r="235">
              <stop offset="0" stop-color="#fffdf5" stop-opacity="0.78" />
              <stop offset="1" stop-color="#fffdf5" stop-opacity="0" />
            </radialGradient>
            <filter id="case-cloud-soft-mobile" x="-14%" y="-18%" width="128%" height="136%">
              <feGaussianBlur stdDeviation="3" />
            </filter>
            <filter id="case-cloud-shadow-mobile" x="-22%" y="-36%" width="144%" height="172%">
              <feGaussianBlur stdDeviation="18" />
            </filter>
          </defs>
          <g fill="#386e9a" fill-opacity="0.16" filter="url(#case-cloud-shadow-mobile)" transform="translate(0 28)">
            <ellipse cx="300" cy="340" rx="292" ry="290" />
            <ellipse cx="300" cy="100" rx="175" ry="68" />
          </g>
          <g fill="url(#case-cloud-fill-mobile)" filter="url(#case-cloud-soft-mobile)">
            <ellipse cx="300" cy="340" rx="292" ry="290" />
            <ellipse cx="300" cy="100" rx="175" ry="68" />
          </g>
          <g fill="url(#case-cloud-sheen-mobile)" filter="url(#case-cloud-soft-mobile)">
            <ellipse cx="252" cy="132" rx="138" ry="82" />
          </g>
        </svg>
      </div>
      <p class="case__eyebrow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 1.6 5.3L19 9l-5.4 1.7L12 16l-1.6-5.3L5 9l5.4-1.7zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" /></svg>
        Caso real destacado
      </p>
      <h2 class="case__title" id="case-title">
        <span>De Zamorano.</span>
        <span>Un proyecto real,</span>
        <span>resultados reales.</span>
      </h2>
      <p class="case__lead">
        Descubre cómo ayudamos a De Zamorano a convertir su visión en una experiencia digital
        que impulsa ventas y fortalece su marca.
      </p>
      <a class="case__cta" href="#contacto">
        <span>Ver caso completo</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M14 8l4 4-4 4" /></svg>
      </a>
    </header>

    <div class="case__showcase" aria-label="Web responsive creada para De Zamorano" data-case-reveal>
      <figure class="case-portrait">
        <img
          src="/media/de-zamorano/portrait.png"
          width="1448"
          height="1086"
          alt="Composición del proyecto De Zamorano con monitor, móvil, vídeo y pedestal sobre nubes"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="case-monitor">
        <div class="case-monitor__frame">
          <span class="case-monitor__camera" aria-hidden="true"></span>
          <span class="case-monitor__screen">
            <picture>
              <source
                media="(max-width: 699px)"
                srcset="/media/de-zamorano/optimized/captura-larga-860.webp 860w"
                sizes="calc(100vw - 36px)"
              />
              <img
                src="/media/de-zamorano/optimized/desktop-1440.jpg"
                srcset="/media/de-zamorano/optimized/desktop-768.jpg 768w, /media/de-zamorano/optimized/desktop-1200.jpg 1200w, /media/de-zamorano/optimized/desktop-1440.jpg 1440w, /media/de-zamorano/desktop.png 1815w"
                sizes="(min-width: 1200px) 52vw, (min-width: 700px) 72vw, calc(100vw - 36px)"
                width="1440"
                height="688"
                alt="Página web responsive de De Zamorano"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </span>
        </div>
        <span class="case-monitor__neck" aria-hidden="true"></span>
        <span class="case-monitor__base" aria-hidden="true"></span>
      </figure>

      <figure class="case-phone">
        <div class="case-phone__frame">
          <span class="case-phone__speaker" aria-hidden="true"></span>
          <img
            src="/media/de-zamorano/optimized/movil-720.webp"
            width="720"
            height="1436"
            alt="Página web de De Zamorano adaptada a móvil"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>

      <figure class="case-video" aria-label="Fotograma de la presentación del proyecto De Zamorano">
        <img
          src="/media/de-zamorano/optimized/steak-640.jpg"
          srcset="/media/de-zamorano/optimized/steak-480.jpg 480w, /media/de-zamorano/optimized/steak-640.jpg 640w"
          sizes="(min-width: 700px) 17vw, 34vw"
          width="640"
          height="360"
          alt="Steak tartar preparado por De Zamorano"
          loading="lazy"
          decoding="async"
        />
        <span class="case-video__play" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5z" /></svg>
        </span>
      </figure>
    </div>

    <div class="case__proof" data-case-reveal>
      <ul class="case-metrics" aria-label="Resultados del proyecto">
        {
          metrics.map((metric) => (
            <li class="case-metric">
              <span class="case-metric__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d={metricIcon(metric.icon)} /></svg>
              </span>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </li>
          ))
        }
      </ul>

      <p class="case__verified">
        <span class="case__verified-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 4.3-2.8 7.6-7 9.5C7.8 18.6 5 15.3 5 11V6zM8.5 12l2.2 2.2 4.8-5" /></svg>
        </span>
        <span><strong>Resultados medidos. Impacto real.</strong> Datos verificados durante los primeros 3 meses en línea.</span>
      </p>
    </div>

    <aside class="case-testimonial" aria-label="Testimonio de De Zamorano" data-case-reveal>
      <p class="case-testimonial__stars" aria-label="Cinco estrellas">★★★★★</p>
      <blockquote>“Altaria Lights entendió nuestras necesidades y superó nuestras expectativas.”</blockquote>
      <footer>
        <img
          class="case-testimonial__avatar"
          src="/media/de-zamorano/optimized/alfredo-160.jpg"
          width="160"
          height="160"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span><strong>Alfredo Zamorano.</strong><small>Director General, De Zamorano</small></span>
      </footer>
    </aside>
  </div>
  <SectionCloudBridge variant="case-how" />
</section>

<script>
  const caseStudy = document.querySelector<HTMLElement>('[data-case-study]');
  if (caseStudy && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const reveal = Array.from(caseStudy.querySelectorAll<HTMLElement>('[data-case-reveal]'));
    caseStudy.classList.add('case--enhanced');
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        caseStudy.classList.add('is-visible');
        observer.disconnect();
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    observer.observe(caseStudy);
    reveal.forEach((element, index) => element.style.setProperty('--case-order', String(index)));
  }
</script>

<style>
  .case {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    color: #102f5f;
    background:
      radial-gradient(ellipse at 72% 18%, rgba(255,255,255,.18), transparent 33%),
      linear-gradient(180deg, #dceefa 0%, #5aa8df 8%, #8fc8e9 52%, #d9ecf8 100%);
  }

  .case__atmosphere {
    position: absolute;
    z-index: -2;
    pointer-events: none;
  }

  .case__atmosphere { inset: 0; }

  .case__cloud { position: absolute; border-radius: 50%; background: rgba(244, 251, 255, .82); }
  .case__cloud--one { width: 44vw; height: 18vw; left: -9vw; bottom: -4vw; }
  .case__cloud--two { width: 52vw; height: 21vw; left: 27vw; bottom: -8vw; }
  .case__cloud--three { width: 38vw; height: 18vw; right: -8vw; bottom: -3vw; }

  .case__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(390px, .88fr) minmax(600px, 1.34fr);
    grid-template-rows: auto auto;
    gap: clamp(16px, 2.5vh, 28px) clamp(38px, 4vw, 76px);
    width: min(100% - 2 * var(--gutter), 1680px);
    height: 100svh;
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(36px, 5.5vh, 64px) 0;
    box-sizing: border-box;
    align-content: center;
  }

  .case__copy {
    position: relative;
    z-index: 0;
    isolation: isolate;
    align-self: end;
    width: 100%;
    max-width: 620px;
    padding: clamp(30px, 4vh, 46px) 0 clamp(30px, 3.5vh, 42px);
  }

  .case__copy-cloud {
    position: absolute;
    z-index: -1;
    inset: -10px -24px -12px -80px;
    pointer-events: none;
  }

  .case__copy-cloud svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .case__copy-cloud .case__cloud-shape--mobile { display: none; }
  .case__cloud-full { display: none; }
  .case__cloud-tablet { display: none; }

  /* Desktop safe area: the graphic cloud deliberately overhangs the copy
     column, while the content keeps a fixed minimum distance from its
     shallow left shoulder. This prevents the title, lead and CTA from
     visually escaping the silhouette at any desktop width. */
  @media (min-width: 1200px) {
    .case__copy {
      --case-copy-safe-left: clamp(46px, 3.4vw, 64px);
      width: calc(100% + var(--case-copy-safe-left));
      max-width: calc(620px + var(--case-copy-safe-left));
      padding-left: var(--case-copy-safe-left);
    }
    .case__copy-cloud { inset: -10px -24px -12px -140px; }
  }

  .case__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 38px;
    padding: 0 15px;
    border: 1px solid rgba(255,255,255,.82);
    border-radius: 999px;
    background: rgba(247,252,255,.84);
    box-shadow: 0 13px 30px -22px rgba(11,53,99,.64);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #196ec0;
  }

  .case__eyebrow svg { width: 18px; fill: none; stroke: #2b81d4; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .case__title {
    display: grid;
    margin-top: 19px;
    font-family: var(--font-display);
    font-size: clamp(42px, 3.2vw, 56px);
    font-weight: 900;
    line-height: .94;
    letter-spacing: -.015em;
    text-transform: uppercase;
    color: #102f5f;
  }

  .case__lead { max-width: 48ch; margin-top: 19px; font-size: clamp(15px, 1.05vw, 18px); line-height: 1.52; color: rgba(20, 62, 103, .76); }

  .case__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-width: 210px;
    min-height: 48px;
    margin-top: 20px;
    padding: 0 20px;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(135deg, #153d70, #072854);
    box-shadow: 0 14px 26px -16px rgba(6,32,67,.82);
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .case__cta svg { width: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 180ms ease; }
  .case__cta:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -16px rgba(6,32,67,.92); }
  .case__cta:hover svg { transform: translateX(4px); }
  .case__cta:focus-visible { outline: 3px solid rgba(9,74,139,.48); outline-offset: 4px; }

  .case__showcase { position: relative; grid-column: 2; grid-row: 1 / span 2; align-self: center; min-height: min(68svh, 650px); }

  .case-portrait { display: none; margin: 0; pointer-events: none; }
  .case-portrait img { display: block; width: 100%; height: auto; object-fit: contain; }

  .case-monitor { position: absolute; top: 4%; right: 0; width: 90%; margin: 0; }
  .case-monitor__frame { position: relative; padding: clamp(8px, .65vw, 12px); border: 2px solid rgba(255,255,255,.9); border-radius: 27px; background: linear-gradient(145deg, #e6edf3, #abb9c4); box-shadow: 0 30px 56px -36px rgba(5,38,76,.58); transform: perspective(1200px) rotateY(-1.5deg) rotateZ(-.6deg); }
  .case-monitor__screen { display: block; aspect-ratio: 1815 / 867; overflow: auto; border-radius: 18px; background: #0b1725; scrollbar-width: none; }
  .case-monitor__screen::-webkit-scrollbar { display: none; }
  .case-monitor__screen picture { display: block; width: 100%; }
  .case-monitor__frame img { display: block; width: 100%; height: auto; }
  .case-monitor__camera { position: absolute; z-index: 2; top: 5px; left: 50%; width: 4px; height: 4px; border-radius: 50%; background: #728494; transform: translateX(-50%); }
  .case-monitor__neck { display: block; width: 17%; height: clamp(58px, 8vh, 80px); margin: -2px auto 0; background: linear-gradient(90deg, #9eacb8, #e8eff4 48%, #aebbc5); clip-path: polygon(26% 0,74% 0,92% 100%,8% 100%); }
  .case-monitor__base { display: block; width: 38%; height: 18px; margin: -3px auto 0; border-radius: 50%; background: linear-gradient(180deg, #eef3f6, #8f9ca6); box-shadow: 0 14px 20px -14px rgba(5,38,76,.6); }

  .case-phone { position: absolute; z-index: 3; left: 2%; bottom: 8%; width: 16%; aspect-ratio: .535; margin: 0; transform: rotate(-2deg); }
  .case-phone__frame { position: relative; height: 100%; padding: 8px; overflow: hidden; border: 2px solid rgba(255,255,255,.86); border-radius: 28px; background: linear-gradient(#06090d,#06090d) content-box, linear-gradient(145deg,#e9eef1,#8c99a3) border-box; box-shadow: 0 25px 38px -22px rgba(4,29,60,.8); }
  .case-phone__frame img { display: block; width: 100%; height: 100%; border-radius: 21px; object-fit: contain; object-position: center top; }
  .case-phone__speaker { position: absolute; z-index: 2; top: 12px; left: 50%; width: 33%; height: 6px; border-radius: 99px; background: #070d14; transform: translateX(-50%); }

  /* The hero's richer cloud/material treatment belongs only to the full
     desktop scene. Compact tiers retain their lighter paint and geometry. */
  @media (min-width: 1020px) {
    :global(html[data-performance-tier='full']) .case { z-index: 3; overflow: visible; }
    :global(html[data-performance-tier='full']) .case__cloud-body-default { display: none; }
    :global(html[data-performance-tier='full']) .case__cloud-full { display: block; }
    :global(html[data-performance-tier='full']) .case__cloud-full--body { opacity: .95; }
    :global(html[data-performance-tier='full']) .case__cloud-full--sheen { opacity: .5; mix-blend-mode: soft-light; }

    :global(html[data-performance-tier='full']) .case__cloud { display: none; }

    :global(html[data-performance-tier='full']) .case__showcase {
      display: grid;
      min-height: min(76svh, 760px);
      place-items: center;
    }
    :global(html[data-performance-tier='full']) .case-portrait {
      display: block;
      width: min(100%, clamp(600px, 52vw, 920px));
    }
    :global(html[data-performance-tier='full']) .case-monitor,
    :global(html[data-performance-tier='full']) .case-phone,
    :global(html[data-performance-tier='full']) .case-video {
      display: none;
    }

    :global(html[data-performance-tier='full']) .case-monitor__frame {
      padding: clamp(5px, .38vw, 7px);
