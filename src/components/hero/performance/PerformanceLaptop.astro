---
import { embeddedWeb } from '../../../data/hero';
import EmbeddedWebExperience from '../EmbeddedWebExperience.astro';

interface Props {
  tier: 'balanced' | 'lite';
}

const { tier } = Astro.props;
const benefitMarks = ['✓', '↗', '☆', '▥'] as const;
const resultDetails = {
  clicks: { note: 'Más visibilidad', mark: '↗' },
  contacts: { note: 'Oportunidades', mark: '+' },
  conversion: { note: 'Más acción', mark: '◎' },
  performance: { note: 'Mejora continua', mark: '✓' },
} as const;
---

<figure
  class={`perf-laptop perf-laptop--${tier}`}
  data-perf-object="laptop"
  role="img"
  aria-label={embeddedWeb.label}
>
  <div class="perf-laptop__tilt">
    <div class="perf-laptop__lid">
      <div class="perf-laptop__screen">
        {tier === 'balanced' ? (
          <EmbeddedWebExperience />
        ) : (
          <>
        <div class="perf-browser" aria-hidden="true">
          <span class="perf-browser__brand"><i></i><b></b></span>
          <span class="perf-browser__links"><i></i><i></i><i></i></span>
          <span class="perf-browser__cta"></span>
        </div>

        <section
          class="perf-web-scene perf-web-scene--impact is-current"
          data-perf-web-scene="impact"
          aria-hidden="true"
        >
          <div class="perf-web-scene__heading">
            <small class="perf-web-scene__eyebrow">Tu negocio, mejor presentado</small>
            <h3>
              {embeddedWeb.impact.title[0]}<br />{embeddedWeb.impact.title[1]}
            </h3>
            <p>{embeddedWeb.impact.sub}</p>
          </div>
          <article class="perf-impact-card" aria-hidden="true">
            <span class="perf-impact-card__chrome">
              <i></i><i></i><i></i>
            </span>
            <span class="perf-impact-card__body">
              <span class="perf-impact-card__copy">
                <small>Diseño que transmite confianza.</small>
                <i></i><i></i>
                <b>Hablemos</b>
              </span>
              <span class="perf-impact-card__badge">
                <b>✓</b><small>Confianza</small>
              </span>
            </span>
          </article>
          <div class="perf-impact-pillars">
            {embeddedWeb.impact.pillars.map((pillar) => (
              <span data-perf-web-pillar={pillar.id}>{pillar.label}</span>
            ))}
          </div>
        </section>

        <section
          class="perf-web-scene perf-web-scene--benefits"
          data-perf-web-scene="benefits"
          aria-hidden="true"
        >
          <div class="perf-web-scene__heading">
            <h3>
              {embeddedWeb.benefits.title[0]}<br />{embeddedWeb.benefits.title[1]}
            </h3>
          </div>
          <div class="perf-benefit-grid">
            {embeddedWeb.benefits.cards.map((card, index) => (
              <article class={index === 1 ? 'is-featured' : ''} data-perf-web-benefit={card.id}>
                <i aria-hidden="true">{benefitMarks[index]}</i>
                <span><strong>{card.title}</strong><small>{card.body}</small></span>
              </article>
            ))}
          </div>
        </section>

        <section
          class="perf-web-scene perf-web-scene--results"
          data-perf-web-scene="results"
          aria-hidden="true"
        >
          <div class="perf-web-scene__heading">
            <small class="perf-web-scene__eyebrow">Resultados con intención</small>
            <h3>Una web que<br />trabaja por ti.</h3>
            <p>Más atención. Más acción.</p>
          </div>
          <article class="perf-result-story" aria-hidden="true">
            <span>Rendimiento</span>
            <strong>Crece con cada mejora.</strong>
            <i></i>
          </article>
          <div class="perf-result-modules">
            {embeddedWeb.results.modules.map((module) => (
              <span data-perf-web-result={module.id} data-mark={resultDetails[module.id].mark}>
                <b>{module.label}</b>
                <small>{resultDetails[module.id].note}</small>
              </span>
            ))}
          </div>
        </section>
          </>
        )}
      </div>
    </div>

    <div class="perf-laptop__base" aria-hidden="true">
      {tier === 'balanced' && <span class="perf-laptop__keyboard"></span>}
      {tier === 'balanced' && <span class="perf-laptop__trackpad"></span>}
    </div>
  </div>
</figure>

<style>
  .perf-laptop {
    position: absolute;
    z-index: 3;
    top: 22%;
    left: 48%;
    width: clamp(520px, 48vw, 850px);
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .perf-laptop__tilt {
    position: relative;
    transform: rotate(0.8deg);
    transform-origin: center bottom;
  }

  .perf-laptop__lid {
    position: relative;
    width: 86%;
    aspect-ratio: 16 / 10.3;
    margin-inline: auto;
    padding: 1.4%;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 2.4% 2.4% 1.2% 1.2% / 3.8% 3.8% 2% 2%;
    background: linear-gradient(145deg, #f3f5f6 0%, #c8d0d6 52%, #9ca7af 100%);
    box-shadow:
      0 18px 30px rgba(44, 83, 117, 0.2),
      0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .perf-laptop--lite .perf-laptop__lid {
    padding: 1.2%;
    border: 3px solid #b8c3ca;
    background: #dbe2e7;
    box-shadow: 0 14px 24px rgba(44, 83, 117, 0.15);
  }

  .perf-laptop__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.4% / 2.4%;
    background: linear-gradient(165deg, #f8fbfe 0%, #eaf4fb 100%);
  }

  .perf-browser {
    position: absolute;
    z-index: 4;
    top: 3.2%;
    left: 3.5%;
    right: 3.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8.7%;
    padding: 0 1.6%;
    border: 1px solid rgba(43, 129, 212, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 5px 12px rgba(31, 87, 137, 0.09);
  }

  .perf-browser__brand,
  .perf-browser__links {
    display: flex;
    align-items: center;
  }

  .perf-browser__brand {
    gap: 5px;
  }

  .perf-browser__brand i {
    width: 7px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sky-top);
  }

  .perf-browser__brand b {
    width: clamp(28px, 3.6vw, 58px);
    height: 3px;
    border-radius: 999px;
    background: var(--ink-navy);
  }

  .perf-browser__links {
    gap: clamp(5px, 0.8vw, 12px);
    margin-left: auto;
    margin-right: 2%;
  }

  .perf-browser__links i {
    width: clamp(18px, 2.6vw, 40px);
    height: 2px;
    background: #a8b9c9;
  }

  .perf-browser__cta {
    width: clamp(33px, 5vw, 68px);
    height: 55%;
    border-radius: 999px;
    background: var(--accent-deep);
  }

  .perf-web-scene {
    position: absolute;
    inset: 15% 4% 5%;
    overflow: hidden;
    opacity: 0;
  }

  .perf-web-scene.is-current {
    opacity: 1;
  }

  .perf-web-scene__heading h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.55vw, 29px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink-navy);
  }

  .perf-web-scene__heading h3 span {
    display: block;
  }

  .perf-web-scene__heading p {
    margin-top: 1.4%;
    font-size: clamp(8px, 0.62vw, 11px);
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .perf-web-scene__eyebrow {
    display: block;
    margin-bottom: 3%;
    font-size: clamp(6px, 0.48vw, 9px);
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sky-top);
  }

  .perf-web-scene--impact .perf-web-scene__heading {
    position: absolute;
    top: 13%;
    left: 4%;
    width: 43%;
  }

  .perf-impact-card {
    position: absolute;
    top: 18%;
    right: 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 35%;
    height: 42%;
    padding: 6%;
    border-radius: 10%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 20px rgba(29, 93, 151, 0.13);
  }

  .perf-impact-card__copy {
    display: grid;
    gap: 8px;
    width: 58%;
  }

  .perf-impact-card__copy small {
    font-size: clamp(6px, 0.52vw, 9px);
    font-weight: 750;
    text-transform: uppercase;
    color: var(--ink-navy);
  }

  .perf-impact-card__copy i {
    display: block;
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: #c3d5e4;
  }

  .perf-impact-card__copy i:last-child {
    width: 70%;
    background: var(--sky-top);
  }

  .perf-impact-card__copy b {
    justify-self: start;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: clamp(6px, 0.48vw, 9px);
    font-weight: 720;
    color: #ffffff;
    background: var(--accent-deep);
  }

  .perf-impact-card__badge {
    display: grid;
    place-items: center;
    width: 31%;
    aspect-ratio: 1;
    border-radius: 50%;
    font-size: clamp(9px, 1.1vw, 18px);
    color: var(--sky-top);
    background: #edf6fd;
  }

  .perf-impact-card__badge small {
    display: none;
  }

  .perf-impact-pillars {
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: 2%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5%;
  }

  .perf-impact-pillars span {
    padding: clamp(6px, 0.7vw, 11px) 4px;
    border-radius: 999px;
    font-size: clamp(7px, 0.55vw, 10px);
    font-weight: 720;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink-navy);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 5px 10px rgba(29, 93, 151, 0.1);
  }

  .perf-web-scene--benefits .perf-web-scene__heading {
    margin: 1% 0 3% 2%;
  }

  .perf-benefit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3%;
    height: 70%;
  }

  .perf-benefit-grid article {
    display: flex;
    align-items: center;
    gap: 6%;
    min-width: 0;
    padding: 7%;
    border: 1px solid rgba(43, 129, 212, 0.16);
    border-radius: 7%;
    color: var(--ink-navy);
    background: rgba(255, 255, 255, 0.84);
  }

  .perf-benefit-grid article.is-featured {
    color: #ffffff;
    background: linear-gradient(135deg, var(--ink-navy), var(--accent-deep));
  }

  .perf-benefit-grid article > i {
    display: grid;
    place-items: center;
    flex: 0 0 25%;
    aspect-ratio: 1;
    border-radius: 28%;
    font-size: clamp(8px, 0.8vw, 14px);
    font-style: normal;
    color: var(--sky-top);
    background: #e7f3fc;
  }

  .perf-benefit-grid article.is-featured > i {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
  }

  .perf-benefit-grid article span {
    display: grid;
    min-width: 0;
  }

  .perf-benefit-grid strong {
    font-size: clamp(8px, 0.68vw, 12px);
    text-transform: uppercase;
  }

  .perf-benefit-grid small {
    margin-top: 2px;
    overflow: hidden;
    font-size: clamp(7px, 0.54vw, 9.5px);
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .perf-web-scene--results .perf-web-scene__heading {
    position: absolute;
    top: 3%;
    left: 2%;
    width: 38%;
  }

  .perf-result-chart {
    position: absolute;
    left: 3%;
    bottom: 7%;
    display: flex;
    align-items: flex-end;
    gap: 6%;
    width: 43%;
    height: 42%;
    padding: 0 4% 3%;
    border-bottom: 1px solid #b8d2e6;
  }

  .perf-result-chart i {
    flex: 1;
    height: 28%;
    border-radius: 3px 3px 0 0;
    background: var(--sky-mid);
  }

  .perf-result-chart i:nth-child(2) { height: 45%; }
  .perf-result-chart i:nth-child(3) { height: 62%; background: var(--sky-top); }
  .perf-result-chart i:nth-child(4) { height: 78%; background: #45cdb9; }
  .perf-result-chart i:nth-child(5) { height: 96%; background: var(--accent-deep); }

  .perf-result-modules {
    position: absolute;
    top: 5%;
    right: 1%;
    bottom: 4%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5%;
    width: 47%;
  }

  .perf-result-modules span {
    display: grid;
    place-items: center;
    padding: 6%;
    border-radius: 8%;
    font-size: clamp(7px, 0.6vw, 10px);
    font-weight: 720;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink-navy);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 6px 12px rgba(29, 93, 151, 0.1);
  }

  .perf-result-modules span:last-child {
    color: #ffffff;
    background: var(--accent-deep);
  }

  .perf-result-story {
    display: none;
  }

  .perf-laptop__base {
    position: relative;
    width: 100%;
    height: clamp(68px, 7vw, 116px);
    margin-top: -0.2%;
    clip-path: polygon(7% 0, 93% 0, 100% 90%, 96% 100%, 4% 100%, 0 90%);
    background: linear-gradient(180deg, #dfe5e9 0%, #b6c0c8 68%, #919da6 100%);
    box-shadow: 0 20px 26px rgba(40, 80, 116, 0.22);
  }

  .perf-laptop__keyboard {
    position: absolute;
    top: 11%;
    left: 11%;
    width: 78%;
    height: 45%;
    border: 1px solid rgba(70, 90, 106, 0.24);
    background:
      repeating-linear-gradient(90deg, transparent 0 7.4%, rgba(74, 91, 106, 0.34) 7.4% 7.7%),
      repeating-linear-gradient(180deg, transparent 0 23%, rgba(74, 91, 106, 0.34) 23% 25%);
  }

  .perf-laptop--lite .perf-laptop__base::before {
    content: '';
    position: absolute;
    top: 11%;
    left: 11%;
    width: 78%;
    height: 45%;
    border: 1px solid rgba(70, 90, 106, 0.24);
    background:
      repeating-linear-gradient(90deg, transparent 0 7.4%, rgba(74, 91, 106, 0.34) 7.4% 7.7%),
      repeating-linear-gradient(180deg, transparent 0 23%, rgba(74, 91, 106, 0.34) 23% 25%);
  }

  .perf-laptop__trackpad {
    position: absolute;
    left: 40%;
    bottom: 8%;
    width: 20%;
    height: 30%;
    border: 1px solid rgba(91, 108, 121, 0.22);
    border-radius: 4px;
    background: rgba(232, 237, 241, 0.55);
  }

  .perf-laptop--lite .perf-impact-card {
    top: 10%;
    right: 3.5%;
    display: block;
    width: 46%;
    height: 60%;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 17px;
    background: rgba(251, 254, 255, 0.96);
    box-shadow: 0 11px 22px rgba(24, 72, 113, 0.12);
  }

  .perf-laptop--lite .perf-impact-card__chrome {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 18%;
    padding-inline: 7%;
    border-bottom: 1px solid rgba(43, 129, 212, 0.1);
    background: #edf7fd;
  }

  .perf-laptop--lite .perf-impact-card__chrome i {
    width: clamp(4px, 0.38vw, 7px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #9cccec;
  }

  .perf-laptop--lite .perf-impact-card__chrome i:last-child {
    width: 18%;
    aspect-ratio: auto;
    height: 3px;
    margin-left: auto;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sky-top), #43cdb9);
  }

  .perf-laptop--lite .perf-impact-card__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 7%;
    height: 82%;
    padding: 8%;
  }

  .perf-laptop--lite .perf-impact-card__copy {
    gap: clamp(4px, 0.48vw, 8px);
    width: auto;
  }

  .perf-laptop--lite .perf-impact-card__copy small {
    font-size: clamp(7px, 0.6vw, 11px);
    line-height: 1.18;
  }

  .perf-laptop--lite .perf-impact-card__copy i {
    height: 3px;
  }

  .perf-laptop--lite .perf-impact-card__badge {
    display: grid;
    width: clamp(45px, 4.8vw, 76px);
    padding: 13% 8%;
    border: 1px solid rgba(43, 129, 212, 0.08);
    border-radius: 18px;
    background: #e9f5fd;
  }

  .perf-laptop--lite .perf-impact-card__badge b {
    font-size: clamp(13px, 1.25vw, 22px);
    line-height: 1;
  }

  .perf-laptop--lite .perf-impact-card__badge small {
    display: block;
    margin-top: 6px;
    font-size: clamp(5px, 0.43vw, 8px);
    font-weight: 760;
    text-transform: uppercase;
    color: var(--ink-navy);
  }

  .perf-laptop--lite .perf-web-scene--impact {
    inset: 14% 3.2% 4%;
    border: 1px solid rgba(43, 129, 212, 0.11);
    border-radius: 18px;
    background:
      radial-gradient(circle at 56% 18%, rgba(255, 255, 255, 0.25) 0 10%, transparent 10.5%),
      radial-gradient(ellipse 48% 25% at 84% 105%, rgba(255, 255, 255, 0.82) 0 70%, transparent 71%),
      linear-gradient(145deg, #d8eefb 0%, #bfe1f6 56%, #acd5ef 100%);
  }

  .perf-laptop--lite .perf-web-scene--impact::after {
    content: '';
    position: absolute;
    right: -3%;
    bottom: -12%;
    width: 58%;
    height: 28%;
    border-radius: 50%;
    background: rgba(247, 252, 255, 0.78);
    pointer-events: none;
  }

  .perf-laptop--lite .perf-web-scene--impact .perf-web-scene__heading {
    z-index: 1;
    top: 17%;
    left: 6%;
    width: 42%;
  }

  .perf-laptop--lite .perf-web-scene--impact .perf-web-scene__heading h3 {
    font-size: clamp(18px, 1.75vw, 32px);
    line-height: 0.9;
  }

  .perf-laptop--lite .perf-web-scene--impact .perf-web-scene__heading p {
    font-size: clamp(8px, 0.65vw, 12px);
  }

  .perf-laptop--lite .perf-web-scene--impact .perf-impact-card,
  .perf-laptop--lite .perf-web-scene--impact .perf-impact-pillars {
    z-index: 1;
  }

  .perf-laptop--lite .perf-web-scene--benefits {
    inset: 15% 4% 5%;
    padding: 2.5%;
    border: 1px solid rgba(43, 129, 212, 0.1);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(231, 245, 253, 0.96), rgba(213, 237, 250, 0.96));
  }

  .perf-laptop--lite .perf-web-scene--benefits .perf-web-scene__heading {
    margin: 0 0 2.5%;
  }

  .perf-laptop--lite .perf-benefit-grid {
    gap: 3.4%;
    height: 72%;
  }

  .perf-laptop--lite .perf-benefit-grid article {
    padding: 5.5%;
    border-color: rgba(43, 129, 212, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.93);
    box-shadow: 0 7px 14px rgba(28, 80, 124, 0.08);
  }

  .perf-laptop--lite .perf-benefit-grid article:nth-child(4) {
    background: #dff2fb;
  }

  .perf-laptop--lite .perf-benefit-grid article.is-featured {
    border-color: rgba(255, 255, 255, 0.18);
    background: linear-gradient(135deg, var(--ink-navy), #1d619a);
  }

  .perf-laptop--lite .perf-benefit-grid article > i {
    flex-basis: 23%;
    border-radius: 12px;
    font-weight: 800;
  }

  .perf-laptop--lite .perf-web-scene--results {
    inset: 14% 3.2% 4%;
    border: 1px solid rgba(43, 129, 212, 0.13);
    border-radius: 18px;
    background: #e5f3fc;
  }

  .perf-laptop--lite .perf-web-scene--results::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2.5%;
    background: linear-gradient(90deg, var(--accent-deep) 0 26%, var(--sky-top) 26% 69%, #45cdb9 69% 100%);
  }

  .perf-laptop--lite .perf-web-scene--results .perf-web-scene__heading {
    top: 10%;
    left: 5%;
    width: 43%;
  }

  .perf-laptop--lite .perf-web-scene--results .perf-web-scene__eyebrow {
    margin-bottom: 4%;
    font-size: clamp(6px, 0.5vw, 9px);
  }

  .perf-laptop--lite .perf-web-scene--results .perf-web-scene__heading h3 {
    font-size: clamp(18px, 1.72vw, 31px);
    line-height: 0.92;
  }

  .perf-laptop--lite .perf-web-scene--results .perf-web-scene__heading p {
    margin-top: 3%;
    font-size: clamp(8px, 0.64vw, 12px);
    font-weight: 620;
  }

  .perf-laptop--lite .perf-result-story {
    position: absolute;
    left: 5%;
    bottom: 8%;
    display: grid;
    align-content: start;
    width: 42%;
    height: 36%;
    padding: 4.2%;
    overflow: hidden;
    border: 1px solid rgba(43, 129, 212, 0.14);
    border-radius: 13px;
    background: #ffffff;
  }

  .perf-laptop--lite .perf-result-story span {
    font-size: clamp(6px, 0.48vw, 9px);
    font-weight: 780;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sky-top);
  }

  .perf-laptop--lite .perf-result-story strong {
    width: 57%;
    margin-top: 3%;
    font-size: clamp(8px, 0.68vw, 12px);
    line-height: 1.08;
    color: var(--ink-navy);
  }

  .perf-laptop--lite .perf-result-story i {
    position: absolute;
    right: 6%;
    bottom: 13%;
    width: 40%;
    height: 59%;
