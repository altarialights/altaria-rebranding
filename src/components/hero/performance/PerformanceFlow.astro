---
import { flow, growthBeat } from '../../../data/hero';

interface Props {
  tier: 'balanced' | 'lite';
}

const { tier } = Astro.props;

const nodeIcons: Record<string, readonly string[]> = {
  contenido: ['M8 5.5v13L19 12 8 5.5Z'],
  marca: ['m12 3.5 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L12 3.5Z'],
  web: ['M3.5 5.5h17v13h-17v-13Z', 'M3.5 9h17', 'M6.2 7.2h.01', 'M8.5 7.2h.01'],
  software: ['m9 7-5 5 5 5', 'm15 7 5 5-5 5', 'm13.5 5-3 14'],
  contacto: ['M8.5 4 10 8 7.8 9.4a14 14 0 0 0 6.8 6.8L16 14l4 1.5-.6 3.3c-.2 1-1.1 1.7-2.1 1.7C9.7 19.9 4.1 14.3 3.5 6.7c0-1 .7-1.9 1.7-2.1L8.5 4Z'],
};
---

<div
  class={`perf-flow perf-flow--${tier}`}
  data-perf-object="flow"
  role="group"
  aria-label={`${growthBeat.title.join(' ')} ${growthBeat.sub}`}
  inert
>
  {tier === 'balanced' ? (
    <>
      <svg class="perf-flow__connections" viewBox="0 0 1000 720" aria-hidden="true">
        <path d="M500 138 C500 218 500 252 500 310" />
        <path d="M864 264 C760 264 688 302 618 352" />
        <path d="M810 646 C728 588 658 522 596 456" />
        <path d="M190 646 C272 588 342 522 404 456" />
        <path d="M136 264 C240 264 312 302 382 352" />
      </svg>
      <figure class="perf-flow__business" aria-label="Tu negocio, centro del ecosistema Altaria">
        <img
          data-perf-flow-image
          data-src="/media/performance/balanced/centro-nodos-512.png"
          width="512"
          height="418"
          alt="Tu negocio"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </>
  ) : (
    <>
      <svg class="perf-flow__connections" viewBox="0 0 1000 720" aria-hidden="true">
        <path d="M500 138 C500 218 500 252 500 310" />
        <path d="M864 264 C760 264 688 302 618 352" />
        <path d="M810 646 C728 588 658 522 596 456" />
        <path d="M190 646 C272 588 342 522 404 456" />
        <path d="M136 264 C240 264 312 302 382 352" />
      </svg>
      <figure class="perf-flow__business perf-flow__business--lite" aria-label="Tu negocio, centro del ecosistema Altaria">
        <img
          data-perf-flow-image
          data-src="/media/performance/lite/centro-nodos-384.png"
          width="384"
          height="314"
          alt="Tu negocio"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </>
  )}

  <nav class="perf-flow__nodes" aria-label={growthBeat.sub}>
    {flow.map((node, index) => (
      <a
        class={`perf-flow__node perf-flow__node--${index + 1}`}
        data-perf-flow-node={node.id}
        href={node.href}
        title={node.tooltip}
      >
        {tier === 'balanced' ? (
          <span class="perf-flow__node-surface">
            <span class="perf-flow__node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {nodeIcons[node.id].map((path) => <path d={path} />)}
              </svg>
            </span>
            <span class="perf-flow__node-copy">
              <strong>{node.label}</strong>
              <small>{node.micro}</small>
            </span>
            <span class="perf-flow__node-arrow" aria-hidden="true">
              <svg viewBox="0 0 20 20">
                <path d="M5 10h9M10.5 6.5 14 10l-3.5 3.5" />
              </svg>
            </span>
          </span>
        ) : (
          <span class="perf-flow__node-surface">
            <span class="perf-flow__node-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {nodeIcons[node.id].map((path) => <path d={path} />)}
              </svg>
            </span>
            <span class="perf-flow__node-copy">
              <strong>{node.label}</strong>
              <small>{node.micro}</small>
            </span>
          </span>
        )}
      </a>
    ))}
  </nav>
</div>

<style>
  .perf-flow {
    position: absolute;
    z-index: 4;
    top: 18%;
    left: 47%;
    width: clamp(510px, 46vw, 820px);
    aspect-ratio: 1.55;
    opacity: 0;
    pointer-events: none;
  }

  .perf-flow--balanced {
    left: 50%;
  }

  .perf-flow__connections {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .perf-flow__connections path {
    fill: none;
    stroke: rgba(247, 252, 255, 0.88);
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .perf-flow__business {
    position: absolute;
    z-index: 2;
    top: 45.5%;
    left: 50%;
    width: 34%;
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .perf-flow__business::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 21% 13% 9%;
    border-radius: 50%;
    background: rgba(219, 241, 255, 0.42);
    box-shadow: 0 18px 36px rgba(28, 76, 121, 0.14);
  }

  .perf-flow__business img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .perf-flow__hub {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 21%;
    transform: translate(-50%, -50%);
  }

  .perf-flow__hub img {
    width: 76%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .perf-flow__hub small {
    font-family: 'Lemon Milk', var(--font-sans);
    font-size: clamp(6px, 0.56vw, 10px);
    letter-spacing: 0.06em;
    color: var(--ink-navy);
    white-space: nowrap;
  }

  .perf-flow__nodes {
    position: absolute;
    inset: 0;
  }

  .perf-flow__node {
    position: absolute;
    z-index: 3;
    display: grid;
    align-content: center;
    gap: 5px;
    width: 31%;
    min-height: 20%;
    padding: 3.2% 3.8% 3.4%;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 18px;
    text-decoration: none;
    color: var(--ink-navy);
    background: rgba(249, 253, 255, 0.96);
    box-shadow:
      0 14px 28px rgba(39, 89, 132, 0.15),
      inset 0 3px 0 rgba(91, 177, 232, 0.32);
    pointer-events: auto;
  }

  .perf-flow--balanced .perf-flow__node {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .perf-flow--balanced .perf-flow__node--1 { --node-accent: #2b81d4; }
  .perf-flow--balanced .perf-flow__node--2 { --node-accent: #62aee0; }
  .perf-flow--balanced .perf-flow__node--3 { --node-accent: #206cad; }
  .perf-flow--balanced .perf-flow__node--4 { --node-accent: #12335f; }
  .perf-flow--balanced .perf-flow__node--5 { --node-accent: #438fca; }
  .perf-flow--lite .perf-flow__node--1 { --node-accent: #2b81d4; }
  .perf-flow--lite .perf-flow__node--2 { --node-accent: #62aee0; }
  .perf-flow--lite .perf-flow__node--3 { --node-accent: #206cad; }
  .perf-flow--lite .perf-flow__node--4 { --node-accent: #12335f; }
  .perf-flow--lite .perf-flow__node--5 { --node-accent: #438fca; }

  .perf-flow__node-surface {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(9px, 0.8vw, 14px);
    width: 100%;
    min-height: 100%;
    padding: clamp(13px, 1.2vw, 19px);
    overflow: hidden;
    border: 1px solid rgba(219, 235, 247, 0.96);
    border-radius: 18px;
    background: linear-gradient(145deg, #ffffff 0%, #f4faff 100%);
    box-shadow:
      0 14px 28px rgba(27, 72, 112, 0.15),
      inset 0 1px 0 #ffffff;
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }

  .perf-flow__node-icon {
    display: grid;
    place-items: center;
    width: clamp(34px, 2.5vw, 42px);
    aspect-ratio: 1;
    border: 1px solid rgba(43, 129, 212, 0.13);
    border-radius: 12px;
    color: var(--node-accent);
    background: #eaf5fd;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .perf-flow__node-icon svg {
    width: 54%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .perf-flow__node-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .perf-flow__node-copy strong {
    font-family: 'Lemon Milk', var(--font-sans);
    font-size: clamp(11px, 0.92vw, 16px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.015em;
  }

  .perf-flow__node-copy small {
    overflow: hidden;
    font-size: clamp(9px, 0.64vw, 11px);
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-soft);
  }

  .perf-flow__node-arrow {
    display: grid;
    place-items: center;
    width: clamp(24px, 1.7vw, 30px);
    aspect-ratio: 1;
    border: 1px solid rgba(18, 51, 95, 0.1);
    border-radius: 50%;
    color: var(--node-accent);
    background: rgba(255, 255, 255, 0.82);
  }

  .perf-flow__node-arrow svg {
    width: 62%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .perf-flow--balanced .perf-flow__node:hover .perf-flow__node-surface,
  .perf-flow--balanced .perf-flow__node:focus-visible .perf-flow__node-surface {
    transform: translateY(-4px);
    border-color: var(--node-accent);
    box-shadow:
      0 20px 34px rgba(24, 71, 112, 0.2),
      inset 0 1px 0 #ffffff;
  }

  .perf-flow--balanced .perf-flow__node:focus-visible {
    outline: none;
  }

  .perf-flow--balanced .perf-flow__node:focus-visible .perf-flow__node-surface {
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.84),
      0 0 0 5px var(--node-accent),
      0 20px 34px rgba(24, 71, 112, 0.2);
  }

  .perf-flow__node--1 { top: 0; left: 34.5%; }
  .perf-flow__node--2 { top: 27%; right: 0; }
  .perf-flow__node--3 { right: 5.5%; bottom: 0; }
  .perf-flow__node--4 { left: 5.5%; bottom: 0; }
  .perf-flow__node--5 { top: 27%; left: 0; }

  .perf-flow--lite {
    top: 22%;
    left: 50%;
    width: clamp(540px, 47vw, 840px);
    aspect-ratio: 1.55;
  }

  .perf-flow--lite .perf-flow__business {
    top: 46.5%;
    width: 41%;
  }

  .perf-flow--lite .perf-flow__business::before {
    inset: 20% 12% 8%;
    background: rgba(219, 241, 255, 0.5);
    box-shadow: 0 15px 28px rgba(28, 76, 121, 0.13);
  }

  .perf-flow--lite .perf-flow__node {
    width: 32%;
    min-height: 18.5%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .perf-flow--lite .perf-flow__node-surface {
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(9px, 0.78vw, 13px);
    padding: clamp(11px, 1vw, 16px) clamp(24px, 2.2vw, 38px) clamp(11px, 1vw, 16px) clamp(11px, 1vw, 16px);
    border-color: rgba(210, 231, 246, 0.98);
    border-radius: 17px;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--node-accent) 11%, transparent) 0 22%, transparent 23%),
      linear-gradient(145deg, #ffffff 0%, #f3faff 100%);
    box-shadow:
      0 13px 24px rgba(27, 72, 112, 0.14),
      inset 0 1px 0 #ffffff;
  }

  .perf-flow--lite .perf-flow__node-surface::after {
    content: '';
    position: absolute;
    top: 50%;
    right: clamp(10px, 0.9vw, 15px);
    width: 4px;
    height: 26%;
    border-radius: 999px;
    background: var(--node-accent);
    opacity: 0.32;
    transform: translateY(-50%);
  }

  .perf-flow--lite .perf-flow__node-icon {
    width: clamp(32px, 2.45vw, 42px);
    border-radius: 12px;
  }

  .perf-flow--lite .perf-flow__node-copy strong {
    font-size: clamp(11px, 0.88vw, 15px);
  }

  .perf-flow--lite .perf-flow__node-copy small {
    font-size: clamp(8px, 0.61vw, 10.5px);
  }

  .perf-flow--lite .perf-flow__node:hover .perf-flow__node-surface,
  .perf-flow--lite .perf-flow__node:focus-visible .perf-flow__node-surface {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--node-accent) 48%, #d2e7f6);
    box-shadow:
      0 17px 28px rgba(24, 71, 112, 0.18),
      inset 0 1px 0 #ffffff;
  }

  .perf-flow--lite .perf-flow__node--1 { top: -1%; left: 34%; }
  .perf-flow--lite .perf-flow__node--2 { top: 26%; right: -1%; }
  .perf-flow--lite .perf-flow__node--3 { right: 2%; bottom: -1%; }
  .perf-flow--lite .perf-flow__node--4 { left: 2%; bottom: -1%; }
  .perf-flow--lite .perf-flow__node--5 { top: 26%; left: -1%; }

  @media (max-width: 1440px) and (min-width: 1200px) {
    .perf-flow__node-arrow {
      display: none;
    }
  }

  @media (max-width: 1199px) and (min-width: 1020px) {
    .perf-flow {
      left: 47%;
      width: clamp(500px, 49vw, 570px);
    }

    .perf-flow--balanced {
      left: 50%;
    }

    .perf-flow--lite {
      left: 50%;
      width: clamp(510px, 49vw, 570px);
    }

    .perf-flow--balanced .perf-flow__node {
      width: 33%;
    }

    .perf-flow--balanced .perf-flow__node--1 {
      left: 33.5%;
    }

    .perf-flow--balanced .perf-flow__node--3 {
      right: 1%;
    }

    .perf-flow--balanced .perf-flow__node--4 {
      left: 1%;
    }

    .perf-flow--lite .perf-flow__node {
      width: 33%;
    }

    .perf-flow--lite .perf-flow__node--1 {
      left: 33.5%;
    }

    .perf-flow--lite .perf-flow__node--3 {
      right: 1%;
    }

    .perf-flow--lite .perf-flow__node--4 {
      left: 1%;
    }

    .perf-flow--lite .perf-flow__node-surface {
      gap: 7px;
      padding: 10px 24px 10px 10px;
    }

    .perf-flow--lite .perf-flow__node-icon {
      width: 30px;
    }

    .perf-flow__node-surface {
      gap: 8px;
      padding: 10px;
    }

    .perf-flow__node-icon {
      width: 30px;
      border-radius: 10px;
    }

    .perf-flow__node-arrow {
      display: none;
    }
  }

  @media (max-height: 660px) and (min-width: 1020px) {
    .perf-flow {
      top: 15%;
      width: clamp(475px, 46vw, 540px);
    }

    .perf-flow--lite {
      top: 18%;
    }

    .perf-flow__node {
      min-height: 18%;
    }
  }
</style>
