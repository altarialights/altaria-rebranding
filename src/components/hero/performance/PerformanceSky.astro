---
import { sunSignature } from '../../../data/hero';

interface Props {
  tier: 'balanced' | 'lite';
}

const { tier } = Astro.props;
const cloudCount = tier === 'balanced' ? 5 : 3;
---

<div class={`perf-sky perf-sky--${tier}`} data-perf-sky>
  <button
    class="perf-sky__sun"
    type="button"
    data-perf-easter="sun"
    aria-label={sunSignature.label}
  ></button>

  <div class="perf-sky__clouds" data-perf-clouds aria-hidden="true">
    {Array.from({ length: cloudCount }, (_, index) => (
      <i class={`perf-sky__cloud perf-sky__cloud--${index + 1}`} data-perf-cloud={index + 1}></i>
    ))}
  </div>

  <span class="perf-event perf-event--birds-a" data-perf-easter="birds-a" aria-hidden="true">
    {tier === 'balanced' && (
      <svg viewBox="0 0 48 18" aria-hidden="true">
        <path d="M2 12c5-7 10-7 15 0M18 9c4-6 9-6 14 0M34 12c4-5 8-5 12 0" />
      </svg>
    )}
  </span>
  <span class="perf-event perf-event--plane" data-perf-easter="plane" aria-hidden="true">
    {tier === 'balanced' && (
      <svg viewBox="0 0 58 22" aria-hidden="true">
        <path d="m3 12 21-3 12-7 4 1-5 7 17 2 3 3-20 1-8 5-4-1 3-5-23 1z" />
      </svg>
    )}
  </span>
  <span class="perf-event perf-event--birds-b" data-perf-easter="birds-b" aria-hidden="true">
    {tier === 'balanced' && (
      <svg viewBox="0 0 34 15" aria-hidden="true">
        <path d="M1 11c4-6 8-6 12 0M16 8c5-6 10-6 15 0" />
      </svg>
    )}
  </span>
  <span class="perf-event perf-event--rocket" data-perf-easter="rocket" aria-hidden="true">
    {tier === 'balanced' && (
      <svg viewBox="0 0 28 58" aria-hidden="true">
        <path d="M14 2C7 10 6 24 8 37h12c2-13 1-27-6-35Z" />
        <path d="M8 32 3 42l6-2m11-8 5 10-6-2M11 43h6l-3 12z" />
        <circle cx="14" cy="21" r="3.5" />
      </svg>
    )}
  </span>

  <aside class={`perf-sun-message perf-sun-message--${tier}`} data-perf-sun-message hidden aria-live="polite">
    <span class="perf-sun-message__content">
      <small data-perf-sun-intro>{sunSignature.intro}</small>
      <strong data-perf-sun-line>
        {sunSignature.line.map((line) => <span>{line}</span>)}
      </strong>
    </span>
  </aside>

  <span class={`perf-sun-bubble perf-sun-bubble--${tier}`} data-perf-sun-bubble hidden role="status">
    {sunSignature.encore}
  </span>

  <span class="perf-reaction" data-perf-reaction hidden aria-hidden="true"></span>
</div>

<style>
  .perf-sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 52%, var(--sky-haze) 100%);
    pointer-events: none;
  }

  .perf-sky::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0;
    background: rgba(15, 44, 86, 0.16);
    transition: opacity 260ms var(--ease-out);
    pointer-events: none;
  }

  :global([data-perf-sun-open='1']) .perf-sky::after {
    opacity: 1;
  }

  .perf-sky--lite {
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-haze) 100%);
  }

  .perf-sky__sun {
    position: absolute;
    top: clamp(76px, 11vh, 126px);
    right: clamp(46px, 8vw, 156px);
    width: clamp(26px, 2.6vw, 48px);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fffdf6;
    box-shadow:
      0 0 0 12px rgba(255, 253, 246, 0.11),
      0 0 34px 16px rgba(255, 253, 235, 0.46),
      0 0 74px 36px rgba(255, 253, 235, 0.16);
    pointer-events: auto;
  }

  .perf-sky__clouds {
    position: absolute;
    inset: 0;
  }

  .perf-sky__cloud {
    position: absolute;
    display: block;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(228, 242, 252, 0.98));
    box-shadow: 0 18px 32px rgba(65, 128, 180, 0.16);
  }

  .perf-sky__cloud::before,
  .perf-sky__cloud::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(160deg, #ffffff, #e8f3fb);
  }

  .perf-sky__cloud::before {
    top: -45%;
    left: 12%;
    width: 46%;
    height: 120%;
  }

  .perf-sky__cloud::after {
    top: -34%;
    right: 8%;
    width: 54%;
    height: 132%;
  }

  .perf-sky__cloud--1 {
    left: -8%;
    top: 55%;
    width: 34vw;
    height: 19vh;
    opacity: 0.38;
  }

  .perf-sky__cloud--2 {
    right: -9%;
    top: 45%;
    width: 29vw;
    height: 17vh;
    opacity: 0.3;
  }

  .perf-sky__cloud--3 {
    left: -5%;
    bottom: -12%;
    width: 62vw;
    height: 32vh;
  }

  .perf-sky__cloud--4 {
    right: -4%;
    bottom: -14%;
    width: 62vw;
    height: 35vh;
  }

  .perf-sky__cloud--5 {
    left: 38%;
    bottom: -20%;
    width: 42vw;
    height: 30vh;
    opacity: 0.84;
  }

  .perf-event {
    position: absolute;
    z-index: 5;
    display: block;
    opacity: 0;
    cursor: pointer;
    pointer-events: none;
  }

  .perf-event svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .perf-event--birds-a,
  .perf-event--birds-b {
    color: rgba(15, 44, 86, 0.58);
  }

  .perf-event--birds-a {
    top: 22%;
    left: 13%;
    width: 48px;
  }

  .perf-event--birds-b {
    top: 29%;
    right: 18%;
    width: 34px;
  }

  .perf-event--birds-a path,
  .perf-event--birds-b path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .perf-event--plane {
    top: 18%;
    left: -8%;
    width: 58px;
    color: rgba(255, 255, 255, 0.86);
  }

  .perf-event--plane path {
    fill: currentColor;
  }

  .perf-event--rocket {
    right: 13%;
    bottom: -10%;
    width: 28px;
    color: rgba(255, 255, 255, 0.94);
  }

  .perf-event--rocket path,
  .perf-event--rocket circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .perf-sky--lite .perf-event--birds-a,
  .perf-sky--lite .perf-event--birds-b {
    height: 11px;
    border-top: 2px solid currentColor;
    border-radius: 50%;
  }

  .perf-sky--lite .perf-event--plane {
    height: 18px;
    background: currentColor;
    clip-path: polygon(0 48%, 38% 34%, 63% 0, 72% 5%, 64% 37%, 96% 46%, 100% 61%, 63% 60%, 45% 90%, 36% 86%, 41% 59%, 0 64%);
  }

  .perf-sky--lite .perf-event--rocket {
    height: 48px;
    border: 2px solid currentColor;
    border-radius: 50% 50% 22% 22%;
  }

  .perf-sun-message {
    position: absolute;
    z-index: 6;
    top: 31%;
    left: 50%;
    width: min(78vw, 760px);
    padding: clamp(18px, 2.2vw, 32px);
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 22px;
    text-align: center;
    color: #ffffff;
    background: rgba(15, 44, 86, 0.9);
    box-shadow: 0 18px 36px rgba(15, 44, 86, 0.2);
    pointer-events: none;
  }

  .perf-sun-message[hidden],
  .perf-sun-bubble[hidden] {
    display: none;
  }

  .perf-sun-message--balanced {
    z-index: 7;
    inset: 0;
    display: grid;
    width: auto;
    padding: clamp(92px, 12vh, 138px) clamp(34px, 7vw, 140px) clamp(54px, 8vh, 96px);
    place-items: center;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(circle at 90% 12%, rgba(255, 255, 255, 0.16), transparent 20%),
      radial-gradient(ellipse 40% 28% at 8% 100%, rgba(116, 176, 220, 0.38) 0 72%, transparent 73%),
      radial-gradient(ellipse 46% 32% at 54% 107%, rgba(108, 169, 216, 0.34) 0 71%, transparent 72%),
      radial-gradient(ellipse 38% 25% at 94% 100%, rgba(130, 186, 225, 0.3) 0 70%, transparent 71%),
      linear-gradient(160deg, #08264f, #164e84 58%, #2976b5);
    box-shadow: none;
  }

  .perf-sun-message--lite {
    z-index: 7;
    inset: 0;
    display: grid;
    width: auto;
    padding: clamp(88px, 12vh, 132px) clamp(34px, 7vw, 130px) clamp(48px, 8vh, 86px);
    place-items: center;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(ellipse 44% 25% at 8% 104%, rgba(118, 178, 220, 0.34) 0 72%, transparent 73%),
      radial-gradient(ellipse 52% 28% at 55% 108%, rgba(105, 167, 214, 0.3) 0 71%, transparent 72%),
      linear-gradient(155deg, #0b2d58 0%, #18578d 58%, #2b81bd 100%);
    box-shadow: none;
  }

  .perf-sun-message__content {
    display: grid;
    width: min(90vw, 1500px);
    justify-items: center;
    text-align: center;
  }

  .perf-sun-message small,
  .perf-sun-message strong,
  .perf-sun-message strong span {
    display: block;
  }

  .perf-sun-message small {
    margin-bottom: 0.55rem;
    font-size: clamp(11px, 0.9vw, 14px);
    letter-spacing: 0.08em;
  }

  .perf-sun-message strong {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 54px);
    line-height: 0.96;
  }

  .perf-sun-message--balanced small {
    margin-bottom: clamp(16px, 2.2vh, 28px);
    font-size: clamp(12px, 0.88vw, 17px);
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(235, 246, 255, 0.9);
  }

  .perf-sun-message--balanced strong {
    font-size: clamp(50px, 6.2vw, 122px);
    line-height: 0.88;
    letter-spacing: -0.012em;
    text-shadow: 0 12px 28px rgba(5, 28, 60, 0.24);
  }

  .perf-sun-message--balanced strong span {
    display: block;
    white-space: nowrap;
  }

  .perf-sun-message--lite small {
    margin-bottom: clamp(12px, 1.8vh, 22px);
    font-size: clamp(11px, 0.78vw, 15px);
    font-weight: 720;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(235, 246, 255, 0.9);
  }

  .perf-sun-message--lite strong {
    font-size: clamp(44px, 5.25vw, 102px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-shadow: 0 9px 22px rgba(5, 28, 60, 0.2);
  }

  .perf-sun-message--lite strong span {
    white-space: nowrap;
  }

  .perf-sun-bubble {
    position: absolute;
    z-index: 8;
    top: clamp(134px, 18vh, 198px);
    right: clamp(34px, 6vw, 118px);
    max-width: min(290px, 34vw);
    padding: 11px 16px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 999px 999px 18px 999px;
    font-size: clamp(11px, 0.82vw, 14px);
    font-weight: 650;
    line-height: 1.25;
    color: var(--ink-navy);
    background: #f7fbff;
    box-shadow: 0 12px 24px rgba(15, 44, 86, 0.16);
    pointer-events: none;
  }

  .perf-sun-bubble--lite {
    top: clamp(118px, 16vh, 178px);
    right: clamp(28px, 5vw, 94px);
    max-width: min(250px, 32vw);
    padding: 9px 14px;
  }

  .perf-reaction {
    position: absolute;
    z-index: 7;
    top: var(--reaction-y, 50%);
    left: var(--reaction-x, 50%);
    width: 38px;
    aspect-ratio: 1;
    border: 2px solid rgba(255, 255, 255, 0.94);
    border-radius: 50%;
    pointer-events: none;
  }

  @media (max-height: 660px) and (min-width: 1020px) {
    .perf-sky__cloud--1,
    .perf-sky__cloud--2 {
      top: 50%;
    }

    .perf-sky__cloud--3,
    .perf-sky__cloud--4,
    .perf-sky__cloud--5 {
      height: 28vh;
    }

    .perf-sun-message--balanced {
      padding-top: 82px;
    }

    .perf-sun-message--balanced strong {
      font-size: clamp(44px, 5.6vw, 70px);
    }

    .perf-sun-message--lite {
      padding-top: 78px;
    }

    .perf-sun-message--lite strong {
      font-size: clamp(40px, 5vw, 64px);
    }
  }
</style>
