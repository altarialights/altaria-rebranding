---
import { softwareBeat } from '../../../data/hero';

interface Props {
  tier: 'balanced' | 'lite';
}

const { tier } = Astro.props;
const moduleCount = tier === 'balanced' ? 5 : 3;
---

<figure
  class={`perf-monitor perf-monitor--${tier}`}
  data-perf-object="monitor"
  role="img"
  aria-label={tier === 'lite'
    ? 'Interfaz conceptual de un panel operativo con proyectos, tareas, actividad semanal y flujo de trabajo'
    : softwareBeat.screenLabel}
>
  <div class="perf-monitor__tilt">
    <div class="perf-monitor__frame">
      <div class="perf-monitor__screen">
        {tier === 'balanced' ? (
          <>
            <span class="perf-monitor__rail" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </span>
            <span class="perf-monitor__topbar" aria-hidden="true"><i></i><b></b></span>
            <span class="perf-monitor__workspace" aria-hidden="true">
              <span class="perf-monitor__code"><i></i><i></i><i></i><i></i></span>
              <span class="perf-monitor__chart"><i></i><i></i><i></i><i></i></span>
              {Array.from({ length: moduleCount }, (_, index) => (
                <span class={`perf-monitor__module perf-monitor__module--${index + 1}`}></span>
              ))}
            </span>
          </>
        ) : (
          <span class="perf-monitor__lite-ui" aria-hidden="true">
            <span class="perf-monitor__lite-rail"><b>A</b><i></i><i></i><i></i></span>
            <span class="perf-monitor__lite-header">
              <span><small>Altaria OS</small><b>Panel operativo</b></span>
              <i>En marcha</i>
            </span>
            <span class="perf-monitor__lite-workspace">
              <span class="perf-monitor__lite-metrics">
                <b data-label="Proyectos">12</b>
                <b data-label="Tareas hoy">8</b>
                <b data-label="Equipo">6</b>
              </span>
              <span class="perf-monitor__lite-activity"><b>Actividad semanal</b><i></i></span>
              <span class="perf-monitor__lite-pipeline">
                <b>Flujo de trabajo</b>
                <i data-task="Propuesta" data-state="Listo"></i>
                <i data-task="Diseño" data-state="En curso"></i>
                <i data-task="Entrega" data-state="Próximo"></i>
              </span>
            </span>
          </span>
        )}
      </div>
    </div>
    <span class="perf-monitor__neck" aria-hidden="true"></span>
    <span class="perf-monitor__foot" aria-hidden="true"></span>
  </div>
</figure>

<style>
  .perf-monitor {
    position: absolute;
    z-index: 3;
    top: 23%;
    left: 51%;
    width: clamp(500px, 43vw, 790px);
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .perf-monitor__tilt {
    position: relative;
    padding-bottom: 17%;
    transform: rotate(1.4deg);
  }

  .perf-monitor__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    padding: 1.7%;
    border-radius: 3% / 4.8%;
    background: linear-gradient(145deg, #f0f3f5 0%, #c4cdd3 58%, #8f9ca5 100%);
    box-shadow:
      14px 22px 34px rgba(42, 78, 109, 0.22),
      0 1px 0 rgba(255, 255, 255, 0.82) inset;
  }

  .perf-monitor--lite .perf-monitor__frame {
    padding: 1.3%;
    border: 3px solid #b7c1c8;
    background: #dce3e7;
    box-shadow: 8px 16px 24px rgba(42, 78, 109, 0.16);
  }

  .perf-monitor__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.6% / 2.8%;
    background: linear-gradient(145deg, #f6fbff 0%, #dceefb 100%);
  }

  .perf-monitor__rail {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8%;
    width: 11%;
    padding-top: 13%;
    background: linear-gradient(180deg, var(--ink-navy), var(--accent-deep));
  }

  .perf-monitor__rail i {
    width: 36%;
    aspect-ratio: 1;
    border-radius: 28%;
    background: rgba(255, 255, 255, 0.2);
  }

  .perf-monitor__rail i:first-child {
    background: #ffffff;
  }

  .perf-monitor__topbar {
    position: absolute;
    top: 4%;
    left: 15%;
    right: 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8%;
  }

  .perf-monitor__topbar i {
    width: 31%;
    height: 20%;
    border-radius: 999px;
    background: #9eb7cb;
  }

  .perf-monitor__topbar b {
    width: 18%;
    height: 70%;
    border-radius: 999px;
    background: var(--sky-top);
  }

  .perf-monitor__workspace {
    position: absolute;
    inset: 16% 4% 6% 15%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    grid-template-rows: 1fr 0.72fr;
    gap: 4%;
  }

  .perf-monitor__lite-ui {
    position: absolute;
    inset: 3%;
    overflow: hidden;
    border: 1px solid rgba(43, 129, 212, 0.14);
    border-radius: 3%;
    color: var(--ink-navy);
    background: #edf6fc;
  }

  .perf-monitor__lite-rail {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9%;
    width: 11%;
    padding-top: 7%;
    background: var(--ink-navy);
  }

  .perf-monitor__lite-rail b {
    display: grid;
    place-items: center;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 9px;
    font-family: var(--font-brand);
    font-size: clamp(8px, 0.78vw, 14px);
    color: #ffffff;
    background: var(--sky-top);
  }

  .perf-monitor__lite-rail i {
    width: 30%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 7px;
  }

  .perf-monitor__lite-rail i:first-of-type {
    background: rgba(255, 255, 255, 0.18);
  }

  .perf-monitor__lite-header {
    position: absolute;
    top: 0;
    left: 11%;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 19%;
    padding: 0 4%;
    border-bottom: 1px solid #d3e5f1;
    background: #ffffff;
  }

  .perf-monitor__lite-header > span {
    display: grid;
    gap: 2px;
  }

  .perf-monitor__lite-header small {
    font-size: clamp(5px, 0.42vw, 8px);
    font-weight: 720;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sky-top);
  }

  .perf-monitor__lite-header b {
    font-size: clamp(9px, 0.82vw, 15px);
    line-height: 1;
  }

  .perf-monitor__lite-header > i {
    padding: 1.8% 3%;
    border: 1px solid #bfe9df;
    border-radius: 999px;
    font-size: clamp(5px, 0.44vw, 8px);
    font-style: normal;
    font-weight: 720;
    color: #167766;
    background: #e3f8f3;
  }

  .perf-monitor__lite-workspace {
    position: absolute;
    inset: 23% 3.5% 5% 14.5%;
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    grid-template-rows: 28% 1fr;
    gap: 5%;
  }

  .perf-monitor__lite-metrics {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3%;
  }

  .perf-monitor__lite-metrics b {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 10% 9% 8%;
    border: 1px solid #d2e4f0;
    border-radius: 10px;
    font-size: clamp(12px, 1.2vw, 21px);
    line-height: 1;
    background: #ffffff;
  }

  .perf-monitor__lite-metrics b::before {
    content: attr(data-label);
    position: absolute;
    top: 12%;
    left: 9%;
    font-size: clamp(5px, 0.43vw, 8px);
    font-weight: 650;
    color: var(--ink-soft);
  }

  .perf-monitor__lite-metrics b::after {
    content: '↗';
    margin-left: auto;
    font-size: clamp(7px, 0.65vw, 12px);
    color: var(--sky-top);
  }

  .perf-monitor__lite-activity,
  .perf-monitor__lite-pipeline {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d2e4f0;
    border-radius: 11px;
    background: #ffffff;
  }

  .perf-monitor__lite-activity {
    padding: 8% 7%;
  }

  .perf-monitor__lite-activity b,
  .perf-monitor__lite-pipeline > b {
    display: block;
    font-size: clamp(6px, 0.53vw, 10px);
    text-transform: uppercase;
  }

  .perf-monitor__lite-activity i {
    position: absolute;
    inset: 29% 8% 12%;
    border-bottom: 1px solid #bed6e8;
    background:
      linear-gradient(#9cccec 0 0) 3% 100% / 9% 31% no-repeat,
      linear-gradient(#72b7e7 0 0) 22% 100% / 9% 49% no-repeat,
      linear-gradient(var(--sky-top) 0 0) 41% 100% / 9% 68% no-repeat,
      linear-gradient(#45cdb9 0 0) 60% 100% / 9% 58% no-repeat,
      linear-gradient(var(--accent-deep) 0 0) 79% 100% / 9% 86% no-repeat,
      linear-gradient(var(--sky-top) 0 0) 98% 100% / 9% 74% no-repeat;
  }

  .perf-monitor__lite-pipeline {
    display: grid;
    grid-template-rows: auto repeat(3, 1fr);
    gap: 5%;
    padding: 9%;
  }

  .perf-monitor__lite-pipeline i {
    position: relative;
    min-height: 0;
    border-bottom: 1px solid #dbe9f3;
    font-style: normal;
  }

  .perf-monitor__lite-pipeline i::before,
  .perf-monitor__lite-pipeline i::after {
    position: absolute;
    top: 37%;
    transform: translateY(-50%);
  }

  .perf-monitor__lite-pipeline i::before {
    content: attr(data-task);
    left: 0;
    font-size: clamp(5px, 0.43vw, 8px);
    font-weight: 650;
  }

  .perf-monitor__lite-pipeline i::after {
    content: attr(data-state);
    right: 0;
    font-size: clamp(4.5px, 0.38vw, 7px);
    color: var(--sky-top);
  }

  .perf-monitor__code,
  .perf-monitor__chart,
  .perf-monitor__module {
    border: 1px solid rgba(43, 129, 212, 0.13);
    border-radius: 7%;
    background: rgba(255, 255, 255, 0.84);
  }

  .perf-monitor__code {
    display: grid;
    align-content: center;
    gap: 8%;
    padding: 10%;
  }

  .perf-monitor__code i {
    height: 5px;
    border-radius: 999px;
    background: #abc6da;
  }

  .perf-monitor__code i:nth-child(1) { width: 65%; background: var(--sky-top); }
  .perf-monitor__code i:nth-child(2) { width: 88%; }
  .perf-monitor__code i:nth-child(3) { width: 76%; }
  .perf-monitor__code i:nth-child(4) { width: 54%; background: #45cdb9; }

  .perf-monitor__chart {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 8%;
    padding: 13%;
  }

  .perf-monitor__chart i {
    width: 13%;
    height: 34%;
    border-radius: 3px 3px 0 0;
    background: var(--sky-mid);
  }

  .perf-monitor__chart i:nth-child(2) { height: 55%; }
  .perf-monitor__chart i:nth-child(3) { height: 75%; background: var(--sky-top); }
  .perf-monitor__chart i:nth-child(4) { height: 92%; background: #45cdb9; }

  .perf-monitor__module {
    min-width: 0;
  }

  .perf-monitor__module--1,
  .perf-monitor__module--2,
  .perf-monitor__module--3,
  .perf-monitor__module--4,
  .perf-monitor__module--5 {
    grid-row: 2;
  }

  .perf-monitor__module--1 { grid-column: 1; width: 30%; }
  .perf-monitor__module--2 { grid-column: 1; width: 30%; margin-left: 35%; background: rgba(43, 129, 212, 0.12); }
  .perf-monitor__module--3 { grid-column: 1; width: 30%; margin-left: 70%; background: rgba(69, 205, 185, 0.14); }
  .perf-monitor__module--4 { grid-column: 2; width: 47%; }
  .perf-monitor__module--5 { grid-column: 2; width: 47%; margin-left: 53%; background: var(--accent-deep); }

  .perf-monitor__neck {
    position: absolute;
    left: 45%;
    bottom: 4%;
    width: 10%;
    height: 15%;
    background: linear-gradient(90deg, #9aa6af, #d5dce1 50%, #929ea7);
  }

  .perf-monitor__foot {
    position: absolute;
    left: 35%;
    bottom: 0;
    width: 30%;
    height: 5%;
    border-radius: 999px;
    background: linear-gradient(180deg, #d5dce1, #929ea7);
    box-shadow: 0 9px 13px rgba(42, 78, 109, 0.18);
  }

  @media (max-width: 1199px) and (min-width: 1020px) {
    .perf-monitor {
      left: 49%;
      width: clamp(485px, 47vw, 560px);
    }
  }

  @media (max-height: 660px) and (min-width: 1020px) {
    .perf-monitor {
      top: 20%;
      width: clamp(460px, 44vw, 530px);
    }
  }
</style>
