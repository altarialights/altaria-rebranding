---
import { brandBeat } from '../../data/hero';

/**
 * Tablet, CSS 3D. Built like the phone — a closed solid with a
 * front, a back, four walls and a faceted rim — because it makes the same
 * kind of entrance: a turn that shows its back before it shows its
 * screen, so every angle needs a real surface.
 *
 * The rim geometry is derived here exactly as in DevicePhone.astro, only
 * with this body's own radius and aspect. Twenty facets plus four walls
 * make a 24-sided rim that never opens up mid-rotation.
 *
 * ON THE CONTENTS OF THE SCREEN
 * ---------------------------------------------------------------------
 * The canvas presents the real Altaria Lights mark: the cloud appears
 * first and the complete logo resolves over it during the brand beat.
 */
const RX = 5.6; // corner radius, % of width
const RY = 7.8; // corner radius, % of height
const ASPECT = 10 / 14.3; // height / width  (landscape tablet)
const SEG = 5; // facets per corner
const OVERLAP = 1.08;

interface Bevel {
  x: number;
  y: number;
  l: number;
  a: number;
}

const bevels: Bevel[] = [];
for (const [sx, sy] of [
  [-1, -1],
  [1, -1],
  [1, 1],
  [-1, 1],
]) {
  const cx = sx > 0 ? 100 - RX : RX;
  const cy = sy > 0 ? 100 - RY : RY;
  const at = (deg: number) => {
    const t = (deg * Math.PI) / 180;
    return { x: cx + sx * RX * Math.cos(t), y: cy + sy * RY * Math.sin(t) };
  };
  for (let i = 0; i < SEG; i++) {
    const p1 = at((i * 90) / SEG);
    const p2 = at(((i + 1) * 90) / SEG);
    const dx = p2.x - p1.x;
    const dy = (p2.y - p1.y) * ASPECT; // into width units
    bevels.push({
      x: (p1.x + p2.x) / 2,
      y: (p1.y + p2.y) / 2,
      l: Math.hypot(dx, dy) * OVERLAP,
      a: (Math.atan2(dy, dx) * 180) / Math.PI,
    });
  }
}

const swatches = ['#2b81d4', '#7dbcea', '#0f2c56', '#ffffff'];
---

<div class="obj obj--tablet" data-obj="tablet" data-layer="L3">
  <div class="obj__stage">
    <div class="obj__float" data-float="tablet">
      <div class="obj__point" data-point="tablet">
        <div class="obj__spin" data-spin="tablet">
          <div class="tablet__object">
            <div class="tablet__side tablet__side--left" aria-hidden="true"></div>
            <div class="tablet__side tablet__side--right" aria-hidden="true"></div>
            <div class="tablet__side tablet__side--top" aria-hidden="true"></div>
            <div class="tablet__side tablet__side--bottom" aria-hidden="true"></div>

            {
              bevels.map((b) => (
                <div
                  class="tablet__bevel"
                  aria-hidden="true"
                  style={`--bx:${b.x.toFixed(3)}%;--by:${b.y.toFixed(3)}%;--bl:${b.l.toFixed(3)}%;--ba:${b.a.toFixed(3)}deg`}
                />
              ))
            }

            <div class="tablet__core" aria-hidden="true"></div>

            <div class="tablet__back" aria-hidden="true">
              <span class="tablet__lens"></span>
              <span class="tablet__backlight"></span>
            </div>

            <div class="tablet__front">
              <div class="tablet__screen" role="img" aria-label={brandBeat.screenLabel}>
                <!-- Two pixel-aligned PNGs: cloud first, complete mark second. -->
                <span class="brand__logo-stage" aria-hidden="true">
                  <img
                    class="brand__logo-layer brand__logo-layer--cloud"
                    data-brand-cloud
                    src="/brand/optimized/altaria-cloud-512.png"
                    srcset="/brand/optimized/altaria-cloud-256.png 1x, /brand/optimized/altaria-cloud-512.png 2x"
                    alt=""
                    width="512"
                    height="512"
                  />
                  <img
                    class="brand__logo-layer brand__logo-layer--complete"
                    data-brand-logo
                    src="/brand/optimized/altaria-logo-512.png"
                    srcset="/brand/optimized/altaria-logo-256.png 1x, /brand/optimized/altaria-logo-512.png 2x"
                    alt=""
                    width="512"
                    height="512"
                  />
                </span>

                <!-- Palette -->
                <span class="brand__palette" aria-hidden="true">
                  {swatches.map((c, i) => (
                    <i data-brand-swatch data-hex={c.toUpperCase()} style={`--c:${c};--i:${i}`} />
                  ))}
                </span>

                <!-- Vertically balanced brand specifications. -->
                <span class="brand__specs" aria-hidden="true">
                <!-- Real type specimens used by Altaria Lights. -->
                <span class="brand__type">
                  <small>Tipografías</small>
                  <span class="brand__type-family">
                    <strong class="brand__type-sample brand__type-sample--puffy">ABC123</strong>
                    <span class="brand__type-name">Puffy</span>
                  </span>
                  <span class="brand__type-family">
                    <strong class="brand__type-sample brand__type-sample--lemon">ABC123</strong>
                    <span class="brand__type-name">Lemon Milk</span>
                  </span>
                </span>

                <!-- Functional hierarchy of the three site typefaces. -->
                <span class="brand__hierarchy" data-brand-hierarchy>
                  <small>Jerarquía</small>
                  <span><b>H1</b><em class="brand__hierarchy-puffy">Puffy</em></span>
                  <span><b>Logo</b><em class="brand__hierarchy-lemon">Lemon Milk</em></span>
                  <span><b>Texto</b><em class="brand__hierarchy-geist">Geist</em></span>
                </span>

                <!-- The actual header wordmark specification. -->
                <span class="brand__wordmark" data-brand-wordmark>
                  <small>Wordmark</small>
                  <strong>Altaria Lights</strong>
                </span>
                </span>

                <!-- Positive and negative applications of the real mark. -->
                <span class="brand__variants" aria-hidden="true">
                  <small>Variantes</small>
                  <span class="brand__variants-row">
                    <i class="brand__variant brand__variant--blue" data-brand-variant>
                      <img
                        src="/brand/optimized/altaria-logo-positive-256.png"
                        srcset="/brand/optimized/altaria-logo-positive-128.png 1x, /brand/optimized/altaria-logo-positive-256.png 2x"
                        alt=""
                        width="256"
                        height="161"
                      />
                    </i>
                    <i class="brand__variant brand__variant--white" data-brand-variant>
                      <img
                        src="/brand/optimized/altaria-logo-negative-256.png"
                        srcset="/brand/optimized/altaria-logo-negative-128.png 1x, /brand/optimized/altaria-logo-negative-256.png 2x"
                        alt=""
                        width="256"
                        height="161"
                      />
                    </i>
                  </span>
                </span>

                <div class="tablet__off" data-tablet-off aria-hidden="true"></div>
              </div>
              <div class="tablet__glass" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .obj--tablet {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(var(--tablet-w-min), var(--tablet-w), var(--tablet-w-max));
    z-index: 3;
    opacity: 0;
    will-change: transform;
  }

  .obj__stage {
    perspective: var(--tablet-persp);
    perspective-origin: 50% 50%;
  }

  .obj__float,
  .obj__point,
  .obj__spin,
  .tablet__object {
    transform-style: preserve-3d;
  }

  .tablet__object {
    position: relative;
    aspect-ratio: 14.3 / 10;
  }

  .tablet__front,
  .tablet__back {
    position: absolute;
    inset: 0;
    border-radius: 5.6% / 7.8%;
    backface-visibility: hidden;
    transform-style: flat;
    overflow: hidden;
  }

  .tablet__front {
    padding: 2.4% 1.9%;
    transform: translateZ(calc(var(--tablet-t) / 2));
    background: linear-gradient(150deg, #f0f3f6 0%, #ccd3d9 30%, #9aa4ac 70%, #7d868e 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .tablet__back {
    transform: translateZ(calc(var(--tablet-t) / -2)) rotateY(180deg);
    background:
      radial-gradient(ellipse 62% 46% at 74% 16%, rgba(255, 255, 255, 0.46) 0%, rgba(255, 255, 255, 0) 62%),
      linear-gradient(206deg, #e8ecf0 0%, #c6ccd3 34%, #9aa3ab 72%, #79828a 100%);
  }

  .tablet__lens {
    position: absolute;
    top: 5%;
    right: 5.5%;
    width: 7.5%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%, #47515c 0%, #1a2027 46%, #070a0d 100%);
    box-shadow:
      0 0 0 1.5px rgba(226, 232, 238, 0.7),
      0 0 0 2.5px rgba(120, 132, 145, 0.55);
  }

  .tablet__backlight {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      62deg,
      rgba(255, 255, 255, 0) 46%,
      rgba(255, 255, 255, 0.14) 64%,
      rgba(255, 255, 255, 0) 82%
    );
  }

  .tablet__core {
    position: absolute;
    inset: 0;
    border-radius: 5.6% / 7.8%;
    background: linear-gradient(150deg, #cfd6dc 0%, #9aa3ab 46%, #79828a 100%);
  }

  /* Walls stop exactly at the corner radius; the bevels take over there. */
  .tablet__side {
    position: absolute;
    background: linear-gradient(
      to right,
      #6f787f 0%,
      #aeb6bd 22%,
      #eef1f4 48%,
      #a7afb6 74%,
      #6b747b 100%
    );
  }

  .tablet__side--left,
  .tablet__side--right {
    top: 7.8%;
    height: 84.4%;
    width: var(--tablet-t);
    border-radius: 45% / 3%;
  }

  .tablet__side--left {
    left: 0;
    transform-origin: left center;
    transform: rotateY(90deg) translateX(calc(var(--tablet-t) / -2));
  }

  .tablet__side--right {
    right: 0;
    transform-origin: right center;
    transform: rotateY(-90deg) translateX(calc(var(--tablet-t) / 2));
  }

  .tablet__side--top,
  .tablet__side--bottom {
    left: 5.6%;
    width: 88.8%;
    height: var(--tablet-t);
    border-radius: 3% / 45%;
    background: linear-gradient(
      to bottom,
      #6f787f 0%,
      #aeb6bd 24%,
      #e8ecef 50%,
      #a7afb6 76%,
      #6b747b 100%
    );
  }

  .tablet__side--top {
    top: 0;
    transform-origin: center top;
    transform: rotateX(-90deg) translateY(calc(var(--tablet-t) / -2));
  }

  .tablet__side--bottom {
    bottom: 0;
    transform-origin: center bottom;
    transform: rotateX(90deg) translateY(calc(var(--tablet-t) / 2));
  }

  .tablet__bevel {
    position: absolute;
    left: var(--bx);
    top: var(--by);
    width: var(--bl);
    height: var(--tablet-t);
    transform: translate(-50%, -50%) rotateZ(var(--ba)) rotateX(90deg);
    background: linear-gradient(
      to bottom,
      #6f787f 0%,
      #aeb6bd 24%,
      #e8ecef 50%,
      #a7afb6 76%,
      #6b747b 100%
    );
  }

  /* --- Branding canvas ------------------------------------------------ */
  .tablet__screen {
    position: relative;
    height: 100%;
    border-radius: 3.6% / 5%;
    overflow: hidden;
    background: linear-gradient(168deg, #ffffff 0%, #f2f6fa 58%, #e6eef6 100%);
  }

  /* Identity board: the mark occupies the former construction area,
     with its palette below and the type specimen in the right column. */
  .brand__logo-stage {
    position: absolute;
    left: 19%;
    top: 14%;
    width: 32%;
    aspect-ratio: 1;
  }

  .brand__logo-layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand__logo-layer--complete {
    opacity: 0;
    transform: scale(0.96);
  }

  .brand__palette {
    position: absolute;
    left: 7%;
    bottom: 9%;
    display: flex;
    justify-content: center;
    gap: 3.4%;
    width: 56%;
  }

  .brand__palette i {
    position: relative;
    z-index: 1;
    flex: 0 0 17.3%;
    aspect-ratio: 1;
    border-radius: 18%;
    background: var(--c);
    opacity: 0;
    cursor: help;
    font-style: normal;
    transition:
      filter 180ms ease,
      box-shadow 180ms ease;
    box-shadow:
      0 1px 3px rgba(20, 40, 62, 0.2),
      0 0 0 1px rgba(15, 44, 86, 0.12) inset;
  }

  .brand__palette i::before,
  .brand__palette i::after {
    position: absolute;
    left: 50%;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand__palette i::before {
    content: '';
    bottom: calc(100% + 3px);
    width: 6px;
    height: 6px;
    background: var(--ink-navy);
    transform: translate(-50%, 5px) rotate(45deg) scale(0.7);
  }

  .brand__palette i::after {
    content: attr(data-hex);
    bottom: calc(100% + 6px);
    padding: 0.48em 0.7em;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    font-family: 'Geist Variable', var(--font-sans);
    font-size: clamp(7px, 0.56vw, 10px);
    font-weight: 650;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #ffffff;
    background: rgba(15, 44, 86, 0.96);
    box-shadow:
      0 8px 18px -8px rgba(15, 44, 86, 0.72),
      0 2px 5px rgba(15, 44, 86, 0.24);
    transform: translate(-50%, 7px) scale(0.9);
  }

  .brand__palette i:hover,
  .brand__palette i.is-hovered {
    z-index: 4;
    filter: brightness(1.07) saturate(1.05);
    box-shadow:
      0 5px 12px -5px rgba(15, 44, 86, 0.6),
      0 0 0 2px rgba(255, 255, 255, 0.78),
      0 0 0 1px rgba(15, 44, 86, 0.12) inset;
  }

  .brand__palette i:hover::before,
  .brand__palette i:hover::after,
  .brand__palette i.is-hovered::before,
  .brand__palette i.is-hovered::after {
    opacity: 1;
  }

  .brand__palette i:hover::before,
  .brand__palette i.is-hovered::before {
    transform: translate(-50%, 0) rotate(45deg) scale(1);
  }

  .brand__palette i:hover::after,
  .brand__palette i.is-hovered::after {
    transform: translate(-50%, 0) scale(1);
  }

  .brand__specs {
    position: absolute;
    right: 3%;
    top: 5%;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 0.82vw, 14px);
    width: 31%;
  }

  .brand__type {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(4px, 0.46vw, 8px);
    width: 100%;
    color: var(--ink-navy);
  }

  .brand__type small {
    display: block;
    width: 100%;
    padding-bottom: clamp(3px, 0.3vw, 5px);
    border-bottom: 1px solid rgba(15, 44, 86, 0.2);
    font-family: var(--font-sans);
    font-size: clamp(7px, 0.62vw, 11px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.12em;
  }

  .brand__type-sample {
    display: block;
    max-width: 100%;
    color: var(--ink-navy);
    white-space: nowrap;
  }

  .brand__type-family {
    display: flex;
    flex-direction: column;
    gap: 1px;
    width: 100%;
  }

  .brand__type-name {
    font-family: var(--font-sans);
    font-size: clamp(7px, 0.56vw, 10px);
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink-navy);
  }

  .brand__type-sample--puffy {
    font-family: 'Puffy', var(--font-display);
    font-size: clamp(13px, 1.22vw, 20px);
    font-weight: 900;
    line-height: 0.95;
  }

  .brand__type-sample--lemon {
    font-family: 'Lemon Milk', var(--font-sans);
    font-size: clamp(11px, 0.92vw, 15px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.04em;
  }

  .brand__hierarchy {
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.25vw, 5px);
    width: 100%;
    opacity: 0;
    color: var(--ink-navy);
  }

  .brand__hierarchy > small {
    display: block;
    width: 100%;
    padding-bottom: clamp(3px, 0.24vw, 4px);
    margin-bottom: 0;
    border-bottom: 1px solid rgba(15, 44, 86, 0.2);
    font-family: var(--font-sans);
    font-size: clamp(7px, 0.56vw, 10px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .brand__hierarchy > span {
    display: grid;
    grid-template-columns: 34% 66%;
    align-items: center;
    width: 100%;
    min-height: clamp(9px, 0.75vw, 13px);
    line-height: 1.1;
  }

  .brand__hierarchy b {
    font-family: var(--font-sans);
    font-size: clamp(8px, 0.65vw, 11px);
    font-weight: 650;
    color: rgba(15, 44, 86, 0.82);
  }

  .brand__hierarchy em {
    overflow: hidden;
    font-size: clamp(9px, 0.72vw, 12px);
    font-weight: 400;
    font-style: normal;
    color: var(--ink-navy);
    white-space: nowrap;
  }

  .brand__hierarchy-puffy {
    font-family: 'Puffy', var(--font-display);
  }

  .brand__hierarchy-lemon {
    font-family: 'Lemon Milk', var(--font-sans);
    text-transform: uppercase;
  }

  .brand__hierarchy-geist {
    font-family: 'Geist Variable', var(--font-sans);
    font-weight: 560 !important;
  }

  .brand__wordmark {
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.28vw, 5px);
    width: 100%;
    opacity: 0;
    color: var(--ink-navy);
  }

  .brand__wordmark small {
    display: block;
    width: 100%;
    padding-bottom: clamp(2px, 0.22vw, 4px);
    border-bottom: 1px solid rgba(15, 44, 86, 0.2);
    font-family: var(--font-sans);
    font-size: clamp(6px, 0.5vw, 9px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand__wordmark strong {
    display: block;
    width: 80%;
    font-family: 'Lemon Milk', var(--font-sans);
    font-size: clamp(7px, 0.7vw, 11px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: scaleX(1.25);
    transform-origin: left center;
  }

  .brand__variants {
    position: absolute;
    right: 3%;
    bottom: 9%;
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.3vw, 5px);
    width: 31%;
    color: var(--ink-navy);
  }

  .brand__variants > small {
    font-family: var(--font-sans);
    font-size: clamp(7px, 0.56vw, 10px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand__variants-row {
    display: flex;
    gap: 7%;
    width: 100%;
  }

  .brand__variant {
    display: grid;
    place-items: center;
    flex: 1;
    aspect-ratio: 1.32;
    overflow: hidden;
    border-radius: 12% / 16%;
    opacity: 0;
    box-shadow:
      0 3px 8px -4px rgba(15, 44, 86, 0.45),
      0 0 0 1px rgba(15, 44, 86, 0.12);
  }

  .brand__variant--blue {
    background: var(--sky-top);
  }

  .brand__variant--white {
    background: #ffffff;
  }

  .brand__variant img {
    display: block;
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .tablet__off {
    position: absolute;
    inset: 0;
    background: #06080b;
    pointer-events: none;
  }

  .tablet__glass {
    position: absolute;
    inset: 2.2%;
    border-radius: 3.6% / 5%;
    background: linear-gradient(
      118deg,
      rgba(255, 255, 255, 0) 54%,
      rgba(255, 255, 255, 0.09) 68%,
      rgba(255, 255, 255, 0.16) 76%,
      rgba(255, 255, 255, 0) 88%
    );
    pointer-events: none;
  }

  :global(html.is-brand-swatch-hovered) {
    cursor: help;
  }
</style>
