---
interface Props {
  id: string;
  body: string;
}
const { id, body } = Astro.props;

/**
 * On desktop panels open towards the nucleus whenever the card's
 * position allows it: that controlled overlap is part of the connected-
 * system scene. Compact retains its previous directions. The hovered
 * anchor rises above the core, and JS still flips or nudges the panel if
 * the preferred side would leave the viewport.
 */
const COMPACT_RIGHT_SIDE = new Set(['web', 'contacto']);
const DESKTOP_RIGHT_SIDE = new Set(['software', 'contacto']);
const side = COMPACT_RIGHT_SIDE.has(id) ? 'right' : 'left';
const desktopSide = DESKTOP_RIGHT_SIDE.has(id) ? 'right' : 'left';

/**
 * Floating explanation card for a flow node. Not a browser tooltip and
 * not a tiny bubble: 300 px of real, readable copy.
 *
 * Shown on hover AND on keyboard focus, dismissed with Escape, opened by
 * tap on touch devices. It is a sibling of the node's label rather than
 * an overlay on top of it, so it never covers the node that triggered it.
 */
---

<div
  class="tip"
  id={`tip-${id}`}
  data-flow-tip={id}
  data-side={side}
  data-desktop-side={desktopSide}
  role="tooltip"
>
  <p>{body}</p>
</div>

<style>
  .tip {
    position: absolute;
    /* Side comes from `data-side` (see the frontmatter): primarily inward
       towards the nucleus. JS overrides it only to protect the viewport. */
    right: calc(100% + var(--tip-gap));
    top: 50%;
    /* 270 rather than v10's 300, and a 12 px gap rather than 14. The
       cluster ends about 130 px short of the viewport edge at 1920, so
       those 32 px are exactly what lets Web open to the right instead of
       being flipped back onto Software. Still three comfortable lines. */
    --tip-gap: 12px;
    width: 270px;
    /* The node sets white-space:nowrap for its own label; without this the
       card inherits it, refuses to wrap, and overflows across the node. */
    white-space: normal;
    padding: 0.95rem 1.1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.14),
      0 22px 46px -20px rgba(20, 60, 100, 0.5);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-soft);

    opacity: 0;
    /* --tip-nudge is written by place(): the horizontal correction that
       keeps the card on its preferred side instead of flipping it. */
    transform: translate(var(--tip-nudge, 0px), calc(-50% + 10px));
    pointer-events: none;
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
    z-index: 12;
  }

  /* `data-side` is the default, `.is-flipped` is the viewport override.
     Two attributes rather than one so the JS never has to know which side
     a given card prefers. */
  .tip[data-side='right'],
  .tip[data-side='left'].is-flipped {
    right: auto;
    left: calc(100% + var(--tip-gap));
  }

  .tip[data-side='right'].is-flipped {
    left: auto;
    right: calc(100% + var(--tip-gap));
  }

  /* Desktop panels favour the nucleus, where their overlap reads as part
     of the system. Compact keeps the previous outward-facing defaults. */
  @media (min-width: 1020px) {
    .tip[data-desktop-side='left'] {
      left: auto;
      right: calc(100% + var(--tip-gap));
    }

    .tip[data-desktop-side='right'] {
      right: auto;
      left: calc(100% + var(--tip-gap));
    }

    .tip[data-desktop-side='left'].is-flipped {
      right: auto;
      left: calc(100% + var(--tip-gap));
    }

    .tip[data-desktop-side='right'].is-flipped {
      left: auto;
      right: calc(100% + var(--tip-gap));
    }
  }

  .tip.is-open {
    opacity: 1;
    transform: translate(var(--tip-nudge, 0px), -50%);
    /* Stays reachable so the pointer can travel from node to card. */
    pointer-events: auto;
  }

  .tip p {
    margin: 0;
  }
</style>
