---
interface Props {
  id: string;
  body: string;
}
const { id, body } = Astro.props;

/**
 * Which side the card opens on by default.
 *
 * Not "always left" and not "always outward": each card opens toward
 * whatever is actually empty next to it.
 *
 *   web       right — the two bottom cards sit 38 % of the box apart and
 *                     are 24 % wide, so there is ~14 % of gap between
 *                     them and a 300 px card cannot fit in it. Opening
 *                     left dropped the explanation straight onto
 *                     Software, which is the bug this fixes.
 *   contacto  right — to its left is the headline column.
 *   marca     left  — the middle of the ring is empty, and there is no
 *                     room to its right: the cluster ends ~130 px from
 *                     the viewport edge.
 *   contenido left  — twelve o'clock, clear on that side.
 *   software  left  — outward, away from Web.
 *
 * JS overrides this only when the chosen side would leave the viewport.
 */
const RIGHT_SIDE = new Set(['web', 'contacto']);
const side = RIGHT_SIDE.has(id) ? 'right' : 'left';

/**
 * Floating explanation card for a flow node. Not a browser tooltip and
 * not a tiny bubble: 300 px of real, readable copy.
 *
 * Shown on hover AND on keyboard focus, dismissed with Escape, opened by
 * tap on touch devices. It is a sibling of the node's label rather than
 * an overlay on top of it, so it never covers the node that triggered it.
 */
---

<div class="tip" id={`tip-${id}`} data-flow-tip={id} data-side={side} role="tooltip">
  <p>{body}</p>
</div>

<style>
  .tip {
    position: absolute;
    /* Side comes from `data-side` (see the frontmatter): outward from the
       centre of the ring, so the card never opens onto its neighbour. JS
       only overrides this when the chosen side would leave the viewport.

       v10 opened every card to the left unconditionally, and Web — bottom
       right — put its explanation straight underneath Software. */
    right: calc(100% + var(--tip-gap));
    top: 50%;
    /* 270 rather than v10's 300, and a 12 px gap rather than 14. The
       cluster ends about 130 px short of the viewport edge at 1920, so
       those 32 px are exactly what lets Web open to the right instead of
       being flipped back onto Software. Still three comfortable lines. */
    --tip-gap: 12px;
    width: 270px;
    /* The node sets white-space:nowrap for its own label; without this the
       card inherits it, refuses to wrap, and overflows across the node. */
    white-space: normal;
    padding: 0.95rem 1.1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.14),
      0 22px 46px -20px rgba(20, 60, 100, 0.5);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-soft);

    opacity: 0;
    /* --tip-nudge is written by place(): the horizontal correction that
       keeps the card on its preferred side instead of flipping it. */
    transform: translate(var(--tip-nudge, 0px), calc(-50% + 10px));
    pointer-events: none;
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
    z-index: 12;
  }

  /* `data-side` is the default, `.is-flipped` is the viewport override.
     Two attributes rather than one so the JS never has to know which side
     a given card prefers. */
  .tip[data-side='right'],
  .tip[data-side='left'].is-flipped {
    right: auto;
    left: calc(100% + var(--tip-gap));
  }

  .tip[data-side='right'].is-flipped {
    left: auto;
    right: calc(100% + var(--tip-gap));
  }

  .tip.is-open {
    opacity: 1;
    transform: translate(var(--tip-nudge, 0px), -50%);
    /* Stays reachable so the pointer can travel from node to card. */
    pointer-events: auto;
  }

  .tip p {
    margin: 0;
  }
</style>
