---
import { embeddedWeb } from '../../data/hero';
---

<div class="web-demo" data-web-experience role="img" aria-label={embeddedWeb.label}>
  <div class="web-demo__visual" aria-hidden="true">
    <!-- One inline sprite keeps the four concepts visually consistent and
         avoids four network requests for icons this small. -->
    <svg class="web-demo__sprite" aria-hidden="true">
      <symbol id="web-icon-trust" viewBox="0 0 24 24">
        <path d="M12 3 19 6v5c0 4.5-2.8 8.1-7 10-4.2-1.9-7-5.5-7-10V6l7-3Z"></path>
        <path d="m8.7 12.1 2.1 2.1 4.6-5"></path>
      </symbol>
      <symbol id="web-icon-sales" viewBox="0 0 24 24">
        <path d="m4 17 5.2-5.2 3.9 3.8L20 8.7"></path>
        <path d="M15.4 8.7H20v4.6"></path>
      </symbol>
      <symbol id="web-icon-brand" viewBox="0 0 24 24">
        <path d="m12 3 2.6 5.4 6 .9-4.3 4.2 1 6-5.3-2.8-5.3 2.8 1-6-4.3-4.2 6-.9L12 3Z"></path>
      </symbol>
      <symbol id="web-icon-metrics" viewBox="0 0 24 24">
        <path d="M12 3a9 9 0 1 0 9 9h-9V3Z"></path>
        <path d="M15 3.6V9h5.4A9 9 0 0 0 15 3.6Z"></path>
      </symbol>
      <symbol id="web-icon-results" viewBox="0 0 24 24">
        <path d="M5 19V9"></path>
        <path d="M10 19V13"></path>
        <path d="M15 19V10"></path>
        <path d="M20 19V5"></path>
      </symbol>
      <symbol id="web-icon-conversion" viewBox="0 0 24 24">
        <path d="M4 5h16l-6.2 7.1v5.1l-3.6 1.8v-6.9L4 5Z"></path>
        <path d="m15.2 16.8 1.6 1.6 3.2-3.6"></path>
      </symbol>
      <!-- A more distinctive icon family reserved for the benefits screen.
           The impact screen keeps its current, simpler pictograms. -->
      <symbol id="benefit-icon-trust" viewBox="0 0 24 24">
        <path class="benefit-icon__soft" d="M12 2.8 20 6v5.5c0 5-3.2 8.6-8 10.3-4.8-1.7-8-5.3-8-10.3V6l8-3.2Z"></path>
        <path d="M12 2.8 20 6v5.5c0 5-3.2 8.6-8 10.3-4.8-1.7-8-5.3-8-10.3V6l8-3.2Z"></path>
        <path class="benefit-icon__bold" d="m8.2 12 2.4 2.4 5.4-5.6"></path>
      </symbol>
      <symbol id="benefit-icon-sales" viewBox="0 0 24 24">
        <path class="benefit-icon__soft" d="M3.5 18.5h17v2h-17z"></path>
        <path d="m4 16 4.8-4.7 3.4 3.1L20 6.8"></path>
        <path class="benefit-icon__bold" d="M15.4 6.8H20v4.6"></path>
      </symbol>
      <symbol id="benefit-icon-brand" viewBox="0 0 24 24">
        <path class="benefit-icon__soft" d="m12 3.2 2.3 5.1 5.5.6-4.1 3.8 1.1 5.4-4.8-2.7-4.8 2.7 1.1-5.4-4.1-3.8 5.5-.6L12 3.2Z"></path>
        <path d="m12 3.2 2.3 5.1 5.5.6-4.1 3.8 1.1 5.4-4.8-2.7-4.8 2.7 1.1-5.4-4.1-3.8 5.5-.6L12 3.2Z"></path>
        <path class="benefit-icon__bold" d="M19 3v3M17.5 4.5h3"></path>
      </symbol>
      <symbol id="benefit-icon-results" viewBox="0 0 24 24">
        <rect class="benefit-icon__soft" x="3" y="3" width="18" height="18" rx="5"></rect>
        <path d="M7 16v-4M12 16V8M17 16v-6"></path>
        <path class="benefit-icon__bold" d="m15.5 6.5 1.4 1.4 2.8-3"></path>
      </symbol>
    </svg>

    <span class="web-demo__sky"></span>
    <span class="web-demo__clouds"></span>

    <!-- Visual browser chrome only: no fake control enters the tab order. -->
    <div class="web-demo__chrome" data-web-demo-chrome>
      <span class="chrome__mark"><i></i><b></b></span>
      <span class="chrome__links"><i></i><i></i><i></i></span>
      <span class="chrome__cta"></span>
    </div>

    <div class="web-demo__scenes">
      <section class="web-demo__scene web-demo__scene--impact" data-web-scene="impact">
        <div class="impact__copy" data-web-impact-copy>
          <h3 class="web-demo__title web-demo__title--impact" data-web-scene-title>
            {embeddedWeb.impact.title.map((line) => <span>{line}</span>)}
          </h3>
          <p class="web-demo__sub" data-web-scene-sub>{embeddedWeb.impact.sub}</p>
        </div>

        <div class="impact__visual" data-web-impact-visual>
          <div class="impact__window">
            <span class="impact__window-bar"><i></i><i></i><i></i><b></b></span>
            <span class="impact__window-body">
              <span class="impact__window-copy">
                <small>Tu negocio, mejor presentado</small>
                <strong>Diseño que transmite confianza.</strong>
                <span class="impact__window-actions">
                  <b>Hablemos</b>
                  <i>Ver proyecto</i>
                </span>
                <span class="impact__window-proof">
                  <i><svg viewBox="0 0 24 24"><use href="#web-icon-trust"></use></svg></i>
                  <em>Diseño profesional</em>
                </span>
              </span>
              <span class="impact__window-art">
                <i class="impact__window-orb"></i>
                <span class="impact__window-card">
                  <svg viewBox="0 0 24 24"><use href="#web-icon-trust"></use></svg>
                  <strong>Confianza</strong>
                  <small>Desde el primer vistazo</small>
                </span>
              </span>
            </span>
          </div>
        </div>

        <ul class="impact__pillars">
          {
            embeddedWeb.impact.pillars.map((pillar) => (
              <li data-web-pillar>
                <span class="concept__icon concept__icon--small">
                  <svg viewBox="0 0 24 24"><use href={`#web-icon-${pillar.id}`}></use></svg>
                </span>
                <strong>{pillar.label}</strong>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="web-demo__scene web-demo__scene--benefits" data-web-scene="benefits">
        <header class="web-demo__scene-head web-demo__scene-head--benefits">
          <h3 class="web-demo__title" data-web-scene-title>
            {embeddedWeb.benefits.title.map((line) => <span>{line}</span>)}
          </h3>
        </header>

        <ul class="concept-grid">
          {
            embeddedWeb.benefits.cards.map((card) => (
              <li class="concept-card" data-web-benefit data-concept={card.id}>
                <span class="concept__icon">
                  <svg viewBox="0 0 24 24"><use href={`#benefit-icon-${card.id}`}></use></svg>
                </span>
                <span class="concept-card__copy">
                  <strong>{card.title}</strong>
                  <p>{card.body}</p>
                </span>
                <span class="concept-card__signal" aria-hidden="true"><i></i><i></i><i></i></span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="web-demo__scene web-demo__scene--results" data-web-scene="results">
        <header class="web-demo__scene-head web-demo__scene-head--results">
          <h3 class="web-demo__title" data-web-scene-title>
            {embeddedWeb.results.title.map((line) => <span>{line}</span>)}
          </h3>
          <p class="web-demo__sub" data-web-scene-sub>{embeddedWeb.results.sub}</p>
        </header>

        <ul class="results-grid">
          {
            embeddedWeb.results.modules.map((module) => (
              <li class="result-card" data-web-metric data-result={module.id}>
                {module.id === 'clicks' && (
                  <svg class="result-card__chart" data-web-chart viewBox="0 0 96 58">
                    <defs>
                      <linearGradient id="web-chart-fill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#3f8fdd" stop-opacity=".32"></stop>
                        <stop offset="1" stop-color="#3f8fdd" stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>
                    <path class="chart__area" d="M7 49 22 38 35 42 52 23 66 29 88 8v43H7Z"></path>
                    <path class="chart__grid" d="M7 49h81M7 34h81M7 19h81"></path>
                    <path class="chart__line" d="M7 49 22 38 35 42 52 23 66 29 88 8"></path>
                    <path class="chart__arrow" d="M80 8h8v8"></path>
                  </svg>
                )}
                {module.id === 'contacts' && (
                  <svg class="result-card__chart" data-web-chart viewBox="0 0 64 38">
                    <path class="chart__grid" d="M5 32h54"></path>
                    <rect class="chart__bar chart__bar--1" x="9" y="23" width="8" height="9" rx="2"></rect>
                    <rect class="chart__bar chart__bar--2" x="22" y="17" width="8" height="15" rx="2"></rect>
                    <rect class="chart__bar chart__bar--3" x="35" y="11" width="8" height="21" rx="2"></rect>
                    <rect class="chart__bar chart__bar--4" x="48" y="5" width="8" height="27" rx="2"></rect>
                  </svg>
                )}
                {module.id === 'conversion' && (
                  <svg class="result-card__chart" data-web-chart viewBox="0 0 64 38">
                    <circle class="chart__target-ring chart__target-ring--outer" cx="30" cy="19" r="14"></circle>
                    <circle class="chart__target-ring" cx="30" cy="19" r="8"></circle>
                    <circle class="chart__conversion-center" cx="30" cy="19" r="2.8"></circle>
                  </svg>
                )}
                {module.id === 'performance' && (
                  <svg class="result-card__chart" data-web-chart viewBox="0 0 64 38">
                    <circle class="chart__donut-track" cx="32" cy="19" r="13"></circle>
                    <circle class="chart__donut" cx="32" cy="19" r="13"></circle>
                    <path class="chart__tick" d="m27 19 3.4 3.4L38 14.8"></path>
                  </svg>
                )}
                <span class="result-card__label"><i></i><strong>{module.label}</strong></span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</div>

<style>
  .web-demo {
    --demo-navy: #0f2c56;
    --demo-blue: #1d6fc0;
    --demo-bright: #3f8fdd;
    --demo-mint: #25b79a;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    contain: layout paint;
    container-type: inline-size;
    color: var(--demo-navy);
    font-family: var(--font-sans);
    pointer-events: none;
    user-select: none;
    background: #8ec5ef;
  }

  .web-demo__visual,
  .web-demo__sky,
  .web-demo__clouds,
  .web-demo__scenes,
  .web-demo__scene {
    position: absolute;
    inset: 0;
  }

  .web-demo__visual {
    overflow: hidden;
  }

  .web-demo__sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .web-demo__sprite symbol {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .web-demo__sky {
    background:
      radial-gradient(circle at 88% 15%, rgba(255, 255, 247, 0.96) 0 1.4%, rgba(255, 250, 224, 0.54) 2.5%, rgba(255, 255, 255, 0) 9%),
      radial-gradient(ellipse 52% 46% at 82% 12%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #318bda 0%, #7dbcea 58%, #d7ecff 100%);
  }

  /* Static radial gradients give the miniature site its own cloud bank
     without another bitmap, blur pass or continuously animated layer. */
  .web-demo__clouds {
    left: -10%;
    right: -10%;
    top: auto;
    bottom: -17%;
    height: 43%;
    background:
      radial-gradient(ellipse 15% 72% at 7% 74%, #f8fcff 0 66%, transparent 67%),
      radial-gradient(ellipse 19% 88% at 22% 67%, #ffffff 0 65%, transparent 66%),
      radial-gradient(ellipse 17% 76% at 38% 77%, #f7fbff 0 65%, transparent 66%),
      radial-gradient(ellipse 22% 92% at 56% 67%, #ffffff 0 64%, transparent 65%),
      radial-gradient(ellipse 18% 78% at 75% 76%, #f7fbff 0 66%, transparent 67%),
      radial-gradient(ellipse 22% 94% at 94% 68%, #ffffff 0 65%, transparent 66%),
      linear-gradient(to bottom, transparent 35%, #f8fcff 72%);
    opacity: 0.96;
  }

  .web-demo__chrome {
    position: absolute;
    z-index: 4;
    top: 3.5%;
    left: 4%;
    right: 4%;
    height: 8.5%;
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    padding: 0 1.4cqw;
    border-radius: 99px;
    background: rgba(247, 252, 255, 0.9);
    box-shadow:
      0 0.7cqw 1.8cqw -1.1cqw rgba(15, 44, 86, 0.32),
      inset 0 0 0 1px rgba(255, 255, 255, 0.84);
  }

  .chrome__mark {
    display: flex;
    align-items: center;
    gap: 0.55cqw;
    width: 14%;
  }

  .chrome__mark i {
    width: clamp(4px, 1.1cqw, 10px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(145deg, #59a7f0, #1764b2);
  }

  .chrome__mark b,
  .chrome__links i,
  .chrome__cta {
    display: block;
    border-radius: 99px;
  }

  .chrome__mark b {
    width: 66%;
    height: clamp(2px, 0.55cqw, 5px);
    background: var(--demo-navy);
  }

  .chrome__links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.1cqw;
    width: 24%;
  }

  .chrome__links i {
    flex: 1;
    height: clamp(2px, 0.42cqw, 4px);
    background: rgba(15, 44, 86, 0.34);
  }

  .chrome__cta {
    width: 10%;
    height: 45%;
    background: linear-gradient(120deg, var(--demo-navy), var(--demo-blue));
    box-shadow: 0 0.45cqw 1cqw -0.6cqw rgba(15, 44, 86, 0.45);
  }

  .web-demo__scenes {
    z-index: 2;
  }

  .web-demo__scene {
    inset: 14.5% 4.5% 5.5%;
    min-width: 0;
    min-height: 0;
  }

  .web-demo__scene--impact {
    display: grid;
    grid-template-columns: 57% minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 3.5cqw;
    opacity: 1;
  }

  .web-demo__scene--benefits,
  .web-demo__scene--results {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 2.2cqw;
    opacity: 0;
    transform: translate3d(0, 7%, 0);
  }

  .impact__copy {
    align-self: center;
    padding-left: 1.2cqw;
  }

  .web-demo__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 4cqw, 36px);
    font-weight: 900;
    line-height: 0.91;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--demo-navy);
  }

  .web-demo__title--impact {
    font-size: clamp(16px, 4.8cqw, 42px);
  }

  .web-demo__title span {
    display: block;
    white-space: nowrap;
  }

  .web-demo__sub {
    margin-top: 1.3cqw;
    font-size: clamp(7px, 1.55cqw, 14px);
    font-weight: 560;
    line-height: 1.24;
    color: rgba(15, 44, 86, 0.76);
  }

  .web-demo__scene-head {
    text-align: center;
  }

  .impact__visual {
    align-self: center;
    display: grid;
    place-items: center;
    min-width: 0;
  }

  .impact__window {
    width: min(92%, 30cqw);
    aspect-ratio: 1.28;
    overflow: hidden;
    border-radius: 2.1cqw;
    background: rgba(248, 252, 255, 0.95);
    box-shadow:
      0 2.3cqw 4cqw -2.2cqw rgba(15, 44, 86, 0.38),
      inset 0 0 0 1px rgba(255, 255, 255, 0.9);
    transform: rotate(2.5deg);
  }

  .impact__window-bar {
    height: 20%;
    display: flex;
    align-items: center;
    gap: 3%;
    padding: 0 6%;
    background: rgba(220, 237, 251, 0.78);
  }

  .impact__window-bar i {
    width: 3.2%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(29, 111, 192, 0.28);
  }

  .impact__window-bar b {
    margin-left: auto;
    width: 32%;
    height: 18%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--demo-bright), var(--demo-mint));
  }

  .impact__window-body {
    height: 80%;
    display: grid;
    grid-template-columns: 1fr 38%;
    align-items: center;
    gap: 7%;
    padding: 8%;
  }

  .impact__window-copy {
    display: flex;
    flex-direction: column;
    gap: 9%;
    height: 62%;
  }

  .impact__window-copy i {
    display: block;
    height: 12%;
    border-radius: 99px;
    background: rgba(15, 44, 86, 0.2);
  }

  .impact__window-copy i:first-child {
    width: 92%;
    height: 22%;
    background: var(--demo-navy);
  }

  .impact__window-copy i:nth-child(2) {
    width: 74%;
  }

  .impact__window-copy i:last-child {
    width: 48%;
    height: 19%;
    margin-top: auto;
    background: var(--demo-blue);
  }

  .impact__window-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9%;
    height: 82%;
    border-radius: 1.3cqw;
    color: var(--demo-blue);
    background: linear-gradient(150deg, #ffffff, #e7f3ff);
    box-shadow: 0 0.8cqw 1.8cqw -1.1cqw rgba(15, 44, 86, 0.34);
  }

  .impact__window-card svg {
    width: 34%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .impact__window-card i {
    width: 56%;
    height: 4%;
    min-height: 1px;
    border-radius: 99px;
    background: rgba(15, 44, 86, 0.22);
  }

  .impact__window-card i:last-child {
    width: 40%;
    background: rgba(29, 111, 192, 0.3);
  }

  .impact__pillars,
  .concept-grid,
  .results-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .impact__pillars {
    grid-column: 1 / -1;
    gap: 1.15cqw;
    align-self: end;
  }

  .impact__pillars li {
    min-width: 0;
    min-height: clamp(22px, 6cqw, 50px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6cqw;
    padding: 0.75cqw;
    border-radius: 1.5cqw;
    background: rgba(248, 252, 255, 0.9);
    box-shadow:
      0 0.7cqw 1.5cqw -1cqw rgba(15, 44, 86, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.78);
  }

  .impact__pillars strong {
    min-width: 0;
    overflow: hidden;
    font-size: clamp(6.5px, 1.2cqw, 11px);
    font-weight: 760;
    line-height: 1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .concept__icon {
    flex: none;
    width: clamp(15px, 4.2cqw, 36px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 28%;
    color: #1764b2;
    background: linear-gradient(145deg, #f9fdff 8%, #c9e6ff 52%, #75b9f6 100%);
    box-shadow:
      0 0.8cqw 1.4cqw -0.8cqw rgba(15, 70, 130, 0.42),
      inset 0 0 0 1px rgba(255, 255, 255, 0.75);
  }

  .concept__icon--small {
    width: clamp(10px, 2.6cqw, 23px);
    border-radius: 34%;
  }

  .concept__icon svg {
    width: 66%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .concept-grid,
  .results-grid {
    align-self: center;
    gap: 1.4cqw;
    height: clamp(108px, 34cqw, 250px);
  }

  .concept-card,
  .result-card {
    min-width: 0;
    min-height: 0;
    border-radius: 2cqw;
    background: rgba(248, 252, 255, 0.94);
    box-shadow:
      0 1.25cqw 2.6cqw -1.5cqw rgba(15, 44, 86, 0.32),
      inset 0 0 0 1px rgba(255, 255, 255, 0.82);
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65cqw;
    padding: 1.35cqw 1.05cqw;
    text-align: center;
  }

  .concept-card strong,
  .result-card strong {
    font-size: clamp(8px, 1.65cqw, 15px);
    font-weight: 820;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .concept-card p {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(6.5px, 1.1cqw, 10px);
    font-weight: 520;
    line-height: 1.2;
    color: rgba(15, 44, 86, 0.7);
  }

  .result-card {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: center;
    padding: 1.2cqw 1.05cqw 1.45cqw;
    text-align: center;
  }

  .result-card strong {
    align-self: end;
  }

  .result-card__chart {
    align-self: stretch;
    justify-self: stretch;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .chart__grid {
    fill: none;
    stroke: rgba(29, 111, 192, 0.15);
    stroke-width: 1;
  }

  .chart__line,
  .chart__arrow,
  .chart__tick {
    fill: none;
    stroke: var(--demo-blue);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chart__bar {
    fill: #75b9f6;
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .chart__bar--2 {
    fill: #55a6ef;
  }

  .chart__bar--3 {
    fill: #358ddb;
  }

  .chart__bar--4 {
    fill: var(--demo-mint);
  }

  .chart__ring {
    fill: none;
    stroke: rgba(29, 111, 192, 0.52);
    stroke-width: 2;
  }

  .chart__ring--outer {
    stroke: rgba(29, 111, 192, 0.2);
  }

  .chart__pulse,
  .chart__signal {
    fill: var(--demo-blue);
  }

  .chart__signal {
    fill: var(--demo-mint);
  }

  .chart__donut-track,
  .chart__donut {
    fill: none;
    stroke-width: 5;
  }

  .chart__donut-track {
    stroke: rgba(29, 111, 192, 0.14);
  }

  .chart__donut {
    stroke: var(--demo-bright);
    stroke-linecap: round;
    stroke-dasharray: 54 82;
    transform: rotate(-90deg);
    transform-origin: 32px 19px;
  }

  @container (max-width: 470px) {
    .web-demo__chrome {
      left: 3.5%;
      right: 3.5%;
    }

    .chrome__links {
      width: 20%;
    }

    .web-demo__scene {
      inset: 14.5% 4% 4.5%;
    }

    .web-demo__scene--impact {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .impact__copy {
      align-self: center;
      padding: 0 2.2cqw;
    }

    .impact__visual {
      display: none;
    }

    .impact__pillars,
    .concept-grid,
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact__pillars {
      gap: 1cqw;
    }

    .impact__pillars li {
      min-height: clamp(18px, 5.2cqw, 24px);
    }

    .concept-grid,
    .results-grid {
      gap: 1.1cqw;
    }

    .concept-card,
    .result-card {
      border-radius: 1.7cqw;
    }

    .concept-card {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      column-gap: 1.5cqw;
      row-gap: 0.35cqw;
      padding: 1.1cqw 1.5cqw;
      text-align: left;
    }

    .concept-card .concept__icon {
      grid-row: 1 / 3;
    }

    .concept-card strong,
    .concept-card p {
      justify-self: start;
    }

    .concept-card p {
      max-width: none;
    }

    .result-card {
      grid-template-columns: 42% 1fr;
      grid-template-rows: 1fr;
      gap: 1cqw;
      padding: 1cqw 1.4cqw;
      text-align: left;
    }

    .result-card strong {
      align-self: center;
    }
  }

  /* -----------------------------------------------------------------
     Premium miniature-site art direction.

     These rules deliberately retain every data-web-* hook above. The
     master timeline still owns opacity and transforms; this layer only
     changes composition, hierarchy and paint.
     ----------------------------------------------------------------- */
  .web-demo {
    --demo-navy: #0f2c56;
    --demo-blue: #217bd0;
    --demo-bright: #42a0ef;
    --demo-mint: #2bc3a5;
    background: #8bc5ef;
  }

  .web-demo__sky {
    background:
      radial-gradient(circle at 88% 14%, rgba(255, 255, 247, 0.98) 0 1.2%, rgba(255, 250, 224, 0.52) 2.4%, rgba(255, 255, 255, 0) 9%),
      radial-gradient(ellipse 42% 44% at 84% 14%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 72%),
      linear-gradient(145deg, rgba(255, 255, 255, 0) 42%, rgba(225, 245, 255, 0.22) 72%, rgba(255, 255, 255, 0.08)),
      linear-gradient(180deg, #2f8bdc 0%, #73b7e9 57%, #d9efff 100%);
  }

  .web-demo__clouds {
    bottom: -18%;
    height: 42%;
    opacity: 0.92;
  }

  .web-demo__chrome {
    top: 3.3%;
    left: 3.7%;
    right: 3.7%;
    height: 8%;
    gap: 1cqw;
    padding: 0 1.3cqw;
    border: 1px solid rgba(255, 255, 255, 0.58);
    background: rgba(244, 251, 255, 0.88);
    box-shadow:
      0 1cqw 2.2cqw -1.35cqw rgba(15, 44, 86, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
  }

  .chrome__mark {
    width: 15%;
  }

  .chrome__mark i {
    box-shadow: 0 0 0 0.5cqw rgba(47, 139, 220, 0.11);
  }

  .chrome__mark b {
    width: 72%;
    background: linear-gradient(90deg, var(--demo-navy), #1d5d9b);
  }

  .chrome__links {
    width: 21%;
    gap: 0.85cqw;
  }

  .chrome__links i {
    height: clamp(2px, 0.36cqw, 4px);
    background: rgba(15, 44, 86, 0.3);
  }

  .chrome__cta {
    width: 10.5%;
    height: 50%;
    background: linear-gradient(120deg, #164d82, #217bd0);
    box-shadow: 0 0.5cqw 1.2cqw -0.65cqw rgba(15, 44, 86, 0.58);
  }

  .web-demo__scene {
    inset: 13.3% 4.2% 5.2%;
  }

  .web-demo__title {
    font-size: clamp(17px, 4.25cqw, 40px);
    font-weight: 900;
    line-height: 0.89;
    letter-spacing: -0.055em;
  }

  .web-demo__title--impact {
    font-size: clamp(19px, 5.15cqw, 48px);
  }

  .web-demo__sub {
    margin: 1.25cqw 0 0;
    font-size: clamp(8px, 1.55cqw, 15px);
    font-weight: 690;
    line-height: 1.16;
    color: rgba(15, 44, 86, 0.82);
  }

  /* Screen 1 · editorial hero -------------------------------------- */
  .web-demo__scene--impact {
    grid-template-columns: 49% minmax(0, 51%);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 2.2cqw;
  }

  .impact__copy {
    align-self: center;
    padding: 0 0 1.6cqw 1.1cqw;
  }

  .impact__copy .web-demo__sub {
    position: relative;
    padding-left: 1.25cqw;
  }

  .impact__copy .web-demo__sub::before {
    position: absolute;
    top: 0.1em;
    bottom: 0.05em;
    left: 0;
    width: max(2px, 0.28cqw);
    border-radius: 99px;
    content: '';
    background: linear-gradient(var(--demo-bright), var(--demo-mint));
  }

  .impact__visual {
    align-self: center;
    justify-items: end;
  }

  .impact__window {
    width: 100%;
    aspect-ratio: 1.43;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 1.85cqw;
    background: rgba(248, 252, 255, 0.96);
    box-shadow:
      0 2.4cqw 4.4cqw -2.1cqw rgba(15, 44, 86, 0.5),
      0 0 0 0.18cqw rgba(255, 255, 255, 0.34);
    transform: rotate(1.4deg);
  }

  .impact__window-bar {
    height: 17%;
    gap: 2.8%;
    padding: 0 5%;
    background: linear-gradient(90deg, rgba(224, 240, 252, 0.92), rgba(244, 250, 255, 0.95));
    border-bottom: 1px solid rgba(15, 44, 86, 0.07);
  }

  .impact__window-bar b {
    width: 29%;
    height: 22%;
    background: linear-gradient(90deg, var(--demo-blue), var(--demo-mint));
  }

  .impact__window-body {
    position: relative;
    height: 83%;
    grid-template-columns: 55% minmax(0, 45%);
    gap: 3%;
    padding: 7% 6.5%;
    background:
      radial-gradient(circle at 88% 24%, rgba(66, 160, 239, 0.16), transparent 33%),
      linear-gradient(140deg, #ffffff, #f1f8ff);
  }

  .impact__window-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5%;
    height: 100%;
  }

  .impact__window-copy small {
    display: block;
    font-size: clamp(4px, 0.72cqw, 7px);
    font-weight: 760;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--demo-blue);
  }

  .impact__window-copy > strong {
    max-width: 13ch;
    font-size: clamp(7px, 1.5cqw, 14px);
    font-weight: 850;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--demo-navy);
  }

  .impact__window-actions {
    display: flex;
    align-items: center;
    gap: 7%;
    margin-top: 3%;
  }

  .impact__window-copy .impact__window-actions b,
  .impact__window-copy .impact__window-actions i {
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    margin: 0;
    border-radius: 99px;
    background: none;
    font-size: clamp(4px, 0.72cqw, 7px);
    font-weight: 760;
    font-style: normal;
    line-height: 1;
    white-space: nowrap;
  }

  .impact__window-copy .impact__window-actions b {
    padding: 4.5% 10%;
    color: #fff;
    background: linear-gradient(120deg, #164d82, var(--demo-blue));
    box-shadow: 0 0.6cqw 1.2cqw -0.65cqw rgba(15, 44, 86, 0.55);
  }

  .impact__window-copy .impact__window-actions i {
    color: rgba(15, 44, 86, 0.64);
  }

  .impact__window-proof {
    display: flex;
    align-items: center;
    gap: 4%;
    margin-top: auto;
  }

  .impact__window-copy .impact__window-proof i {
    display: grid;
    place-items: center;
    width: 10%;
    height: auto;
    aspect-ratio: 1;
    min-height: 0;
    margin: 0;
    border-radius: 50%;
    color: var(--demo-mint);
    background: rgba(43, 195, 165, 0.12);
  }

  .impact__window-proof svg {
    width: 66%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .impact__window-proof em {
    font-size: clamp(4px, 0.63cqw, 6px);
    font-weight: 650;
    font-style: normal;
    color: rgba(15, 44, 86, 0.62);
  }

  .impact__window-art {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
  }

  .impact__window-orb {
    position: absolute;
    width: 86%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 36% 30%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 24%),
      linear-gradient(145deg, #8dcbf8, #277ed0 62%, #1a5da0);
    box-shadow:
      0 1.2cqw 2.5cqw -1.3cqw rgba(15, 72, 132, 0.56),
      inset 0 0 0 1px rgba(255, 255, 255, 0.38);
  }

  .impact__window-card {
    position: relative;
    z-index: 1;
    width: 72%;
    height: auto;
    aspect-ratio: 0.95;
    gap: 5%;
    padding: 9%;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 1.15cqw;
    color: var(--demo-blue);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 1cqw 2cqw -0.9cqw rgba(15, 44, 86, 0.52);
    backdrop-filter: blur(5px);
    transform: translate(8%, 6%);
  }

  .impact__window-card svg {
    width: 34%;
  }

  .impact__window-card strong {
    font-size: clamp(5px, 0.9cqw, 9px);
    font-weight: 820;
    line-height: 1;
    text-transform: uppercase;
    color: var(--demo-navy);
  }

  .impact__window-card small {
    font-size: clamp(3.5px, 0.56cqw, 6px);
    font-weight: 580;
    line-height: 1.1;
    text-align: center;
    color: rgba(15, 44, 86, 0.62);
  }

  .impact__pillars {
    gap: 1cqw;
  }

  .impact__pillars li {
    min-height: clamp(28px, 6.7cqw, 58px);
    gap: 0.8cqw;
    padding: 0.8cqw 0.7cqw;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 1.35cqw;
    background: rgba(250, 253, 255, 0.92);
    box-shadow:
      0 0.9cqw 1.8cqw -1.05cqw rgba(15, 44, 86, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);
  }

  .impact__pillars li:nth-child(2) {
    background: linear-gradient(145deg, rgba(236, 248, 255, 0.95), rgba(220, 241, 255, 0.92));
  }

  .impact__pillars li:nth-child(4) {
    background: linear-gradient(145deg, rgba(238, 252, 249, 0.96), rgba(218, 246, 241, 0.94));
  }

  .impact__pillars strong {
    font-size: clamp(8px, 1.45cqw, 13px);
    font-weight: 820;
  }

  .concept__icon--small {
    width: clamp(15px, 3.4cqw, 30px);
  }

  /* Screen 2 · benefit system -------------------------------------- */
  .web-demo__scene--benefits {
    grid-template-rows: auto minmax(0, 1fr);
    gap: 2cqw;
  }

  .web-demo__scene-head--benefits {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 1cqw;
    text-align: left;
  }

  .concept-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    align-self: stretch;
    gap: 1.25cqw;
    height: auto;
    min-height: 0;
    padding: 0 0.6cqw 0.6cqw;
  }

  .concept-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: 1fr;
    align-items: center;
    gap: 1.25cqw;
    overflow: hidden;
    padding: 1.45cqw 1.5cqw;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 1.65cqw;
    text-align: left;
    background: rgba(250, 253, 255, 0.94);
    box-shadow:
      0 1.15cqw 2.4cqw -1.35cqw rgba(15, 44, 86, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.84);
  }

  .concept-card::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: max(2px, 0.32cqw);
    content: '';
    background: var(--demo-blue);
  }

  .concept-card[data-concept='sales'] {
    border-color: rgba(68, 150, 224, 0.4);
    color: #fff;
    background: linear-gradient(135deg, #0f2c56 0%, #175692 58%, #247bc2 100%);
  }

  .concept-card[data-concept='sales']::before {
    background: var(--demo-mint);
  }

  .concept-card[data-concept='brand'] {
    margin-left: 1.1cqw;
    border-color: rgba(255, 255, 255, 0.74);
    background: rgba(241, 249, 255, 0.78);
    backdrop-filter: blur(7px);
  }

  .concept-card[data-concept='brand']::before {
    background: #6ab4ee;
  }

  .concept-card[data-concept='results'] {
    margin-right: 1.1cqw;
    background: linear-gradient(140deg, rgba(237, 252, 249, 0.97), rgba(213, 244, 239, 0.94));
  }

  .concept-card[data-concept='results']::before {
    background: var(--demo-mint);
  }

  .concept-card .concept__icon {
    grid-row: auto;
    width: clamp(24px, 5.2cqw, 48px);
  }

  .concept-card[data-concept='sales'] .concept__icon {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 0.8cqw 1.5cqw -0.8cqw rgba(2, 23, 48, 0.5);
  }

  .concept-card__copy {
    display: flex;
    flex-direction: column;
    gap: 0.45cqw;
    min-width: 0;
  }

  .concept-card strong {
    font-size: clamp(9px, 1.8cqw, 17px);
    font-weight: 850;
    line-height: 1;
  }

  .concept-card p {
    margin: 0;
    max-width: none;
    font-size: clamp(7px, 1.15cqw, 11px);
    font-weight: 580;
    line-height: 1.15;
    color: rgba(15, 44, 86, 0.72);
  }

  .concept-card[data-concept='sales'] p {
    color: rgba(255, 255, 255, 0.75);
  }

  .concept-card__signal {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.25cqw;
    width: 3.8cqw;
    height: 3.8cqw;
    opacity: 0.72;
  }

  .concept-card__signal i {
    display: block;
    width: 18%;
    border-radius: 99px;
    background: var(--demo-blue);
  }

  .concept-card__signal i:nth-child(1) { height: 36%; }
  .concept-card__signal i:nth-child(2) { height: 64%; }
  .concept-card__signal i:nth-child(3) { height: 92%; }

  .concept-card[data-concept='trust'] .concept-card__signal,
  .concept-card[data-concept='results'] .concept-card__signal {
    align-items: center;
    border: max(1px, 0.22cqw) solid rgba(33, 123, 208, 0.38);
    border-radius: 50%;
  }

  .concept-card[data-concept='trust'] .concept-card__signal::after {
    content: '✓';
    font-size: 2cqw;
    font-weight: 900;
    color: var(--demo-blue);
  }

  .concept-card[data-concept='trust'] .concept-card__signal i,
  .concept-card[data-concept='results'] .concept-card__signal i {
    display: none;
  }

  .concept-card[data-concept='results'] .concept-card__signal {
    border-color: rgba(43, 195, 165, 0.5);
    background: conic-gradient(var(--demo-mint) 0 62%, rgba(43, 195, 165, 0.11) 62% 100%);
    box-shadow: inset 0 0 0 0.7cqw rgba(238, 252, 249, 0.95);
  }

  .concept-card[data-concept='sales'] .concept-card__signal i {
    background: var(--demo-mint);
  }

  .concept-card[data-concept='brand'] .concept-card__signal {
    align-items: center;
  }

  .concept-card[data-concept='brand'] .concept-card__signal i {
    width: 0.75cqw;
    height: 0.75cqw;
    border-radius: 50%;
  }

  .concept-card[data-concept='brand'] .concept-card__signal i:nth-child(2) {
    width: 1.2cqw;
    height: 1.2cqw;
    background: var(--demo-mint);
  }

  /* Screen 3 · asymmetric results dashboard ------------------------ */
  .web-demo__scene--results {
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1.7cqw;
  }

  .web-demo__scene-head--results {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3cqw;
    padding: 0 0.8cqw;
    text-align: left;
  }

  .web-demo__scene-head--results .web-demo__sub {
    max-width: 28ch;
    margin: 0 0 0.25cqw;
    padding-left: 1.2cqw;
    border-left: max(2px, 0.24cqw) solid var(--demo-mint);
    font-size: clamp(7px, 1.25cqw, 12px);
    text-align: left;
  }

  .results-grid {
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-rows: repeat(3, minmax(0, 1fr));
    align-self: stretch;
    gap: 1.05cqw;
    height: auto;
    min-height: 0;
    padding: 0 0.6cqw 0.6cqw;
  }

  .result-card {
    position: relative;
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    gap: 0.85cqw;
    overflow: hidden;
    padding: 0.85cqw 1.1cqw;
    border: 1px solid rgba(255, 255, 255, 0.66);
    border-radius: 1.35cqw;
    text-align: left;
    background: rgba(250, 253, 255, 0.91);
    box-shadow:
      0 0.9cqw 1.9cqw -1.1cqw rgba(15, 44, 86, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.84);
  }

  .result-card[data-result='clicks'] {
    grid-row: 1 / -1;
    grid-template-columns: 1fr;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1cqw;
    padding: 1.45cqw 1.55cqw 1.15cqw;
    border-color: rgba(255, 255, 255, 0.78);
    border-radius: 1.8cqw;
    background:
      radial-gradient(circle at 90% 10%, rgba(43, 195, 165, 0.13), transparent 30%),
      linear-gradient(145deg, rgba(251, 254, 255, 0.98), rgba(226, 243, 255, 0.94));
  }

  .result-card[data-result='conversion'] {
    background: linear-gradient(140deg, rgba(238, 248, 255, 0.96), rgba(221, 241, 255, 0.94));
  }

  .result-card[data-result='performance'] {
    color: #fff;
    background: linear-gradient(135deg, #0f2c56, #175590 62%, #1d6db0);
    box-shadow:
      0 1cqw 2.2cqw -1.1cqw rgba(5, 28, 55, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .result-card__label {
    display: flex;
    align-items: center;
    gap: 0.55cqw;
    min-width: 0;
  }

  .result-card__label i {
    flex: none;
    width: 0.55cqw;
    min-width: 3px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--demo-mint);
    box-shadow: 0 0 0 0.45cqw rgba(43, 195, 165, 0.11);
  }

  .result-card strong {
    align-self: auto;
    font-size: clamp(7px, 1.35cqw, 13px);
    font-weight: 830;
    line-height: 1.04;
  }

  .result-card[data-result='clicks'] .result-card__label {
    grid-row: 1;
  }

  .result-card[data-result='clicks'] strong {
    font-size: clamp(9px, 1.75cqw, 16px);
  }

  .result-card__chart {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .result-card[data-result='clicks'] .result-card__chart {
    grid-row: 2;
  }

  .chart__area {
    fill: url('#web-chart-fill');
  }

  .chart__line,
  .chart__arrow,
  .chart__tick {
    stroke-width: 2.8;
  }

  .chart__funnel {
    fill: rgba(66, 160, 239, 0.12);
    stroke: var(--demo-blue);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .result-card[data-result='performance'] .chart__donut-track {
    stroke: rgba(255, 255, 255, 0.18);
  }

  .result-card[data-result='performance'] .chart__donut {
    stroke: #78c8f6;
