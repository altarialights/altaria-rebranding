---
import { sunSignature } from '../../data/hero';

const sparkles = [
  [8, 22], [14, 68], [23, 34], [31, 82], [39, 18], [48, 72], [57, 25],
  [64, 79], [71, 37], [78, 67], [84, 29], [89, 57], [94, 76], [54, 12],
] as const;

/**
 * The sun easter egg lives above the hero scene and below the header.
 * Its atmosphere is painted CSS: it never changes opacity on a parent of
 * the CSS 3D devices and never competes with the master scroll timeline.
 */
---

<div class="sun-layer" data-sun-layer>
  <span class="sun-core" data-sun-core aria-hidden="true"></span>
  <button class="sun-hit" data-sun-hit type="button" aria-label={sunSignature.label}></button>

  <div class="sig__atmosphere" aria-hidden="true">
    <span class="sig__veil" data-sig-veil></span>
    <span class="sig__rays" data-sig-rays></span>
    <span class="sig__flare" data-sig-flare></span>
    <span class="sig__mist" data-sig-mist></span>

    <span class="sig__cloud sig__cloud--left" data-sig-cloud></span>
    <span class="sig__cloud sig__cloud--right" data-sig-cloud></span>
    <span class="sig__cloud sig__cloud--bottom" data-sig-cloud></span>

    <span class="sig__sparkles">
      {
        sparkles.map(([x, y], index) => (
          <i style={`--sx:${x}%;--sy:${y}%;--delay:${(index % 5) * 0.13}s`} data-sig-particle></i>
        ))
      }
    </span>
  </div>

  <p class="sig" data-sig role="status" aria-live="polite">
    <span class="sig__intro" data-sig-intro>{sunSignature.intro}</span>
    <span class="sig__line" data-sig-line>
      {sunSignature.line.map((row) => <span class="sig__line-row">{row}</span>)}
    </span>
  </p>

  <span class="sig__bubble" data-sig-bubble role="status">{sunSignature.encore}</span>
</div>

<style>
  .sun-layer {
    position: absolute;
    inset: 0;
    z-index: 57;
    pointer-events: none;
  }

  .sun-core {
    position: absolute;
    left: var(--sun-x);
    top: var(--sun-y);
    z-index: 8;
    width: clamp(220px, 18vw, 360px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) scale(0.86);
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(
      circle,
      rgba(255, 255, 248, 0.98) 0%,
      rgba(255, 247, 218, 0.64) 20%,
      rgba(255, 229, 171, 0.24) 48%,
      rgba(255, 229, 171, 0) 72%
    );
    will-change: transform, opacity;
  }

  .sun-hit {
    position: absolute;
    left: var(--sun-x);
    top: var(--sun-y);
    z-index: 12;
    width: 176px;
    height: 176px;
    margin: -88px 0 0 -88px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .sun-hit:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 4px;
  }

  :global([data-sky-busy]) .sun-hit {
    pointer-events: none;
  }

  .sig__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .sig__veil {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      radial-gradient(
        circle 30vw at var(--sun-x) var(--sun-y),
        rgba(255, 252, 224, 0.34) 0%,
        rgba(125, 201, 255, 0.2) 28%,
        rgba(34, 119, 203, 0) 72%
      ),
      radial-gradient(
        ellipse 72% 70% at 50% 47%,
        rgba(23, 104, 190, 0.78) 0%,
        rgba(8, 70, 154, 0.88) 62%,
        rgba(4, 44, 112, 0.96) 100%
      ),
      linear-gradient(145deg, rgba(5, 55, 137, 0.94), rgba(15, 105, 193, 0.9));
    will-change: opacity;
  }

  .sig__rays,
  .sig__flare {
    position: absolute;
    left: var(--sun-x);
    top: var(--sun-y);
    border-radius: 50%;
    opacity: 0;
    will-change: transform, opacity;
  }

  .sig__rays {
    width: 105vmax;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotate(-10deg) scale(0.82);
    background: repeating-conic-gradient(
      from 8deg,
      rgba(255, 251, 221, 0.16) 0deg,
      rgba(255, 251, 221, 0.03) 1.4deg,
      rgba(255, 251, 221, 0) 4deg,
      rgba(255, 251, 221, 0) 17deg
    );
    -webkit-mask-image: radial-gradient(circle, #000 0 5%, rgba(0, 0, 0, 0.82) 17%, transparent 61%);
    mask-image: radial-gradient(circle, #000 0 5%, rgba(0, 0, 0, 0.82) 17%, transparent 61%);
  }

  .sig__flare {
    width: min(58vw, 940px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) scale(0.82);
    background: radial-gradient(
      circle,
      rgba(255, 255, 248, 0.88) 0%,
      rgba(255, 245, 203, 0.34) 13%,
      rgba(177, 222, 255, 0.16) 35%,
      rgba(177, 222, 255, 0) 68%
    );
  }

  .sig__mist {
    position: absolute;
    inset: 20% 8% 8%;
    opacity: 0;
    background:
      radial-gradient(ellipse at 52% 44%, rgba(194, 230, 255, 0.2), transparent 54%),
      linear-gradient(to bottom, transparent 15%, rgba(122, 196, 246, 0.12) 54%, rgba(223, 243, 255, 0.2));
    filter: blur(18px);
    will-change: opacity, transform;
  }

  .sig__backdrop {
    position: absolute;
    left: 50%;
    width: 100%;
    transform: translateX(-50%);
    opacity: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 8vw, 10rem);
    font-weight: 900;
    line-height: 0.82;
    text-align: center;
    text-transform: uppercase;
    color: rgba(213, 239, 255, 0.11);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .sig__backdrop--top {
    top: 3%;
  }

  .sig__backdrop--bottom {
    bottom: -5%;
    width: 92vw;
    font-size: clamp(4rem, 7.2vw, 9rem);
    line-height: 0.78;
    white-space: normal;
  }

  .sig__cloud {
    position: absolute;
    opacity: 0;
    background:
      radial-gradient(ellipse 31% 48% at 0% 68%, #fff 0%, rgba(255, 255, 255, 0.92) 48%, transparent 78%),
      radial-gradient(ellipse 34% 52% at 18% 54%, #fff 0%, rgba(252, 254, 255, 0.92) 50%, transparent 79%),
      radial-gradient(ellipse 38% 58% at 36% 44%, #fff 0%, rgba(247, 252, 255, 0.9) 48%, transparent 77%),
      radial-gradient(ellipse 34% 50% at 53% 58%, #fff 0%, rgba(239, 249, 255, 0.84) 50%, transparent 80%),
      radial-gradient(ellipse 29% 44% at 68% 70%, rgba(242, 251, 255, 0.94) 0%, rgba(220, 240, 253, 0.72) 50%, transparent 80%),
      radial-gradient(ellipse 58% 38% at 35% 88%, rgba(224, 241, 253, 0.82) 0%, rgba(190, 220, 243, 0.42) 54%, transparent 84%);
    filter: blur(7px) drop-shadow(0 -10px 28px rgba(217, 241, 255, 0.18));
    will-change: transform, opacity;
  }

  .sig__cloud--left {
    left: -18vw;
    bottom: -10vh;
    width: 68vw;
    height: 64vh;
  }

  .sig__cloud--right {
    right: -18vw;
    bottom: -8vh;
    width: 68vw;
    height: 58vh;
    transform: scaleX(-1);
  }

  .sig__cloud--bottom {
    left: 16vw;
    bottom: -25vh;
    width: 72vw;
    height: 44vh;
  }

  .sig__sparkles,
  .sig__sparkles i {
    position: absolute;
  }

  .sig__sparkles {
    inset: 0;
  }

  .sig__sparkles i {
    left: var(--sx);
    top: var(--sy);
    width: clamp(2px, 0.28vw, 5px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 5px 2px rgba(219, 245, 255, 0.72), 0 0 18px 6px rgba(128, 209, 255, 0.28);
    opacity: 0;
    will-change: transform, opacity;
  }

  .sig {
    position: absolute;
    left: 50%;
    top: 51%;
    z-index: 6;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: clamp(0.65rem, 1.4vh, 1.15rem);
    width: min(96vw, 1800px);
    margin: 0;
    text-align: center;
    pointer-events: none;
  }

  .sig__intro {
    display: block;
    opacity: 0;
    font-size: clamp(0.78rem, 0.58rem + 0.58vw, 1.35rem);
    font-weight: 750;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.96);
    text-shadow: 0 2px 18px rgba(1, 30, 76, 0.62), 0 0 18px rgba(215, 242, 255, 0.26);
    will-change: transform, opacity;
  }

  .sig__line {
    display: grid;
    justify-items: center;
    opacity: 0;
    padding: 0.3em 0.16em 0.22em;
    margin: -0.3em -0.16em -0.22em;
    overflow: visible;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 9.4vw, 11.75rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.018em;
    white-space: nowrap;
    color: #fff;
    text-shadow:
      0 0 8px rgba(255, 255, 255, 0.4),
      0 0 26px rgba(213, 240, 255, 0.56),
      0 8px 36px rgba(0, 37, 94, 0.42);
    will-change: transform, opacity, filter;
  }

  .sig__line-row {
    display: block;
  }

  .sig__bubble {
    position: absolute;
    right: calc(100% - var(--sun-x) + clamp(1.5rem, 2.3vw, 3rem));
    top: calc(var(--sun-y) + clamp(4.5rem, 6vw, 7rem));
    z-index: 11;
    padding: 0.72rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 14px 34px -16px rgba(3, 35, 82, 0.58), inset 0 1px 0 #fff;
    color: var(--ink);
    font-size: clamp(0.78rem, 0.72rem + 0.15vw, 0.92rem);
    font-weight: 650;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    transform-origin: 88% 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .sig__bubble::after {
    content: '';
    position: absolute;
    right: 1.15rem;
    top: -5px;
    width: 10px;
    height: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.7);
    border-top: 1px solid rgba(255, 255, 255, 0.7);
    background: inherit;
    transform: rotate(45deg);
  }

  /* The reveal owns many large, initially transparent surfaces. Keep the
     authored hints available for hover/click, but do not reserve compositor
     resources during the rest of the page lifetime. The interaction script
     adds this class before starting any visible tween and removes it only
     after every sun animation has settled. */
  .sun-layer:not(.is-compositor-ready) *,
  .sun-layer:not(.is-compositor-ready) *::before,
  .sun-layer:not(.is-compositor-ready) *::after {
    will-change: auto !important;
  }

  @media (max-width: 1019px) {
    .sig,
    .sig__atmosphere,
    .sig__bubble {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sig__rays {
      display: none;
    }
  }
</style>
