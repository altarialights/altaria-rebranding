---
import { sunSignature } from '../../data/hero';

/**
 * The sun, and what happens if you press it.
 *
 * The quietest of the easter eggs and the only one that is about the
 * studio rather than about the weather. The birds, the jet and the rocket
 * are jokes; this one is a signature. It gets no bubble, no card and no
 * panel — the brief for it was that the SKY becomes the place the message
 * appears, and a container of any kind would turn a moment into a
 * notification.
 *
 * Three parts:
 *   .sun-hit    an invisible disc over the sun. Sits below the header on
 *               purpose: from 1440 down the sun's centre is behind the
 *               capsule, and letting the header occlude the top of the
 *               disc costs a sliver of hit area and keeps the "Hablemos"
 *               button working. The rest of the disc is always clear.
 *   .sun-core   the halo's reaction. A warm disc that lives at the sun
 *               and only exists to have something small to animate — the
 *               real sun gradient is a full-bleed layer and cannot be
 *               scaled without moving the sun across the sky.
 *   .sig        the veil and the two lines.
 */
---

<div class="sun-layer" data-sun-layer>
  <span class="sun-core" data-sun-core aria-hidden="true"></span>
  <button class="sun-hit" data-sun-hit type="button" aria-label={sunSignature.label}></button>

  <!-- The sky deepening around the message. Not a scrim: it is a soft
       radial that is strongest where the words are and gone by the edges,
       so it reads as light gathering rather than as an overlay. -->
  <span class="sig__veil" data-sig-veil aria-hidden="true"></span>

  <p class="sig" data-sig role="status" aria-live="polite">
    <span class="sig__intro" data-sig-intro>{sunSignature.intro}</span>
    <span class="sig__line" data-sig-line>{sunSignature.line}</span>
  </p>
</div>

<style>
  .sun-layer {
    position: absolute;
    inset: 0;
    /* Above the scene and the reaction layer, below the header. */
    z-index: 57;
    pointer-events: none;
  }

  /* --- The sun's own reaction ---------------------------------------- */
  .sun-core {
    position: absolute;
    left: var(--sun-x);
    top: var(--sun-y);
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(
      circle,
      rgba(255, 253, 246, 0.9) 0%,
      rgba(255, 244, 214, 0.5) 22%,
      rgba(255, 233, 189, 0.22) 46%,
      rgba(255, 233, 189, 0) 72%
    );
    will-change: transform, opacity;
  }

  .sun-hit {
    position: absolute;
    left: var(--sun-x);
    top: var(--sun-y);
    width: 176px;
    height: 176px;
    margin: -88px 0 0 -88px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    /* The only affordance is the cursor, and you have to be on it to see
       that. Nothing about the sun says "button" until you touch it. */
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .sun-hit:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: 4px;
  }

  /* The disc reaches down to about 16vh, which is the lane the jet and
     the second flock fly through — they would be uncatchable while they
     crossed it. Whatever is passing wins: it is the thing that is about
     to be gone, and the sun is not going anywhere. sky-life.ts owns the
     flag.

     `:global()` on the ancestor because it is the stage, which belongs to
     another component: Astro scopes every compound in a selector, so a
     plain `[data-sky-busy] .sun-hit` compiles to a rule that requires the
     stage to carry THIS component's scope id, and silently never
     matches. */
  :global([data-sky-busy]) .sun-hit {
    pointer-events: none;
  }

  /* --- The message ---------------------------------------------------- */
  /* The veil is what makes the moment legible, and it is a PAINTED layer
     for a reason: dimming the scene by tweening opacity on an ancestor of
     the devices would wrap four preserve-3d subtrees in a render surface
     and tear it down again two seconds later — the exact create/destroy
     cycle that caused the v5 face flicker. A wash costs nothing and
     touches no 3D sorting.

     Three stacked washes, and the coverage is deliberate: the first pass
     of this was far too transparent and the scene went on competing with
     the sentence — you could still read the headline and count the keys
     on the laptop. This is the sky itself thickening until it is nearly
     all you can see.

       · a broad white-blue FOG, which is what takes the detail out of
         whatever is underneath without darkening it;
       · the sky's own blue over the top, deepest behind the words;
       · a soft luminous bloom right where the sentence lands, so the
         white type sits in light rather than on a flat field.

     Blue and luminous, never grey and never black — three layers of
     weather, not a modal scrim. And no backdrop-filter: reading the
     backdrop through a filter would pull four preserve-3d subtrees into
     a render surface, which is the one thing this project does not do. */
  .sig__veil {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      radial-gradient(
        ellipse 44% 32% at 57% 46%,
        rgba(255, 255, 255, 0.22) 0%,
        rgba(255, 255, 255, 0.08) 52%,
        rgba(255, 255, 255, 0) 80%
      ),
      radial-gradient(
        ellipse 78% 66% at 57% 46%,
        rgba(19, 64, 118, 0.8) 0%,
        rgba(19, 64, 118, 0.72) 44%,
        rgba(23, 76, 136, 0.6) 74%,
        rgba(25, 82, 144, 0.52) 100%
      ),
      linear-gradient(to bottom, rgba(28, 92, 158, 0.3), rgba(21, 70, 126, 0.34));
    will-change: opacity;
  }

  /* Right of centre, clear of the headline column that runs 7–47vw in
     every beat. It still crosses whatever device is on stage — there is
     no gap in this composition wide enough for a five-word line — which
     is what the veil is for. */
  .sig {
    position: absolute;
    left: 57%;
    top: 46%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: max-content;
    max-width: 88vw;
    /* Left-aligned, not centred. Centring hangs the small line in the
       middle of the block, which at 1920 is exactly where the phone is —
       the credit disappeared onto a lit screen. Sitting it on the
       shoulder of the big line also just reads better: a signature, not
       a caption. */
    text-align: left;
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }

  /* Small, spaced, in the body sans: this is the credit line, not the
     headline. It arrives first and gets out of the way. */
  .sig__intro {
    display: block;
    opacity: 0;
    font-size: clamp(0.72rem, 0.62rem + 0.36vw, 0.98rem);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 2px 14px rgba(30, 74, 120, 0.5);
    will-change: transform, opacity;
  }

  /* The protagonist. Puffy, big, and lit rather than coloured.
     ------------------------------------------------------------------
     The warm sweep is a gradient clipped to the glyphs, so the light
     genuinely travels THROUGH the letters instead of a highlight sliding
     over the top of them. Because that makes the text itself
     transparent, the glow has to come from `filter: drop-shadow`, which
     works off what was actually painted — a `text-shadow` would print
     the halo inside the letterforms and turn them to mud. */
  /* THE ACCENT BUG LIVED HERE.
     `background-clip: text` paints the gradient only inside the element's
     PADDING BOX and the glyphs are transparent, so any part of a letter
     that sticks out of that box is not drawn at all — it does not get
     clipped, it never gets painted. With line-height 1.02 the acute on
     the Í of "TENÍA" rises straight out of the box and vanishes.
     The padding is the fix, and it is generous on purpose: 0.3em of
     headroom clears an acute over a cap, a diaeresis, and the tilde of an
     Ñ with room to spare, for any sentence written here in future. The
     negative margin gives the space back to the layout. */
  .sig__line {
    display: block;
    opacity: 0;
    padding: 0.3em 0.16em 0.22em;
    margin: -0.3em -0.16em -0.22em;
    overflow: visible;
    font-family: var(--font-display);
    /* Big enough to be the protagonist, small enough that the block stays
       inside the right-hand two thirds instead of spanning the frame. */
    font-size: clamp(1.9rem, 3.4vw, 4.3rem);
    font-weight: 900;
    line-height: 1.16;
    letter-spacing: -0.005em;
    white-space: nowrap;
    background: linear-gradient(
      100deg,
      #ffffff 0%,
      #ffffff 34%,
      #fff7e6 44%,
      #ffeec9 50%,
      #fff7e6 56%,
      #ffffff 66%,
      #ffffff 100%
    );
    background-size: 300% 100%;
    background-position: 140% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 3px 22px rgba(255, 236, 196, 0.5))
      drop-shadow(0 1px 3px rgba(40, 84, 130, 0.28));
    will-change: transform, opacity, filter;
  }

  /* Below 1020 the hero is the simplified choreography and the copy
     climbs to 12vh, where this would land on it. The sun keeps its
     reaction; the message does not run. */
  @media (max-width: 1019px) {
    .sig,
    .sig__veil {
      display: none;
    }
  }
</style>
