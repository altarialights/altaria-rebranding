---
import { growthBeat, flow } from '../../data/hero';
import BeatCopy from './BeatCopy.astro';
import FlowNode from './FlowNode.astro';

/**
 * Beat 3 — the connected system.
 *
 * Two parts: the copy block on the left (L5) and the node cluster on the
 * right (L3). The nodes are real anchors: hoverable, focusable, and each
 * one navigates to its article in "Cómo funciona". Nothing here is a
 * metric — there is not a single number, invented or otherwise.
 *
 * The connector SVG shares the cluster's coordinate space (520 × 430) so
 * the curves land on the node edges without magic offsets.
 */
---

<BeatCopy id="growth" title={growthBeat.title} sub={growthBeat.sub} variant={5} />

<div class="obj obj--flow" data-obj="flow" data-layer="L3">
  <div class="obj__float" data-float="flow">
    <div class="flow" data-flow-cluster>
      <!-- A soft aura where the ring is, so the middle of the circle is
           not a hole. It is the only thing left in the centre now that the
           connectors are gone, and it does the job a drawn line was doing
           badly: giving the composition a centre of gravity. -->
      <span class="flow__aura" data-flow-aura aria-hidden="true"></span>

      {flow.map((node, i) => <FlowNode node={node} index={i} />)}
    </div>
  </div>
</div>

<style>
  .obj--flow {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--flow-w);
    /* Above the growth copy block (5, its sibling here) so an open
       explanation card PAINTS over the headline when it reaches left past
       the ring, instead of the headline showing through it. Still below
       the foreground cloud layer (8), like the devices.
       Note this only settles the two of them: the other four beats live
       outside .hero__objects and always paint above it. That is fine —
       none of them is visible while the ring is on screen. */
    z-index: 7;
    opacity: 0;
    will-change: transform, opacity;
  }

  .obj__float {
    will-change: transform;
  }

  .flow {
    position: relative;
    aspect-ratio: 900 / 820;
    /* The cards settle out of a slight backward tilt; without a
       perspective here that rotationX would just squash them. */
    perspective: 1600px;
  }

  .flow__aura {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Reaches just past the ring of cards, so the light itself carries
       the circle. */
    width: 80%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(238, 248, 255, 0.62) 24%,
      rgba(190, 222, 249, 0.36) 46%,
      rgba(190, 222, 249, 0) 70%
    );
  }
</style>
