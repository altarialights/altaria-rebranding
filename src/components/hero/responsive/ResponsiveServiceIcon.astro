---
import type { ResponsiveServiceIcon } from '../../../data/responsiveHero';

interface Props {
  icon: ResponsiveServiceIcon;
}

const { icon } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    icon === 'content' && (
      <>
        <rect x="4" y="3.5" width="16" height="17" rx="4" />
        <path d="m10 8 5.5 4-5.5 4Z" />
      </>
    )
  }
  {
    icon === 'web' && (
      <>
        <rect x="3" y="4.5" width="18" height="15" rx="3" />
        <path d="M3.5 9h17M7 7h.01" />
      </>
    )
  }
  {
    icon === 'software' && (
      <>
        <path d="m9 7-5 5 5 5M15 7l5 5-5 5M13.5 4.5l-3 15" />
      </>
    )
  }
  {
    icon === 'brand' && (
      <path d="m12 3 2.45 4.97 5.48.8-3.96 3.86.93 5.45L12 15.5l-4.9 2.58.94-5.45-3.97-3.86 5.48-.8Z" />
    )
  }
  {
    icon === 'connected' && (
      <>
        <circle cx="12" cy="12" r="3" />
        <circle cx="5" cy="6" r="2" />
        <circle cx="19" cy="6" r="2" />
        <circle cx="5" cy="18" r="2" />
        <circle cx="19" cy="18" r="2" />
        <path d="m7 7.5 2.6 2.2M17 7.5l-2.6 2.2M7 16.5l2.6-2.2M17 16.5l-2.6-2.2" />
      </>
    )
  }
</svg>

<style>
  svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
