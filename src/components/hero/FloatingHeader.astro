---
import { header as defaultHeader } from '../../data/hero';
import { serviceNavigation } from '../../data/site-navigation';

interface HeaderLink {
  label: string;
  href: string;
}

interface Props {
  alwaysVisible?: boolean;
  brandHref?: string;
  nav?: readonly HeaderLink[];
  cta?: HeaderLink;
}

const {
  alwaysVisible = false,
  brandHref = '#top',
  nav = defaultHeader.nav,
  cta = defaultHeader.cta,
} = Astro.props;

const currentPath = Astro.url.pathname;
const navWithoutServices = nav.filter((item: HeaderLink) => !item.label.toLocaleLowerCase('es').startsWith('servicio'));
const diagnosticLink = { label: 'Diagnóstico', href: '/medir-nivel-digital' };
const secondaryNav = navWithoutServices.some((item: HeaderLink) => item.href === diagnosticLink.href)
  ? navWithoutServices
  : [...navWithoutServices, diagnosticLink];

/**
 * Floating capsule header. Absent from the first frame — not even the
 * wordmark — and drops in from above while the opening statement
 * dissolves.
 *
 * It arrives already compact: a fixed-width capsule, narrower than the
 * viewport and centred. Because the width never animates, the morph costs
 * zero layout shift (the previous build's entire CLS budget came from
 * animating a header's width).
 *
 * The approved lockup already includes the symbol and wordmark, so the
 * header renders it as one atomic image at every performance tier.
 */
---

<header class:list={['hdr', { 'hdr--visible': alwaysVisible }]} data-header>
  <div class="hdr__capsule" data-header-capsule>
    <a class="hdr__brand" href={brandHref} aria-label={`${defaultHeader.wordmark} — inicio`}>
      <img
        class="hdr__logo"
        src="/brand/optimized/altaria-v2-logo-header-384.webp"
        srcset="/brand/optimized/altaria-v2-logo-header-384.webp 1x, /brand/optimized/altaria-v2-logo-header-768.webp 2x"
        alt=""
        width="768"
        height="256"
      />
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      <div class="hdr__services" data-header-services-root>
        <button
          class="hdr__services-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="floating-header-services"
          data-header-services-button
        >
          <span>Servicios</span>
          <svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1.5 1.5 4.5 4 4.5-4" /></svg>
        </button>
        <div class="hdr__services-panel" id="floating-header-services" aria-hidden="true" inert data-header-services-panel>
          <div class="hdr__services-heading">
            <span>Qué podemos hacer por ti</span>
            <a href="/servicios">Ver todos <span aria-hidden="true">→</span></a>
          </div>
          <ul>
            {serviceNavigation.map((service) => (
              <li>
                <a href={service.href} aria-current={currentPath === service.href.split('#')[0] ? 'page' : undefined}>
                  <span class="hdr__services-mark" aria-hidden="true">{service.shortLabel}</span>
                  <span><strong>{service.label}</strong><small>{service.description}</small></span>
                  <span class="hdr__services-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {secondaryNav.map((item: HeaderLink) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="hdr__cta" href={cta.href}>{cta.label}</a>

    <div class="hdr__menu" data-header-menu-root>
      <button
        class="hdr__menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="floating-header-menu"
        aria-label="Abrir menú"
        data-header-menu-button
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path class="hdr__menu-line" d="M2 5h16" />
          <path class="hdr__menu-line" d="M2 10h16" />
          <path class="hdr__menu-line" d="M2 15h16" />
          <path class="hdr__close-line" d="M4 4l12 12" />
          <path class="hdr__close-line" d="M16 4 4 16" />
        </svg>
      </button>

      <nav
        class="hdr__menu-panel"
        id="floating-header-menu"
        aria-label="Principal móvil"
        hidden
        inert
        data-header-menu-panel
      >
        <div class="hdr__menu-heading" style="--hdr-menu-order: 0">
          <span>Servicios</span>
          <a href="/servicios">Ver todos <span aria-hidden="true">→</span></a>
        </div>
        <ol class="hdr__menu-services">
          {serviceNavigation.map((service, index: number) => (
            <li style={`--hdr-menu-order: ${index + 1}`}>
              <a href={service.href}>
                <span class="hdr__menu-service-mark" aria-hidden="true">{service.shortLabel}</span>
                <span><strong>{service.label}</strong><small>{service.description}</small></span>
                <span class="hdr__menu-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="hdr__menu-secondary" style={`--hdr-menu-order: ${serviceNavigation.length + 1}`}>
          {secondaryNav.map((item: HeaderLink) => <a href={item.href}>{item.label}</a>)}
        </div>
        <a class="hdr__menu-cta" href={cta.href} style={`--hdr-menu-order: ${serviceNavigation.length + 2}`}>
          <span>{cta.label}</span><span aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  import { initFloatingHeader } from '../../scripts/floating-header';
  initFloatingHeader();
</script>

<style>
  .hdr {
    position: fixed;
    inset: var(--header-top) 0 auto 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .hdr__capsule {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 0.5rem + 1.4vw, 2.6rem);
    width: var(--header-w);
    height: var(--header-h);
    /* Tight on the left so the wordmark sits close to the capsule edge,
       which is the same vertical line the headline starts on. */
    padding: 0 0.6rem 0 1.35rem;
    border-radius: 999px;
    background: rgba(255, 253, 250, 0.72);
    backdrop-filter: blur(14px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.62),
      0 18px 44px -22px rgba(20, 60, 100, 0.42);
    pointer-events: auto;

    /* Entry state; the timeline animates to 0 / 1 / 1. */
    opacity: 0;
    transform: translateY(-130%) scale(0.96);
    will-change: transform, opacity;
  }

  .hdr__brand {
    display: flex;
    align-items: center;
    width: clamp(205px, 12vw, 225px);
    min-width: clamp(205px, 12vw, 225px);
    height: calc(var(--header-h) - 12px);
    flex: 0 0 auto;
    margin-right: auto;
    text-decoration: none;
  }

  .hdr--visible .hdr__capsule {
    opacity: 1;
    transform: none;
  }

  .hdr__logo {
    display: block;
    width: 100%;
    height: 100%;
    flex: 0 0 auto;
    object-fit: contain;
    object-position: left center;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 1.2vw, 2.1rem);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .hdr__nav > a,
  .hdr__services-trigger {
    text-decoration: none;
    color: var(--ink);
    opacity: 0.78;
    transition: opacity 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .hdr__nav > a:hover,
  .hdr__services-trigger:hover,
  .hdr__services.is-services-open .hdr__services-trigger {
    opacity: 1;
  }

  .hdr__services {
    position: relative;
  }

  .hdr__services-trigger {
    display: inline-flex;
    padding: 10px 0;
    align-items: center;
    gap: 7px;
    border: 0;
    font: inherit;
    background: transparent;
    cursor: pointer;
  }

  .hdr__services-trigger svg {
    width: 10px;
    height: 7px;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 240ms cubic-bezier(.22, 1, .36, 1);
  }

  .hdr__services.is-services-open .hdr__services-trigger svg {
    transform: rotate(180deg);
  }

  .hdr__services-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 14px);
    left: 50%;
    width: min(520px, 70vw);
    padding: 18px;
    border: 1px solid rgba(255,255,255,.86);
    border-radius: 24px;
    background: rgba(248,252,255,.94);
    backdrop-filter: blur(20px) saturate(1.18);
    box-shadow: 0 28px 60px -28px rgba(5,48,92,.48), inset 0 1px 0 #fff;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-44%, -9px) scale(.975);
    transform-origin: 42% 0;
    transition: opacity 170ms ease, transform 260ms cubic-bezier(.22, 1, .36, 1), visibility 0s linear 260ms;
  }

  .hdr__services-panel::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 18px;
  }

  .hdr__services.is-services-open .hdr__services-panel {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: translate(-44%, 0) scale(1);
    transition-delay: 0s;
  }

  .hdr__services-heading {
    display: flex;
    padding: 2px 3px 14px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: #547493;
    font-size: 11px;
    letter-spacing: .04em;
  }

  .hdr__services-heading > a {
    color: #1767ae;
    font-weight: 750;
    text-decoration: none;
  }

  .hdr__services-panel ul {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
  }

  .hdr__services-panel li a {
    display: grid;
    min-height: 82px;
    padding: 12px;
    grid-template-columns: 42px minmax(0, 1fr) 18px;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(23,103,174,.08);
    border-radius: 17px;
    color: #123963;
    background: rgba(255,255,255,.68);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .hdr__services-panel li a:hover,
  .hdr__services-panel li a:focus-visible,
  .hdr__services-panel li a[aria-current='page'] {
    border-color: rgba(23,103,174,.2);
    background: #fff;
    box-shadow: 0 12px 24px -20px rgba(10,65,116,.8);
    transform: translateY(-2px);
  }

  .hdr__services-mark,
  .hdr__menu-service-mark {
    display: grid;
    width: 42px;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 13px;
    color: #0966c1;
    background: linear-gradient(145deg, #eef8ff, #d9edfc);
    box-shadow: inset 0 1px 0 #fff;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: -.02em;
  }

  .hdr__services-panel li a > span:nth-child(2) {
    display: grid;
    gap: 3px;
  }

  .hdr__services-panel strong {
    font-size: 12px;
    line-height: 1.15;
  }

  .hdr__services-panel small {
    color: #6684a1;
    font-size: 10px;
    line-height: 1.25;
  }

  .hdr__services-arrow {
    color: #2c7ac0;
    transition: transform 180ms ease;
  }

  .hdr__services-panel li a:hover .hdr__services-arrow,
  .hdr__services-panel li a:focus-visible .hdr__services-arrow {
    transform: translateX(3px);
  }

  .hdr__cta {
    padding: 0.72em 1.5em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
    color: #fff;
    background: var(--accent-deep);
    box-shadow: 0 10px 24px -12px rgba(20, 80, 140, 0.9);
    transition: transform 200ms var(--ease-out);
  }

  .hdr__cta:hover {
    transform: translateY(-1px);
  }

  .hdr__menu {
    display: none;
  }

  @media (max-width: 1019px) {
    .hdr {
      inset-block-start: 20px;
    }

    .hdr__capsule {
      position: relative;
      align-items: flex-start;
      width: calc(100% - 40px);
      height: 62px;
      padding: 6px 7px 6px 16px;
      gap: 12px;
      overflow: visible;
      transition:
        height 360ms cubic-bezier(0.22, 1, 0.36, 1),
        border-radius 360ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 240ms ease;
    }

    .hdr__capsule.is-menu-open {
      height: 304px;
      border-radius: 29px 29px 38px 29px;
      box-shadow: 0 28px 48px -30px rgba(7, 43, 85, 0.72);
    }

    .hdr__brand {
      width: clamp(158px, 28vw, 190px);
      min-width: clamp(158px, 28vw, 190px);
      height: 48px;
    }

    .hdr__nav,
    .hdr__cta {
      display: none;
    }

    .hdr__menu {
      position: static;
      display: block;
      margin-left: auto;
    }

    .hdr__menu-button {
      position: relative;
      z-index: 2;
      display: grid;
      width: 48px;
      height: 48px;
      padding: 0;
      place-items: center;
      border: 1px solid rgba(48, 126, 190, 0.18);
      border-radius: 50%;
      color: #1760a5;
      background: rgba(218, 240, 252, 0.92);
      cursor: pointer;
      transition: color 180ms ease, background-color 180ms ease, transform 140ms ease;
    }

    .hdr__menu-button:hover {
      color: #0c4f8c;
      background: #cfe7f7;
    }

    .hdr__menu-button:active {
      transform: scale(.96);
    }

    .hdr__menu-button:focus-visible,
    .hdr__menu-panel a:focus-visible {
      outline: 3px solid rgba(43, 129, 212, .42);
      outline-offset: 3px;
    }

    .hdr__menu-button svg {
      width: 20px;
      height: 20px;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.5;
    }

    .hdr__menu-line,
    .hdr__close-line {
      transform-origin: center;
      transition: opacity 140ms ease, transform 220ms cubic-bezier(.22, 1, .36, 1);
    }

    .hdr__close-line {
      opacity: 0;
      transform: scale(.65);
    }

    .hdr__menu-button[aria-expanded='true'] .hdr__menu-line {
      opacity: 0;
      transform: scaleX(.35);
    }

    .hdr__menu-button[aria-expanded='true'] .hdr__close-line {
      opacity: 1;
      transform: scale(1);
    }

    .hdr__menu-panel {
      position: absolute;
      z-index: 1;
      top: 62px;
      right: 16px;
      left: 16px;
      height: 230px;
      padding: 8px 0 16px;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 170ms ease,
        transform 260ms cubic-bezier(.22, 1, .36, 1),
        visibility 0s linear 260ms;
    }

    .hdr__menu-panel[hidden] {
      display: none;
    }

    .hdr__capsule.is-menu-open .hdr__menu-panel {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 40ms, 40ms, 0s;
    }

    .hdr__menu-panel ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .hdr__menu-panel li,
    .hdr__menu-cta {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 180ms ease, transform 240ms cubic-bezier(.22, 1, .36, 1);
    }

    .hdr__capsule.is-menu-open .hdr__menu-panel li,
    .hdr__capsule.is-menu-open .hdr__menu-cta {
      opacity: 1;
      transform: translateY(0);
      transition-delay: calc(90ms + var(--hdr-menu-order) * 55ms);
    }

    .hdr__menu-panel li a {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr) 24px;
      min-height: 70px;
      padding: 8px 10px;
      align-items: center;
      border-bottom: 1px solid rgba(21, 89, 152, .14);
      color: #123963;
      text-decoration: none;
      transition: color 160ms ease, transform 180ms ease, background-color 160ms ease;
    }

    .hdr__menu-index {
      align-self: start;
      padding-top: 9px;
      font-family: 'Lemon Milk', var(--font-sans);
      font-size: 9px;
      letter-spacing: .12em;
      color: #2b81d4;
    }

    .hdr__menu-panel strong {
      font-family: 'Lemon Milk', var(--font-sans);
      font-size: clamp(13px, 2vw, 16px);
      font-weight: 400;
      letter-spacing: .035em;
      text-transform: uppercase;
    }

    .hdr__menu-arrow {
      justify-self: end;
      font-size: 18px;
    }

    .hdr__menu-panel li a:hover {
      color: #145998;
      background: rgba(43, 129, 212, .06);
      transform: translateX(4px);
    }

    .hdr__menu-panel .hdr__menu-cta {
      display: flex;
      width: min(100%, 300px);
      min-height: 48px;
      margin: 10px 0 0 auto;
      padding: 0 18px;
      align-items: center;
      justify-content: space-between;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, #1762ad, #093b76);
      text-decoration: none;
    }
  }

  @media (max-width: 767px) {
    .hdr__capsule {
      width: calc(100% - 26px);
    }

    .hdr__capsule.is-menu-open {
      height: 365px;
      border-radius: 27px 27px 42px 27px;
    }

    .hdr__brand {
      width: 150px;
      min-width: 150px;
    }

    .hdr__menu-panel {
      height: 296px;
      padding-top: 6px;
    }

    .hdr__menu-panel ol {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hdr__menu-panel li a {
      min-height: 64px;
      padding-block: 6px;
    }

    .hdr__menu-panel .hdr__menu-cta {
      width: min(100%, 270px);
      margin: 12px auto 0;
      min-height: 50px;
    }
  }

  :global(html.has-header-menu-open) {
    overflow: hidden;
  }

  @media (max-width: 1019px) {
    .hdr {
      inset-block-start: max(18px, env(safe-area-inset-top));
      isolation: isolate;
    }

    .hdr::after {
      position: fixed;
      z-index: -1;
      inset: 0;
      content: '';
      pointer-events: none;
      background: rgba(10,51,96,.11);
      opacity: 0;
      transition: opacity 220ms ease;
    }

    .hdr.is-menu-open::after {
      opacity: 1;
    }

    .hdr__capsule {
      isolation: isolate;
      width: calc(100% - 40px);
      height: 58px;
      padding: 6px 8px 6px 18px;
      border: 0;
      border-radius: 29px;
      background: transparent;
      backdrop-filter: none;
      box-shadow: none;
    }

    .hdr__capsule::before,
    .hdr__capsule::after {
      position: absolute;
      z-index: -1;
      content: '';
      pointer-events: none;
    }

    .hdr__capsule::before {
      top: 0;
      right: 0;
      left: 0;
      height: 100%;
      border: 1px solid rgba(255,255,255,.82);
      border-radius: 29px;
      background: #f3f9fd;
      box-shadow: 0 18px 36px -28px rgba(7,43,85,.78);
      transition: height 360ms cubic-bezier(.22,1,.36,1), border-radius 360ms cubic-bezier(.22,1,.36,1), box-shadow 240ms ease;
    }

    .hdr__capsule::after {
      top: 326px;
      right: 3.5%;
      width: 126px;
      height: 82px;
      border-radius: 50%;
      background: #f3f9fd;
      opacity: 0;
      transform: scale(.76);
      transform-origin: center;
      transition: opacity 160ms ease 80ms, transform 320ms cubic-bezier(.22,1,.36,1) 40ms;
    }

    .hdr__capsule.is-menu-open {
      height: 58px;
      border-radius: 29px;
      box-shadow: none;
    }

    .hdr__capsule.is-menu-open::before {
      height: var(--hdr-menu-open-height, 410px);
      border-radius: 29px 29px 40px 29px;
      box-shadow: 0 28px 48px -30px rgba(7,43,85,.72);
    }

    .hdr__capsule.is-menu-open::after {
      opacity: 1;
      transform: scale(1);
    }

    .hdr__brand {
      position: relative;
      z-index: 2;
      width: 150px;
      min-width: 150px;
      height: 44px;
    }

    .hdr__menu-button {
      width: 44px;
      height: 44px;
      background: #dceefa;
      flex: 0 0 44px;
    }

    .hdr__menu-panel {
      top: 59px;
      right: 10px;
      left: 10px;
      width: 100%;
      width: auto;
      height: auto;
      max-height: none;
      padding: 9px 8px 16px;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      box-shadow: none;
      transform: translateY(-8px);
    }

    .hdr__capsule.is-menu-open .hdr__menu-panel {
      transform: translateY(0);
    }

    .hdr__menu-heading {
      display: flex;
      padding: 1px 5px 10px;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      color: #547493;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .04em;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 180ms ease, transform 240ms cubic-bezier(.22, 1, .36, 1);
    }

    .hdr__menu-heading > a {
      color: #1767ae;
      text-decoration: none;
    }

    .hdr__menu-panel .hdr__menu-services {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 20px;
    }

    .hdr__menu-panel .hdr__menu-services li a {
      display: grid;
      min-height: 86px;
      padding: 9px 6px;
      grid-template-columns: 42px minmax(0, 1fr) 18px;
      align-items: center;
      gap: 10px;
      border: 0;
      border-bottom: 1px solid rgba(21,89,152,.17);
      border-radius: 0;
      color: #123963;
      background: transparent;
    }

    .hdr__menu-panel .hdr__menu-services li a:hover,
    .hdr__menu-panel .hdr__menu-services li a:focus-visible {
      color: #0e5596;
      background: rgba(43,129,212,.06);
      transform: translateX(4px);
    }

    .hdr__menu-panel .hdr__menu-services li a > span:nth-child(2) {
      display: grid;
      min-width: 0;
      gap: 3px;
    }

    .hdr__menu-panel .hdr__menu-services strong {
      font-family: var(--font-sans);
      font-size: clamp(11px, 1.7vw, 13px);
      font-weight: 780;
      letter-spacing: 0;
      text-transform: none;
