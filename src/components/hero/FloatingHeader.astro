---
import { header as defaultHeader } from '../../data/hero';

interface HeaderLink {
  label: string;
  href: string;
}

interface Props {
  alwaysVisible?: boolean;
  brandHref?: string;
  nav?: readonly HeaderLink[];
  cta?: HeaderLink;
}

const {
  alwaysVisible = false,
  brandHref = '#top',
  nav = defaultHeader.nav,
  cta = defaultHeader.cta,
} = Astro.props;

/**
 * Floating capsule header. Absent from the first frame — not even the
 * wordmark — and drops in from above while the opening statement
 * dissolves.
 *
 * It arrives already compact: a fixed-width capsule, narrower than the
 * viewport and centred. Because the width never animates, the morph costs
 * zero layout shift (the previous build's entire CLS budget came from
 * animating a header's width).
 *
 * The approved lockup already includes the symbol and wordmark, so the
 * header renders it as one atomic image at every performance tier.
 */
---

<header class:list={['hdr', { 'hdr--visible': alwaysVisible }]} data-header>
  <div class="hdr__capsule" data-header-capsule>
    <a class="hdr__brand" href={brandHref} aria-label={`${defaultHeader.wordmark} — inicio`}>
      <img
        class="hdr__logo"
        src="/brand/optimized/altaria-v2-logo-header-384.webp"
        srcset="/brand/optimized/altaria-v2-logo-header-384.webp 1x, /brand/optimized/altaria-v2-logo-header-768.webp 2x"
        alt=""
        width="768"
        height="256"
      />
    </a>

    <nav class="hdr__nav" aria-label="Principal">
      {nav.map((item: HeaderLink) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="hdr__cta" href={cta.href}>{cta.label}</a>

    <div class="hdr__menu" data-header-menu-root>
      <button
        class="hdr__menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="floating-header-menu"
        aria-label="Abrir menú"
        data-header-menu-button
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path class="hdr__menu-line" d="M2 5h16" />
          <path class="hdr__menu-line" d="M2 10h16" />
          <path class="hdr__menu-line" d="M2 15h16" />
          <path class="hdr__close-line" d="M4 4l12 12" />
          <path class="hdr__close-line" d="M16 4 4 16" />
        </svg>
      </button>

      <nav
        class="hdr__menu-panel"
        id="floating-header-menu"
        aria-label="Principal móvil"
        hidden
        inert
        data-header-menu-panel
      >
        <ol>
          {nav.map((item: HeaderLink, index: number) => (
            <li style={`--hdr-menu-order: ${index}`}>
              <a href={item.href}>
                <span class="hdr__menu-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <strong>{item.label}</strong>
                <span class="hdr__menu-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="hdr__menu-cta" href={cta.href} style={`--hdr-menu-order: ${nav.length}`}>
          <span>{cta.label}</span><span aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const setHeaderRegionInert = (element: HTMLElement, value: boolean): void => {
    element.inert = value;
    if (value) element.setAttribute('inert', '');
    else element.removeAttribute('inert');
  };

  document.querySelectorAll<HTMLElement>('[data-header-menu-root]').forEach((root) => {
    if (root.dataset.initialised === 'true') return;
    root.dataset.initialised = 'true';

    const capsule = root.closest<HTMLElement>('[data-header-capsule]');
    const button = root.querySelector<HTMLButtonElement>('[data-header-menu-button]');
    const panel = root.querySelector<HTMLElement>('[data-header-menu-panel]');
    const backgroundRegions = Array.from(document.querySelectorAll<HTMLElement>('main, footer'));
    const responsive = window.matchMedia('(max-width: 1019px)');
    let open = false;
    let closeTimer = 0;

    const setMenu = (nextOpen: boolean, restoreFocus = false): void => {
      if (!capsule || !button || !panel || open === nextOpen) return;
      window.clearTimeout(closeTimer);
      open = nextOpen;
      setHeaderRegionInert(panel, !open);
      backgroundRegions.forEach((region) => setHeaderRegionInert(region, open));
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');

      if (open) {
        panel.hidden = false;
        void panel.offsetHeight;
        capsule.classList.add('is-menu-open');
        return;
      }

      capsule.classList.remove('is-menu-open');
      if (restoreFocus) button.focus({ preventScroll: true });
      closeTimer = window.setTimeout(() => {
        if (!open) panel.hidden = true;
      }, 380);
    };

    button?.addEventListener('click', () => setMenu(!open, open));
    panel?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setMenu(false, true);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!open || capsule?.contains(event.target as Node)) return;
      setMenu(false);
    });
    responsive.addEventListener('change', () => setMenu(false));
  });
</script>

<style>
  .hdr {
    position: fixed;
    inset: var(--header-top) 0 auto 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .hdr__capsule {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 0.5rem + 1.4vw, 2.6rem);
    width: var(--header-w);
    height: var(--header-h);
    /* Tight on the left so the wordmark sits close to the capsule edge,
       which is the same vertical line the headline starts on. */
    padding: 0 0.6rem 0 1.35rem;
    border-radius: 999px;
    background: rgba(255, 253, 250, 0.72);
    backdrop-filter: blur(14px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.62),
      0 18px 44px -22px rgba(20, 60, 100, 0.42);
    pointer-events: auto;

    /* Entry state; the timeline animates to 0 / 1 / 1. */
    opacity: 0;
    transform: translateY(-130%) scale(0.96);
    will-change: transform, opacity;
  }

  .hdr__brand {
    display: flex;
    align-items: center;
    width: clamp(205px, 12vw, 225px);
    min-width: clamp(205px, 12vw, 225px);
    height: calc(var(--header-h) - 12px);
    flex: 0 0 auto;
    margin-right: auto;
    text-decoration: none;
  }

  .hdr--visible .hdr__capsule {
    opacity: 1;
    transform: none;
  }

  .hdr__logo {
    display: block;
    width: 100%;
    height: 100%;
    flex: 0 0 auto;
    object-fit: contain;
    object-position: left center;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 1.2vw, 2.1rem);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .hdr__nav a {
    text-decoration: none;
    color: var(--ink);
    opacity: 0.78;
    transition: opacity 200ms var(--ease-out);
  }

  .hdr__nav a:hover {
    opacity: 1;
  }

  .hdr__cta {
    padding: 0.72em 1.5em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
    color: #fff;
    background: var(--accent-deep);
    box-shadow: 0 10px 24px -12px rgba(20, 80, 140, 0.9);
    transition: transform 200ms var(--ease-out);
  }

  .hdr__cta:hover {
    transform: translateY(-1px);
  }

  .hdr__menu {
    display: none;
  }

  @media (max-width: 1019px) {
    .hdr {
      inset-block-start: 20px;
    }

    .hdr__capsule {
      position: relative;
      align-items: flex-start;
      width: calc(100% - 40px);
      height: 62px;
      padding: 6px 7px 6px 16px;
      gap: 12px;
      overflow: visible;
      transition:
        height 360ms cubic-bezier(0.22, 1, 0.36, 1),
        border-radius 360ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 240ms ease;
    }

    .hdr__capsule.is-menu-open {
      height: 304px;
      border-radius: 29px 29px 38px 29px;
      box-shadow: 0 28px 48px -30px rgba(7, 43, 85, 0.72);
    }

    .hdr__brand {
      width: clamp(158px, 28vw, 190px);
      min-width: clamp(158px, 28vw, 190px);
      height: 48px;
    }

    .hdr__nav,
    .hdr__cta {
      display: none;
    }

    .hdr__menu {
      position: static;
      display: block;
      margin-left: auto;
    }

    .hdr__menu-button {
      position: relative;
      z-index: 2;
      display: grid;
      width: 48px;
      height: 48px;
      padding: 0;
      place-items: center;
      border: 1px solid rgba(48, 126, 190, 0.18);
      border-radius: 50%;
      color: #1760a5;
      background: rgba(218, 240, 252, 0.92);
      cursor: pointer;
      transition: color 180ms ease, background-color 180ms ease, transform 140ms ease;
    }

    .hdr__menu-button:hover {
      color: #0c4f8c;
      background: #cfe7f7;
    }

    .hdr__menu-button:active {
      transform: scale(.96);
    }

    .hdr__menu-button:focus-visible,
    .hdr__menu-panel a:focus-visible {
      outline: 3px solid rgba(43, 129, 212, .42);
      outline-offset: 3px;
    }

    .hdr__menu-button svg {
      width: 20px;
      height: 20px;
      overflow: visible;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.5;
    }

    .hdr__menu-line,
    .hdr__close-line {
      transform-origin: center;
      transition: opacity 140ms ease, transform 220ms cubic-bezier(.22, 1, .36, 1);
    }

    .hdr__close-line {
      opacity: 0;
      transform: scale(.65);
    }

    .hdr__menu-button[aria-expanded='true'] .hdr__menu-line {
      opacity: 0;
      transform: scaleX(.35);
    }

    .hdr__menu-button[aria-expanded='true'] .hdr__close-line {
      opacity: 1;
      transform: scale(1);
    }

    .hdr__menu-panel {
      position: absolute;
      z-index: 1;
      top: 62px;
      right: 16px;
      left: 16px;
      height: 230px;
      padding: 8px 0 16px;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 170ms ease,
        transform 260ms cubic-bezier(.22, 1, .36, 1),
        visibility 0s linear 260ms;
    }

    .hdr__menu-panel[hidden] {
      display: none;
    }

    .hdr__capsule.is-menu-open .hdr__menu-panel {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 40ms, 40ms, 0s;
    }

    .hdr__menu-panel ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .hdr__menu-panel li,
    .hdr__menu-cta {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 180ms ease, transform 240ms cubic-bezier(.22, 1, .36, 1);
    }

    .hdr__capsule.is-menu-open .hdr__menu-panel li,
    .hdr__capsule.is-menu-open .hdr__menu-cta {
      opacity: 1;
      transform: translateY(0);
      transition-delay: calc(90ms + var(--hdr-menu-order) * 55ms);
    }

    .hdr__menu-panel li a {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr) 24px;
      min-height: 70px;
      padding: 8px 10px;
      align-items: center;
      border-bottom: 1px solid rgba(21, 89, 152, .14);
      color: #123963;
      text-decoration: none;
      transition: color 160ms ease, transform 180ms ease, background-color 160ms ease;
    }

    .hdr__menu-index {
      align-self: start;
      padding-top: 9px;
      font-family: 'Lemon Milk', var(--font-sans);
      font-size: 9px;
      letter-spacing: .12em;
      color: #2b81d4;
    }

    .hdr__menu-panel strong {
      font-family: 'Lemon Milk', var(--font-sans);
      font-size: clamp(13px, 2vw, 16px);
      font-weight: 400;
      letter-spacing: .035em;
      text-transform: uppercase;
    }

    .hdr__menu-arrow {
      justify-self: end;
      font-size: 18px;
    }

    .hdr__menu-panel li a:hover {
      color: #145998;
      background: rgba(43, 129, 212, .06);
      transform: translateX(4px);
    }

    .hdr__menu-panel .hdr__menu-cta {
      display: flex;
      width: min(100%, 300px);
      min-height: 48px;
      margin: 10px 0 0 auto;
      padding: 0 18px;
      align-items: center;
      justify-content: space-between;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, #1762ad, #093b76);
      text-decoration: none;
    }
  }

  @media (max-width: 767px) {
    .hdr__capsule {
      width: calc(100% - 26px);
    }

    .hdr__capsule.is-menu-open {
      height: 365px;
      border-radius: 27px 27px 42px 27px;
    }

    .hdr__brand {
      width: 150px;
      min-width: 150px;
    }

    .hdr__menu-panel {
      height: 296px;
      padding-top: 6px;
    }

    .hdr__menu-panel ol {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hdr__menu-panel li a {
      min-height: 64px;
      padding-block: 6px;
    }

    .hdr__menu-panel .hdr__menu-cta {
      width: min(100%, 270px);
      margin: 12px auto 0;
      min-height: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__capsule,
    .hdr__menu-panel,
    .hdr__menu-line,
    .hdr__close-line,
    .hdr__menu-panel li,
    .hdr__menu-cta {
      transition-duration: 1ms !important;
      transition-delay: 0ms !important;
    }
  }
</style>
