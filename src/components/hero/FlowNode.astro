---
import FlowTooltip from './FlowTooltip.astro';
import type { FlowNodeContent } from '../../data/hero';

interface Props {
  node: FlowNodeContent;
  index: number;
}
const { node, index } = Astro.props;

/**
 * A service card in the closing composition.
 *
 * v8 used slim pill-shaped nodes. With the devices now leaving the stage
 * instead of parking in a corner, five pills left the last beat looking
 * like a wireframe of itself — a lot of sky and five small labels. These
 * carry real weight: a preview strip that sketches what the service
 * actually produces, then the label and the micro-copy.
 *
 * Still a real anchor: each one navigates to its article in "Cómo
 * funciona" and still opens its explanation card on hover or focus.
 */
const icons: Record<string, string> = {
  contenido:
    'M3 6.5a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zM10 9.4v5.2l4.4-2.6z',
  marca: 'M12 3.2 5 7v5.4c0 4 2.9 7.2 7 8.4 4.1-1.2 7-4.4 7-8.4V7zM9.4 12.2l1.9 1.9 3.5-3.7',
  web: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5zM9 20h6M12 16v4',
  software: 'M9.4 8.2 5.6 12l3.8 3.8M14.6 8.2 18.4 12l-3.8 3.8M13.2 5.4l-2.4 13.2',
  contacto:
    'M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5zM8 3v5M16 3v5M3 11h18M9.6 15.4l1.9 1.9 3.4-3.4',
};
---

<a
  class:list={['card', `card--${node.id}`]}
  href={node.href}
  inert
  data-flow-node={node.id}
  data-obj={`node-${node.id}`}
  style={`--i:${index}`}
  aria-describedby={`tip-${node.id}`}
>
  <!-- Preview strip: a two-second sketch of what the service produces. -->
  <span class="card__preview" aria-hidden="true">
    {
      node.id === 'contenido' && (
        <span class="pv pv--feed">
          <i />
          <i />
          <i />
        </span>
      )
    }
    {
      node.id === 'marca' && (
        <span class="pv pv--palette">
          <i style="--c:#1d6fc0" />
          <i style="--c:#0e1620" />
          <i style="--c:#c9a35a" />
          <i style="--c:#e8eef5" />
        </span>
      )
    }
    {
      node.id === 'web' && (
        <span class="pv pv--page">
          <b />
          <i style="--w:74%" />
          <i style="--w:52%" />
        </span>
      )
    }
    {
      node.id === 'software' && (
        <span class="pv pv--chart">
          <i style="--h:44%" />
          <i style="--h:72%" />
          <i style="--h:56%" />
          <i style="--h:88%" />
          <i style="--h:64%" />
        </span>
      )
    }
    {
      node.id === 'contacto' && (
        <span class="pv pv--action">
          <i />
          <b />
        </span>
      )
    }
  </span>

  <span class="card__body">
    <span class="card__head">
      <span class="card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d={icons[node.id]} /></svg>
      </span>
      <strong>{node.label}</strong>
    </span>
    <em>{node.micro}</em>
  </span>

  <FlowTooltip id={node.id} body={node.tooltip} />
</a>

<style>
  .card {
    position: absolute;
    width: 24%;
    z-index: 5;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.12),
      0 22px 44px -22px rgba(20, 60, 100, 0.5);
    color: var(--accent);
    text-decoration: none;
    opacity: 0;
    /* INERT UNTIL IT HAS ACTUALLY ARRIVED.
       ----------------------------------------------------------------
       These were live from the first frame of the page. Long before the
       closing beat, moving the pointer across the empty middle of the
       sky turned it into a hand and a click navigated to a section —
       an invisible link intercepting the page.

       `inert` is the whole fix in one attribute: no pointer events, no
       focus, out of the tab order, out of the accessibility tree. It is
       set in the markup and cleared per card by the timeline, one card
       at a time, only once that card is most of the way in. The cursor
       and pointer-events lines are belt and braces for the same thing. */
    cursor: default;
    pointer-events: none;
    /* Centre-anchored: these coordinates ARE the card's middle, which is
       what lets the connectors aim at the card instead of at its corner.
       The timeline owns transform during the entry, so hover changes
       shadow and surface only — a second transform would fight it. */
    transform: translate(-50%, -50%);
    transition:
      box-shadow 280ms var(--ease-out),
      background-color 280ms var(--ease-out);
    will-change: transform, opacity;
  }

  /* The explanation card is a child of the anchor, and the anchor builds
     its own stacking context (opacity + will-change), so `z-index` on the
     tooltip can only order it INSIDE its own card — never above a
     sibling card that comes later in the DOM. Lifting the whole card is
     what puts the explanation on top. `focus-within` and not
     `focus-visible`: the pointer can travel into the card, and the
     keyboard path opens it from the anchor itself. */
  /* Live: the timeline drops `inert` once the card has arrived. */
  .card:not([inert]) {
    cursor: pointer;
    pointer-events: auto;
  }

  .card:hover,
  .card:focus-within {
    /* The explanation panel is allowed to cross the central business,
       but must always paint as an intentional foreground layer. */
    z-index: 30;
  }

  .card:hover,
  .card:focus-visible {
    background: rgba(255, 255, 255, 0.97);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.3),
      0 30px 56px -22px rgba(20, 60, 100, 0.55);
  }

  /* --- Preview strip -------------------------------------------------- */
  .card__preview {
    display: block;
    height: 4.2em;
    padding: 0.8em 0.95em;
    border-radius: 16px 16px 0 0;
    background: linear-gradient(150deg, rgba(29, 111, 192, 0.1), rgba(29, 111, 192, 0.03));
    box-shadow: inset 0 -1px 0 rgba(29, 111, 192, 0.1);
  }

  .pv {
    display: flex;
    height: 100%;
  }

  .pv--feed {
    flex-direction: column;
    justify-content: space-between;
  }
  .pv--feed i {
    display: block;
    height: 26%;
    border-radius: 3px;
    background: rgba(29, 111, 192, 0.28);
  }
  .pv--feed i:first-child {
    width: 62%;
    background: linear-gradient(100deg, #3f8fdd, #25b79a);
  }
  .pv--feed i:nth-child(2) {
    width: 100%;
  }
  .pv--feed i:last-child {
    width: 44%;
  }

  .pv--palette {
    gap: 5%;
  }
  .pv--palette i {
    flex: 1;
    border-radius: 5px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
  }

  .pv--page {
    flex-direction: column;
    justify-content: center;
    gap: 9%;
  }
  .pv--page b {
    display: block;
    height: 36%;
    border-radius: 3px;
    background: linear-gradient(100deg, rgba(63, 143, 221, 0.55), rgba(37, 183, 154, 0.4));
  }
  .pv--page i {
    display: block;
    width: var(--w);
    height: 13%;
    min-height: 2px;
    border-radius: 2px;
    background: rgba(14, 22, 32, 0.2);
  }

  .pv--chart {
    align-items: flex-end;
    gap: 6%;
  }
  .pv--chart i {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(to top, rgba(63, 143, 221, 0.3), rgba(37, 183, 154, 0.75));
  }

  .pv--action {
    align-items: center;
    gap: 8%;
  }
  .pv--action i {
    width: 34%;
    height: 48%;
    border-radius: 99px;
    background: linear-gradient(100deg, var(--gold), var(--gold-deep));
  }
  .pv--action b {
    flex: 1;
    height: 20%;
    min-height: 2px;
    border-radius: 2px;
    background: rgba(14, 22, 32, 0.18);
  }

  /* --- Body ----------------------------------------------------------- */
  .card__body {
    display: grid;
    gap: 0.15em;
    padding: 0.8em 0.95em 0.9em;
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 0.45em;
  }

  .card__icon svg {
    display: block;
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card strong {
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .card em {
    font-size: var(--step--1);
    font-style: normal;
    line-height: 1.3;
    color: var(--ink-faint);
  }

  /* The last step is the only warm accent in the scene. */
  .card--contacto {
    background: rgba(255, 252, 245, 0.92);
    color: var(--gold-deep);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(201, 163, 90, 0.34),
      0 22px 44px -22px rgba(120, 90, 30, 0.45);
  }

  .card--contacto .card__preview {
    background: linear-gradient(150deg, rgba(201, 163, 90, 0.16), rgba(201, 163, 90, 0.04));
    box-shadow: inset 0 -1px 0 rgba(201, 163, 90, 0.2);
  }

  .card--contacto:hover,
  .card--contacto:focus-visible {
    background: rgba(255, 253, 249, 0.98);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(201, 163, 90, 0.55),
      0 30px 56px -22px rgba(120, 90, 30, 0.5);
  }

  /* Placement — a TRUE circle, not an ellipse.
     ---------------------------------------------------------------
     Five cards at 72° apart, starting at twelve o'clock and going
     clockwise in the order the hero showed the services. The vertical
     percentages are divided by the box's aspect ratio, because `top: %`
     resolves against height and `left: %` against width: using the same
     number for both would lay them out on an ellipse and the circle
     would only be a circle on one viewport.

     Nothing is drawn between them. v9 wired them together with a blue
     curve and the composition lost its calm — the ring now comes from
     where the cards ARE and from the order they arrive in, which is the
     more confident version of the same idea. */
  .card--contenido {
    left: 50.00%;
    top: 14.33%;
  }
  .card--marca {
    left: 80.91%;
    top: 38.98%;
  }
  .card--web {
    left: 69.10%;
    top: 78.86%;
  }
  .card--software {
    left: 30.90%;
    top: 78.86%;
  }
  .card--contacto {
    left: 19.09%;
    top: 38.98%;
  }
</style>
