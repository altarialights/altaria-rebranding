---
import FlowTooltip from './FlowTooltip.astro';
import type { FlowNodeContent } from '../../data/hero';

interface Props {
  node: FlowNodeContent;
  index: number;
}
const { node, index } = Astro.props;

const icons: Record<string, string> = {
  creatividad: 'M3 6.5a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zM10 9.4v5.2l4.4-2.6z',
  visita: 'M5 3.2 11.7 19.6l2.2-6.4 6.4-2.2z',
  web: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5zM9 20h6M12 16v4',
  reserva: 'M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5zM8 3v5M16 3v5M3 11h18M9.6 15.4l1.9 1.9 3.4-3.4',
};
---

<a
  class:list={['node', `node--${node.id}`]}
  href={node.href}
  data-flow-node={node.id}
  data-obj={`node-${node.id}`}
  style={`--i:${index}`}
  aria-describedby={`tip-${node.id}`}
>
  <span class="node__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d={icons[node.id]} /></svg>
  </span>
  <span class="node__text">
    <strong>{node.label}</strong>
    <em>{node.micro}</em>
  </span>

  <FlowTooltip id={node.id} body={node.tooltip} />
</a>

<style>
  .node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.72em;
    padding: 0.72em 1.05em;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.13),
      0 16px 34px -18px rgba(20, 60, 100, 0.45);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0;
    cursor: pointer;
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out);
    will-change: transform, opacity;
  }

  .node:hover,
  .node:focus-visible {
    transform: translateY(-3px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(29, 111, 192, 0.28),
      0 24px 46px -18px rgba(20, 60, 100, 0.55);
  }

  /* The final step is the only warm accent in the scene. */
  .node--reserva {
    color: var(--gold-deep);
    background: rgba(255, 252, 245, 0.94);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(201, 163, 90, 0.36),
      0 18px 38px -18px rgba(120, 90, 30, 0.42);
  }

  .node--reserva:hover,
  .node--reserva:focus-visible {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.95) inset,
      0 0 0 1px rgba(201, 163, 90, 0.55),
      0 26px 48px -18px rgba(120, 90, 30, 0.5);
  }

  .node__icon svg {
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node__text {
    display: grid;
    line-height: 1.2;
  }

  .node__text strong {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .node__text em {
    font-size: var(--step--2);
    font-style: normal;
    color: var(--ink-faint);
  }

  /* Cluster placement — the connector SVG below shares these coords. */
  .node--creatividad {
    left: 2%;
    top: 20%;
  }
  .node--visita {
    left: 52%;
    top: 4%;
  }
  .node--web {
    left: 44%;
    top: 46%;
  }
  .node--reserva {
    left: 20%;
    top: 80%;
  }
</style>
