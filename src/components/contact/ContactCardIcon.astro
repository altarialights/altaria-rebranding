---
interface Props {
  name: 'phone' | 'mail' | 'download' | 'share' | 'arrow' | 'building' | 'globe' | 'pin' | 'close' | 'copy';
}
const { name } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'phone' && <path d="m8 3 2 5-2.5 2a16 16 0 0 0 6.5 6.5l2-2.5 5 2v3a2 2 0 0 1-2.2 2C10 20 4 14 3 5.2A2 2 0 0 1 5 3Z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'download' && <><path d="M12 3v12m-5-5 5 5 5-5M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></>}
  {name === 'share' && <><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 10.5 6.8-4m-6.8 7 6.8 4" /></>}
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'building' && <><path d="m3 8 9-5 9 5H3Zm0 13h18M5 11v6m5-6v6m4-6v6m5-6v6M3 18h18" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></>}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" />}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></>}
</svg>
