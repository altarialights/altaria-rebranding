---
interface Props {
  icon: 'web' | 'management' | 'automation' | 'dashboard' | 'mobile' | 'integration' | 'portal' | 'support';
}

const { icon } = Astro.props;
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {icon === 'web' && <><rect x="6" y="8" width="36" height="30" rx="5"/><path d="M6 16h36M12 12h.1M17 12h.1M22 12h.1M16 25l-4 4 4 4M32 25l4 4-4 4M27 22l-6 14"/></>}
  {icon === 'management' && <><rect x="7" y="6" width="34" height="36" rx="5"/><path d="M15 14h18M15 22h8M15 30h8M30 21v12M26 27h8"/></>}
  {icon === 'automation' && <><path d="M24 8v5M24 35v5M8 24h5M35 24h5M12.7 12.7l3.6 3.6M31.7 31.7l3.6 3.6M35.3 12.7l-3.6 3.6M16.3 31.7l-3.6 3.6"/><circle cx="24" cy="24" r="10"/><path d="M21 19l8 5-8 5z"/></>}
  {icon === 'dashboard' && <><rect x="6" y="7" width="36" height="34" rx="5"/><path d="M12 34V25M20 34V18M28 34V28M36 34V14M12 13h8"/></>}
  {icon === 'mobile' && <><rect x="14" y="4" width="20" height="40" rx="5"/><path d="M21 9h6M22 38h4M19 28l4-4 3 3 5-6"/></>}
  {icon === 'integration' && <><path d="M18 12h-5a5 5 0 0 0-5 5v6M30 36h5a5 5 0 0 0 5-5v-6M12 28v8h8M36 20v-8h-8"/><path d="M17 30l14-14"/><circle cx="15" cy="15" r="3"/><circle cx="33" cy="33" r="3"/></>}
  {icon === 'portal' && <><circle cx="24" cy="16" r="7"/><path d="M11 40v-5a13 13 0 0 1 26 0v5M34 8h8v10M42 8l-9 9"/></>}
  {icon === 'support' && <><path d="M10 27v-5a14 14 0 0 1 28 0v5M10 27H7a3 3 0 0 0-3 3v5a3 3 0 0 0 3 3h5V27h-2ZM38 27h3a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3h-5V27h2ZM36 38c-2 4-6 6-12 6"/><circle cx="22" cy="44" r="2"/></>}
</svg>
