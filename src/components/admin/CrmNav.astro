---
import '../../styles/admin-crm.css';
interface Props { active: 'overview' | 'companies' | 'pipeline' | 'tasks' | 'proposals' | 'sales'; }
const { active } = Astro.props;
const tabs = [
  { id: 'overview', label: 'Resumen', href: '/admin/crm' },
  { id: 'companies', label: 'Empresas', href: '/admin/crm/empresas' },
  { id: 'pipeline', label: 'Oportunidades', href: '/admin/crm/oportunidades' },
  { id: 'proposals', label: 'Propuestas', href: '/admin/crm/propuestas' },
  { id: 'tasks', label: 'Tareas', href: '/admin/crm/tareas' },
  { id: 'sales', label: 'Guía comercial', href: '/admin/crm/guia-comercial' },
] as const;
---
<nav class="crm-tabs" aria-label="Navegación del CRM">
  {tabs.map((tab) => <a href={tab.href} class:list={[{ 'is-active': active === tab.id }]}
    aria-current={active === tab.id ? 'page' : undefined}>{tab.label}</a>)}
</nav>
<script>
  import '../../scripts/admin-crm-forms';
  document.querySelector<HTMLElement>('.crm-tabs a.is-active')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
</script>
