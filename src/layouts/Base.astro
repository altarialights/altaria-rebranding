---
import '../styles/global.css';
import performanceTierBoot from '../scripts/performance-tier-boot.js?raw';
import CookieConsent from '../components/privacy/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Altaria Lights — prototipo de hero (Puerta 0).' } = Astro.props;
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={performanceTierBoot}></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/optimized/altaria-v2-favicon-16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/optimized/altaria-v2-favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/brand/optimized/altaria-v2-favicon-48.png"
    />
    {/* The opening statement is the first paint and it is set in Puffy.
        Without this the browser only discovers the font after parsing the
        stylesheet, and the phrase appears in the fallback and then jumps.
        `crossorigin` is required on font preloads even same-origin — omit
        it and the file is fetched twice. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Puffy.woff2" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/otf"
      href="/fonts/LEMONMILK-Regular.otf"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
