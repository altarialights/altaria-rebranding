# Copy to .env.bookings.local (ignored by Git). Never paste secrets into chat.
BOOKING_ENABLED=false
BOOKING_GOOGLE_CLIENT_ID=
BOOKING_GOOGLE_CLIENT_SECRET=
BOOKING_GOOGLE_REFRESH_TOKEN=
# Use the exact calendar ID from Google Calendar settings, not an assumed account.
BOOKING_GOOGLE_CALENDAR_ID=
BOOKING_BUSY_CALENDAR_IDS=
# Local/preview must use a separate, explicitly selected test calendar and recipient.
BOOKING_GOOGLE_TEST_CALENDAR_ID=
BOOKING_TEST_ATTENDEE_EMAIL=
BOOKING_TEST_TELEGRAM_BOT_TOKEN=
BOOKING_TEST_TELEGRAM_CHAT_ID=
# Dedicated meeting bot in production; does not change payment notifications.
BOOKING_TELEGRAM_BOT_TOKEN=
BOOKING_TELEGRAM_CHAT_ID=
BOOKING_TELEGRAM_OWNER_ID=
# Independent random secret (32+ characters), Telegram webhook authentication.
BOOKING_TELEGRAM_WEBHOOK_SECRET=
BOOKING_ORGANIZER_NAME=Martín
# Generate two independent random 32-byte hex strings, do not reuse credentials.
BOOKING_RATE_SECRET=
CRON_SECRET=
# Optional server-only configuration; defaults live in src/lib/meetings/config.ts.
# BOOKING_SCHEDULE_JSON={"timezone":"Europe/Madrid","durationMinutes":30,"bufferMinutes":15,"noticeHours":24,"horizonDays":30,"weekdays":[1,2,3,4,5],"windows":[["10:00","14:00"],["16:00","18:00"]]}
