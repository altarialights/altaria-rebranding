# Archivo privado .env.test: copiar y completar sólo después de aprobar una Turso TEST nueva.
# No reutilizar valores de .env. Esta plantilla no contiene credenciales válidas.
ALTARIA_TEST_TURSO_URL=libsql://altaria-os-test-REPLACE.aws-eu-west-1.turso.io
ALTARIA_TEST_DB_MARKER=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
TURSO_DATABASE_URL=libsql://altaria-os-test-REPLACE.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# WorkOS staging only. Enable the two verified flags after a real Google + TOTP test.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://127.0.0.1:4321/auth/altaria/callback
WORKOS_COOKIE_PASSWORD=
ALTARIA_WORKOS_MFA_VERIFIED=0
ALTARIA_WORKOS_GOOGLE_ONLY_VERIFIED=0
ALTARIA_WORKOS_SIGNUP_DISABLED_VERIFIED=0
# Rellenar sólo cuando la persona propietaria haya completado Google + TOTP en staging.
ALTARIA_TEST_OWNER_EMAIL=

# Gmail staging Phase 3 remains disabled until Google Cloud and restricted scope approval.
ALTARIA_GMAIL_CONNECT_ENABLED=0
ALTARIA_GMAIL_TEST_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:4321/api/admin/gmail/callback
ALTARIA_GMAIL_TOKEN_KEY=

# Content OS: solo contrato local. No activar R2 hasta autorizar suscripción y piloto.
# ALTARIA_CONTENT_STORAGE_PROVIDER=mock_local
# ALTARIA_R2_ACCOUNT_ID=
# ALTARIA_R2_BUCKET=
# ALTARIA_R2_JURISDICTION=eu
# ALTARIA_R2_ENDPOINT=
# ALTARIA_R2_ACCESS_KEY_ID=
# ALTARIA_R2_SECRET_ACCESS_KEY=
# ALTARIA_R2_MAX_OBJECT_BYTES=
# ALTARIA_R2_MAX_TOTAL_BYTES=

# MCP privado Fase 7: desactivado hasta configurar WorkOS staging y un endpoint
# HTTPS TEST con autorización explícita. No reutilizar credenciales de producción.
ALTARIA_MCP_ENABLED=0
# Astro y la pasarela usan solo loopback. No iniciar sin aprobacion externa.
ALTARIA_MCP_ASTRO_ORIGIN=http://127.0.0.1:4321
ALTARIA_MCP_TRANSPORT_URL=http://127.0.0.1:4331/mcp
ALTARIA_MCP_OAUTH_ISSUER=
ALTARIA_MCP_RESOURCE=
ALTARIA_MCP_OAUTH_AUDIENCE=
ALTARIA_MCP_RESOURCE_HOST=
ALTARIA_MCP_CLIENT_ID=
